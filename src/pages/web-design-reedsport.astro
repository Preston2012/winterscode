---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('reedsport')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-reedsport"
  title="Reedsport Web Design · Sites from $1,750 · Winters Code"
  description="Custom websites for Reedsport businesses, built to catch dune and river visitors searching ahead. From $1,750. Text Preston at 541-551-0731."
  eyebrow="Locations · Reedsport"
  h1="Web design in Reedsport, Oregon."
  sub="Custom, fast, mobile-first websites for Reedsport businesses. Built to catch visitors planning a dune or river trip."
  bgImage="/photo/local/towns/reedsport"
  showcase
  heroFocal="center 48%"
  intro={[
    "Reedsport sits where the Umpqua River meets the Oregon Dunes. Its businesses live and die by visitors who plan their trip online before they pull into town, so loading fast and answering the question first is what <span class='hl-green'>wins the booking.</span>",
  ]}
/>
