---
/**
 * /work : full sites + apps gallery. Sites lead: they are what sells.
 *
 * Spec ref: docs/design/S6_PLUS.md "/work page spec" (~line 1175).
 * Design soul: dense/dashboard. Proof-via-density. Live numbers
 * (Lighthouse scores, store badges, build durations).
 *
 * Sections:
 *   01 SITES GRID   : every site in portfolio.ts, live Lighthouse per card
 *   02 APPS GRID    : 4 cards (Baseline, StainSlayer, ChopLight, Demi+MyKonos)
 *   03 BRANDING     : the graphic board, added S230 so the proof pages carry it
 *   04 PROCESS      : 3-step (a text and a consult, SOW + 50%, live in days)
 *   05 CONTACT      : reusable section
 *
 * S326 DNA. Each site card's primary is "Text me about a build like this"
 * (prefilled with the project name); the case study and the live site are
 * quiet links after it. Scores paint with the last known reads from
 * src/lib/sites.ts instead of "measuring...", then the live fetch replaces
 * them. One explainer per section instead of the same essay on every card.
 * Order is Sogn, SeaBreeze, US Survey Supply first (portfolio.ts order).
 * Baseline Marketing left the Sites grid: it is Preston's own product site,
 * reached from the Baseline card under Apps. The MyKonos demo opens on tap.
 *
 * Each card has expand-to-detail: click reveals stack + scope + result
 * rows, app store / play store / visit-site links, optional pull quote.
 * Vanilla JS toggle, no framework.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import Contact from '../components/sections/Contact.astro';
import { sites, apps, brand, portfolio } from '../lib/portfolio.ts';
import { SITES, fmtGrade } from '../lib/sites.ts';
import { smsAboutHref } from '../lib/text-cta';
import Explainer from '../components/ui/Explainer.astro';
import Instrument from '../components/sections/Instrument.astro';
import ChereFeature from '../components/sections/ChereFeature.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Tabs from '../components/ui/Tabs.astro';
import Fold from '../components/ui/Fold.astro';
import Arrow from '../components/ui/Arrow.astro';
import TextCta from '../components/ui/TextCta.astro';
import CardArt from '../components/ui/CardArt.astro';
import { breadcrumbSchema, absUrl } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
];
const breadcrumbLd = breadcrumbSchema(crumbs);

// First paint shows the last real reads (dated in sites.ts), never "measuring".
const LH_LABELS = ['perf', 'a11y', 'seo', 'best'];
const lhTier = (n: number) => (n >= 90 ? 'good' : n >= 50 ? 'ok' : 'low');
const secTier = (g: string) => {
  const c = g.charAt(0);
  return c === 'A' ? 'good' : c === 'B' || c === 'C' ? 'ok' : 'low';
};
const measuredSite = (slug: string) => SITES.find((s) => s.portfolioSlug === slug);
// The client's own closing sentence, for the card face (the full quote is on
// the case page). Verbatim, nothing trimmed inside the sentence.
const lastSentence = (t: string) => {
  const x = t.trim(); const cut = x.slice(0, -1).lastIndexOf('. ');
  return cut > 0 ? x.slice(cut + 2) : x;
};
const familyStart = sites.findIndex((p) => p.family);
const moreApps = apps.filter((p) => p.slug !== 'chere' && p.slug !== 'stainslayer-ai');
const stain = apps.filter((p) => p.slug === 'stainslayer-ai');
const visitOf = (p: { links: { label: string; href: string; primary?: boolean }[] }) =>
  p.links.find((l) => l.primary) ?? p.links[0];

// ItemList over the real published portfolio. Position follows the order the
// page renders, and each entry points at its case study when it has one, so
// the list and the internal links on the cards agree.
// S326 moved Preston's own product sites under Apps (ownProduct). They keep
// their place in the list, after the apps that link to them (S339).
const ownSites = portfolio.filter((p) => p.ownProduct && p.published !== false);
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sites, apps and brand work built by Winters Code',
  numberOfItems: sites.length + apps.length + ownSites.length + brand.length,
  itemListElement: [...sites, ...apps, ...ownSites, ...brand].map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: p.name,
      // Chere' has no site of its own yet; its card on this page is its home.
      url: p.caseStudy ? absUrl(p.caseStudy) : p.slug === 'chere' ? absUrl('/work#chere') : (p.links.find((l) => l.primary) ?? p.links[0])?.href,
      ...(p.image ? { image: absUrl(p.image.src) } : {}),
    },
  })),
};
---

<BaseLayout
  title="Work · Oregon Coast Sites I've Built · Winters Code"
  description="Sites and apps I've built for Oregon coast businesses, with live Lighthouse and security grades on every site. Sites start at 3 business days."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <!-- S339 round 3 (Preston 2026-11-21: fold, dedupe, cut numbers and
       labels). The on-page index, the numbered section heads and the process
       steps (Services and /process carry them) are gone. Sites, Apps and
       Branding are one tab set; every card is one riveted plate with the
       live phone score and security grade on its face, and one way in. -->
  <PageHero
    eyebrow="Work"
    h1="Sites and apps I've built."
    sub="Live sites for working coast businesses. Every score is read live, so you can check it yourself."
  />

  <Tabs
    label="The work"
    cols={3}
    tabs={[
      { id: 'sites', label: 'Sites', sub: `${sites.length} live, scored`, icon: 'web' },
      { id: 'apps', label: 'Apps', sub: 'iPhone and Android', icon: 'apps' },
      { id: 'branding', label: 'Branding', sub: 'Logos and marks', icon: 'brand' },
    ]}
  >
    <div slot="panel-sites">
      <ul class="wk-list" role="list">
        {sites.map((p, i) => (
          <>
          {i === familyStart && <li class="wk-group" role="listitem">Built for family</li>}
          <li role="listitem">
            <article class="wk-card wk-card--art" id={p.slug} data-chip-site={p.slug}>
              {p.image && (
                <a class="wk-art" href={p.caseStudy ?? visitOf(p)?.href} target={p.caseStudy ? undefined : '_blank'} rel={p.caseStudy ? undefined : 'noopener'} tabindex="-1" aria-hidden="true">
                  <CardArt slug={p.slug} image={p.image} decorative sizes="(min-width: 740px) 45vw, 90vw" />
                </a>
              )}
              <div class="wk-top">
                <h3 class="wk-name"><a href={p.caseStudy ?? visitOf(p)?.href} target={p.caseStudy ? undefined : '_blank'} rel={p.caseStudy ? undefined : 'noopener'}>{p.name}</a></h3>
                <span class="wk-tag">{p.build === 'rebuild' ? 'Rebuild' : 'New build'}</span>
              </div>
              <p class="wk-face">{p.face ?? p.meta}</p>
              {p.quote && <p class="wk-quote">&ldquo;{lastSentence(p.quote.text)}&rdquo; <span>{p.quote.shortAttr ?? p.quote.attr}</span></p>}
              <div class="wk-foot">
                <p class="wk-score" title="Google's phone test and Mozilla's security-header grade, read live">
                  <span class="wk-lamp" aria-hidden="true"></span>
                  <b data-chip-perf>{measuredSite(p.slug)?.lhFallback?.[0] ?? '·'}</b> on a phone
                  <span class="wk-sep" aria-hidden="true">·</span>
                  <b data-chip-grade>{measuredSite(p.slug)?.secFallback?.grade ?? '·'}</b>
                </p>
                <div class="wk-go">
                  {p.caseStudy && <a class="wc-link" href={p.caseStudy}>Case study <Arrow size={16} /></a>}
                  {visitOf(p) && <a class="wc-link wk-live" href={visitOf(p).href} target="_blank" rel="noopener">Live site <Arrow dir="up-right" size={14} /></a>}
                </div>
              </div>
            </article>
          </li>
          </>
        ))}
      </ul>
      <Fold title="How the scores are read">
        <p>Each card shows two live measurements from the client's own site. The first is Google's Lighthouse phone test, 0 to 100, the harder of its two tests. The second is Mozilla Observatory's grade for security headers, A+ at the top. That is a header check, not a full security test. If a score drops on a site I built, you'll see it here and on <a href="/wall">the Wall</a>.</p>
      </Fold>
      <TextCta label="Text me about a site like these" links={[{ href: '/web-design-coos-bay', label: 'Web design in Coos Bay' }]} />
    </div>

    <div slot="panel-apps">
      <div class="wk-feature"><ChereFeature variant="work" /></div>
      <ul class="wk-list" role="list">
        {stain.map((p) => (
          <li role="listitem">
            <article class="wk-card wk-card--img" id={p.slug}>
              {p.image && <a class="wk-img" href={p.caseStudy ?? visitOf(p)?.href} tabindex="-1" aria-hidden="true"><img src={p.image.srcSmall ?? p.image.src} alt="" width={p.image.width} height={p.image.height} loading="lazy" decoding="async" /></a>}
              <div class="wk-top">
                <h3 class="wk-name"><a href={p.caseStudy ?? visitOf(p)?.href}>{p.name}</a></h3>
                <span class="wk-tag">{p.status === 'retired' ? 'Retired' : p.status}</span>
              </div>
              <p class="wk-face">{p.meta}</p>
              <div class="wk-go">{p.caseStudy && <a class="wc-link" href={p.caseStudy}>Case study <Arrow size={16} /></a>}</div>
            </article>
          </li>
        ))}
      </ul>
      {moreApps.length > 0 && (
        <Fold title="More from the shop" meta={`${moreApps.length} more`}>
          <ul class="wk-list wk-list--tight" role="list">
            {moreApps.map((p) => (
              <li role="listitem">
                <article class="wk-card" id={p.slug}>
                  <div class="wk-top">
                    <h3 class="wk-name">{p.slug === 'demiurge-mykonos' ? p.name : <a href={visitOf(p)?.href} target="_blank" rel="noopener">{p.name}</a>}</h3>
                  </div>
                  <p class="wk-face">{p.meta}</p>
                  {p.slug === 'demiurge-mykonos' && (
                    <details class="wk-demo">
                      <summary>Try the live demo</summary>
                      <Instrument />
                    </details>
                  )}
                  <div class="wk-go">
                    {p.slug !== 'demiurge-mykonos' && visitOf(p) && <a class="wc-link" href={visitOf(p).href} target="_blank" rel="noopener">{visitOf(p).label} <Arrow dir="up-right" size={14} /></a>}
                    {p.relatedCase && <a class="wc-link" id={p.relatedCase.href.split('/').pop()} href={p.relatedCase.href}>{p.relatedCase.label} <Arrow size={16} /></a>}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </Fold>
      )}
    </div>

    <div slot="panel-branding">
      {brand.map((p) => (
        <article class="wk-brand">
          {p.image && (
            <a class="wk-brand-img" href={visitOf(p)?.href}>
              <picture>
                {p.image.srcSmall && <source type="image/webp" srcset={`${p.image.srcXSmall ? p.image.srcXSmall + ' 480w, ' : ''}${p.image.srcSmall} 800w, ${p.image.src} 1200w`} sizes="(min-width: 1024px) 50vw, 100vw" />}
                <img src={p.image.src} alt={p.image.alt} width={p.image.width} height={p.image.height} loading="lazy" decoding="async" />
              </picture>
            </a>
          )}
          <div>
            <h3 class="wk-name">{p.name}</h3>
            <p class="wk-face">{p.meta}</p>
            <div class="wk-go">{p.links.map((l) => <a class="wc-link" href={l.href}>{l.label} <Arrow size={16} /></a>)}</div>
          </div>
        </article>
      ))}
    </div>
  </Tabs>

  <Contact />
</BaseLayout>

<script>
  // Live scores: each site card's phone score and security grade, read from
  // the same /api/workshop feed the Wall uses. The dated last reads print
  // first, so a failed fetch leaves true numbers, never "measuring".
  const MAP: Record<string, string> = {
    'bandon-by-the-dunes': 'bbtd', 'baseline-marketing': 'baseline', 'sogn-contracting': 'sogn',
    seabreeze: 'seabreeze', 'us-survey-supply': 'taylor', 'makai-painting': 'makai',
    'south-coast-cuisine': 'jen', 'grand-management': 'grand', 'professors-golf': 'golf',
  };
  fetch('/api/workshop', { headers: { accept: 'application/json' } })
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data) return;
      for (const slug in MAP) {
        const card = document.querySelector(`[data-chip-site="${slug}"]`);
        if (!card) continue;
        const lh = data.lighthouse?.[MAP[slug]];
        const sec = data.security?.sites?.[MAP[slug]];
        const perf = card.querySelector('[data-chip-perf]');
        const grade = card.querySelector('[data-chip-grade]');
        if (perf && Array.isArray(lh) && typeof lh[0] === 'number') perf.textContent = String(lh[0]);
        if (grade && sec?.grade) grade.textContent = String(sec.grade);
      }
    })
    .catch(() => {});
</script>

<style>
  .wk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .wk-list + :global(.wfold) { margin-top: 14px; }
  .wk-group { margin: 14px 0 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ash-300); display: flex; align-items: center; gap: 10px; }
  .wk-group::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #f6c39c, #c47b45 55%, #8a5430); }

  .wk-card {
    display: flex; flex-direction: column; gap: 8px; height: 100%;
    padding: 16px 16px 10px;
    background: rgba(10, 13, 12, 0.55);
    border: 1px solid var(--wc-line);
    border-radius: var(--wc-r);
    transition: border-color .2s ease;
  }
  .wk-card:hover { border-color: rgba(244, 168, 116, 0.35); }
  .wk-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .wk-name { margin: 0; font-family: var(--wc-display); font-weight: 500; font-size: 21px; line-height: 1.2; letter-spacing: -0.01em; }
  .wk-name a { color: #eef1ec; text-decoration: none; }
  .wk-name a:hover, .wk-name a:focus-visible { color: var(--color-copper-bright); }
  .wk-tag { flex: none; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ash-300); padding: 3px 8px; border: 1px solid var(--wc-line); border-radius: 999px; }
  .wk-face { margin: 0; font-size: 15px; line-height: 1.5; color: var(--color-ash-300); }
  .wk-quote { margin: 2px 0 0; font-family: var(--wc-display); font-style: italic; font-size: 16px; line-height: 1.4; color: #eef1ec; }
  .wk-quote span { display: block; margin-top: 2px; font-family: var(--font-sans); font-style: normal; font-size: 13px; color: var(--color-ash-500); }
  .wk-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; margin-top: auto; padding-top: 6px; border-top: 1px solid var(--wc-line); }
  .wk-score { display: flex; align-items: center; gap: 6px; margin: 0; min-height: 44px; font-size: 14px; color: var(--color-ash-300); }
  .wk-score b { font-family: var(--font-mono); font-weight: 500; color: var(--color-wc-green-bright); }
  .wk-lamp { width: 7px; height: 7px; border-radius: 50%; background: var(--color-wc-green-bright); box-shadow: 0 0 0 3px rgba(77, 216, 168, 0.16); }
  .wk-sep { color: var(--color-ash-500); }
  .wk-go { display: flex; flex-wrap: wrap; gap: 0 18px; }
  .wk-live { color: var(--color-ash-100); }
  .wk-card--art { padding-top: 0; overflow: hidden; }
  .wk-art { display: block; margin: 0 -16px 6px; border-bottom: 1px solid var(--wc-line); }

  .wk-feature { margin-bottom: 12px; }
  .wk-card--img { padding-top: 0; overflow: hidden; }
  .wk-img { display: block; margin: 0 -16px 6px; aspect-ratio: 1200 / 630; overflow: hidden; }
  .wk-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wk-demo { margin-top: 4px; }
  .wk-demo summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; color: var(--color-wc-green); }

  .wk-brand { display: grid; gap: 16px; }
  .wk-brand-img { display: block; border-radius: var(--wc-r); overflow: hidden; border: 1px solid var(--wc-line); }
  .wk-brand-img img { display: block; width: 100%; height: auto; }

  @media (min-width: 740px) {
    .wk-list { grid-template-columns: 1fr 1fr; gap: 12px; }
    .wk-list--tight { grid-template-columns: 1fr; }
    .wk-group { grid-column: 1 / -1; }
    .wk-brand { grid-template-columns: 1.2fr 1fr; align-items: center; gap: 28px; }
  }
</style>
