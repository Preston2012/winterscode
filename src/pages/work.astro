---
/**
 * /work : full apps + sites gallery.
 *
 * Spec ref: docs/design/S6_PLUS.md "/work page spec" (~line 1175).
 * Design soul: dense/dashboard. Proof-via-density. Live numbers
 * (Lighthouse scores, store badges, build durations).
 *
 * Sections:
 *   01 APPS GRID    : 4 cards (Baseline, StainSlayer, ChopLight, Demi+MyKonos)
 *   02 SITES GRID   : 2 cards (Sogn, Baseline Marketing) with live Lighthouse
 *   03 PROCESS      : 3-step (questionnaire + consult, SOW + 50%, live in days)
 *   04 CONTACT      : reusable section
 *
 * Each card has expand-to-detail: click reveals stack + scope + result
 * rows, app store / play store / visit-site links, optional pull quote.
 * Vanilla JS toggle, no framework.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import Contact from '../components/sections/Contact.astro';
import { sites, apps } from '../lib/portfolio.ts';
import Explainer from '../components/ui/Explainer.astro';
import Instrument from '../components/sections/Instrument.astro';
---

<BaseLayout
  title="Work · Winters Code"
  description="Apps and sites I've built. Live Lighthouse on every site. One app on the stores, three in beta. Days for sites, weeks for apps."
>
  <Header />
  <MobileMenu />

  <PageHero
    eyebrow="WORK · APPS + SITES"
    h1="Apps and sites I've built."
    sub="One app live on App Store and Play Store. Three more in private beta. Sites live and serving traffic. Lighthouse scores and build durations from real data."
    sub2="I design and I build, end to end."
  />

  <nav class="wk-index" aria-label="On this page">
    <p class="wk-index-k">On this page</p>
    <ol>
      <li><span class="wk-ix-num">01</span><span class="wk-ix-name">Mobile apps</span><span class="wk-ix-meta">iOS &amp; Android</span></li>
      <li><span class="wk-ix-num">02</span><span class="wk-ix-name">Sites</span><span class="wk-ix-meta">Live Lighthouse</span></li>
      <li><span class="wk-ix-num">03</span><span class="wk-ix-name">How I work</span><span class="wk-ix-meta">Days, not weeks</span></li>
    </ol>
  </nav>

  <Divider label="01" />

  <!-- APPS GRID -->
  <section class="wk-section" aria-labelledby="wk-apps-h">
    <header class="wk-head">
      <div class="wk-eyebrow">
        <span class="line" aria-hidden="true"></span>
        <h2 class="wk-h" id="wk-apps-h">01 · MOBILE APPS</h2>
        <span class="wk-meta">{apps.length} built on iOS & Android</span>
      </div>
    </header>

    <ul class="wk-grid wk-grid-apps" role="list">
      {apps.map((p) => (
        <li class="wk-card-wrap" role="listitem" id={p.slug}>
          <article
            class="wk-card"
            data-slug={p.slug}
            data-status={p.status}
            data-widget={p.slug === 'demiurge-mykonos' ? 'true' : undefined}
          >
            {p.slug === 'demiurge-mykonos' && (
              <div class="mk-primer">
                <div class="mk-row">
                  <span class="mk-name">MyKonos</span>
                  <span class="mk-beta">Beta</span>
                </div>
                <p class="mk-desc">An AI companion app I built. The window below runs its real engine, right here in your browser. <b>It remembers between chats.</b> Tell it something, reset, ask again, <span class='hl-green'>it still knows.</span></p>
                <span class="mk-live"><span class="d" aria-hidden="true"></span>Live demo</span>
              </div>
            )}
            <div class="wk-preview" aria-hidden={p.slug === 'demiurge-mykonos' ? undefined : (p.image ? undefined : 'true')}>
              {p.slug === 'demiurge-mykonos' ? (
                <Instrument />
              ) : p.image ? (
                <a class="wk-preview-link" href={(p.links.find((l) => l.primary) ?? p.links[0])?.href} target="_blank" rel="noopener" aria-label={`Visit ${p.name}`}>
                <picture>
                  {p.image.srcSmall && (
                    <source
                      type="image/webp"
                      srcset={`${p.image.srcXSmall ? p.image.srcXSmall + " 480w, " : ""}${p.image.srcSmall} 720w, ${p.image.src} 1280w`}
                      sizes="(min-width: 1024px) 50vw, 100vw"
                    />
                  )}
                  <img
                    src={p.image.src}
                    alt={p.image.alt}
                    width={p.image.width}
                    height={p.image.height}
                    loading="lazy"
                    decoding="async"
                    class="wk-img"
                  />
                </picture>
                </a>
              ) : (
                <span class="wk-mark" aria-hidden="true">{p.numeral}</span>
              )}
            </div>

            <div class="wk-body">
              <div class="wk-title-row">
                <h3 class="wk-title">{p.slug === 'demiurge-mykonos' ? p.name : <a class="wk-title-link" href={(p.links.find((l) => l.primary) ?? p.links[0])?.href} target="_blank" rel="noopener">{p.name}</a>}</h3>
                {p.slug !== 'demiurge-mykonos' && (
                  <span class={`wk-status wk-status-${p.status}`}>
                    {p.status.toUpperCase()}
                  </span>
                )}
              </div>
              <p class="wk-meta-line">{p.meta}</p>

              <div class="wk-tags" role="list">
                {p.tags.map((t) => (
                  <span class="wk-tag" role="listitem">{t}</span>
                ))}
              </div>

              {(p.links.find((l) => l.primary) ?? p.links[0]) && (
                <a class="wk-visit" href={(p.links.find((l) => l.primary) ?? p.links[0]).href} target="_blank" rel="noopener">
                  {(p.links.find((l) => l.primary) ?? p.links[0]).label}
                </a>
              )}
              <button
                type="button"
                class="wk-expand-btn"
                data-toggle-target={p.slug}
                aria-expanded="false"
                aria-controls={`${p.slug}-detail`}
              >
                <span data-toggle-label>more details</span>
                <span class="wk-expand-icon" aria-hidden="true">+</span>
              </button>

              <div
                class="wk-detail"
                id={`${p.slug}-detail`}
                hidden
              >
                <dl class="wk-detail-rows">
                  {p.details.map((d) => (
                    <div class="wk-detail-row">
                      <dt>{d.label}</dt>
                      <dd>{d.value}</dd>
                    </div>
                  ))}
                </dl>

                {p.quote && (
                  <blockquote class="wk-quote">
                    <p>{p.quote.text}</p>
                    <cite>{p.quote.attr}</cite>
                  </blockquote>
                )}

                {p.links.length > 0 && (
                  <div class="wk-links">
                    {p.links.map((link) => (
                      <a
                        href={link.href}
                        class={link.primary ? 'wk-link wk-link-primary' : 'wk-link'}
                        target="_blank"
                        rel="noopener"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <Divider label="02" />

  <!-- SITES GRID with live Lighthouse -->
  <section class="wk-section" aria-labelledby="wk-sites-h">
    <header class="wk-head">
      <div class="wk-eyebrow">
        <span class="line" aria-hidden="true"></span>
        <h2 class="wk-h" id="wk-sites-h">02 · SITES</h2>
        <span class="wk-meta">
          live Lighthouse on every one
          <Explainer label="?">
            Each card below shows real-time Lighthouse scores fetched fresh when you load this page. No screenshots, no hard-coded numbers. If a score drops on a client site I shipped, you'll see it here.
          </Explainer>
        </span>
      </div>
    </header>

    <ul class="wk-grid wk-grid-sites" role="list">
      {sites.map((p) => (
        <li class="wk-card-wrap" role="listitem" id={p.slug}>
          <article
            class="wk-card wk-card-site"
            data-slug={p.slug}
            data-status={p.status}
          >
            <div class="wk-body">
              <div class="wk-title-row">
                <h3 class="wk-title">{p.slug === 'demiurge-mykonos' ? p.name : <a class="wk-title-link" href={(p.links.find((l) => l.primary) ?? p.links[0])?.href} target="_blank" rel="noopener">{p.name}</a>}</h3>
                {p.slug !== 'demiurge-mykonos' && (
                  <span class={`wk-status wk-status-${p.status}`}>
                    {p.status.toUpperCase()}
                  </span>
                )}
              </div>
              <p class="wk-meta-line">{p.meta}</p>

              <div class="wk-tags" role="list">
                {p.tags.map((t) => (
                  <span class="wk-tag" role="listitem">{t}</span>
                ))}
              </div>

              <div
                class="wk-lighthouse"
                data-lh-site={p.slug}
                aria-live="polite"
              >
                <span class="wk-lh-label">
                  LIGHTHOUSE
                  <Explainer label="?">
                    Google's scorecard for any website. Four numbers, 0 to 100 each: speed, accessibility, security, and how well Google can read the page. 100 is perfect. Most small-business sites score 50-70. These numbers re-measure every time you load this page. Scores shown are mobile (the harder test). Desktop usually runs 2 to 5 points higher.
                  </Explainer>
                </span>
                <span class="wk-lh-scores" data-lh-scores>
                  <span class="wk-lh-pending">measuring...</span>
                </span>
                <span class="wk-lh-measured" data-lh-measured></span>
              </div>

              <div class="wk-cta-row">
                {(p.links.find((l) => l.primary) ?? p.links[0]) && (
                  <a class="wk-visit" href={(p.links.find((l) => l.primary) ?? p.links[0]).href} target="_blank" rel="noopener">
                    {(p.links.find((l) => l.primary) ?? p.links[0]).label}
                  </a>
                )}
                <div class="wk-security" data-sec-site={p.slug} aria-live="polite">
                  <span class="wk-sec-label">
                    MOZILLA
                    <Explainer label="?">
                      Mozilla Observatory grade for HTTP security headers like HSTS and CSP. A+ is the top grade; most small-business sites score C or lower. Re-checked live when you load this page.
                    </Explainer>
                  </span>
                  <span class="wk-sec-grade" data-sec-grade>
                    <span class="wk-sec-pending">checking...</span>
                  </span>
                </div>
              </div>
              <button
                type="button"
                class="wk-expand-btn"
                data-toggle-target={p.slug}
                aria-expanded="false"
                aria-controls={`${p.slug}-detail`}
              >
                <span data-toggle-label>more details</span>
                <span class="wk-expand-icon" aria-hidden="true">+</span>
              </button>

              <div class="wk-detail" id={`${p.slug}-detail`} hidden>
                <dl class="wk-detail-rows">
                  {p.details.map((d) => (
                    <div class="wk-detail-row">
                      <dt>{d.label}</dt>
                      <dd>{d.value}</dd>
                    </div>
                  ))}
                </dl>

                {p.quote && (
                  <blockquote class="wk-quote">
                    <p>{p.quote.text}</p>
                    <cite>{p.quote.attr}</cite>
                  </blockquote>
                )}

                {p.links.length > 0 && (
                  <div class="wk-links">
                    {p.links.map((link) => (
                      <a
                        href={link.href}
                        class={link.primary ? 'wk-link wk-link-primary' : 'wk-link'}
                        target="_blank"
                        rel="noopener"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <Divider label="03" />

  <!-- PROCESS -->
  <section class="wk-section wk-process" aria-labelledby="wk-process-h">
    <header class="wk-head">
      <div class="wk-eyebrow">
        <span class="line" aria-hidden="true"></span>
        <h2 class="wk-h" id="wk-process-h">03 · PROCESS</h2>
        <span class="wk-meta">how a build actually runs</span>
      </div>
    </header>

    <ol class="wk-steps" role="list">
      <li class="wk-step">
        <span class="wk-step-num" aria-hidden="true">01</span>
        <div class="wk-step-body">
          <h3 class="wk-step-h">Questionnaire + consult</h3>
          <p class="wk-step-p">
            Two-page form. Business, audience, services, goals, what you
            have, what you need. Free consult to scope it.
          </p>
          <p class="wk-step-time">No cost. No pitch deck.</p>
        </div>
      </li>
      <li class="wk-step">
        <span class="wk-step-num" aria-hidden="true">02</span>
        <div class="wk-step-body">
          <h3 class="wk-step-h">SOW + 50%</h3>
          <p class="wk-step-p">
            Statement of work locks scope. 50% deposit clears. Work
            starts the same week.
          </p>
          <p class="wk-step-time">Stripe invoice. Standard contract.</p>
        </div>
      </li>
      <li class="wk-step">
        <span class="wk-step-num" aria-hidden="true">03</span>
        <div class="wk-step-body">
          <h3 class="wk-step-h">Live in days</h3>
          <p class="wk-step-p">
            Build, review, polish, ship. Final 50% on launch. Hosting
            and maintenance optional, never required.
          </p>
          <p class="wk-step-time">Most sites: 3 to 7 business days.</p>
        </div>
      </li>
    </ol>
  </section>

  <Divider label="04" />

  <Contact sectionNumber="04" />
</BaseLayout>

<script is:inline>
  (function () {
    // ----- expand / collapse cards
    const buttons = document.querySelectorAll('[data-toggle-target]');
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-toggle-target');
        const detail = document.getElementById(slug + '-detail');
        if (!detail) return;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          detail.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
          const lbl = btn.querySelector('[data-toggle-label]');
          if (lbl) lbl.textContent = 'more details';
          const icon = btn.querySelector('.wk-expand-icon');
          if (icon) icon.textContent = '+';
        } else {
          detail.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          const lbl = btn.querySelector('[data-toggle-label]');
          if (lbl) lbl.textContent = 'less';
          const icon = btn.querySelector('.wk-expand-icon');
          if (icon) icon.textContent = '\u2212';
        }
      });
    }

    // If URL has a hash matching a card slug, auto-expand it.
    if (location.hash && location.hash.length > 1) {
      const slug = location.hash.slice(1);
      const btn = document.querySelector(
        '[data-toggle-target="' + slug + '"]',
      );
      if (btn && btn.getAttribute('aria-expanded') === 'false') btn.click();
    }

    // ----- live Lighthouse from /api/workshop
    async function loadLighthouse() {
      try {
        const res = await fetch('/api/workshop', {
          headers: { accept: 'application/json' },
        });
        if (!res.ok) return;
        const data = await res.json();
        const lh = data.lighthouse;
        if (!lh) return;
        function fill(slug, scores) {
          const root = document.querySelector('[data-lh-site="' + slug + '"]');
          if (!root) return;
          const target = root.querySelector('[data-lh-scores]');
          const measured = root.querySelector('[data-lh-measured]');
          if (!Array.isArray(scores) || scores.length !== 4) return;
          target.textContent = '';
          const labels = ['perf', 'a11y', 'best', 'seo'];
          scores.forEach((n, i) => {
            const pill = document.createElement('span');
            pill.className = 'wk-lh-pill';
            const grade =
              n >= 90 ? 'good' : n >= 50 ? 'ok' : 'low';
            pill.classList.add('wk-lh-pill-' + grade);
            pill.textContent = labels[i] + ' ' + n;
            target.appendChild(pill);
          });
          if (measured && lh.measured) {
            measured.textContent = 'measured ' + lh.measured;
          }
        }
        // Each /work card gets its real site's PSI scores.
        // Previously baseline-marketing card showed winterscode scores by mistake.
        if (lh.bbtd) fill('bandon-by-the-dunes', lh.bbtd);
        if (lh.baseline) fill('baseline-marketing', lh.baseline);
        if (lh.sogn) fill('sogn-contracting', lh.sogn);
        if (lh.seabreeze) fill('seabreeze', lh.seabreeze);

        // ----- per-site security grade (Mozilla Observatory)
        const sec = data.security && data.security.sites;
        if (sec) {
          const SEC_MAP = {
            'bandon-by-the-dunes': 'bbtd',
            'baseline-marketing': 'baseline',
            'sogn-contracting': 'sogn',
            'seabreeze': 'seabreeze',
          };
          for (const slug in SEC_MAP) {
            const info = sec[SEC_MAP[slug]];
            if (!info || !info.grade) continue;
            const root = document.querySelector('[data-sec-site="' + slug + '"]');
            if (!root) continue;
            const target = root.querySelector('[data-sec-grade]');
            if (!target) continue;
            target.textContent = '';
            const pill = document.createElement('span');
            const g = String(info.grade);
            const tier = g.charAt(0) === 'A' ? 'good' : (g.charAt(0) === 'B' || g.charAt(0) === 'C') ? 'ok' : 'low';
            pill.className = 'wk-sec-pill wk-sec-pill-' + tier;
            pill.textContent = typeof info.score === 'number' ? (g + ' (' + info.score + ')') : g;
            target.appendChild(pill);
          }
        }
      } catch (e) {
        // Silent fail. Lighthouse panel falls back to "measuring..." text.
      }
    }
    loadLighthouse();
  })();
</script>

<style>
  /* NEW: orientation contents (/work top rework) */
  .wk-index { padding: 0 4px; margin: 28px 0 8px; border-top: 1px solid var(--copper-hairline); }
  .wk-index-k { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-copper); font-weight: 600; margin: 14px 0 6px; }
  .wk-index ol { list-style: none; margin: 0; padding: 0; }
  .wk-index li { display: grid; grid-template-columns: 30px 1fr auto; align-items: baseline; gap: 12px; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .wk-index li:last-child { border-bottom: 0; }
  .wk-ix-num { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--color-copper-bright); letter-spacing: 0.04em; }
  .wk-ix-name { font-family: var(--font-serif); font-size: 18px; font-weight: 500; color: var(--color-ash-100); line-height: 1.15; }
  .wk-ix-meta { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--color-ash-500); text-align: right; white-space: nowrap; }
  @media (min-width: 740px) { .wk-ix-name { font-size: 20px; } }
  @media (min-width: 1024px) {
    .wk-index ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 28px; }
    .wk-index li { border-bottom: 0; border-left: 1px solid rgba(255,255,255,0.07); padding: 4px 0 4px 16px; display: block; }
    .wk-index li:first-child { border-left: 0; padding-left: 0; }
    .wk-ix-num { display: block; margin-bottom: 6px; }
    .wk-ix-name { display: block; font-size: 21px; }
    .wk-ix-meta { display: block; text-align: left; margin-top: 4px; }
  }

  /* NEW: MyKonos primer (top of the demiurge-mykonos card) */
  .mk-primer { padding: 16px 16px 14px; }
  @media (min-width: 1024px) { .mk-primer { padding: 18px 18px 16px; } }
  .mk-row { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; }
  .mk-name { font-family: var(--font-serif); font-size: 21px; font-weight: 600; color: var(--color-ash-100); line-height: 1; letter-spacing: -0.01em; }
  @media (min-width: 1024px) { .mk-name { font-size: 24px; } }
  .mk-beta { font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; color: var(--color-wc-green); border: 1px solid rgba(77,216,168,0.4); border-radius: 4px; padding: 2px 7px; text-transform: uppercase; }
  .mk-desc { font-family: var(--font-sans); font-size: 14px; line-height: 1.6; color: var(--color-ash-300); margin: 0; max-width: 56ch; }
  .mk-desc b { color: var(--color-ash-100); font-weight: 600; }
  .mk-live { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ash-500); margin-top: 10px; }
  .mk-live .d { width: 5px; height: 5px; border-radius: 50%; background: var(--color-wc-green); box-shadow: 0 0 6px rgba(77,216,168,0.6); }
  @media (prefers-reduced-motion: no-preference) { .mk-live .d { animation: mkpulse 2.4s ease-in-out infinite; } }
  @keyframes mkpulse { 0%,100%{opacity:1} 50%{opacity:.45} }

  .wk-section {
    padding: 32px 4px 40px;
    max-width: 720px;
    margin: 0 auto;
  }
  @media (min-width: 740px) {
    .wk-section { padding: 48px 4px 56px; max-width: 860px; }
  }
  @media (min-width: 1024px) {
    .wk-section { padding: 64px 0 72px; max-width: 1080px; }
  }

  .wk-head {
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--copper-hairline);
  }
  .wk-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .wk-eyebrow .line {
    width: 28px;
    height: 1px;
    background: var(--color-copper);
  }
  @media (min-width: 1024px) { .wk-eyebrow .line { width: 40px; } }
  .wk-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-copper);
    text-transform: uppercase;
    margin: 0;
  }
  @media (min-width: 1024px) { .wk-h { font-size: 13px; } }
  .wk-meta {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-ash-500);
    font-style: italic;
  }

  /* Grid */
  .wk-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  /* Apps grid: single-column at all breakpoints. Each widget gets
     the full container width so dense interactive demos can breathe
     vertically without the 2-col squeeze. Container caps at 960px. */
  .wk-grid-apps {
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 740px) { .wk-grid-apps { gap: 28px; } }
  @media (min-width: 1024px) { .wk-grid-apps { gap: 32px; } }

  /* Sites grid: 2-col at 768+ as before. */
  /* Sites are 1-col on tablet so widget cards (Sogn) get full width to
     breathe. 2-col only at desktop where there's actual horizontal room. */
  @media (min-width: 740px) {
    .wk-grid-sites { gap: 24px; }
  }
  @media (min-width: 1024px) {
