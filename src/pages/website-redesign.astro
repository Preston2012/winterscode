---
import ServiceLayout from '../components/templates/ServiceLayout.astro';
import type { ServiceEntry } from '../lib/business';
const service: ServiceEntry = {
  slug: 'website-redesign',
  name: 'Website Redesign',
  shortLabel: 'Website Redesign',
  blurb: 'Redesign and rebuild for sites that are slow, dated, or rented.',
  serviceType: 'Website redesign and rebuild',
};
---
<ServiceLayout
  service={service}
  path="/website-redesign"
  breadcrumb={[
    { name: 'Home', path: '/' },
    { name: 'Website Redesign', path: '/website-redesign' },
  ]}
  title="Website Redesign & Rebuild · Winters Code"
  description="Website redesign and rebuild for Oregon coast businesses. Turn a slow, dated, rented site into a fast custom one you own. Measured before and after."
  eyebrow="Redesign · Rebuild"
  h1="Keep the business. Rebuild the foundation."
  sub="Your site still runs. That is not the same as working for you. Keep what works, replace what is holding it back."
  sub2="Measured before. Measured after."
  bgImage="/photo/local/scenes/sunset-reflection"
  showcase
  heroFocal="center 40%"
  intro={[
    "A redesign is worth it when the current site is costing you: slow loads that lose mobile visitors, a template you cannot really change, a platform you pay monthly to rent, or a look that no longer matches the business.",
    "I rebuild on a modern, custom-built stack. Not a new theme on the same tired platform, but a fast, secure, custom site that <span class='hl-green'>is yours to keep</span>. And I measure it, so <em>the improvement is on paper, not just a feeling.</em>",
  ]}
  includesTitle="What a rebuild fixes"
  includes={[
    { h: 'Speed', body: 'Sub-second mobile loads instead of the 5-second crawl that sends visitors back to the search results.' },
    { h: 'Ownership', body: 'You own the code and content. No monthly platform rent, no lock-in.' },
    { h: 'Security', body: 'The full browser security header set, not just a bare lock icon in the address bar.' },
    { h: 'Search visibility', body: 'Clean metadata, structured data, and an internal-link structure search engines can actually read.' },
    { h: 'A current look', body: 'A custom design that matches the business you run today, built mobile-first.' },
    { h: 'Content migration', body: 'Your existing pages, photos, and copy carried over, cleaned up, and improved, not lost.' },
  ]}
  sections={[
    {
      heading: 'Most local sites are overdue',
      body: [
        'In my audit of 169 Coos County business sites, <span class="stat">not one</span> scored well on both speed and security. The best security grade in the whole county was a B. More than half were renting their site from a template platform, which is a large part of why. A rebuild on a custom stack is how you <span class="hl-green">stop paying rent on your own site.</span>',
        'Run your current site through the free audit and we will see exactly what a rebuild would change.',
      ],
    },
    {
      heading: 'What it costs, and why it is more than a new site',
      body: [
        'A rebuild starts at <span class="stat">$2,500</span>. Most land between there and $3,500, depending on how many pages have to move and whether there is a catalog or a booking system to repair.',
        'A new site starts from nothing, which is simple. A rebuild starts from something that has to survive the move: the content inventory, the redirect map, the years of search value you already paid for. That is real work, and skipping it is how a redesign quietly costs a business its rankings.',
        'Not every site needs one. Some need an afternoon of fixes. I will tell you which one you are before either of us talks about money.',
      ],
    },
  ]}
  whyLink
  faq={[
    { q: 'Can you save my content, or do I start over?', a: 'I carry your existing pages, photos, and copy over, then clean them up. You keep what works; we fix what does not. Nothing of value gets thrown away.' },
    { q: 'How do I know a redesign is worth it?', a: 'Run the free audit. If your site is slow, insecure, hard to update, or stuck on a platform you pay to rent, a rebuild usually pays for itself in speed and search visibility. The audit shows you where you stand first.' },
    { q: 'How long does a rebuild take?', a: 'Most rebuilds land in the same windows as a new build: a few days to a couple of weeks depending on size. I work in days, not quarters.' },
    { q: 'Will my search rankings survive the move?', a: 'Yes, when it is done right. I keep your URLs stable or set proper redirects so existing rankings carry over, and the speed and structure gains usually help, not hurt.' },
  ]}
  relatedTitle="Related"
  relatedLinks={[
    { href: '/services/web-design', label: 'Web Design', sub: 'The full service' },
    { href: '/core-web-vitals-fix', label: 'Core Web Vitals Fix', sub: 'If speed is the issue' },
    { href: '/audit', label: 'Free site audit', sub: 'See where you stand' },
  ]}
/>
