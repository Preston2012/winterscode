---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import Tabs from '../components/ui/Tabs.astro';
import Fold from '../components/ui/Fold.astro';
import Steps from '../components/ui/Steps.astro';
import Contact from '../components/sections/Contact.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { breadcrumbSchema, absUrl } from '../lib/schema';
import { services } from '../lib/business';
import TextCta from '../components/ui/TextCta.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];
const breadcrumbLd = breadcrumbSchema(crumbs);
const servicesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Winters Code services',
  numberOfItems: services.length,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.name,
      serviceType: s.serviceType,
      url: absUrl(`/services/${s.slug}`),
    },
  })),
};
---

<BaseLayout
  title="Services · Websites, Apps & Care Plans · Winters Code"
  description="Websites, apps, custom software, AI automation, SEO and branding for Oregon coast businesses. Six services, one builder, one price with everything in."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(servicesLd)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <!-- S339 round 3 (Preston 2026-11-21: fold, dedupe, cut numbers, every word
       earns its place). Eight stacked sections became: the hero, the three
       steps on a rail, one tab set (Sites, Apps, Care, Extras) and five
       folded questions. The charter-captain opener and the "no agency
       runaround" line are cut; the anchors #sites, #apps, #care and #addons
       still land, each opening its tab. -->
  <PageHero
    eyebrow="Services"
    h1="What I'm hired for."
    sub="Websites, apps, branding and automation. Sites start at $1,750 with everything in; care is optional, from $75 a month."
    bgImage="/photo/local/services-coast-wash"
    bgOpacity={0.4}
  />

  <section class="sv-how wc-plate" aria-labelledby="sv-how-h">
    <h2 class="sv-how-h" id="sv-how-h">How it goes</h2>
    <Steps steps={[
      { title: 'A text and a consult', body: 'No cost, no pitch deck.' },
      { title: 'A written scope and 50%', body: 'Locks the scope and the start date.' },
      { title: 'Live in days', body: 'Starting at 3 business days. The final 50% on launch.' },
    ]} />
  </section>

  <Tabs
    label="What's on the menu"
    tabs={[
      { id: 'sites', label: 'Sites', sub: 'From $1,750', icon: 'web' },
      { id: 'apps', label: 'Apps', sub: 'MVP in 2 to 4 weeks', icon: 'apps' },
      { id: 'care', label: 'Care', sub: 'From $75 a month', icon: 'keep' },
      { id: 'addons', label: 'Extras', sub: 'And what I skip', icon: 'all' },
    ]}
  >
    <div slot="panel-sites">
      <p class="sv-price"><span class="wc-cu">$1,750</span> <span>for most local business sites, everything in</span></p>
      <p class="sv-p">One number. No per-page fees, no surprise add-ons, no monthly anything you didn't ask for. Bigger jobs cost more and I say so up front.</p>
      <div class="sv-folds">
        <Fold title="Your website" meta="custom, written for you" group="sv-sites">
          <ul class="wc-bullets">
            <li>Custom design and code, not a template with your name dropped in.</li>
            <li>The pages you need: home, about, your services or work, contact.</li>
            <li>Real photos shot here on the coast, and the words written for you.</li>
            <li>Galleries, a contact form that reaches you, privacy and terms pages.</li>
            <li>An email on your own domain if you want one.</li>
            <li>Right on every phone, tablet and computer.</li>
          </ul>
        </Fold>
        <Fold title="Your brand" meta="logo and vector files" group="sv-sites">
          <p>A logo and brand identity if you don't have one yet, made as part of the project, with real vector files for signs, shirts, cards and print.</p>
        </Fold>
        <Fold title="Getting found" meta="fast, listed, readable" group="sv-sites">
          <ul class="wc-bullets">
            <li>Built to load fast on a phone and scored live on Google's own test. In my audit, the local sites Google could score averaged 61 out of 100. Every one I build is on <a href="/wall">the Wall</a>.</li>
            <li>Search Console set up and your sitemap submitted.</li>
            <li>Google Business Profile filled in: hours, photos, services.</li>
            <li>Clean structure Google and AI assistants can read. Junk bots shut out.</li>
            <li>Site, listing and socials all saying the same thing.</li>
          </ul>
        </Fold>
        <Fold title="Safe and yours" meta="no lock-in" group="sv-sites">
          <ul class="wc-bullets">
            <li>HTTPS, a hardened setup and spam-protected forms, built in.</li>
            <li>No WordPress, no plugin licenses, no being tied to whoever made it.</li>
            <li>Yours to keep, free and clear, with no required monthly fee.</li>
          </ul>
        </Fold>
      </div>
      <p class="sv-note">Already have a site? That is a rebuild, and most land between $2,500 and $3,500. <a href="/website-redesign">What a rebuild covers</a></p>
      <TextCta label="Text me about a site" links={[{ href: '/pricing', label: 'Pricing' }]} />
    </div>

    <div slot="panel-apps">
      <p class="sv-p sv-p--lead">Flutter, so one codebase runs on iPhone and Android.</p>
      <div class="sv-tiers">
        <div class="sv-tier"><p class="sv-tier-h">MVP</p><p class="sv-tier-t">2 to 4 weeks</p><ul class="wc-bullets"><li>5 to 10 screens</li><li>iPhone and Android</li><li>Logins and a basic backend</li></ul></div>
        <div class="sv-tier"><p class="sv-tier-h">Full build</p><p class="sv-tier-t">4 to 8 weeks</p><ul class="wc-bullets"><li>Payments and real-time data</li><li>AI features</li><li>App Store and Google Play</li></ul></div>
        <div class="sv-tier"><p class="sv-tier-h">Custom system</p><p class="sv-tier-t">8 to 16 weeks</p><ul class="wc-bullets"><li>Separate staff and customer access</li><li>Subscriptions and integrations</li><li>50+ screens, complex workflows</li></ul></div>
      </div>
      <p class="sv-note">If a build uses an AI model or a paid API, I name that running cost in the quote.</p>
      <TextCta label="Text me about an app" links={[{ href: '/services/app-development', label: 'How app builds work' }]} />
    </div>

    <div slot="panel-care">
      <p class="sv-p sv-p--lead">Optional, month to month. The person who built it maintains it.</p>
      <div class="sv-tiers sv-tiers--2">
        <div class="sv-tier"><p class="sv-tier-h">Basic</p><p class="sv-tier-t"><span class="wc-cu">$75</span> a month and up</p><ul class="wc-bullets"><li>Hosting and SSL on your account</li><li>Daily backups and security patches</li><li>10 content edits a month</li><li>Uptime monitoring</li></ul></div>
        <div class="sv-tier"><p class="sv-tier-h">Pro</p><p class="sv-tier-t"><span class="wc-cu">$250</span> a month and up</p><ul class="wc-bullets"><li>Everything in Basic</li><li>Unlimited reasonable edits, scheduled with me</li><li>A quarterly speed and search pass, fixes made</li><li>Improvements as you grow</li></ul></div>
      </div>
      <div class="sv-folds">
        <Fold title="Do I have to be a build client?" group="sv-care"><p>Not necessarily. If your site is on a stack I can support, I can often take over maintenance. If it is a tangle of plugins, a rebuild may be the better path, and the <a href="/audit">audit</a> will tell us.</p></Fold>
        <Fold title="What counts as a content edit?" group="sv-care"><p>Updating hours or prices, swapping a photo, adding a page, fixing a typo, posting an event. Bigger feature work is quoted separately.</p></Fold>
        <Fold title="What if my site goes down?" group="sv-care"><p>A static site rarely does. If hosting hiccups, uptime monitoring usually catches it before you notice, and daily backups make recovery quick.</p></Fold>
        <Fold title="Can I cancel?" group="sv-care"><p>Yes, anytime. No lock-in: the work should keep earning the relationship.</p></Fold>
      </div>
      <TextCta label="Text me about a care plan" links={[{ href: '/pricing', label: 'Pricing' }]} />
    </div>

    <div slot="panel-addons">
      <p class="sv-sub-h">When it costs more</p>
      <p class="sv-p">The floor covers a complete core site. These add to it, quoted clearly.</p>
      <ul class="wc-bullets wc-bullets--2 sv-extras">
        <li><span><b>Bigger sites.</b> Many more pages, or sections well beyond a core site.</span></li>
        <li><span><b>More search reach.</b> Stronger local search past the baseline every site gets.</span></li>
        <li><span><b>Booking, payments or a store.</b> Scheduling, taking payments, selling products.</span></li>
        <li><span><b>Listing feeds.</b> MLS or RMLS for real estate.</span></li>
        <li><span><b>Integrations.</b> Stripe, QuickBooks or what you already use, wired together.</span></li>
        <li><span><b>AI workflows.</b> Intake, replies and lead routing, running costs named up front.</span></li>
      </ul>
      <p class="sv-sub-h">What I skip</p>
      <p class="sv-p">Banner sliders, filler nobody reads, newsletters you'll never send, stock photos and fake "verified" badges. And I don't run paid ads, write blogs, shoot video or manage social. For those I'll point you to someone good; for social, I can build the automation that posts for you.</p>
    </div>
  </Tabs>

  <section class="sv-faq" id="faq" aria-labelledby="sv-faq-h">
    <p class="wc-eyebrow"><span class="wc-dot" aria-hidden="true"></span>Questions</p>
    <h2 class="wc-h2 sv-faq-h" id="sv-faq-h">The ones <span class="wc-soft">everyone asks.</span></h2>
    <Fold title="How much does this cost?" group="sv-faq" open>
      <p>One price, everything in. Most local business sites start at $1,750, with the pages, the words, real photos, branding, a site built to load fast on a phone, and security, and it's yours to keep. The consult is free and the written quote holds for 14 days. <a href="/pricing">Pricing</a></p>
    </Fold>
    <Fold title="Why no WordPress?" group="sv-faq">
      <p>WordPress is mass-produced software with plugins stacked on top: slow, plugin-dependent, and it breaks when something auto-updates. Custom code loads faster, reads cleanly to Google and carries strict security headers. Every site I build scores 90 or better on Google's mobile test, measured live on the Wall.</p>
    </Fold>
    <Fold title="Do you maintain it after?" group="sv-faq">
      <p>Yes, and it's optional: Basic from $75 a month, Pro from $250. You text a real person, not a ticket queue.</p>
    </Fold>
    <Fold title="What if I don't have content yet?" group="sv-faq">
      <p>I do most of the lift. Start with a text about what you have. I can shoot the photos and draft the words, and you edit. If you'd rather write it all out, there's a <a href="/questionnaire.pdf">2-page questionnaire</a>, never a gate before we talk.</p>
    </Fold>
    <Fold title="How are you this fast?" group="sv-faq">
      <p>A modern stack (Astro, React, Flutter), one person making every call, and tooling I built that keeps each project's decisions on file, so nothing gets relearned between builds. What it has produced is on <a href="/work">the work page</a>.</p>
    </Fold>
  </section>

  <Contact />
</BaseLayout>

<style>
  .sv-how { margin-top: 8px; padding: 24px 20px; }
  .sv-how-h { margin: 0 0 18px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ash-300); }
  @media (min-width: 740px) { .sv-how { padding: 28px 32px; } }

  .sv-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: 0; }
  .sv-price .wc-cu { font-family: var(--wc-display); font-style: normal; font-weight: 500; font-size: clamp(44px, 7vw, 64px); line-height: 1; letter-spacing: -0.02em; }
  .sv-price span:last-child { font-size: 16px; color: var(--color-ash-300); }
  .sv-p { margin: 12px 0 0; max-width: 40rem; font-size: 16px; line-height: 1.6; color: var(--color-ash-300); }
  .sv-p--lead { margin-top: 0; font-size: 17px; color: #eef1ec; }
  .sv-folds { margin-top: 18px; }
  .sv-folds :global(.wc-bullets) { color: var(--color-ash-300); }
  .sv-note { margin: 16px 0 0; font-size: 15px; line-height: 1.55; color: var(--color-ash-300); }
  .sv-note a, .sv-faq a, .sv-folds a { color: var(--color-wc-green); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .sv-sub-h { margin: 22px 0 0; font-size: 18px; font-weight: 600; color: #eef1ec; }
  .sv-sub-h:first-child { margin-top: 0; }
  .sv-extras { margin-top: 14px; color: var(--color-ash-300); }
  .sv-extras b { color: #eef1ec; font-weight: 600; }

  .sv-tiers { display: grid; gap: 10px; margin-top: 16px; }
  .sv-tier { padding: 18px 18px; background: rgba(10, 13, 12, 0.55); border: 1px solid var(--wc-line); border-radius: var(--wc-r); }
  .sv-tier-h { margin: 0; font-size: 18px; font-weight: 600; color: #eef1ec; }
  .sv-tier-t { margin: 2px 0 12px; font-size: 15px; color: var(--color-copper-bright); }
  .sv-tier-t .wc-cu { font-family: var(--wc-display); font-style: normal; font-size: 28px; font-weight: 500; }
  .sv-tier :global(.wc-bullets) { color: var(--color-ash-300); gap: 6px; }
  @media (min-width: 740px) {
    .sv-tiers { grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .sv-tiers--2 { grid-template-columns: 1fr 1fr; }
  }

  .sv-faq { margin-top: 48px; }
  .sv-faq-h { margin-bottom: 20px; }
</style>
