---
/**
 * /wall : the full live workshop broadcast.
 *
 * Dense, Bloomberg-terminal aesthetic. Every section pulls from /api/workshop
 * (server-rendered with live data at build time, then refreshed client-side).
 *
 * 6 modules per S6_PLUS.md design doc:
 *   1. DEPLOYS. last deploy time, 30-day count, per-repo breakdown
 *   2. LIGHTHOUSE. winterscode + sogn live scores, history sparkline
 *   3. SECURITY. observatory grade + headers present
 *   4. ENGINE. Demiurge memories, uptime, last write
 *   5. CALENDAR. next 3 available consult slots, by event type
 *   6. ACCEPTING. geographic acceptance, capacity status
 *
 * Mono everywhere. Copper hairlines. Scanline borders. Dense rows.
 * "Apple status page meets Bloomberg terminal" per design doc.
 *
 * Server-side fetch at build time provides the SSR'd values (no flash of
 * placeholder). Client-side refresh on focus + every 30s keeps it live.
 *
 * Audience: technical evaluators (A3) + clients on a maintenance plan who
 * want transparency. Most homepage visitors never land here.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import Contact from '../components/sections/Contact.astro';

// Server-side fetch at build / SSR time. Failures fall back to safe defaults.
// The page hydrates with these values, then client JS refreshes from the
// same endpoint to keep things fresh.
let initialData: any = null;
let fetchError: string | null = null;

try {
  // Build-time fetch only works for fully-deployed APIs. Use the public URL
  // since this runs in the build container. If we move to live SSR later
  // this can become Astro.url-relative.
  const r = await fetch('https://winterscode.com/api/workshop', {
    headers: { 'user-agent': 'winterscode-build/1.0' },
    signal: AbortSignal.timeout(8000),
  });
  if (r.ok) initialData = await r.json();
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'fetch failed';
}

// Safe extractors with sensible fallbacks
const deploys = initialData?.deploys ?? { last: '.', last_message: '.', count_30d: 0, repo_count: 0, source: 'fallback' };
const lighthouse = initialData?.lighthouse ?? { winterscode: [0,0,0,0], sogn: [0,0,0,0], baseline: [0,0,0,0], bbtd: [0,0,0,0], seabreeze: [0,0,0,0], measured: '.', source: 'fallback' };
const security = initialData?.security ?? { grade: '.', score: 0, headers_ok: [], sites: {}, source: 'fallback' };
const engine = initialData?.engine ?? { memories: 0, added_last_7d: 0, uptime_30d_pct: 0, source: 'fallback' };
const calendar = initialData?.calendar ?? { next: '.', source: 'fallback' };
const speed = initialData?.speed ?? { last_three: '.', source: 'fallback' };

// Format Lighthouse arrays for display
const lhWC = Array.isArray(lighthouse.winterscode) ? lighthouse.winterscode : [0,0,0,0];
const lhSogn = Array.isArray(lighthouse.sogn) ? lighthouse.sogn : [0,0,0,0];
const lhBaseline = Array.isArray(lighthouse.baseline) ? lighthouse.baseline : [0,0,0,0];
const lhBbtd = Array.isArray(lighthouse.bbtd) ? lighthouse.bbtd : [0,0,0,0];
const lhSeabreeze = Array.isArray(lighthouse.seabreeze) ? lighthouse.seabreeze : [95,100,100,100];

// LH average (P/A/SEO/BP). easier to scan at a glance
function avg(arr: number[]): number {
  if (!arr.length) return 0;
  return Math.round(arr.reduce((a, b) => a + b, 0) / arr.length);
}
const lhWCAvg = avg(lhWC);
const lhSognAvg = avg(lhSogn);
const lhBaselineAvg = avg(lhBaseline);
const lhBbtdAvg = avg(lhBbtd);
const lhSeabreezeAvg = avg(lhSeabreeze);

// Per-site Observatory grade + score for the SECURITY module rows.
const secSites: Record<string, { grade?: string; score?: number }> = (security as any).sites ?? {};
function secOf(k: string): { grade: string; score: number | null } {
  const st = secSites[k] ?? {};
  const grade = st.grade ?? (security.grade ?? '.');
  const score = typeof st.score === 'number' ? st.score : null;
  return { grade, score };
}
function secTier(grade: string): string {
  const c = (grade || '?').charAt(0);
  return c === 'A' ? 'a' : (c === 'B' || c === 'C') ? 'bc' : 'low';
}
function secLabel(g: { grade: string; score: number | null }): string {
  return g.score != null ? g.grade + ' (' + g.score + ')' : g.grade;
}
const secRows = [
  { key: 'winterscode', name: 'winterscode' },
  { key: 'sogn', name: 'sogn' },
  { key: 'baseline', name: 'baseline' },
  { key: 'bbtd', name: 'bandon' },
  { key: 'seabreeze', name: 'seabreeze' },
].map((r) => ({ ...r, ...secOf(r.key) }));

// Engine memory format with thousands separator
const memCount = (engine.memories ?? 0).toLocaleString();

const updatedAt = initialData?.updated_at ?? new Date().toISOString();
---

<BaseLayout
  title="The Wall · Workshop Broadcast · Winters Code"
  description="Live broadcast from the workshop. Deploys, Lighthouse, security grade, engine state, and next consult slot. Refreshes when you focus the tab."
>
  <Header />
  <MobileMenu />

  <PageHero
    eyebrow="The Wall · Workshop Broadcast"
    h1="The shop, live."
    sub="Deploys pushed, sites measured, slots open. Everything happening right now, on one page."
    sub2="Refreshes when you focus the tab. The numbers are real, the sources are linked."
    showStamp={false}
  />

  <section class="wall-grid" aria-label="Live workshop data">
    <div class="wall-status-bar">
      <span class="wall-pulse" aria-hidden="true"></span>
      <span class="wall-status-text">LIVE</span>
      <span class="wall-status-sep">·</span>
      <span class="wall-status-updated" data-wall-updated>updated {new Date(updatedAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/Los_Angeles' })} PT</span>
      <span class="wall-status-sep">·</span>
      <span class="wall-status-source">{fetchError ? `source: fallback (${fetchError})` : 'source: /api/workshop'}</span>
    </div>

    {/* MODULE 01. DEPLOYS */}
    <article class="wall-mod wall-mod-wide" data-mod="deploys">
      <header class="wall-mod-head">
        <span class="wall-mod-num">01</span>
        <h2 class="wall-mod-title">DEPLOYS</h2>
        <a class="wall-mod-source" href="https://github.com/Preston2012" target="_blank" rel="noopener">github ↗</a>
        <span class="wall-mod-badge" data-mod-source={deploys.source}>{deploys.source}</span>
      </header>
      <div class="wall-mod-body">
        <div class="wall-stat-big">
          <span class="wall-stat-num" data-deploys-last>{deploys.last}</span>
          <span class="wall-stat-label">since last push</span>
        </div>
        <div class="wall-stat-grid">
          <div class="wall-stat-cell">
            <span class="wall-stat-cell-num" data-deploys-30d>{deploys.count_30d}</span>
            <span class="wall-stat-cell-label">commits · 30d</span>
          </div>
          <div class="wall-stat-cell">
            <span class="wall-stat-cell-num" data-deploys-repos>{deploys.repo_count}</span>
            <span class="wall-stat-cell-label">repos active</span>
          </div>
        </div>
        <p class="wall-mod-detail" data-deploys-msg>last: {deploys.last_message}</p>
      </div>
    </article>

    {/* MODULE 02. LIGHTHOUSE */}
    <article class="wall-mod wall-mod-wide" data-mod="lighthouse">
      <header class="wall-mod-head">
        <span class="wall-mod-num">02</span>
        <h2 class="wall-mod-title">LIGHTHOUSE</h2>
        <a class="wall-mod-source" href="https://pagespeed.web.dev/" target="_blank" rel="noopener">pagespeed ↗</a>
        <span class="wall-mod-badge" data-mod-source={lighthouse.source}>{lighthouse.source}</span>
      </header>
      <div class="wall-mod-body">
        <table class="wall-table" aria-label="Lighthouse scores per site, mobile">
          <thead>
            <tr>
              <th scope="col">site</th>
              <th scope="col" class="wall-num">perf</th>
              <th scope="col" class="wall-num">a11y</th>
              <th scope="col" class="wall-num">seo</th>
              <th scope="col" class="wall-num">bp</th>
              <th scope="col" class="wall-num">avg</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">winterscode</th>
              <td class="wall-num" data-lh-wc-0>{lhWC[0]}</td>
              <td class="wall-num" data-lh-wc-1>{lhWC[1]}</td>
              <td class="wall-num" data-lh-wc-2>{lhWC[2]}</td>
              <td class="wall-num" data-lh-wc-3>{lhWC[3]}</td>
              <td class="wall-num wall-num-strong" data-lh-wc-avg>{lhWCAvg}</td>
            </tr>
            <tr>
              <th scope="row">sogn</th>
              <td class="wall-num" data-lh-sogn-0>{lhSogn[0]}</td>
              <td class="wall-num" data-lh-sogn-1>{lhSogn[1]}</td>
              <td class="wall-num" data-lh-sogn-2>{lhSogn[2]}</td>
              <td class="wall-num" data-lh-sogn-3>{lhSogn[3]}</td>
              <td class="wall-num wall-num-strong" data-lh-sogn-avg>{lhSognAvg}</td>
            </tr>
            <tr>
              <th scope="row">baseline</th>
              <td class="wall-num" data-lh-baseline-0>{lhBaseline[0]}</td>
              <td class="wall-num" data-lh-baseline-1>{lhBaseline[1]}</td>
              <td class="wall-num" data-lh-baseline-2>{lhBaseline[2]}</td>
              <td class="wall-num" data-lh-baseline-3>{lhBaseline[3]}</td>
              <td class="wall-num wall-num-strong" data-lh-baseline-avg>{lhBaselineAvg}</td>
            </tr>
            <tr>
              <th scope="row">bandon</th>
              <td class="wall-num" data-lh-bbtd-0>{lhBbtd[0]}</td>
              <td class="wall-num" data-lh-bbtd-1>{lhBbtd[1]}</td>
              <td class="wall-num" data-lh-bbtd-2>{lhBbtd[2]}</td>
              <td class="wall-num" data-lh-bbtd-3>{lhBbtd[3]}</td>
              <td class="wall-num wall-num-strong" data-lh-bbtd-avg>{lhBbtdAvg}</td>
            </tr>
            <tr>
              <th scope="row">seabreeze</th>
              <td class="wall-num" data-lh-seabreeze-0>{lhSeabreeze[0]}</td>
              <td class="wall-num" data-lh-seabreeze-1>{lhSeabreeze[1]}</td>
              <td class="wall-num" data-lh-seabreeze-2>{lhSeabreeze[2]}</td>
              <td class="wall-num" data-lh-seabreeze-3>{lhSeabreeze[3]}</td>
              <td class="wall-num wall-num-strong" data-lh-seabreeze-avg>{lhSeabreezeAvg}</td>
            </tr>
          </tbody>
        </table>
        <p class="wall-mod-detail">Mobile · measured <span data-lh-measured>{lighthouse.measured}</span> · desktop typically 2-5 points higher</p>
      </div>
    </article>

    {/* MODULE 03. SECURITY */}
    <article class="wall-mod" data-mod="security">
      <header class="wall-mod-head">
        <span class="wall-mod-num">03</span>
        <h2 class="wall-mod-title">SECURITY</h2>
        <a class="wall-mod-source" href="https://developer.mozilla.org/en-US/observatory/analyze?host=winterscode.com" target="_blank" rel="noopener">observatory ↗</a>
        <span class="wall-mod-badge" data-mod-source={security.source}>{security.source}</span>
      </header>
      <div class="wall-mod-body">
        <ul class="wall-sec-list" data-sec-rows>
          {secRows.map((r) => (
            <li class="wall-sec-row">
              <span class="wall-sec-site">{r.name}</span>
              <span class={`wall-sec-pill wall-sec-tier-${secTier(r.grade)}`} data-sec-grade-site={r.key}>{secLabel(r)}</span>
            </li>
          ))}
        </ul>
        <p class="wall-mod-detail">Mozilla Observatory · live · A+ is the top grade</p>
      </div>
    </article>

    {/* MODULE 04. ENGINE */}
    <article class="wall-mod" data-mod="engine">
      <header class="wall-mod-head">
        <span class="wall-mod-num">04</span>
        <h2 class="wall-mod-title">ENGINE</h2>
        <a class="wall-mod-source" href="https://github.com/Preston2012/demi" target="_blank" rel="noopener">demi repo ↗</a>
        <span class="wall-mod-badge" data-mod-source={engine.source}>{engine.source}</span>
      </header>
      <div class="wall-mod-body">
        <div class="wall-stat-big">
          <span class="wall-stat-num" data-engine-mem>{memCount}</span>
          <span class="wall-stat-label">demiurge memories</span>
        </div>
        <div class="wall-stat-grid">
          <div class="wall-stat-cell">
            <span class="wall-stat-cell-num" data-engine-week>+{engine.added_last_7d ?? 0}</span>
            <span class="wall-stat-cell-label">added · 7d</span>
          </div>
          <div class="wall-stat-cell">
            <span class="wall-stat-cell-num" data-engine-uptime>{engine.uptime_30d_pct}%</span>
            <span class="wall-stat-cell-label">uptime · 30d</span>
          </div>
        </div>
        <p class="wall-mod-detail">Memory engine + AI workflow built in-house. Runs alongside my builds.</p>
      </div>
    </article>

    {/* MODULE 05. CALENDAR */}
    <article class="wall-mod" data-mod="calendar">
      <header class="wall-mod-head">
        <span class="wall-mod-num">05</span>
        <h2 class="wall-mod-title">CALENDAR</h2>
        <span class="wall-mod-badge" data-mod-source={calendar.source}>{calendar.source}</span>
      </header>
      <div class="wall-mod-body">
        <div class="wall-stat-big">
          <span class="wall-stat-num" data-cal-next>{calendar.next}</span>
          <span class="wall-stat-label">next available slot</span>
        </div>
        <p class="wall-mod-detail">Consults are free in Bandon + Coos + Curry. Travel deposits credit on signing.</p>
        <a class="wall-cta" href="/contact">book a consult →</a>
      </div>
    </article>

    {/* MODULE 06. ACCEPTING */}
    <article class="wall-mod" data-mod="accepting">
      <header class="wall-mod-head">
        <span class="wall-mod-num">06</span>
        <h2 class="wall-mod-title">ACCEPTING</h2>
        <span class="wall-mod-badge wall-mod-badge-static">policy</span>
      </header>
      <div class="wall-mod-body">
        <ul class="wall-zone-list">
          <li class="wall-zone wall-zone-free">
            <span class="wall-zone-icon">●</span>
            <div class="wall-zone-meta">
              <span class="wall-zone-name">Bandon</span>
              <span class="wall-zone-cost">free in-person · or video</span>
            </div>
          </li>
          <li class="wall-zone wall-zone-free">
            <span class="wall-zone-icon">●</span>
            <div class="wall-zone-meta">
              <span class="wall-zone-name">Coos &amp; Curry counties</span>
              <span class="wall-zone-cost">free 30-min video</span>
            </div>
          </li>
          <li class="wall-zone">
            <span class="wall-zone-icon">●</span>
            <div class="wall-zone-meta">
              <span class="wall-zone-name">1.5hr drive</span>
              <span class="wall-zone-cost">$250 deposit · credits to project</span>
            </div>
          </li>
          <li class="wall-zone">
            <span class="wall-zone-icon">●</span>
            <div class="wall-zone-meta">
              <span class="wall-zone-name">2.5hr drive</span>
              <span class="wall-zone-cost">$400 deposit · credits to project</span>
            </div>
          </li>
          <li class="wall-zone wall-zone-remote">
            <span class="wall-zone-icon">○</span>
            <div class="wall-zone-meta">
              <span class="wall-zone-name">outside drive zones</span>
              <span class="wall-zone-cost">video consults only</span>
            </div>
          </li>
        </ul>
      </div>
    </article>

    {/* MODULE 07. SPEED RECORD */}
    <article class="wall-mod wall-mod-wide" data-mod="speed">
      <header class="wall-mod-head">
        <span class="wall-mod-num">07</span>
        <h2 class="wall-mod-title">RECENT BUILDS</h2>
        <span class="wall-mod-badge" data-mod-source={speed.source}>{speed.source}</span>
      </header>
      <div class="wall-mod-body">
        <ul class="wall-builds-list">
          <li class="wall-builds-row">
            <a class="wall-builds-name" href="https://seabreeze.llc" target="_blank" rel="noopener">SeaBreeze Landscape &amp; Home Repair</a>
            <span class="wall-builds-days">7d</span>
          </li>
          <li class="wall-builds-row">
            <a class="wall-builds-name" href="https://www.bandonbythedunesrealtee.net" target="_blank" rel="noopener">Bandon By The Dunes Realtee</a>
            <span class="wall-builds-days">18d</span>
          </li>
          <li class="wall-builds-row">
            <a class="wall-builds-name" href="https://sogncontracting.com" target="_blank" rel="noopener">Sogn Contracting</a>
            <span class="wall-builds-days">3d</span>
          </li>
        </ul>
        <p class="wall-mod-detail">Contract to live, in business days. Most sites run 3-7 days, larger sites 1-2 weeks, app MVP 2-4 weeks. Custom builds quoted in consult.</p>
      </div>
    </article>
  </section>

  <Divider label="01" />

  <Contact sectionNumber="01" />

  <script is:inline>
    // Wall live-refresh script. Pulls /api/workshop on focus + every 30s
    // while tab is visible. Pauses when hidden. Updates DOM in place. no
    // re-render flash. Falls back silently on any error (last good values
    // remain visible).
    (function () {
      var lastFetch = 0;
      var minIntervalMs = 25000;

      function setText(sel, text) {
        var el = document.querySelector(sel);
        if (el && text !== undefined && text !== null) el.textContent = text;
      }

      function refresh() {
        var now = Date.now();
        if (now - lastFetch < minIntervalMs) return;
        lastFetch = now;
        fetch('/api/workshop', { signal: AbortSignal.timeout(8000) })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d) return;

            // Update badge sources per module. SSR may have baked 'fallback' if
            // build-time fetch hit GH rate limits or PSI quota. KV-cached upstream
            // recovers within minutes, but bake stays until next deploy. Patch
            // the badge attributes here to reflect actual current upstream state.
            function setBadge(modName, src) {
              if (!src) return;
              var badge = document.querySelector('[data-mod="' + modName + '"] .wall-mod-badge');
              if (badge) { badge.setAttribute('data-mod-source', src); badge.textContent = src; }
            }
            if (d.deploys) setBadge('deploys', d.deploys.source);
            if (d.lighthouse) setBadge('lighthouse', d.lighthouse.source);
            if (d.security) setBadge('security', d.security.source);
            if (d.engine) setBadge('engine', d.engine.source);
            if (d.calendar) setBadge('calendar', d.calendar.source);
            if (d.speed) setBadge('speed', d.speed.source);

            if (d.deploys) {
              setText('[data-deploys-last]', d.deploys.last);
              setText('[data-deploys-30d]', d.deploys.count_30d);
              setText('[data-deploys-repos]', d.deploys.repo_count);
              setText('[data-deploys-msg]', 'last: ' + d.deploys.last_message);
            }
            if (d.lighthouse) {
              var lh = d.lighthouse;
              if (Array.isArray(lh.winterscode)) {
                for (var i = 0; i < 4; i++) setText('[data-lh-wc-' + i + ']', lh.winterscode[i]);
                var avgWC = Math.round(lh.winterscode.reduce(function(a,b){return a+b;},0) / 4);
                setText('[data-lh-wc-avg]', avgWC);
              }
              if (Array.isArray(lh.sogn)) {
                for (var i = 0; i < 4; i++) setText('[data-lh-sogn-' + i + ']', lh.sogn[i]);
                var avgSogn = Math.round(lh.sogn.reduce(function(a,b){return a+b;},0) / 4);
                setText('[data-lh-sogn-avg]', avgSogn);
              }
              if (Array.isArray(lh.baseline)) {
                for (var i = 0; i < 4; i++) setText('[data-lh-baseline-' + i + ']', lh.baseline[i]);
                var avgBaseline = Math.round(lh.baseline.reduce(function(a,b){return a+b;},0) / 4);
                setText('[data-lh-baseline-avg]', avgBaseline);
              }
              if (Array.isArray(lh.bbtd)) {
                for (var i = 0; i < 4; i++) setText('[data-lh-bbtd-' + i + ']', lh.bbtd[i]);
                var avgBbtd = Math.round(lh.bbtd.reduce(function(a,b){return a+b;},0) / 4);
                setText('[data-lh-bbtd-avg]', avgBbtd);
              }
              if (Array.isArray(lh.seabreeze)) {
                for (var i = 0; i < 4; i++) setText('[data-lh-seabreeze-' + i + ']', lh.seabreeze[i]);
                var avgSeabreeze = Math.round(lh.seabreeze.reduce(function(a,b){return a+b;},0) / 4);
                setText('[data-lh-seabreeze-avg]', avgSeabreeze);
              }
              setText('[data-lh-measured]', lh.measured);
            }
            if (d.security && d.security.sites) {
              var secSitesLive = d.security.sites;
              var secTierOf = function (g) {
                var c = String(g || '?').charAt(0);
                return c === 'A' ? 'a' : (c === 'B' || c === 'C') ? 'bc' : 'low';
              };
              ['winterscode','sogn','baseline','bbtd','seabreeze'].forEach(function (k) {
                var info = secSitesLive[k];
                if (!info || !info.grade) return;
                var el = document.querySelector('[data-sec-grade-site="' + k + '"]');
                if (!el) return;
                el.textContent = typeof info.score === 'number' ? (info.grade + ' (' + info.score + ')') : info.grade;
                el.className = 'wall-sec-pill wall-sec-tier-' + secTierOf(info.grade);
              });
            }
            if (d.engine) {
              setText('[data-engine-mem]', (d.engine.memories || 0).toLocaleString());
              setText('[data-engine-week]', '+' + (d.engine.added_last_7d || 0));
              setText('[data-engine-uptime]', (d.engine.uptime_30d_pct || 0) + '%');
            }
            if (d.calendar) setText('[data-cal-next]', d.calendar.next);

            // Update "updated" timestamp
            var when = new Date(d.updated_at || Date.now()).toLocaleTimeString('en-US', {
              hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'America/Los_Angeles'
            });
            setText('[data-wall-updated]', 'updated ' + when + ' PT');
          })
          .catch(function () { /* silently fall back to last values */ });
      }

      // Initial refresh after first paint, then on visibility/focus + every 30s
      if (document.visibilityState === 'visible') refresh();
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') refresh();
      });
      window.addEventListener('focus', refresh);
      setInterval(function () {
        if (document.visibilityState === 'visible') refresh();
      }, 30000);
    })();
  </script>
</BaseLayout>

<style>
  .wall-grid {
    max-width: 1200px;
