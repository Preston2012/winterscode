---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Seam from '../components/ui/Seam.astro';
import HomeHero from '../components/home/HomeHero.astro';
import StartPoint from '../components/home/StartPoint.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import WhyMe from '../components/home/WhyMe.astro';
import StraightAnswers from '../components/home/StraightAnswers.astro';
import HomeClose from '../components/home/HomeClose.astro';
---

<BaseLayout
  title="Oregon Coast Web Design & Apps · Bandon · Winters Code"
  description="Custom websites, apps, and tools for Oregon coast businesses, built in Bandon. Sites from $1,750, starting at 3 business days. Help is just a text away."
>
  <!-- S339 home consolidation (Preston 2026-11-21: "bolder, more connect,
       more explore", restrained). Five beats instead of ten sections:
       the hero, what I build (four doors that open in place), the work
       counted in days, why it's worth it with who builds it, straight
       answers, and the tagline as the close. The H1 is the LCP element, so
       nothing is preloaded. The Tangle, WhyPrice, ClientWord, SelectedWork,
       CareLine, ServicesTeaser, AboutTeaser and FaqQ1 are off Home; their
       content is condensed into these beats and every one of their pages
       is unchanged.

       Round 2, Preston's phone markup the same day: "if it's gonna be boxy
       it should be softer, rounded, clipped corners, bullets, rivets. It
       should feel well manufactured." Every surface is a rounded plate,
       the important ones carry corner rivets, the site's own numbered bezel
       divides the beats, and arrows and icons are drawn for this page. -->
  <Header homepage />
  <MobileMenu />

  <div class="home">
    <HomeHero />
    <Seam />
    <StartPoint />
    <Seam />
    <ProofStrip />
    <Seam />
    <WhyMe />
    <Seam />
    <StraightAnswers />
    <Seam />
    <HomeClose />
  </div>
</BaseLayout>

<script>
  // S453: the once-on-arrival half of Home's motion (counts, the close).
  // The scroll-driven half is CSS in each section.
  import '../lib/in-view';
</script>

<style is:global>
  /* S453: a section the reader landed on (lib/in-view, "landed, not
     scrolled") shows finished: no intro, no fill, no drop. */
  .home .is-instant, .home .is-instant * { animation: none !important; transition: none !important; }
  /* Keyboard focus shows its element finished: tabbing scrolls a control
     just into view, mid-entrance, and a focus ring belongs on something
     fully there (S453 audit: a card link focused at 0.87 opacity). */
  .home :has(:focus-visible) { animation: none !important; }

  /* S453 round 2: every section headline rises out of a cut as it scrolls
     in, and its soft second half (.wc-soft) surfaces after it; the eyebrow
     above slides in with its copper dot setting like a rivet. The hero's
     H1 is the LCP element and never moves; the close has its own entrance.
     Finished before the headline reaches the upper two thirds of the
     visible band, so it never sits half revealed where it is read. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .home section:not(.hh):not(.hc) .wc-h2 {
        animation: home-h2 linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 0% cover 22%;
      }
      .home section:not(.hh):not(.hc) .wc-h2 .wc-soft {
        animation: home-soft linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 30% cover 26%;
      }
      .home section:not(.hh) .wc-eyebrow {
        animation: home-brow linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 0% entry 100%;
      }
      .home section:not(.hh) .wc-eyebrow .wc-dot {
        animation: home-dot linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 20% cover 14%;
      }
    }
  }
  @keyframes home-h2 {
    from { clip-path: inset(0 -6% 100% -6%); transform: translateY(0.55em); }
    to { clip-path: inset(-12% -6% -14% -6%); transform: none; }
  }
  @keyframes home-soft {
    from { opacity: 0; filter: blur(8px); }
    to { opacity: 1; filter: none; }
  }
  @keyframes home-brow {
    from { opacity: 0; transform: translateX(-48px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes home-dot {
    0% { transform: scale(0); }
    60% { transform: scale(2.2); box-shadow: 0 0 0 3px rgba(211, 130, 60, 0.14), 0 0 16px 4px rgba(246, 165, 100, 0.6); }
    100% { transform: none; }
  }

  /* Home layout. The plates, rivets, buttons and type come from the shop
     system in global.css; Home only sets its own page measure. */
  .home {
    --home-gut: 16px;
    --home-max: 1120px;
    --home-pad: clamp(40px, 6vw, 84px);
    background: var(--color-bg-deep);
    hyphens: manual;
    /* Home runs edge to edge; the framed column is for reading pages. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    /* S453: the band a reader can actually see, for every scroll-driven
       move on Home: under the header pinned at the top, and on phones above the
       thumb bar (TextBar, under 768px). A reveal timed to the whole
       viewport finished out of sight or stalled in plain view. */
    --vi: 88px 92px;
  }
  @media (min-width: 768px) { .home { --vi: 80px 0px; } }
  /* From tablet up, the content edge lines up with the framed header and
     footer column (.page in global.css: 92vw up to 960 with 24px inside,
     then 1200 with 40px inside), so the logo, the H1 and every section
     start on one line. Phones keep a 16px gutter for room. */
  @media (min-width: 700px) { .home { --home-gut: calc(4vw + 24px); --home-max: calc(min(92vw, 960px) - 48px); } }
  @media (min-width: 1024px) { .home { --home-gut: 40px; --home-max: 1120px; } }
</style>
