---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Hero from '../components/sections/Hero.astro';
import Tangle from '../components/sections/Tangle.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import WhyPrice from '../components/sections/WhyPrice.astro';
import CareLine from '../components/sections/CareLine.astro';
import ClientWord from '../components/sections/ClientWord.astro';
import ServicesTeaser from '../components/sections/ServicesTeaser.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import FaqQ1 from '../components/sections/FaqQ1.astro';
import Contact from '../components/sections/Contact.astro';
import Divider from '../components/ui/Divider.astro';
---

<BaseLayout
  title="Oregon Coast Web Design & Apps · Bandon · Winters Code"
  description="Custom websites, apps, and tools for Oregon coast businesses, built in Bandon. Sites from $1,750, starting at 3 business days. Help is just a text away."
>
  <Fragment slot="head">
    <!-- Preload the hero stamp (homepage LCP element). Fetching during HTML
         parse instead of after the picture element pulls LCP toward FCP on mobile. -->
    <link rel="preload" as="image" href="/wc-seal-256.webp" type="image/webp" fetchpriority="high" />
  </Fragment>

  <!-- S339 HONE-SPEC (Nov 4) order: hero, why $1,750, Rod, the work, care,
       the tangle, services, about, the first question, the closer. Each
       section is one beat that points at its own page. "Built on the coast"
       and the logo band are off Home; their pages are unchanged. -->
  <Header homepage />
  <MobileMenu />

  <Hero />

  <WhyPrice />

  <Divider label="WC" ariaLabel="In the client's words, return to top" />

  <ClientWord />

  <Divider label="WC" ariaLabel="Selected work, return to top" />

  <SelectedWork />

  <CareLine />

  <Divider label="WC" ariaLabel="The tangle, return to top" />

  <Tangle />

  <Divider label="WC" ariaLabel="Services, return to top" />

  <ServicesTeaser />

  <Divider label="WC" ariaLabel="About, return to top" />

  <AboutTeaser />

  <Divider label="WC" ariaLabel="A question, return to top" />

  <FaqQ1 />

  <Divider label="WC" ariaLabel="Reach out, return to top" />

  <Contact
    sectionNumber=""
    why="You're not renting a template. You own a hand-built site that loads fast on a phone and comes with the words, photos and branding, from someone in Bandon you can text."
  />
</BaseLayout>
