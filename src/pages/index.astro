---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Hero from '../components/sections/Hero.astro';
import Tangle from '../components/sections/Tangle.astro';
import Wall from '../components/sections/Wall.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import ServicesTeaser from '../components/sections/ServicesTeaser.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import FaqQ1 from '../components/sections/FaqQ1.astro';
import WorkshopStatus from '../components/sections/WorkshopStatus.astro';
import Contact from '../components/sections/Contact.astro';
import Divider from '../components/ui/Divider.astro';
---

<BaseLayout
  title="Winters Code · Custom websites and apps for the Oregon coast"
  description="Custom sites, apps, and tools for the Oregon coast. Help is just a text away. Bandon-based. Days for sites, weeks for apps. Real workshop, broadcasting live."
>
  <Header homepage />
  <MobileMenu />

  <Hero />

  <Divider label="WC" ariaLabel="Workshop intro, return to top" />

  <Tangle />

  <Divider label="WC" ariaLabel="Workshop intro, return to top" />

  <Wall />

  <Divider label="02" ariaLabel="Section 02, return to top" />

  <SelectedWork />

  <Divider label="03" ariaLabel="Section 03, return to top" />

  <ServicesTeaser />

  <Divider label="04" ariaLabel="Section 04, return to top" />

  <AboutTeaser />

  <Divider label="05" ariaLabel="Section 05, return to top" />

  <FaqQ1 />

  <Divider label="06" ariaLabel="Section 06, return to top" />

  <Contact sectionNumber="06" />

  <WorkshopStatus />
</BaseLayout>
