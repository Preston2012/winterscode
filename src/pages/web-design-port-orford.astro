---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('port-orford')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-port-orford"
  title="Port Orford Web Design · Sites from $1,750 · Winters Code"
  description="Image-forward websites for Port Orford fishing, arts and tourism businesses. Hand-built in Bandon from $1,750. Text Preston at 541-551-0731."
  eyebrow="Locations · Port Orford"
  h1="Web design in Port Orford, Oregon."
  sub="Custom, fast, image-forward websites for Port Orford's fishing, arts, and tourism businesses."
  bgImage="/photo/local/towns/port-orford"
  showcase
  heroFocal="center 44%"
  intro={[
    "Port Orford is small, salty, and full of character: a working fishing port with a dolly dock and a genuine arts scene. Visitors and gallery buyers research before they drive out, so a clean, fast site <span class='hl-green'>turns curiosity into a stop.</span>",
  ]}
/>
