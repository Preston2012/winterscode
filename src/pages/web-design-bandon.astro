---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('bandon')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-bandon"
  title="Bandon Web Design · Sites from $1,750 · Winters Code"
  description="Custom websites from a shop in Bandon. Free in-person consult, hand-built sites from $1,750 that you own. Text Preston at 541-551-0731."
  eyebrow="Locations · Bandon"
  h1="Web design in Bandon, Oregon."
  sub="Custom, fast, mobile-first websites for Bandon businesses, from a shop that is actually in Bandon."
  sub2="The builder is local. The work is live."
  bgImage="/photo/local/scenes/bandon-seastacks"
  showcase
  heroFocal="center 62%"
  heroTextPos="top"
  intro={[
    "This is home. The shop is in Bandon, my family has been here six generations, and the sites I have built for Bandon businesses are live: <a href='/work/sogn-contracting'>a contractor</a>, <a href='/work/seabreeze'>a landscape and home-repair company</a>, <a href='/work/bandon-by-the-dunes'>a brokerage</a>, <a href='/work/us-survey-supply'>a surveying-equipment dealer</a>, <a href='/work/professors-golf'>a golf service</a> and <a href='/work#south-coast-cuisine'>a private chef</a>. When you hire me here, you get <span class='hl-green'>the person who builds it sitting across the table</span>, not a ticket queue.",
  ]}
  rod
  why="Free face to face in town, hand-built, and you own it."
/>
