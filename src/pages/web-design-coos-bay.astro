---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('coos-bay')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-coos-bay"
  title="Coos Bay Web Design · Sites from $1,750 · Winters Code"
  description="Custom websites for Coos Bay businesses, hand-built 30 minutes away in Bandon. Sites from $1,750 that you own. Text Preston at 541-551-0731."
  eyebrow="Locations · Coos Bay"
  h1="Web design in Coos Bay, Oregon."
  sub="Hand-built websites for Coos Bay businesses. Fast on a phone, yours to keep, and built by someone you can text."
  bgImage="/photo/local/towns/coos-bay"
  showcase
  heroFocal="center 42%"
  heroTextPos="top"
  intro={[
    "Coos Bay is the biggest market on the Oregon coast, which makes it the most competitive locally. That cuts both ways: when your site is the fast one, <span class='hl-green'>you stand out quickly.</span>",
  ]}
  proof={{
    heading: 'Coos Bay work you can visit',
    items: [
      {
        body: "Grand Management Services runs rentals and subsidized communities from Park Avenue. I rebuilt their site off WordPress: 50 pages in English and Spanish, rentals live from AppFolio, and a security grade that went from D- to A+. Live since October 27, on their own Cloudflare account.",
        href: '/work/grand-management',
        label: 'See the Grand case study →',
      },
      {
        body: 'Makai Painting is a Coos Bay painting and residential-rehab company. Their new site went live October 19: 20 pages, an estimate form that reaches the office, and their own job photos.',
        href: '/work#makai-painting',
        label: 'See the Makai build →',
      },
    ],
  }}
  why="You own the site and the account it runs on, it's coded by hand to load fast on a phone, and the person who built it answers your texts."
/>
