---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import Contact from '../components/sections/Contact.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/schema';
import { smsHref, phoneDisplay } from '../lib/text-cta';

// S326 DNA: one LCP (the portrait), one StainSlayer line instead of the
// product list, the Lighthouse average told once, and the old Send a brief,
// then Cal, then Text block gone. Why Bandon now runs straight into the
// closing block, whose Text button sits over "I answer my texts within a few
// hours during business days." The phone number in How I work is a text link.
const sms = smsHref(Astro.url.pathname);
import Tabs from '../components/ui/Tabs.astro';
---

<BaseLayout
  title="About Preston Winters · Bandon Web Designer · Winters Code"
  description="Preston Winters. 6th generation Bandon. Solo software shop. I've owned small businesses. I know what it's like to drown in software you didn't choose."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]))} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }]} />

  <Fragment slot="head">
    <!-- Preload the LCP element, which is the portrait, not the wash. The wash
         renders at 0.4 opacity behind the content and was holding the only
         high-priority image slot on this page while the portrait sat on
         loading="lazy". Verified with web/tests/lcp-element.mjs at 412w
         dpr1.75: the LCP candidate is IMG.ab-photo-img. If this page's layout
         changes, re-measure before changing this line. -->
    <link rel="preload" as="image" imagesrcset="/photo/preston-560.webp 560w, /photo/preston-840.webp 840w, /photo/preston-1120.webp 1120w" imagesizes="(min-width: 1024px) 380px, (min-width: 740px) 300px, 84vw" fetchpriority="high" />
  </Fragment>

  <PageHero
    eyebrow="About"
    h1="I'm Preston Winters."
    sub="Sixth generation Bandon. A one-person software shop: I build it, I stand behind it, I answer the phone."
    bgImage="/photo/local/grass-coast-wash"
    bgOpacity={0.4}
  />

  <!-- S339 round 3 (Preston 2026-11-21: fold, dedupe, cut numbers). The
       story stays open; How I work, What I believe and Why Bandon are one tab
       set, deduped against each other and against the closer (the Text
       button in the list and the repeated tagline are gone). -->
  <section class="ab-story" aria-labelledby="ab-story-h">
    <figure class="ab-photo">
      <picture>
        <source
          type="image/webp"
          srcset="
            /photo/preston-560.webp 560w,
            /photo/preston-840.webp 840w,
            /photo/preston-1120.webp 1120w
          "
          sizes="(min-width: 1024px) 380px, (min-width: 740px) 300px, 84vw"
        />
        <img
          src="/photo/preston-840.webp"
          alt="Preston Winters with his daughter at the Coquille River Lighthouse, Bandon, Oregon."
          width="840"
          height="796"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="ab-photo-img"
        />
      </picture>
      <figcaption class="ab-photo-cap">
        Coquille River Lighthouse, Bandon. Where I'm from, where I work,
        where my kids are growing up.
      </figcaption>
    </figure>

    <div class="ab-prose">
      <h2 class="ab-story-h" id="ab-story-h">The short version.</h2>

      <p>
        <span class="ab-hl-place">Sixth generation Bandon</span>. My dad's fifth gen, his dad before him,
        all the way back. I grew up here. My three daughters are growing
        up here. The plan is to stay.
      </p>

      <p>
        I'm self-taught on every stack I work in. Started with landscaping
        as a teenager and never stopped, I'm a licensed landscaping pro
        in Oregon. Picked up code somewhere along the way and didn't put
        it down. Now I build websites, apps, and <span class="ab-hl-app">AI tools</span> for businesses
        on the Oregon coast. I do the design and the photography too. The landscaping work taught me how to show
        up on time, do the job right, and not make excuses. The same
        rules apply to software.
      </p>

      <p>
        That same AI work runs under every build I do. I built my
        own <span class="ab-hl-app">memory engine</span> on top of Claude and use it on every
        project, so I'm not relearning your business every time we
        talk. The notes stick. The decisions stick. The same person
        who took your first call writes your code.
      </p>

      <p>
        Winters Code brought all of that home. I build the kind of
        tools I wish I'd had,
        for the kind of businesses I grew up around. Built to last,
        with <span class="ab-hl-place">somebody local</span> on the other end of it.
      </p>
    </div>
  </section>

  <Tabs
    label="How I run the shop"
    cols={3}
    tabs={[
      { id: 'how', label: 'How I work', sub: 'Plain rules', icon: 'all' },
      { id: 'believe', label: 'What I believe', sub: 'Four I keep', icon: 'lock' },
      { id: 'bandon', label: 'Why Bandon', sub: 'Six generations', icon: 'keep' },
    ]}
  >
    <div slot="panel-how">
      <ul class="wc-bullets ab-list">
        <li><span><b>I show up in person when it matters.</b> Small towns run on trust, and a phone call doesn't build it the same way.</span></li>
        <li><span><b>I answer texts within a few hours</b> during business days. A real person, a real response time.</span></li>
        <li><span><b>No outsourcing.</b> No offshore team, no junior you'll never meet. The work is mine.</span></li>
        <li><span><b>The site fits your customer.</b> Sometimes a long story, sometimes a big phone number and a way to book. I build the one you need.</span></li>
      </ul>
    </div>
    <div slot="panel-believe">
      <ul class="wc-bullets wc-bullets--copper ab-list">
        <li><span><b>Speed matters.</b> Sites start at 3 business days and apps run in weeks, not quarterly project plans.</span></li>
        <li><span><b>Quality is non-negotiable.</b> HTTPS, security headers and spam-protected forms on every site, scored live on <a href="/wall">the Wall</a>.</span></li>
        <li><span><b>The code is custom.</b> The code under your site is the code I wrote for it, and it's yours to keep.</span></li>
        <li><span><b>Relationships beat one-off projects.</b> The person who built it is the person who maintains it.</span></li>
      </ul>
    </div>
    <div slot="panel-bandon">
      <p class="ab-p">My family has been on the south Oregon coast for six generations, and Bandon is where I'll be in ten years. The coast is full of family businesses that deserve good tools, built by someone they can meet.</p>
      <p class="ab-p">Bandon gets free in-person consults, at Warehouse Coffee or your shop. Coos and Curry get a free 30-minute video call. If you've ever called a national agency and gotten a ticket number instead of an answer, I'm the opposite of that.</p>
    </div>
  </Tabs>

  <Contact headerTitle="Let's talk." />
</BaseLayout>

<style>
  /* ─── Shared block scaffolding ─── */
  .ab-block {
    padding: 32px 4px 24px;
    max-width: 760px;
    margin: 0 auto;
  }
  @media (min-width: 740px) {
    .ab-block { padding: 48px 4px 32px; }
  }
  .ab-block-head { margin: 0 0 18px; }
  .ab-block-h {
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.15;
    color: var(--color-ash-100);
    margin: 0 0 6px;
    font-weight: 600;
  }
  @media (min-width: 740px) { .ab-block-h { font-size: 36px; } }
  @media (min-width: 1024px) { .ab-block-h { font-size: 42px; } }
  .ab-block-sub {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ash-400);
    margin: 0;
  }
  @media (min-width: 740px) { .ab-block-sub { font-size: 15px; } }

  /* ─── Section 01: photo + prose ─── */
  .ab-story {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 24px 4px 16px;
    max-width: 960px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 740px) {
    .ab-story { grid-template-columns: 260px 1fr; gap: 32px; padding: 40px 4px 24px; }
  }
  @media (min-width: 1024px) {
    .ab-story { grid-template-columns: 340px 1fr; gap: 48px; padding: 56px 4px 32px; }
  }

  .ab-photo {
    margin: 0;
    max-width: 380px;
    justify-self: center;
  }
  @media (min-width: 740px) { .ab-photo { justify-self: start; } }
  .ab-photo-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card, 10px);
    border: 1px solid var(--copper-hairline);
    display: block;
  }
  .ab-photo-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ash-500);
    margin: 10px 0 0;
    letter-spacing: 0.02em;
  }
  @media (min-width: 740px) { .ab-photo-cap { font-size: 12px; } }

  .ab-prose { min-width: 0; }
  .ab-story-h {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-ash-100);
    margin: 0 0 16px;
    font-weight: 600;
  }
  @media (min-width: 740px) { .ab-story-h { font-size: 28px; } }
  @media (min-width: 1024px) { .ab-story-h { font-size: 32px; } }

  .ab-prose p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ash-300);
    margin: 0 0 14px;
  }
  @media (min-width: 740px) { .ab-prose p { font-size: 16px; } }
  .ab-prose p strong { color: var(--color-ash-100); }
  .ab-prose p em {
    color: var(--color-copper-bright);
    font-style: italic;
  }
  .ab-prose p a {
    color: var(--color-ash-100);
    text-decoration: underline;
    text-decoration-color: var(--color-copper);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }
  .ab-prose p a:focus-visible {
    color: var(--color-copper-bright);
    text-decoration-color: var(--color-copper-bright);
    outline: none;
  }

  @media (hover: hover) {

    .ab-prose p a:hover {
    color: var(--color-copper-bright);
    text-decoration-color: var(--color-copper-bright);
    outline: none;
  }}
  .ab-prose p a strong { color: inherit; }

  /* Word highlights: green threads the product/tech story, copper the
     place/roots story. Color carries it; weight stays light. */
  .ab-hl-app { color: var(--color-wc-green); font-weight: 600; }
  .ab-hl-place { color: var(--color-copper-bright); font-weight: 600; }

  /* ─── Section 02: How I work ─── */
  .ab-how-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .ab-how-list li {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ash-300);
    padding: 0 0 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 740px) { .ab-how-list li { font-size: 15px; } }
  .ab-how-list li:last-child { border-bottom: 0; }
  .ab-how-list strong {
    display: block;
    color: var(--color-ash-100);
    font-weight: 600;
    margin: 0 0 4px;
  }

  /* ─── Section 03: Four laws ─── */
  .ab-laws-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .ab-laws-list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--copper-hairline);
  }
  .ab-laws-list li:last-child {
    border-bottom: 1px solid var(--copper-hairline);
  }
  @media (min-width: 740px) {
    .ab-laws-list li { grid-template-columns: 72px 1fr; gap: 20px; padding: 18px 0; }
  }

  .ab-law-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 36px;
    line-height: 1;
    color: var(--color-copper);
    font-weight: 600;
  }
  @media (min-width: 740px) { .ab-law-num { font-size: 48px; } }
  @media (min-width: 1024px) { .ab-law-num { font-size: 56px; } }

  .ab-law-body { min-width: 0; }
  .ab-law-h {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-ash-100);
    margin: 0 0 4px;
    font-weight: 600;
  }
  @media (min-width: 740px) { .ab-law-h { font-size: 18px; } }
  .ab-law-body p {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-ash-400);
    margin: 0;
  }
  @media (min-width: 740px) { .ab-law-body p { font-size: 14px; } }

  /* ─── Section 04: Bandon roots ─── */
  .ab-roots-body p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ash-300);
    margin: 0 0 14px;
  }
  @media (min-width: 740px) { .ab-roots-body p { font-size: 16px; } }
  .ab-roots-pull {
    font-family: var(--font-serif);
    font-size: 20px !important;
    line-height: 1.35 !important;
    color: var(--color-ash-100) !important;
    border-left: 2px solid var(--color-wc-green);
    padding-left: 16px;
    margin: 24px 0 0 !important;
  }
  @media (min-width: 740px) {
    .ab-roots-pull { font-size: 24px !important; padding-left: 20px; }
  }
  .ab-roots-pull em {
    color: var(--color-wc-green);
    font-style: italic;
  }

  .ab-roots-soft {
    margin: 18px 0 0 !important;
    font-size: 14px !important;
    color: var(--color-ash-400) !important;
  }
  .ab-roots-soft a,
  .ab-text-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--copper-hairline);
    text-underline-offset: 3px;
  }
  @media (hover: hover) {
    .ab-roots-soft a:hover,
    .ab-text-link:hover { color: var(--color-wc-green); }
  }
  /* S339 HONE-SPEC: the reply-time row carries the page's one filled Text. */
  .ab-reply-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 10px; }
  .ab-reply-btn { padding: 10px 16px; font-size: 14px; }

  /* S339 round 3 */
  .ab-list { color: var(--color-ash-300); gap: 14px; }
  .ab-list b { color: #eef1ec; font-weight: 600; }
  .ab-list a, .ab-p a { color: var(--color-wc-green); }
  .ab-p { margin: 0 0 12px; font-size: 16px; line-height: 1.65; color: var(--color-ash-300); max-width: 44rem; }
  .ab-p:last-child { margin-bottom: 0; }
</style>
