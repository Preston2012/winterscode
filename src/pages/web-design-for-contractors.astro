---
import ServiceLayout from '../components/templates/ServiceLayout.astro';
import type { ServiceEntry } from '../lib/business';
const service: ServiceEntry = {
  slug: 'web-design-for-contractors',
  name: 'Web Design for Contractors',
  shortLabel: 'For Contractors',
  blurb: 'Websites for Oregon coast contractors and trades.',
  serviceType: 'Web design for contractors and trades',
};
---
<ServiceLayout
  service={service}
  path="/web-design-for-contractors"
  breadcrumb={[
    { name: 'Home', path: '/' },
    { name: 'Web Design for Contractors', path: '/web-design-for-contractors' },
  ]}
  title="Contractor Website Design, Oregon · From $1,750 · Winters Code"
  description="Website design for Oregon contractors, handymen and trades: before-and-after galleries, quote forms, fast on a phone. From $1,750. Text 541-551-0731."
  eyebrow="Industries · Contractors"
  h1="Websites for contractors who build."
  sub="Show the work, capture the lead, and load fast on a phone at the job site. Built for trades on the Oregon coast."
  bgImage="/photo/local/scenes/surf-pine"
  showcase
  heroFocal="center 50%"
  heroTextPos="top"
  intro={[
    "Most of your customers find you on a phone, often standing in the project they want fixed. Your website has one job in that moment: prove you do good work and make it dead simple to reach you. <span class='hl-green'>Do that well and the search turns into a phone call.</span> A slow, generic template does neither.",
    "I built the website for <a href=\"https://sogncontracting.com\" target=\"_blank\" rel=\"noopener\">Sogn Contracting</a>, a 30-year Bandon contractor, so this is not theory. What a real contractor site does for a trade business is below.",
  ]}
  includesTitle="What a contractor site needs"
  includes={[
    { h: 'Before-and-after gallery', body: 'The most persuasive thing you have. Real project photos, organized and fast, even on a slow connection.' },
    { h: 'Services and service area', body: 'Clear pages for what you do and where, so a search for the trade plus the town has a page that answers it.' },
    { h: 'Lead capture', body: 'A quote request form that actually delivers to your inbox, with the details you need to scope a job.' },
    { h: 'Reviews and trust', body: 'License number, years in business, and real reviews placed where they close the deal.' },
    { h: 'Phone-first', body: 'A tap-to-call number in reach at all times, because a customer standing in the job wants to call, not fill out a form.' },
    { h: 'Fast on the job site', body: 'Built to load fast on a phone and checked with Lighthouse, so the page is up before the customer loses patience.' },
  ]}
  sections={[
    {
      heading: 'Proof from a real contractor site',
      body: [
        "<a href=\"https://sogncontracting.com\" target=\"_blank\" rel=\"noopener\">Sogn Contracting</a> in Bandon has been at it for 30 years. The site went from kickoff to live in three business days: a before-and-after gallery that does the selling, services and service-area pages, a working quote form, and the CCB license number right where customers look for it.",
        "It's live, indexed and scored on the Wall, so you can go look at it instead of taking my word. Upkeep since: 105 commits across six months, made by the same person who answers the phone.",
        "<a href=\"/work#makai-painting\">Makai Painting</a> in Coos Bay, a painting and residential-rehab company, went live in five business days with 20 pages, twelve of them service pages, and an estimate form that reaches the office inbox.",
      ],
    },
  ]}
  whyLink
  textLinks={[{ href: '/work/sogn-contracting', label: 'Read the Sogn case' }, { href: '/pricing', label: 'See pricing' }]}
  faq={[
    { q: 'I am busy on jobs. How much of my time does this take?', a: 'Very little. A few texts and one consult get me what I need. I can shoot the project photos and draft the copy, then you just approve. Sites start at 3 business days.' },
    { q: 'Can you show my past projects?', a: 'Yes, and you should. A before-and-after gallery is the single most persuasive thing on a contractor site. I organize and optimize the photos so they load fast and look sharp.' },
    { q: 'Will it bring in leads?', a: 'That is the goal. Clear services, a working quote form, your service-area towns, and fast mobile loads are what turn a search into a phone call. I also wire up the SEO basics most contractor sites skip.' },
    { q: 'Have you built a contractor site before?', a: 'Yes. Sogn Contracting in Bandon is live, built in three business days and scored live on the Wall. Real, indexed, local work you can go look at.' },
  ]}
  closerWhy="$1,750 once, half to start and half at launch. You own it, there's no monthly fee unless you want care, and the price I quote is the price you pay."
  relatedTitle="Related"
  relatedLinks={[
    { href: '/work/sogn-contracting', label: 'Sogn Contracting', sub: 'Contractor case study' },
    { href: '/services/web-design', label: 'Web Design', sub: 'The full service' },
    { href: '/web-design-bandon', label: 'Web Design in Bandon', sub: 'Local work' },
  ]}
/>
