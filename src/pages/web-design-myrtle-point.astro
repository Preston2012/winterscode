---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('myrtle-point')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-myrtle-point"
  title="Myrtle Point Web Design · Sites from $1,750 · Winters Code"
  description="Custom websites for Myrtle Point trades and farms. Hand-built in Bandon from $1,750, fast on a phone and yours to keep. Text Preston at 541-551-0731."
  eyebrow="Locations · Myrtle Point"
  h1="Web design in Myrtle Point, Oregon."
  sub="Custom, fast, mobile-first websites for Myrtle Point trades, farms, and family shops."
  bgImage="/photo/local/towns/myrtle-point"
  showcase
  heroFocal="center 42%"
  heroTextPos="top"
  intro={[
    "Myrtle Point is ranch and dairy country in the upper Coquille Valley, where trades, farms and family shops serve a tight rural community. In a market this size, a clean, fast site <span class='hl-green'>stands out quickly.</span>",
  ]}
  nearby="Nearby work: <a href='/work/grand-management'>Grand Management in Coos Bay</a>, rebuilt off WordPress into 50 bilingual pages."
/>
