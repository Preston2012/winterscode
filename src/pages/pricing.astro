---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import PageHero from '../components/sections/PageHero.astro';
import Divider from '../components/ui/Divider.astro';
import ClientQuote from '../components/ui/ClientQuote.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Contact from '../components/sections/Contact.astro';
import TextCta from '../components/ui/TextCta.astro';
import Tabs from '../components/ui/Tabs.astro';
import Fold from '../components/ui/Fold.astro';
import Arrow from '../components/ui/Arrow.astro';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing' },
];
const breadcrumbLd = breadcrumbSchema(crumbs);
---

<BaseLayout
  title="Pricing · Sites from $1,750 · Winters Code"
  description="Websites for Oregon coast businesses from $1,750, one price with everything in. You own it. Care optional from $75/mo. Text 541-551-0731."
  canonicalPath="/pricing"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <!-- S339 round 3 (Preston 2026-11-21: fold, dedupe, every word earns its
       place). Seven stacked sections became one rate card in three tabs (new
       site, rebuild, care), the five questions on a plate, and two folds. The
       #compare anchor Home and /faq link to still lands. -->
  <PageHero
    eyebrow="Pricing"
    h1="One price. Everything in."
    sub="Local business sites start at $1,750, with everything included. Bigger jobs cost more and I tell you up front. Care plans optional, from $75 a month."
    bgImage="/photo/local/scenes/seastacks-gorse"
    showcase
    bgPosition="center 50%"
  />

  <Tabs
    label="Rate card"
    cols={3}
    tabs={[
      { id: 'new-site', label: 'New site', sub: '$1,750', icon: 'web' },
      { id: 'rebuild', label: 'Rebuild', sub: '$2,500 to $3,500', icon: 'auto' },
      { id: 'care', label: 'Care', sub: 'From $75 a month', icon: 'keep' },
    ]}
  >
    <div slot="panel-new-site">
      <p class="pr-price"><span class="wc-cu">$1,750</span> for most local business sites</p>
      <p class="pr-p">A real, finished website, not a demo you keep buying pieces of.</p>
      <p class="pr-p">One price, everything in: the pages, the words, real photos, branding, a site built to load fast on a phone, and security, and it's yours to keep. No per-page fees, no surprise add-ons, no monthly anything you didn't ask for. The price I quote is the price you pay.</p>
      <figure class="pr-quote">
        <blockquote><p>&ldquo;We are proud to endorse and recommend WintersCode.com.&rdquo;</p></blockquote>
        <figcaption>General Manager, US Survey Supply <a class="wc-link" href="/work/us-survey-supply">See the US Survey Supply build <Arrow size={16} /></a></figcaption>
      </figure>
      <TextCta lead="Tell me about your business in a text and I'll tell you where it lands." links={[{ href: '/audit', label: 'Free audit of your current site' }]} />
      <p class="pr-p">Want it line by line? See the full breakdown on <a href="/services#sites">services</a>.</p>
    </div>
    <div slot="panel-rebuild">
      <p class="pr-price"><span class="wc-cu">$2,500</span> to $3,500 for most rebuilds</p>
      <p class="pr-p">Most businesses around here are not starting from nothing. They have a site with years of photos, words, and search history in it, sitting on a foundation that has stopped keeping up. That is a rebuild, not a new build, and it is a different job.</p>
      <p class="pr-p">A rebuild keeps what is worth keeping and replaces what is holding it back. Most land between $2,500 and $3,500, depending on how many pages have to move and whether there is a catalog or a booking system to repair.</p>
      <p class="pr-p">It costs more than a new site for a plain reason. A new site starts from nothing, which is simple. A rebuild starts from something that has to survive the move: the content inventory, the redirect map, the years of search value you already paid for. Skipping that work is how a redesign quietly costs a business its rankings.</p>
      <p class="pr-p">Not every site needs one. Some need an afternoon of fixes. I will tell you which one you are before either of us talks about money.</p>
      <TextCta links={[{ href: '/website-redesign', label: 'See what a rebuild covers' }]} />
    </div>
    <div slot="panel-care">
      <p class="pr-p pr-p--lead">Optional. Fixed monthly pricing, public. Cancel anytime.</p>
      <div class="pr-tiers">
        <div class="pr-tier"><p class="pr-tier-h">Basic</p><p class="pr-tier-t">starting at <span class="wc-cu">$75</span>/mo</p><ul class="wc-bullets"><li>Hosting and SSL, managed on your account</li><li>Daily backups</li><li>Security patches</li><li>10 content edits / month</li><li>Uptime monitoring</li></ul></div>
        <div class="pr-tier"><p class="pr-tier-h">Pro</p><p class="pr-tier-t">starting at <span class="wc-cu">$250</span>/mo</p><ul class="wc-bullets"><li>Everything in Basic</li><li>Unlimited reasonable edits</li><li>Edits scheduled directly with me</li><li>Quarterly performance + SEO pass, fixes made</li><li>Improvements rolled in as you grow</li></ul></div>
      </div>
      <p class="pr-p">Not required, ever. The site is yours either way. See <a href="/services#care">care plan details</a> or <a href="/services">all services</a>.</p>
      <TextCta />
    </div>
  </Tabs>

  <p class="pr-terms"><span class="wc-dot" aria-hidden="true"></span>Every project starts with a free consult and a written quote that holds for 14 days. A 50 percent deposit locks scope and schedule, and the rest is due at launch.</p>

  <section class="pr-compare wc-plate wc-rv" id="compare" aria-labelledby="pr-compare-h">
    <h2 class="pr-compare-h" id="pr-compare-h">Comparing quotes? <span class="wc-soft">Ask these five.</span></h2>
    <ul class="wc-bullets wc-bullets--copper pr-compare-list">
      <li>Who owns the domain and the code?</li>
      <li>Are the words, photos and logo included?</li>
      <li>What does it score on Google's phone test?</li>
      <li>Is there a required monthly fee?</li>
      <li>Who answers when it breaks?</li>
    </ul>
    <p class="pr-p">If the cheaper quote answers all five the same way, take it.</p>
    <p class="pr-p">Every site I build is scored live on a phone. <a href="/wall">Check any of them on the Wall</a>.</p>
  </section>

  <div class="pr-folds">
    <Fold title={'What "yours to keep" actually means'}>
      <p>Most website deals never say this part out loud. Here it is plainly.</p>
      <ul class="wc-bullets">
        <li>The domain is registered in your name. I never hold it. If you and I never speak again, you still own the address</li>
        <li>The site runs on your own Cloudflare account. At this size that tier costs nothing</li>
        <li>I hold an access token you can revoke in two clicks, any day, without asking me</li>
        <li>The code is yours, and it moves to your own GitHub whenever you want it</li>
        <li>Skip the care plan and nothing turns off. The site keeps running exactly as it is</li>
        <li>The care plan buys changes, monitoring, and somebody local to call. It does not buy access to your own website. You already have that</li>
      </ul>
    </Fold>
    <Fold title="When it costs more">
      <p>The floor covers a complete core site. These add to it, and I quote them clearly.</p>
      <ul class="wc-bullets">
        <li><span><b>Bigger sites.</b> A lot more pages, or sections well beyond a core site.</span></li>
        <li><span><b>Booking, payments, or a store.</b> Online scheduling, taking payments, or selling products.</span></li>
        <li><span><b>Listing feeds.</b> MLS or RMLS feeds for real estate.</span></li>
        <li><span><b>Integrations.</b> Stripe, QuickBooks, or whatever you already use, wired together.</span></li>
        <li><span><b>AI workflow design.</b> Automating intake, replies, and lead routing. Practical AI, not the buzzword kind. If it uses an AI model or a paid API, I name that running cost in the quote, so the monthly bill is never a surprise.</span></li>
      </ul>
      <p>Cross-platform apps and custom systems are quoted per project too. Tell me what you need and I'll price it straight.</p>
      <p>Anything on this list is priced in writing before you sign.</p>
    </Fold>
  </div>

  <Contact policy />
</BaseLayout>

<style>
  .pr-price { margin: 0; font-size: 16px; color: var(--color-ash-300); }
  .pr-price .wc-cu { font-family: var(--wc-display); font-style: normal; font-weight: 500; font-size: clamp(44px, 7vw, 64px); line-height: 1; letter-spacing: -0.02em; margin-right: 8px; }
  .pr-p { margin: 12px 0 0; max-width: 42rem; font-size: 16px; line-height: 1.6; color: var(--color-ash-300); }
  .pr-p--lead { margin-top: 0; color: #eef1ec; font-size: 17px; }
  .pr-p a, .pr-quote a { color: var(--color-wc-green); }
  .pr-quote { margin: 22px 0 0; padding: 0; }
  .pr-quote blockquote { margin: 0; }
  .pr-quote p { margin: 0; font-family: var(--wc-display); font-style: italic; font-size: clamp(20px, 2.6vw, 26px); line-height: 1.3; color: #eef1ec; }
  .pr-quote figcaption { margin-top: 6px; display: flex; flex-wrap: wrap; align-items: center; gap: 0 16px; font-size: 14px; color: var(--color-ash-500); }
  .pr-tiers { display: grid; gap: 10px; margin-top: 16px; }
  .pr-tier { padding: 18px; background: rgba(10, 13, 12, 0.55); border: 1px solid var(--wc-line); border-radius: var(--wc-r); }
  .pr-tier-h { margin: 0; font-size: 18px; font-weight: 600; color: #eef1ec; }
  .pr-tier-t { margin: 2px 0 12px; font-size: 15px; color: var(--color-copper-bright); }
  .pr-tier-t .wc-cu { font-family: var(--wc-display); font-style: normal; font-size: 28px; font-weight: 500; }
  .pr-tier :global(.wc-bullets) { color: var(--color-ash-300); gap: 6px; }
  @media (min-width: 740px) { .pr-tiers { grid-template-columns: 1fr 1fr; gap: 12px; } }

  .pr-terms { display: flex; gap: 10px; align-items: flex-start; margin: 16px 4px 0; font-size: 14.5px; line-height: 1.5; color: var(--color-ash-300); }
  .pr-terms .wc-dot { margin-top: 6px; }

  .pr-compare { margin-top: 28px; padding: 28px 22px 24px; }
  .pr-compare-h { margin: 0 0 16px; font-family: var(--wc-display); font-weight: 500; font-size: clamp(26px, 4vw, 40px); line-height: 1.1; letter-spacing: -0.015em; color: #eef1ec; }
  .pr-compare-list { color: #eef1ec; }
  .pr-compare-list :global(li) { font-size: 16.5px; }
  @media (min-width: 740px) { .pr-compare { padding: 36px 40px 32px; } }

  .pr-folds { margin-top: 16px; }
  .pr-folds :global(.wc-bullets) { color: var(--color-ash-300); margin-bottom: 12px; }
</style>
