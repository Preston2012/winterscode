---
/**
 * Professors Golf, case stub (S326 DNA, decision C: stub or demote).
 * Built from the live card facts in src/lib/portfolio.ts and src/lib/sites.ts
 * only: one business day (sites.ts builtDays, "per Preston"), the homepage
 * plus an events page, click-to-call header, sharecard, the
 * client's own Cloudflare account. No quote, no client words, nothing new.
 * If Preston picks "demote", delete this file and drop caseStudy from the
 * professors-golf portfolio entry and the homepage card.
 */
import CaseStudyLayout from '../../components/templates/CaseStudyLayout.astro';
import { bizDaysWord, builtDays } from '../../lib/counts';
---
<CaseStudyLayout
  slug="professors-golf"
  title="Professors Golf Case Study · Winters Code"
  description={`A Bandon golf service online in ${bizDaysWord('golf')}: fitting, instruction, caddy referrals, tee times and golf trips, on the client's own Cloudflare account.`}
  eyebrow="Work · Case Study"
  h1={`Online in ${bizDaysWord('golf')}.`}
  sub={`A Bandon golf service whose first version was built in ${bizDaysWord('golf')}, running in the client's own Cloudflare account.`}
  intro={[
    "Professors Golf LLC is a Bandon golf service: club fitting, PGA-certified instruction, caddy referrals, local tee times and all-inclusive golf trips.",
    `The first version went up in <span class='hl-copper'>${bizDaysWord('golf')}</span>: a homepage that covers all of it plus an events page, with a click-to-call header and a sharecard built for the group text.`,
    "It runs in <span class='hl-green'>the client's own Cloudflare account</span>, not mine, so the site is theirs to keep. Its scores are measured on <a href='/wall'>the Wall</a> with every other site I build.",
  ]}
  stats={[
    { value: String(builtDays('golf')), label: builtDays('golf') === 1 ? 'business day of build time' : 'business days of build time' },
    { value: 'A+', label: 'Mozilla Observatory, measured live' },
  ]}
  relatedLinks={[
    { href: '/services/web-design', label: 'Web Design', sub: 'What a build includes' },
    { href: '/pricing', label: 'Pricing', sub: 'One price, everything in' },
    { href: '/web-design-bandon', label: 'Web Design in Bandon', sub: 'Local work' },
    { href: '/work', label: 'All work', sub: 'More projects' },
  ]}
/>
