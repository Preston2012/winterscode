---
/**
 * /chere/join, one page to get Chere' onto a phone (S384, Preston 2026-11-16: "a page where
 * people can join iOS or Android easily and it's sexy and well done").
 *
 * Two lanes, iPhone and Android, each three taps. A visitor's own phone comes first and is
 * marked "Your phone" by a one-line script that reads the user agent; with no script both lanes
 * show in the same order. A computer gets a QR code to carry the page to a phone. The last step
 * is the same on both: text Preston the key the app shows, and he texts back a setup code.
 * Under it, the Chere' master video (2026-11-10 cut, 720p web encode), Preston 2026-11-16:
 * "Below text me your key should be the latest Chere' video".
 *
 * Links: TestFlight's public link for Chere' (Apple approved build 2501 for outside testers),
 * and on Android the testers Google Group, Play's opt-in page and the Play listing. The Android
 * lane's buttons open a coming-soon note until Google approves the Closed testing release (ANDROID_LIVE).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import MobileMenu from '../../components/layout/MobileMenu.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { smsBase, phoneDisplay } from '../../lib/text-cta';
import { v } from '../../lib/asset';

const path = '/chere/join';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: "Chere'", path: '/chere' },
  { name: 'Get the app', path },
];
const sms = smsBase + encodeURIComponent("Hi Preston, I installed Chere'. My phone's key is: ");

const PKG = 'com.winterscode.chere.demo';
// Android goes live when Google approves the Closed testing release. Until then each Android button
// opens the coming-soon note (Preston, 2026-11-17: "put a coming soon pop-up on the play button for
// now until the link is live"). Set true and rebuild to make them real links.
const ANDROID_LIVE = false;
const smsAndroid = smsBase + encodeURIComponent("Hi Preston, I'd like Chere' on my Android phone. ");
// Official store badges (the same files baseline.marketing uses). Apple's badge may only link to an App
// Store page, so it sits on Get TestFlight (TestFlight's own App Store page), never on the beta link.
const BADGES: Record<string, { src: string; alt: string; w: number; h: number }> = {
  appstore: { src: '/chere/badge-appstore.svg', alt: 'Download on the App Store', w: 120, h: 40 },
  googleplay: { src: '/chere/badge-googleplay.svg', alt: 'Get it on Google Play', w: 135, h: 40 },
};

type Step = { h: string; p: string; href: string; cta: string; badge?: string };
const ios: Step[] = [
  {
    h: 'Get TestFlight',
    p: "Apple's free app for trying apps before they're in the App Store.",
    href: 'https://apps.apple.com/us/app/testflight/id899247664',
    cta: 'Get TestFlight',
    badge: 'appstore',
  },
  {
    h: "Join the Chere' beta",
    p: 'It opens in TestFlight. Tap Accept, then Install.',
    href: 'https://testflight.apple.com/join/9jFFH197',
    cta: "Join the beta",
  },
];
const android: Step[] = [
  {
    h: 'Join the testers group',
    p: 'Use the Google account your phone is signed in with, then tap Join group.',
    href: 'https://groups.google.com/g/chere-testers',
    cta: 'Join the group',
  },
  {
    h: 'Become a tester',
    p: 'One tap on Google Play says you are in.',
    href: `https://play.google.com/apps/testing/${PKG}`,
    cta: 'Become a tester',
  },
  {
    h: 'Install from Google Play',
    p: 'Updates come through Play from here on, like any other app.',
    href: `https://play.google.com/store/apps/details?id=${PKG}`,
    cta: 'Open Google Play',
    badge: 'googleplay',
  },
];

// The video goes through the byte-range route (src/pages/media/[file].ts), which iPhone Safari needs.
const mediaUrl = (file: string) => {
  const ver = v(`/work/${file}`).split('?')[1];
  return `/media/${file}${ver ? `?${ver}` : ''}`;
};

const QR_N = 29;
const QR_D = 'M0 0h1v1h-1zM1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM4 0h1v1h-1zM5 0h1v1h-1zM6 0h1v1h-1zM9 0h1v1h-1zM10 0h1v1h-1zM13 0h1v1h-1zM14 0h1v1h-1zM15 0h1v1h-1zM17 0h1v1h-1zM18 0h1v1h-1zM19 0h1v1h-1zM20 0h1v1h-1zM22 0h1v1h-1zM23 0h1v1h-1zM24 0h1v1h-1zM25 0h1v1h-1zM26 0h1v1h-1zM27 0h1v1h-1zM28 0h1v1h-1zM0 1h1v1h-1zM6 1h1v1h-1zM11 1h1v1h-1zM13 1h1v1h-1zM14 1h1v1h-1zM15 1h1v1h-1zM16 1h1v1h-1zM20 1h1v1h-1zM22 1h1v1h-1zM28 1h1v1h-1zM0 2h1v1h-1zM2 2h1v1h-1zM3 2h1v1h-1zM4 2h1v1h-1zM6 2h1v1h-1zM8 2h1v1h-1zM11 2h1v1h-1zM13 2h1v1h-1zM15 2h1v1h-1zM19 2h1v1h-1zM20 2h1v1h-1zM22 2h1v1h-1zM24 2h1v1h-1zM25 2h1v1h-1zM26 2h1v1h-1zM28 2h1v1h-1zM0 3h1v1h-1zM2 3h1v1h-1zM3 3h1v1h-1zM4 3h1v1h-1zM6 3h1v1h-1zM8 3h1v1h-1zM9 3h1v1h-1zM12 3h1v1h-1zM14 3h1v1h-1zM15 3h1v1h-1zM17 3h1v1h-1zM18 3h1v1h-1zM19 3h1v1h-1zM22 3h1v1h-1zM24 3h1v1h-1zM25 3h1v1h-1zM26 3h1v1h-1zM28 3h1v1h-1zM0 4h1v1h-1zM2 4h1v1h-1zM3 4h1v1h-1zM4 4h1v1h-1zM6 4h1v1h-1zM8 4h1v1h-1zM10 4h1v1h-1zM15 4h1v1h-1zM16 4h1v1h-1zM17 4h1v1h-1zM18 4h1v1h-1zM19 4h1v1h-1zM20 4h1v1h-1zM22 4h1v1h-1zM24 4h1v1h-1zM25 4h1v1h-1zM26 4h1v1h-1zM28 4h1v1h-1zM0 5h1v1h-1zM6 5h1v1h-1zM8 5h1v1h-1zM10 5h1v1h-1zM11 5h1v1h-1zM12 5h1v1h-1zM17 5h1v1h-1zM20 5h1v1h-1zM22 5h1v1h-1zM28 5h1v1h-1zM0 6h1v1h-1zM1 6h1v1h-1zM2 6h1v1h-1zM3 6h1v1h-1zM4 6h1v1h-1zM5 6h1v1h-1zM6 6h1v1h-1zM8 6h1v1h-1zM10 6h1v1h-1zM12 6h1v1h-1zM14 6h1v1h-1zM16 6h1v1h-1zM18 6h1v1h-1zM20 6h1v1h-1zM22 6h1v1h-1zM23 6h1v1h-1zM24 6h1v1h-1zM25 6h1v1h-1zM26 6h1v1h-1zM27 6h1v1h-1zM28 6h1v1h-1zM8 7h1v1h-1zM11 7h1v1h-1zM12 7h1v1h-1zM14 7h1v1h-1zM16 7h1v1h-1zM19 7h1v1h-1zM0 8h1v1h-1zM2 8h1v1h-1zM3 8h1v1h-1zM4 8h1v1h-1zM5 8h1v1h-1zM6 8h1v1h-1zM9 8h1v1h-1zM17 8h1v1h-1zM22 8h1v1h-1zM23 8h1v1h-1zM24 8h1v1h-1zM25 8h1v1h-1zM26 8h1v1h-1zM2 9h1v1h-1zM3 9h1v1h-1zM4 9h1v1h-1zM13 9h1v1h-1zM14 9h1v1h-1zM15 9h1v1h-1zM18 9h1v1h-1zM19 9h1v1h-1zM20 9h1v1h-1zM21 9h1v1h-1zM22 9h1v1h-1zM23 9h1v1h-1zM24 9h1v1h-1zM28 9h1v1h-1zM0 10h1v1h-1zM1 10h1v1h-1zM3 10h1v1h-1zM4 10h1v1h-1zM6 10h1v1h-1zM7 10h1v1h-1zM8 10h1v1h-1zM9 10h1v1