16 21h1v1h-1zM20 21h1v1h-1zM24 21h1v1h-1zM25 21h1v1h-1zM26 21h1v1h-1zM27 21h1v1h-1zM28 21h1v1h-1zM0 22h1v1h-1zM1 22h1v1h-1zM2 22h1v1h-1zM3 22h1v1h-1zM4 22h1v1h-1zM5 22h1v1h-1zM6 22h1v1h-1zM12 22h1v1h-1zM15 22h1v1h-1zM17 22h1v1h-1zM18 22h1v1h-1zM19 22h1v1h-1zM20 22h1v1h-1zM22 22h1v1h-1zM24 22h1v1h-1zM25 22h1v1h-1zM26 22h1v1h-1zM0 23h1v1h-1zM6 23h1v1h-1zM8 23h1v1h-1zM9 23h1v1h-1zM14 23h1v1h-1zM18 23h1v1h-1zM19 23h1v1h-1zM20 23h1v1h-1zM24 23h1v1h-1zM27 23h1v1h-1zM28 23h1v1h-1zM0 24h1v1h-1zM2 24h1v1h-1zM3 24h1v1h-1zM4 24h1v1h-1zM6 24h1v1h-1zM8 24h1v1h-1zM12 24h1v1h-1zM17 24h1v1h-1zM20 24h1v1h-1zM21 24h1v1h-1zM22 24h1v1h-1zM23 24h1v1h-1zM24 24h1v1h-1zM26 24h1v1h-1zM27 24h1v1h-1zM0 25h1v1h-1zM2 25h1v1h-1zM3 25h1v1h-1zM4 25h1v1h-1zM6 25h1v1h-1zM8 25h1v1h-1zM10 25h1v1h-1zM11 25h1v1h-1zM14 25h1v1h-1zM16 25h1v1h-1zM18 25h1v1h-1zM19 25h1v1h-1zM20 25h1v1h-1zM25 25h1v1h-1zM26 25h1v1h-1zM27 25h1v1h-1zM28 25h1v1h-1zM0 26h1v1h-1zM2 26h1v1h-1zM3 26h1v1h-1zM4 26h1v1h-1zM6 26h1v1h-1zM8 26h1v1h-1zM9 26h1v1h-1zM10 26h1v1h-1zM12 26h1v1h-1zM13 26h1v1h-1zM15 26h1v1h-1zM16 26h1v1h-1zM19 26h1v1h-1zM20 26h1v1h-1zM21 26h1v1h-1zM22 26h1v1h-1zM23 26h1v1h-1zM24 26h1v1h-1zM25 26h1v1h-1zM26 26h1v1h-1zM27 26h1v1h-1zM0 27h1v1h-1zM6 27h1v1h-1zM12 27h1v1h-1zM16 27h1v1h-1zM20 27h1v1h-1zM21 27h1v1h-1zM23 27h1v1h-1zM25 27h1v1h-1zM27 27h1v1h-1zM0 28h1v1h-1zM1 28h1v1h-1zM2 28h1v1h-1zM3 28h1v1h-1zM4 28h1v1h-1zM5 28h1v1h-1zM6 28h1v1h-1zM8 28h1v1h-1zM9 28h1v1h-1zM10 28h1v1h-1zM11 28h1v1h-1zM13 28h1v1h-1zM14 28h1v1h-1zM17 28h1v1h-1zM18 28h1v1h-1zM19 28h1v1h-1zM22 28h1v1h-1zM23 28h1v1h-1zM24 28h1v1h-1zM25 28h1v1h-1zM26 28h1v1h-1z';
---

<BaseLayout
  title="Get Chere' on Your Phone · Winters Code"
  description="Install the Chere' beta on iPhone, iPad or Android in a few taps, then text Preston the key the app shows to connect your phone to your business."
  canonicalPath={path}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(crumbs))} />
    <script is:inline>document.documentElement.dataset.os=/android/i.test(navigator.userAgent)?'android':/iphone|ipad|ipod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1)?'ios':'other';document.documentElement.dataset.apple=/iphone|ipad|ipod|macintosh|mac os/i.test(navigator.userAgent)||navigator.platform==='MacIntel'?'1':'0';</script>
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <section class="jn-hero" aria-labelledby="jn-h1">
    <div class="jn-eyebrow mono">CHERE' · BETA</div>
    <h1 class="h1 jn-h1" id="jn-h1">Get Chere' on your phone.</h1>
    <p class="jn-sub">
      A few taps, then one text. Pick your phone below and go top to bottom.
    </p>
  </section>

  <div class="jn-qr" aria-hidden="true">
    <svg viewBox={`-2 -2 ${QR_N + 4} ${QR_N + 4}`} class="jn-qr-code" shape-rendering="crispEdges" role="img">
      <rect x="-2" y="-2" width={QR_N + 4} height={QR_N + 4} rx="1.5" fill="#f2efe8" />
      <path d={QR_D} fill="#0a0d0c" />
    </svg>
    <p class="jn-qr-text">
      <span class="jn-qr-h">On a computer?</span>
      Scan the code with your phone's camera to open the install steps there.
    </p>
  </div>

  <div class="jn-lanes">
    <section class="jn-lane jn-lane-ios" aria-labelledby="jn-ios-h">
      <header class="jn-lane-head">
        <svg class="jn-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.6" /><path d="M10.5 18.5h3" /></svg>
        <div class="jn-lane-titles">
          <span class="jn-yours mono">YOUR PHONE</span>
          <h2 class="jn-lane-h" id="jn-ios-h">iPhone or iPad</h2>
          <p class="jn-lane-sub mono">VIA TESTFLIGHT</p>
        </div>
      </header>
      <ol class="jn-steps">
        {ios.map((s, i) => (
          <li class="jn-step">
            <span class="jn-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="jn-step-body">
              <h3 class="jn-step-h">{s.h}</h3>
              <p class="jn-step-p">{s.p}</p>
              {s.badge ? (
                <a class="jn-badge" href={s.href} rel="noopener" aria-label={BADGES[s.badge].alt}>
                  <img src={BADGES[s.badge].src} alt={BADGES[s.badge].alt} width={BADGES[s.badge].w} height={BADGES[s.badge].h} decoding="async" />
                </a>
              ) : (
                <a class="btn btn-secondary jn-btn" href={s.href} rel="noopener" data-apple-join={s.href.includes('testflight.apple.com') ? '' : undefined}>{s.cta}<span aria-hidden="true" class="jn-arrow">→</span></a>
              )}
            </div>
          </li>
        ))}
        <li class="jn-step">
          <span class="jn-n mono" aria-hidden="true">03</span>
          <div class="jn-step-body">
            <h3 class="jn-step-h">Open Chere'</h3>
            <p class="jn-step-p">It shows a short key for your phone. That's the last step, below.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="jn-lane jn-lane-android" aria-labelledby="jn-and-h">
      <header class="jn-lane-head">
        <svg class="jn-glyph" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2" /><circle cx="12" cy="5.4" r=".6" /></svg>
        <div class="jn-lane-titles">
          <span class="jn-yours mono">YOUR PHONE</span>
          <h2 class="jn-lane-h" id="jn-and-h">Android</h2>
          <p class="jn-lane-sub mono">VIA GOOGLE PLAY</p>
        </div>
      </header>
      <ol class="jn-steps">
        {android.map((s, i) => (
          <li class="jn-step">
            <span class="jn-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="jn-step-body">
              <h3 class="jn-step-h">{s.h}</h3>
              <p class="jn-step-p">{s.p}</p>
              {ANDROID_LIVE ? (
                s.badge ? (
                  <a class="jn-badge" href={s.href} rel="noopener" aria-label={BADGES[s.badge].alt}>
                    <img src={BADGES[s.badge].src} alt={BADGES[s.badge].alt} width={BADGES[s.badge].w} height={BADGES[s.badge].h} decoding="async" />
                  </a>
                ) : (
                  <a class="btn btn-secondary jn-btn" href={s.href} rel="noopener">{s.cta}<span aria-hidden="true" class="jn-arrow">→</span></a>
                )
              ) : s.badge ? (
                <button type="button" class="jn-badge jn-badge-btn" popovertarget="jn-soon" aria-label={`${BADGES[s.badge].alt}, coming soon`}>
                  <img src={BADGES[s.badge].src} alt="" width={BADGES[s.badge].w} height={BADGES[s.badge].h} decoding="async" />
                </button>
              ) : (
                <button type="button" class="btn btn-secondary jn-btn" popovertarget="jn-soon">{s.cta}<span aria-hidden="true" class="jn-arrow">→</span></button>
              )}
            </div>
          </li>
        ))}
        <li class="jn-step">
          <span class="jn-n mono" aria-hidden="true">04</span>
          <div class="jn-step-body">
            <h3 class="jn-step-h">Open Chere'</h3>
            <p class="jn-step-p">It shows a short key for your phone. That's the last step, below.</p>
          </div>
        </li>
      </ol>
    </section>
  </div>

  {!ANDROID_LIVE && (
    <div id="jn-soon" popover class="jn-soon" role="dialog" aria-labelledby="jn-soon-h">
      <p class="jn-soon-eyebrow mono">ANDROID</p>
      <h2 class="jn-soon-h" id="jn-soon-h">Coming soon to Google Play.</h2>
      <p class="jn-soon-p">Google is reviewing Chere' for Android right now. Text me and I'll send you the link the day it's live.</p>
      <a href={smsAndroid} class="btn btn-primary jn-soon-btn">
        <span>Text Preston</span>
        <span class="jn-connect-num">{phoneDisplay}</span>
      </a>
      <button type="button" class="jn-soon-close" popovertarget="jn-soon" popovertargetaction="hide">Close</button>
    </div>
    <script is:inline>
      /* iOS Safari 15.6 to 16.x ignores the popover attribute: the note would sit open and Close would do
         nothing. Where togglePopover is missing, the same buttons drive a data-open fallback. */
      (function () {
        var box = document.getElementById('jn-soon');
        if (!box || typeof box.togglePopover === 'function') return;
        var last = null;
        function openBox(from) {
          last = from;
          box.setAttribute('data-open', '');
          var c = box.querySelector('.jn-soon-close');
          if (c) c.focus();
        }
        function closeBox() {
          if (!box.hasAttribute('data-open')) return;
          box.removeAttribute('data-open');
          if (last && last.focus) last.focus();
        }
        var triggers = document.querySelectorAll('[popovertarget="jn-soon"]');
        for (var i = 0; i < triggers.length; i++) {
          triggers[i].addEventListener('click', function (e) {
            var t = e.currentTarget;
            if (t.getAttribute('popovertargetaction') === 'hide') closeBox();
            else openBox(t);
          });
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBox(); });
        document.addEventListener('click', function (e) {
          if (box.hasAttribute('data-open') && !box.contains(e.target) && !e.target.closest('[popovertarget="jn-soon"]')) closeBox();
        });
      })();
    </script>
  )}

  <div id="jn-apple" popover class="jn-soon" role="dialog" aria-label="Join on iPhone or iPad">
    <p class="jn-soon-eyebrow mono">IPHONE AND IPAD</p>
    <p class="jn-soon-p">Chere' for iPhone and iPad installs through TestFlight. Open this page on your iPhone or iPad to join.</p>
    <button type="button" class="jn-soon-close" data-apple-close>Close</button>
  </div>
  <script is:inline>
    /* On a device that is not an iPhone, iPad or Mac the TestFlight page can only say "open this on your
       iPhone", so the Join button opens this note instead. Script off, or an Apple device: the link works as is.
       Where togglePopover is missing (iOS Safari 15.6 to 16.x), data-open drives the same box. */
    (function () {
      var box = document.getElementById('jn-apple');
      var link = document.querySelector('[data-apple-join]');
      if (!box || !link || document.documentElement.dataset.apple === '1') return;
      var native = typeof box.showPopover === 'function';
      var closeBtn = box.querySelector('[data-apple-close]');
      function isOpen() { return native ? box.matches(':popover-open') : box.hasAttribute('data-open'); }
      function openBox() {
        if (native) box.showPopover(); else box.setAttribute('data-open', '');
        if (closeBtn) closeBtn.focus();
      }
      function closeBox() {
        if (!isOpen()) return;
        if (native) box.hidePopover(); else box.removeAttribute('data-open');
        link.focus();
      }
      link.addEventListener('click', function (e) { e.preventDefault(); openBox(); });
      if (closeBtn) closeBtn.addEventListener('click', closeBox);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeBox(); });
      document.addEventListener('click', function (e) {
        if (!native && box.hasAttribute('data-open') && !box.contains(e.target) && !e.target.closest('[data-apple-join]')) closeBox();
      });
    })();
  </script>

  <section class="jn-connect" aria-labelledby="jn-connect-h" data-textbar-hide>
    <div class="jn-connect-n mono" aria-hidden="true">LAST STEP</div>
    <h2 class="h2 jn-connect-h" id="jn-connect-h">Text me your phone's key.</h2>
    <p class="jn-connect-p">
      Chere' shows a short key the first time it opens. It isn't a password, so texting it is
      fine. I text back a one-time setup code for that phone, and you're connected to your
      business.
    </p>
    <a href={sms} class="btn btn-primary jn-connect-btn">
      <span>Text Preston</span>
      <span class="jn-connect-num">{phoneDisplay}</span>
    </a>
    <p class="jn-foot">
      Stuck on a step? <a href="/chere/support">Chere' support</a> has the details, and
      <a href="/chere/privacy">the privacy page</a> says what the app keeps.
    </p>
  </section>

  <section class="jn-video" aria-labelledby="jn-video-h">
    <h2 class="h2 jn-video-h" id="jn-video-h">See it work first.</h2>
    <p class="jn-video-p">A minute and a half: a kitchen photo becomes a priced estimate.</p>
    <div class="jn-player">
      <video
        controls
        playsinline
        preload="none"
        width="1280"
        height="720"
        poster={v('/work/chere-master-poster-1280.webp')}
        aria-label="Chere' video, 1 minute 32 seconds, with music. A kitchen photo becomes a priced estimate."
      >
        <source src={mediaUrl('chere-master.webm')} type="video/webm" />
        <source src={mediaUrl('chere-master.mp4')} type="video/mp4" />
      </video>
    </div>
  </section>
</BaseLayout>

