---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('coquille')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-coquille"
  title="Coquille Web Design · Sites from $1,750 · Winters Code"
  description="Custom websites for Coquille businesses, built for the valley's local searches. Hand-built in Bandon from $1,750. Text Preston at 541-551-0731."
  eyebrow="Locations · Coquille"
  h1="Web design in Coquille, Oregon."
  sub="Custom, fast, mobile-first websites for Coquille businesses, built for the searches the valley already makes."
  bgImage="/photo/local/towns/coquille"
  showcase
  heroFocal="center 46%"
  intro={[
    "Coquille is the heart of the valley and the Coos County seat. Its businesses serve a steady local base rather than tourist traffic, and showing up clearly for the everyday valley searches is <span class='hl-green'>where a good site earns its keep.</span>",
  ]}
  nearby="Nearby work: <a href='/work/grand-management'>Grand Management in Coos Bay</a>, rebuilt off WordPress into 50 bilingual pages."
/>
