---
import ServiceLayout from '../../components/templates/ServiceLayout.astro';
import { serviceBySlug, towns } from '../../lib/business';

const service = serviceBySlug('web-development')!;
const townLinks = towns.map((t) => ({ href: `/web-design-${t.slug}`, label: `${t.name}, OR`, sub: t.county }));
---

<ServiceLayout
  service={service}
  title="Web Development · Custom-Coded Sites · Winters Code"
  description="Custom web development for Oregon coast businesses. Astro, React, and edge functions. No WordPress, no page builders. Fast, secure, and yours to keep."
  eyebrow="Services · Web Development"
  h1="Custom code, not a plugin stack."
  sub="The engineering under the design. Astro, React, and edge functions, written for your site and no one else's."
  sub2="No WordPress. No page builders. No plugins to babysit."
  bgImage="/photo/local/rocky-cove"
  showcase
  heroFocal="center 55%"
  heroTextPos="top"
  intro={[
    "Web development is the part customers never see and always feel. It is why a page loads in under a second instead of five, why a form actually delivers, why the site does not fall over when a plugin auto-updates at 2 AM.",
    "It is custom code, end to end. <em>The person who builds it is the person who maintains it.</em> No offshore team, no junior you will never meet.",
  ]}
  includes={[
    { h: 'Modern stack', body: 'Astro and React for sites, with edge functions where the logic needs them. The same tools the fastest sites on the web are built on.' },
    { h: 'Real performance', body: 'Sub-second loads on rural LTE, around a 95 Lighthouse average across the sites I ship. Speed is engineered in, not bolted on.' },
    { h: 'Secure by default', body: 'HTTPS, HSTS, and the full header set behind it. Most local sites have HTTPS and nothing else.' },
    { h: 'Custom integrations', body: 'Stripe, booking systems, CRMs, your existing tools, wired together so they actually talk to each other.' },
    { h: 'Clean, owned codebase', body: 'No vendor lock-in. The code is yours, documented and handed over, hosted wherever you like.' },
    { h: 'Built to last', body: 'No plugin soup to rot. Fewer moving parts means fewer 2 AM breakages and a site that still runs years from now.' },
  ]}
  sections={[
    {
      heading: 'What "rented" actually costs',
      body: [
        'When I audited 169 Coos County small-business sites, <span class="stat">more than half</span> were renting their website from a platform. Every Squarespace site shared the same locked configuration. Every Wix site scored about the same as all the others. Templated software produces templated results.',
        'Custom code is the difference. It does exactly what your business needs instead of what a theme assumed, and there is no monthly fee just to keep your own site online. The result is concrete: around <span class="stat">95</span> on mobile, an <span class="hl-copper">A-plus</span> security grade, and <span class="hl-green">a site that still runs years from now.</span>',
      ],
    },
  ]}
  whyLink
  faq={[
    { q: 'What is wrong with WordPress?', a: 'For a brochure site, mostly speed and security. It is mass-produced software with plugins stacked on top, which means slower loads, a bigger attack surface, and updates that break things. Custom code avoids all three.' },
    { q: 'Can you work with my existing tools?', a: 'Yes. Integrations are core work: Stripe to QuickBooks, a booking calendar, a CRM, an email platform. If you already use it, I can wire your site into it.' },
    { q: 'Do I get the code?', a: 'Yes. The code and content are yours to keep. No platform charging a monthly fee just to keep your own site online.' },
    { q: 'Who maintains it after launch?', a: 'I do, if you want. Monthly care plans start at <span class="stat">$75/mo</span>. The person who wrote the code is the person who keeps it running.' },
  ]}
  relatedTitle="Development for businesses across the south coast"
  relatedIntro="Local pages for the towns I serve."
  relatedLinks={townLinks}
/>
