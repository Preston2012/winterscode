  @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 400; font-display: swap; src: url('/_fonts/gauge-poppins-400.woff2') format('woff2'); }
  @font-face { font-family: 'Poppins'; font-style: normal; font-weight: 600; font-display: swap; src: url('/_fonts/gauge-poppins-600.woff2') format('woff2'); }

  /* Paused or reduced: every ambient animation and transition stops and the page shows its still, complete state. */
