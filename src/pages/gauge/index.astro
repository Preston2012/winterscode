</style>

<style>
  .gz {
    --gz-display: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
    --gz-body: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    --gz-mono: 'JetBrains Mono', ui-monospace, monospace;
    --gz-teal: #2dd4bf;
    --gz-amber: #d4a72d;
    --gz-line: #1b2024;
    --gz-1: #e2e8f0;
    --gz-2: #94a3b8;
    --gz-3: #7b8aa0;
    display: grid;
    gap: 16px;
    padding: 8px 0 0;
    font-family: var(--gz-body);
    color: var(--gz-1);
    font-variant-numeric: tabular-nums;
  }
  .gz * { box-sizing: border-box; }
  .gz a { color: var(--gz-teal); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; display: inline-block; padding: 12px 2px; }
  .gz a:focus-visible { outline: 2px solid var(--gz-teal); outline-offset: 3px; border-radius: 2px; }

  .gz-stage {
    background: #000;
    border: 1px solid var(--gz-line);
    border-radius: 16px;
    padding: 28px 18px;
    min-width: 0;
  }
  @media (min-width: 740px) { .gz-stage { padding: 44px 36px; } }
  @media (min-width: 1024px) { .gz-stage { padding: 56px 56px; } }

  /* ── type ── */
  .gz-kicker { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gz-teal); margin: 0 0 12px; }
  .gz-h1 { font-family: var(--gz-display); font-weight: 400; font-size: clamp(40px, 9.5vw, 88px); line-height: 1.02; letter-spacing: -0.025em; margin: 0 0 20px; color: var(--gz-1); text-wrap: balance; }
  .gz-h2 { font-family: var(--gz-display); font-weight: 500; font-size: clamp(27px, 4.6vw, 42px); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 14px; color: var(--gz-1); text-wrap: balance; }
  .gz-h3 { font-family: var(--gz-display); font-weight: 500; font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 16px; color: var(--gz-1); }
  .gz-sub, .gz-lead { font-size: 16px; line-height: 1.7; color: var(--gz-2); margin: 0 0 18px; max-width: 58ch; }
  @media (min-width: 740px) { .gz-sub { font-size: 18px; } .gz-lead { font-size: 17px; } }
  .gz-text { font-size: 15px; line-height: 1.7; color: var(--gz-2); margin: 0; }
  .gz-mini { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--gz-3); }
  .gz-num { font-family: var(--gz-mono); font-size: 12px; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .gz-fig { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gz-3); margin: 10px 0 0; text-align: center; }
  .gz-fig--wide { margin-top: 24px; }
  .gz-head { margin-bottom: 28px; max-width: 760px; }

  /* ── hero ── */
  .gz-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    background:
      radial-gradient(circle at 78% 42%, rgba(45, 212, 191, 0.07), rgba(0, 0, 0, 0) 55%),
      #000;
  }
  @media (min-width: 880px) { .gz-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 40px; } }
  .gz-brandline { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; }
  .gz-wordmark { font-family: var(--gz-display); font-weight: 700; font-size: 18px; letter-spacing: 0.34em; color: var(--gz-teal); }
  .gz-status {
    display: inline-flex; align-items: flex-start; gap: 10px;
    margin: 6px 0 26px; padding: 12px 14px;
    border: 2px solid var(--gz-amber); border-radius: 10px;
    font-size: 14px; line-height: 1.5; color: var(--gz-1);
    max-width: 100%;
  }
  .gz-status strong { color: var(--gz-amber); font-weight: 600; }
  .gz-status-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--gz-amber); margin-top: 6px; }
  .gz-stats { display: flex; gap: 28px; margin: 0; flex-wrap: wrap; }
  .gz-stats div { min-width: 0; }
  .gz-stats dt { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gz-3); }
  .gz-stats dd { margin: 4px 0 0; font-family: var(--gz-display); font-weight: 500; font-size: 34px; color: var(--gz-teal); line-height: 1; }
  .gz-hero-dial { margin: 0; width: min(100%, 440px); justify-self: center; }

  /* ── ideas ── */
  .gz-ideas { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  @media (min-width: 900px) { .gz-ideas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gz-card { background: #0a0a0a; border: 1px solid var(--gz-line); border-radius: 12px; padding: 22px 18px; display: flex; flex-direction: column; min-width: 0; }
  @media (min-width: 740px) { .gz-card { padding: 28px 26px; } }
  .gz-visual { margin: 4px 0 20px; min-width: 0; }

  .gz-dials { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .gz-dialfig { margin: 0; text-align: center; min-width: 0; }
