  .gz-dialfig .gz-num { font-size: 18px; font-weight: 500; }
  .gz-dialfig .gz-mini { font-size: 10px; letter-spacing: 0.04em; }

  .gz-bars { display: grid; gap: 16px; }
  .gz-barlabel { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--gz-1); margin-bottom: 7px; }
  .gz-bar { display: block; width: 100%; height: 14px; }
  .gz-bar--strip { height: 28px; }
  .gz-axis { display: flex; justify-content: space-between; margin-top: 7px; font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gz-3); }

  .gz-braid svg { display: block; width: 100%; height: auto; }
  .gz-braidtags { display: flex; justify-content: space-between; font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 6px; }

  .gz-ladder { list-style: none; margin: 4px 0 20px; padding: 0; display: grid; gap: 10px; }
  .gz-rung { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; align-items: center; padding: 12px; border: 1px solid var(--gz-line); border-left: 2px solid var(--rc); border-radius: 10px; background: #000; }
  .gz-rung--emergency { border: 2px solid var(--rc); background: #12050a; }
  .gz-rung-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 0 6px; flex-wrap: wrap; }
  .gz-chip { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rt); border: 1px solid var(--rc); border-radius: 999px; padding: 3px 10px; }
  .gz-rung-time { color: var(--gz-1); }
  .gz-rung-line { margin: 0 0 6px; font-size: 14px; line-height: 1.5; color: var(--gz-1); }
  .gz-rung--emergency .gz-rung-line { font-weight: 600; }

  /* ── skies ── */
  .gz-states { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 640px) { .gz-states { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } }
  .gz-state { background: var(--sb); border: 1px solid var(--sbd); border-radius: 12px; padding: 16px 14px; display: flex; flex-direction: column; gap: 4px; min-height: 156px; min-width: 0; }
  .gz-state :global(svg) { margin-bottom: 8px; }
  .gz-state-name { font-family: var(--gz-display); font-weight: 500; font-size: 17px; color: var(--st); line-height: 1.2; }
  .gz-state-tag { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gz-2); }
  .gz-dots { margin-top: auto; padding-top: 12px; display: flex; gap: 6px; }
  .gz-dots i { display: block; width: 14px; height: 14px; border-radius: 50%; }
  .gz-state--aa { background: #0a0a0a; border: 2px solid var(--gz-line); }
  .gz-aa { font-family: var(--gz-display); font-weight: 700; font-size: 30px; color: var(--gz-teal); margin-bottom: 8px; line-height: 1; }
  .gz-state--aa .gz-state-name { color: var(--gz-1); }

  /* ── voice ── */
  .gz-voice { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 740px) { .gz-voice { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gz-quote { margin: 0; padding: 20px 18px; border-radius: 10px; border: 1px solid var(--gz-line); background: #0a0a0a; min-width: 0; }
  .gz-quote figcaption { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 10px; }
  .gz-quote blockquote { margin: 0; font-size: 16px; line-height: 1.6; color: var(--gz-1); }
  .gz-quote--good { border-color: rgba(45, 212, 191, 0.35); }
  .gz-quote--good figcaption { color: var(--gz-teal); }
  .gz-quote--doubt { border-color: rgba(212, 167, 45, 0.4); }
  .gz-quote--doubt figcaption { color: var(--gz-amber); }
  .gz-quote--alarm { border-color: rgba(168, 85, 247, 0.45); background: #0d0714; }
  .gz-quote--alarm figcaption { color: #c084fc; }
  .gz-quote--alarm blockquote { font-weight: 600; }
  .gz-quote--no figcaption { color: #f87171; }
  .gz-quote--no blockquote { color: var(--gz-3); text-decoration: line-through; text-decoration-color: rgba(239, 68, 68, 0.6); }

  /* ── promise ── */
  .gz-promise { margin: 0; display: grid; border-top: 1px solid var(--gz-line); }
  .gz-prow { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--gz-line); }
  @media (min-width: 740px) { .gz-prow { grid-template-columns: 220px minmax(0, 1fr); gap: 24px; align-items: baseline; } }
  .gz-prow dt { font-family: var(--gz-display); font-weight: 500; font-size: 22px; color: var(--gz-teal); }
  .gz-prow dd { margin: 0; font-size: 15px; line-height: 1.6; color: var(--gz-2); }

  /* ── data ── */
  .gz-data { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; align-items: start; }
  @media (min-width: 880px) { .gz-data { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; } }
  .gz-data-copy { display: grid; gap: 16px; }
  .gz-readout { margin: 0; border: 2px solid var(--gz-line); border-radius: 12px; padding: 18px; background: #0a0a0a; }
  .gz-readout figcaption { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gz-3); margin-bottom: 12px; }
  .gz-readout dl { margin: 0; display: grid; gap: 10px; }
  .gz-readout dl div { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .gz-readout dt { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gz-3); }
  .gz-readout dd { margin: 0; font-family: var(--gz-mono); font-size: 14px; color: var(--gz-1); overflow-wrap: anywhere; }
  .gz-ok { color: var(--gz-teal); }

  /* ── status ledger ── */
  .gz-ledger { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--gz-line); }
  .gz-lrow { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--gz-line); }
  @media (min-width: 740px) { .gz-lrow { grid-template-columns: 120px 160px minmax(0, 1fr); gap: 20px; align-items: baseline; } }
  .gz-lstate { font-family: var(--gz-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .gz-lrow--done .gz-lstate { color: var(--gz-teal); }
  .gz-lrow--under-way .gz-lstate { color: var(--gz-amber); }
  .gz-lrow--not-yet .gz-lstate { color: var(--gz-3); }
  .gz-lk { font-family: var(--gz-display); font-weight: 500; font-size: 18px; color: var(--gz-1); }
  .gz-lv { font-size: 15px; line-height: 1.6; color: var(--gz-2); }
  .gz-close { margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: var(--gz-2); }

  /* ───────────── motion and the live lab ───────────── */
  .gz-pausewrap { display: none; margin: 18px 0 0; }
  .gz-js .gz-pausewrap { display: block; }
  @media (prefers-reduced-motion: reduce) { .gz-js .gz-pausewrap { display: none; } }
  .gz-pause {
    font: 500 12px/1 var(--gz-mono); letter-spacing: 0.12em; text-transform: uppercase;
    min-height: 44px; padding: 0 18px; cursor: pointer;
    color: var(--gz-teal); background: #000; border: 2px solid var(--gz-teal); border-radius: 10px;
  }
  .gz-pause:focus-visible { outline: 2px solid var(--gz-1); outline-offset: 3px; }

  .gz-hero { position: relative; overflow: hidden; }
  .gz-hero > * { position: relative; z-index: 1; }
  .gz-hero > .gz-field { position: absolute; z-index: 0; inset: 0; pointer-events: none; }
  .gz-field i { position: absolute; inset: -25%; opacity: 0; background: radial-gradient(circle at 74% 42%, var(--fc) 0%, rgba(0, 0, 0, 0) 56%); }
  .gz-field i:first-child { opacity: 0.14; }
  @media (prefers-reduced-motion: no-preference) {
    .gz-field i { animation: gz-field 42s linear infinite; animation-delay: var(--fd); }
  }
  @keyframes gz-field { 0% { opacity: 0; } 5% { opacity: 0.15; } 16% { opacity: 0.15; } 22% { opacity: 0; } 100% { opacity: 0; } }

  .gz-breathe { opacity: 0.4; }
  @media (prefers-reduced-motion: no-preference) {
    .gz-breathe { animation: gz-breathe 5.5s ease-in-out infinite; }
  }
  @keyframes gz-breathe { 0%, 100% { opacity: 0.1; } 50% { opacity: 0.75; } }

  .gz-strand { stroke-dasharray: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .gz-js:not(.gz-still) .gz-draw:not(.gz-drawn) .gz-strand { stroke-dashoffset: 1; }
    .gz-js .gz-draw .gz-strand { transition: stroke-dashoffset 2.4s cubic-bezier(0.3, 0.6, 0.2, 1) calc(var(--i) * 0.14s); }
  }

  .gz-rung { position: relative; }
  .gz-rung::after { content: ''; position: absolute; inset: -1px; border-radius: 10px; border: 2px solid var(--rc); opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .gz-rung::after { animation: gz-rung 9s ease-in-out infinite; animation-delay: calc(var(--i) * 3s); }
  }
  @keyframes gz-rung { 0% { opacity: 0; } 8% { opacity: 1; } 30% { opacity: 1; } 38% { opacity: 0; } 100% { opacity: 0; } }

  .gz-panel { position: relative; border: 1px solid var(--gz-line); border-radius: 14px; overflow: hidden; background: #000; --pa: #fbbf24; }
  .gz-sky { position: absolute; inset: 0; }
  .gz-sky i { position: absolute; inset: 0; opacity: 0; }
  .gz-sky i.on { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .gz-sky i { transition: opacity 0.8s ease; } }
  .gz-panel-in { position: relative; padding: 18px 14px; }
  @media (min-width: 740px) { .gz-panel-in { padding: 26px 26px; } }
  .gz-ph { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .gz-ph p { margin: 0; }
  .gz-ph-state strong { font-family: var(--gz-display); font-weight: 500; font-size: 24px; margin-left: 8px; }
  .gz-acc { color: var(--pa); }
  @media (prefers-reduced-motion: no-preference) { .gz-acc { transition: color 0.8s ease; } }
  .gz-ph-clock { font-size: 14px; color: var(--gz-1); }

  .gz-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 640px) { .gz-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .gz-cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr); } }
  .gz-pc { background: rgba(0, 0, 0, 0.74); border: 1px solid var(--gz-line); border-radius: 12px; padding: 16px; margin: 0; min-width: 0; }
  .gz-pc-k { margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.14em; }
  .gz-pc--dial { display: flex; flex-direction: column; }
  .gz-pc--dial :global(svg) { width: 100%; max-width: 230px; margin: 0 auto; }
  .gz-pc--dial figcaption { text-align: center; margin-top: 8px; font-size: 12px; color: var(--gz-1); }
  .gz-pc-col { display: grid; gap: 12px; align-content: start; min-width: 0; }
  @media (min-width: 640px) and (max-width: 999px) { .gz-pc-col { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gz-cw { border-color: rgba(45, 212, 191, 0.4); }
  .gz-cw.gz-warn { border-color: rgba(212, 167, 45, 0.6); }
  .gz-cw-main { margin: 0 0 6px; font-family: var(--gz-display); font-weight: 500; font-size: 22px; line-height: 1.2; color: var(--gz-1); }
  .gz-cw-note { margin: 0; font-size: 12px; color: var(--gz-teal); }
  .gz-cw.gz-warn .gz-cw-note { color: #e0b53d; }
  .gz-pc--dial.gz-warn figcaption { color: #e0b53d; }

  .gz-dew-main { margin: 0 0 12px; display: flex; align-items: baseline; gap: 4px; flex-wrap: wrap; }
  .gz-dew-n { font-family: var(--gz-display); font-weight: 600; font-size: 34px; line-height: 1; color: var(--gz-1); font-variant-numeric: tabular-nums; }
  .gz-dew-u { font-family: var(--gz-mono); font-size: 13px; color: var(--gz-2); }
  .gz-dew-l { margin-left: 8px; font-family: var(--gz-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gz-1); }
  .gz-dewbar { position: relative; display: flex; height: 10px; border-radius: 5px; margin: 0 7px; }
  .gz-dewbar i { display: block; height: 100%; }
  .gz-dewbar i:first-of-type { border-radius: 5px 0 0 5px; }
  .gz-dewbar i:nth-of-type(4) { border-radius: 0 5px 5px 0; }
  .gz-dewmk { position: absolute; top: -7px; width: 4px; height: 24px; margin-left: -2px; background: var(--gz-1); border: 1px solid #000; border-radius: 2px; }
  @media (prefers-reduced-motion: no-preference) { .gz-dewmk { transition: left 0.6s cubic-bezier(0.34, 1.3, 0.64, 1); } }
  .gz-dewticks { position: relative; height: 16px; margin: 10px 7px 0; }
  .gz-dewticks span { position: absolute; transform: translateX(-50%); font-family: var(--gz-mono); font-size: 11px; color: var(--gz-2); }
  .gz-dewkey { margin: 8px 0 0; }

  .gz-tl { margin-top: 14px; background: rgba(0, 0, 0, 0.74); border: 1px solid var(--gz-line); border-radius: 12px; padding: 14px 14px 10px; }
  .gz-tlhead { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .gz-tl svg { display: block; width: 100%; height: auto; }
  .gz-tlrain { height: 56px; margin-top: 4px; }
  .gz-playhead { stroke: var(--pa); stroke-width: 1.6; }
  .gz-playdot { fill: var(--pa); stroke: #000; stroke-width: 2; }
  @media (prefers-reduced-motion: no-preference) { .gz-playhead, .gz-playdot { transition: stroke 0.8s ease, fill 0.8s ease; } }
  .gz-scrub { display: none; margin-top: 12px; }
  .gz-js .gz-scrub { display: block; }
  .gz-scrublabel { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--gz-1); margin-bottom: 4px; }
  .gz-range { -webkit-appearance: none; appearance: none; width: 100%; height: 44px; background: transparent; margin: 0; cursor: pointer; }
  .gz-range::-webkit-slider-runnable-track { height: 4px; background: #2a3138; border-radius: 2px; }
  .gz-range::-moz-range-track { height: 4px; background: #2a3138; border-radius: 2px; }
  .gz-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 28px; height: 28px; margin-top: -12px; border-radius: 50%; background: #000; border: 2px solid var(--gz-teal); }
  .gz-range::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: #000; border: 2px solid var(--gz-teal); }
  .gz-range:focus-visible { outline: 2px solid var(--gz-teal); outline-offset: 2px; border-radius: 8px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.gz');
  if (root) {
    root.classList.add('gz-js');
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let still = mq.matches;
    const btn = root.querySelector<HTMLButtonElement>('[data-gz-pause]');
    let kick = () => {};
    const setStill = (v: boolean) => {
      still = v;
      root.classList.toggle('gz-still', v);
      if (btn) {
        btn.setAttribute('aria-pressed', String(v));
        btn.textContent = v ? 'Resume motion' : 'Pause motion';
      }
      kick();
    };
    btn?.addEventListener('click', () => setStill(!still));
    mq.addEventListener('change', (e) => setStill(e.matches));

    // Timelines draw in once, when they scroll into view.
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('gz-drawn'); io.unobserve(e.target); } }),
      { threshold: 0.25 },
    );
    root.querySelectorAll('[data-draw]').forEach((d) => io.observe(d));

    const panel = root.querySelector<HTMLElement>('[data-gz-panel]');
    if (panel) {
      const D = JSON.parse(panel.dataset.series || '{}');
      const STEPS = D.s.length;
      const slider = panel.querySelector<HTMLInputElement>('.gz-range')!;
      const r = (k: string) => panel.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
      const layers = Array.from(panel.querySelectorAll<HTMLElement>('.gz-sky i'));
      const agFig = r('agree');
      const agSvg = agFig.querySelector<SVGElement>('.gz-dial')!;
      const agFills = Array.from(agSvg.querySelectorAll<SVGElement>('.gz-fill'));
      const agRead = agSvg.querySelector('.gz-read')!;
      const nc = panel.querySelector<SVGElement>('.gz-nc')!;
      const heads = Array.from(panel.querySelectorAll<SVGElement>('[data-ph]'));
      const cwCard = r('cwcard');

      const fmt = (t: number) => {
        const m = Math.round((D.start + t) * 60) % 1440;
        let h = Math.floor(m / 60);
        const mi = m % 60;
        const ap = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return `${h}:${String(mi).padStart(2, '0')} ${ap}`;
      };
      const off = (t: number) => {
        if (t === 0) return 'Now';
        const h = Math.floor(t);
        const m = Math.round((t - h) * 60);
        return `Now +${h} h${m ? ` ${m} m` : ''}`;
      };

      let cur = -1;
      const render = (i: number) => {
        if (i === cur) return;
        cur = i;
        const t = i / 4;
        const st = D.s[i];
        const a = D.a[i];
        const p = D.p;

        layers.forEach((l, k) => l.classList.toggle('on', k === st));
        r('state').textContent = D.st[st].n;
        panel.style.setProperty('--pa', D.st[st].c);
        r('clock').textContent = fmt(t);
        r('offset').textContent = off(t);

        // Agreement dial: arc, needle, grain and colour all follow the number.
        const warn = a < 65;
        agSvg.style.setProperty('--v', String(a));
        agSvg.style.setProperty('--na', `${135 + (a / 100) * 270}deg`);
        agSvg.style.setProperty('--c', warn ? '#d4a72d' : '#2dd4bf');
        agFills.forEach((f) => {
          if (f.classList.contains('gz-breathe')) { (f as unknown as HTMLElement).style.display = warn ? '' : 'none'; return; }
          const g = warn ? 'url(#gz-g2)' : a < 80 ? 'url(#gz-g1)' : '';
          if (g) f.setAttribute('filter', g); else f.removeAttribute('filter');
        });
        agRead.textContent = `${a}%`;
        r('agree-note').textContent = warn ? 'Leads with the doubt' : a < 80 ? 'Holds, with some grain' : 'States it cleanly';
        agFig.classList.toggle('gz-warn', warn);

        // Nowcast Pulse: minutes until rain reaches 50 percent, looking two hours ahead.
        let mins = -1;
        if (p[i] >= 50) mins = 0;
        else for (let k = i + 1; k <= Math.min(STEPS - 1, i + 8); k++) if (p[k] >= 50) { mins = (k - i) * 15; break; }
        const num = nc.querySelector('[data-r="nc-num"]')!;
        const cap = nc.querySelector('[data-r="nc-cap"]')!;
        if (mins === 0) { num.textContent = 'NOW'; cap.textContent = 'RAIN OCCURRING'; nc.style.setProperty('--v', '0'); r('nc-note').textContent = 'Rain is occurring now'; }
        else if (mins > 0) { num.textContent = String(mins); cap.textContent = 'MIN UNTIL RAIN'; nc.style.setProperty('--v', String((mins / 120) * 100)); r('nc-note').textContent = `Rain in ${mins} minutes`; }
        else { num.textContent = '2 H+'; cap.textContent = 'NO RAIN IN 2 H'; nc.style.setProperty('--v', '100'); r('nc-note').textContent = 'No rain in the next 2 hours'; }

        // Next Clean Window: the first dry run of an hour or more, within 12 hours.
        let found: { s: number; e: number } | null = null;
        let k = i;
        while (k < STEPS) {
          if (p[k] < 30) {
            let e = k;
            while (e < STEPS && p[e] < 30) e++;
            if (e - k >= 4) { found = { s: k, e }; break; }
            k = e;
          } else k++;
        }
        if (!found || (found.s - i) / 4 > 12) {
          const tail = STEPS - 1 - i < 48;
          r('cw').textContent = tail ? 'Past the end of the range' : 'No clean window in the next 12 hours';
          r('cwn').textContent = tail ? 'Fewer than 12 hours left' : 'Rain holds on';
          cwCard.classList.remove('gz-warn');
        } else {
          let sum = 0;
          for (let q = found.s; q < found.e; q++) sum += D.a[q];
          const conf = Math.round(sum / (found.e - found.s));
          const dur = (found.e - found.s) / 4;
          r('cw').textContent = found.e >= STEPS && dur >= 18
            ? 'Clear for 18+ hours'
            : `${found.s === i ? 'Now' : fmt(found.s / 4)} to ${found.e >= STEPS ? 'the end of the range' : fmt(found.e / 4)}`;
          r('cwn').textContent = conf < 65 ? `${conf}% agreement. May shift` : `${conf}% agreement`;
          cwCard.classList.toggle('gz-warn', conf < 65);
        }

        // Dew point comfort scale, 40 to 80 F.
        const d = D.d[i];
        r('dew').textContent = String(Math.round(d));
        r('dewlab').textContent = d <= 55 ? 'Comfortable' : d < 65 ? 'Humid' : d < 70 ? 'Sticky' : 'Oppressive';
        r('dewmk').style.left = `${Math.min(100, Math.max(0, ((d - 40) / 40) * 100))}%`;

        // Playhead on both timelines (600 unit axis).
        const x = (t / 48) * 600;
        heads.forEach((h) => {
          if (h.dataset.ph === 'dot') h.setAttribute('cx', x.toFixed(1));
          else { h.setAttribute('x1', x.toFixed(1)); h.setAttribute('x2', x.toFixed(1)); }
        });
        slider.setAttribute('aria-valuetext', `${off(t)}, ${fmt(t)}, ${D.st[st].n}`);
      };

      // A gentle autoplay until the reader takes over, paused when off screen or when motion is paused.
      let visible = false;
      let touched = false;
      let raf = 0;
      let pos = 0;
      let hold = 0;
      let last = 0;
      const frame = (ts: number) => {
        raf = 0;
        if (!visible || still || touched) { last = 0; return; }
        if (!last) last = ts;
        const dt = Math.min(100, ts - last);
        last = ts;
        if (hold > 0) { hold -= dt; if (hold <= 0) pos = 0; }
        else { pos += dt * (192 / 30000); if (pos >= 192) { pos = 192; hold = 2500; } }
        const i = Math.round(pos);
        if (i !== cur) { slider.value = String(i); render(i); }
        raf = requestAnimationFrame(frame);
      };
      kick = () => { if (!raf && visible && !still && !touched) raf = requestAnimationFrame(frame); };

      slider.addEventListener('input', () => { touched = true; pos = Number(slider.value); render(pos); });
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; last = 0; kick(); }, { threshold: 0.15 }).observe(panel);
      render(0);
    }

    setStill(mq.matches);
  }
</script>
