---
/**
 * /gauge, Gauge's own page inside the Winters Code frame (S429, Preston 2026-11-18 12:06 PT:
 * "have you guys made a page for gauge yet? ... For now it gets a page on my website but it
 * will need its own website").
 *
 * STATE: built and previewed privately. It stays noindex, out of the nav and out of the sitemap
 * until Preston approves it, because the app is being rebuilt and the name "Gauge" and the
 * feature names are not cleared yet.
 *
 * COPY RULE. Say what Gauge is being built to do. Never that a feature exists today. No
 * trademark symbols on the feature names (their clearance is not done). Every figure drawn on
 * this page is an illustration and is labelled as one. There are no download buttons and no
 * store badges, because there is nothing to download.
 *
 * BRAND. Gauge's own locked brand, not the site's: true black canvas, teal #2dd4bf for the
 * interactive and the confident, amber #d4a72d for disagreement, Space Grotesk, Poppins and
 * JetBrains Mono with tabular figures, the 270 degree arc, uncertainty shown as texture, seven
 * atmospheric states, the Flight Engineer voice. Zero shadows, 2px interactive borders. Every
 * visual is built in code (SVG and CSS) from the brand, with no stock images and no screenshots
 * of the current app. No scripts at all, so the repo's CSP has nothing to hash here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import MobileMenu from '../../components/layout/MobileMenu.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ArcMark from '../../components/gauge/ArcMark.astro';
import ArcDial from '../../components/gauge/ArcDial.astro';
import GrainDefs from '../../components/gauge/GrainDefs.astro';
import NowcastDial from '../../components/gauge/NowcastDial.astro';
import { breadcrumbSchema } from '../../lib/schema';

const path = '/gauge';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Gauge', path },
];

const TEAL = '#2dd4bf';
const AMBER = '#d4a72d';
const VIOLET = '#a855f7';
const CRIMSON = '#ef4444';

// ── The braid: seven forecast strands on one time axis. They share a path where the sources
// agree and fan out where they split. Pure arithmetic, computed once at build time.
const W = 600;
const H = 200;
const offsets = [-1, -0.64, -0.3, 0, 0.32, 0.66, 1];
const xs = Array.from({ length: 61 }, (_, i) => (i / 60) * W);
const centre = (t: number) => 104 + 20 * Math.sin(t * 5.4) - 12 * t;
const spread = (t: number) => 1.5 + 66 * Math.pow(t, 1.75);
const strandY = (k: number, t: number) =>
  centre(t) + spread(t) * (offsets[k] * 0.92 + 0.24 * Math.sin(t * 9.5 + k * 1.9) * t);
const strands = offsets.map((_, k) =>
  xs.map((x, i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${strandY(k, x / W).toFixed(1)}`).join(' '),
);
const upper = xs.map((x) => `${x.toFixed(1)} ${(centre(x / W) - spread(x / W) * 1.05).toFixed(1)}`);
const lower = xs.map((x) => `${x.toFixed(1)} ${(centre(x / W) + spread(x / W) * 1.05).toFixed(1)}`).reverse();
const envelope = `M${upper.join(' L')} L${lower.join(' L')} Z`;

// ── Twelve hourly cells whose grain rises as the forecast frays.
const hours = Array.from({ length: 12 }, (_, i) => ({
  grain: (i < 3 ? 0 : i < 6 ? 1 : i < 9 ? 2 : 3) as 0 | 1 | 2 | 3,
  color: i < 6 ? TEAL : AMBER,
}));

// ── Three dials for idea 01. Below 65 percent agreement the arc turns amber and grainy.
const dials = [
  { v: 0.94, color: TEAL, grain: 0 as const, num: '94%', note: 'States it cleanly' },
  { v: 0.71, color: TEAL, grain: 1 as const, num: '71%', note: 'Holds, with some grain' },
  { v: 0.48, color: AMBER, grain: 2 as const, num: '48%', note: 'Leads with the doubt' },
];

// ── The alert ladder.
const ladder = [
  {
    key: 'watch',
    name: 'Watch',
    color: AMBER,
    text: '#d4a72d',
    v: 0.82,
    time: '3 H 10 M',
    line: 'Storm conditions possible this afternoon. Winds near 30 mph by 4 PM.',
    voice: 'Flight Engineer',
  },
  {
    key: 'warning',
    name: 'Warning',
    color: VIOLET,
    text: '#c084fc',
    v: 0.38,
    time: '0 H 38 M',
    line: 'Severe storm moving northeast at 28 mph. Gusts to 60 mph. Arrival 38 minutes.',
    voice: 'Flight Engineer',
  },
  {
    key: 'emergency',
    name: 'Emergency',
    color: CRIMSON,
    text: '#f87171',
    v: 0.08,
    time: '0 H 04 M',
    line: 'Tornado warning. Take shelter now. Go to an interior room on the lowest floor.',
    voice: 'Air Traffic Controller',
  },
];

// ── The seven atmospheric states, from the locked brand brief.
const states = [
  { name: 'Clear Sky', tag: 'Warm gold', accent: '#fbbf24', text: '#fbbf24', bg: 'linear-gradient(135deg,#1a1400 0%,#0f0f0f 40%,#0a0f12 100%)', border: 'rgba(251,191,36,0.22)', dots: ['#fbbf24', '#f59e0b', '#d97706'] },
  { name: 'Overcast', tag: 'Cool steel', accent: '#94a3b8', text: '#aab6c6', bg: 'linear-gradient(135deg,#0f1218 0%,#0a0a0a 40%,#0d1017 100%)', border: 'rgba(148,163,184,0.2)', dots: ['#cbd5e1', '#94a3b8', '#64748b'] },
  { name: 'Rain', tag: 'Electric indigo', accent: '#818cf8', text: '#818cf8', bg: 'linear-gradient(135deg,#0a0a1a 0%,#0a0a0f 40%,#0f0a1f 100%)', border: 'rgba(129,140,248,0.25)', dots: ['#818cf8', '#6366f1', '#4f46e5'] },
  { name: 'Severe Storm', tag: 'Violet charge', accent: '#a855f7', text: '#c084fc', bg: 'linear-gradient(135deg,#12050f 0%,#0a0a0a 30%,#0a051a 100%)', border: 'rgba(168,85,247,0.28)', dots: ['#c084fc', '#a855f7', '#7c3aed'] },
  { name: 'Snow', tag: 'Frozen cyan', accent: '#22d3ee', text: '#22d3ee', bg: 'linear-gradient(135deg,#0a1015 0%,#0a0a0f 40%,#0f1520 100%)', border: 'rgba(34,211,238,0.22)', dots: ['#a5f3fc', '#22d3ee', '#0891b2'] },
  { name: 'Extreme Heat', tag: 'Warm ember', accent: '#ef6a50', text: '#ef6a50', bg: 'linear-gradient(135deg,#1a0a05 0%,#0f0a0a 40%,#150505 100%)', border: 'rgba(239,106,80,0.26)', dots: ['#ef6a50', '#ef4444', '#dc2626'] },
  { name: 'Clear Night', tag: 'Deep indigo', accent: '#6366f1', text: '#a5b4fc', bg: 'linear-gradient(135deg,#050510 0%,#000005 40%,#03030f 100%)', border: 'rgba(129,140,248,0.2)', dots: ['#6366f1', '#4338ca', '#312e81'] },
];

const promise = [
  { k: 'Free', v: 'Every feature, for everyone. There is no paid tier and no trial.' },
  { k: 'Open source', v: 'Anyone can read the code and check how a forecast was made.' },
  { k: 'No ads', v: 'Not now and not later. Nothing on the screen is there to sell you something.' },
  { k: 'No accounts', v: 'Nothing to sign up for. You open it and it works.' },
  { k: 'No tracking', v: 'Gauge is not built to follow you or to build a profile of you.' },
];

const ledger = [
  { s: 'Done', k: 'Designed', v: 'The mark, the dial, the seven skies and the voice are locked.' },
  { s: 'Done', k: 'Specified', v: 'Each feature is written down with the data it needs and where that data comes from.' },
  { s: 'Under way', k: 'Being built', v: 'The app, rebuilt to match the design.' },
  { s: 'Not yet', k: 'Released', v: 'No download, no store listing and no public release.' },
];

// ── The scrub: 48 invented hours in 15 minute steps. Every value below is made up for the
// illustration and the page says so. The page script reads this and drives the palette, the
// agreement dial, the rain countdown, the clean window and the dew point from one clock.
const START_HOUR = 13;
const STEPS = 193;
const gauss = (t: number, m: number, sd: number, a: number) => a * Math.exp(-((t - m) ** 2) / (2 * sd * sd));
const series = { s: [] as number[], p: [] as number[], a: [] as number[], d: [] as number[] };
for (let i = 0; i < STEPS; i++) {
  const t = i / 4;
  const pr = Math.min(0.98, 0.04 + gauss(t, 7.5, 1.1, 0.85) + gauss(t, 22, 2.2, 0.9) + gauss(t, 33, 1.5, 0.6));
  const clock = (START_HOUR + t) % 24;
  const night = clock >= 20.5 || clock < 6;
  const cloud = (t > 3.5 && t < 11) || (t > 17 && t < 30) || (t > 31 && t < 36);
  let st = 0;
  if (pr > 0.45) st = t > 20.5 && t < 24.5 && pr > 0.6 ? 3 : 2;
  else if (cloud) st = 1;
  else st = night ? 6 : 0;
  const dip = gauss(t, 22, 3, 0.14) + gauss(t, 7.5, 1.5, 0.06);
  const a = Math.max(0.36, Math.min(0.97, 0.97 - 0.5 * Math.pow(t / 48, 1.15) - dip + 0.02 * Math.sin(t * 1.7)));
  const d = 50 + 7 * Math.sin((t / 48) * Math.PI * 1.4) + 12 * pr + (night ? -1.5 : 0);
  series.s.push(st);
  series.p.push(Math.round(pr * 100));
  series.a.push(Math.round(a * 100));
  series.d.push(Math.round(d * 10) / 10);
}
const seriesJson = JSON.stringify({
  ...series,
  start: START_HOUR,
  st: states.map((s) => ({ n: s.name, c: s.text })),
});

// Hourly rain bars under the braid. Grain level follows agreement: sure bars are smooth teal,
// unsure ones are grainy amber.
const rainBars = Array.from({ length: 49 }, (_, h) => {
  const i = Math.min(STEPS - 1, h * 4);
  const pct = series.p[i];
  const ag = series.a[i];
  const grain = (ag >= 80 ? 0 : ag >= 65 ? 1 : ag >= 50 ? 2 : 3) as 0 | 1 | 2 | 3;
  const hh = Math.max(2, (pct / 100) * 46);
  return { x: (h / 48) * W - 4.5, y: 52 - hh, h: hh, grain, color: ag >= 65 ? TEAL : AMBER };
});
---

<BaseLayout
  title="Gauge · A Forecast Instrument, In Development · Winters Code"
  description="Gauge is a free, open source weather app being built to show how sure a forecast is. No ads, no accounts, no tracking. In development."
  canonicalPath={path}
  ogImage={null}
  noindex={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(crumbs))} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <div class="gz">
    <GrainDefs />

    <!-- ───────────── Hero ───────────── -->
    <section class="gz-stage gz-hero" aria-labelledby="gz-h1">
      <div class="gz-field" aria-hidden="true">
        {states.map((s, i) => (<i style={`--fc:${s.accent};--fd:${-i * 6}s`}></i>))}
      </div>
      <div class="gz-hero-copy">
        <p class="gz-brandline">
          <ArcMark size={34} />
          <span class="gz-wordmark">GAUGE</span>
        </p>
        <p class="gz-kicker">A precision atmospheric instrument</p>
        <h1 class="gz-h1" id="gz-h1">Weather, measured.</h1>
        <p class="gz-sub">
          Gauge is being built to show how sure a forecast is, not only what it says. Numbers first.
          Uncertainty stated plainly.
        </p>
        <p class="gz-status">
          <span class="gz-status-dot" aria-hidden="true"></span>
          <span><strong>In development.</strong> Nothing to download yet, and no store listing.</span>
        </p>
        <dl class="gz-stats">
          <div><dt>Ads</dt><dd>0</dd></div>
          <div><dt>Accounts</dt><dd>0</dd></div>
          <div><dt>Trackers</dt><dd>0</dd></div>
        </dl>
        <p class="gz-pausewrap">
          <button type="button" class="gz-pause" data-gz-pause aria-pressed="false">Pause motion</button>
        </p>
      </div>
      <figure class="gz-hero-dial">
        <ArcDial
          value={0.92}
          readout="92%"
          caption="MODEL AGREEMENT"
          animate={true}
          label="Illustration of the Gauge dial: an arc filled to 92 percent, labelled model agreement."
        />
        <figcaption class="gz-fig">Illustration. Not live data.</figcaption>
      </figure>
    </section>

    <!-- ───────────── Four ideas ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-ideas-h">
      <header class="gz-head">
        <p class="gz-kicker">01 / What it is</p>
        <h2 class="gz-h2" id="gz-ideas-h">A weather app designed like an instrument.</h2>
        <p class="gz-lead">
          Most weather apps hand you one number and a cartoon sun. Gauge is being built around four
          ideas that show how much to trust the number.
        </p>
      </header>

      <div class="gz-ideas">
        <!-- 1. The arc -->
        <article class="gz-card" aria-labelledby="gz-i1">
          <p class="gz-kicker">Idea 1 · The arc</p>
          <h3 class="gz-h3" id="gz-i1">Agreement you can read at a glance.</h3>
          <div class="gz-visual gz-dials">
            {dials.map((d) => (
              <figure class="gz-dialfig">
                <ArcDial
                  value={d.v}
                  color={d.color}
                  grain={d.grain}
                  ticks={false}
                  breathe={d.grain === 2}
                  label={`Example dial at ${d.num} agreement.`}
                />
                <figcaption>
                  <span class="gz-num" style={`color:${d.color}`}>{d.num}</span>
                  <span class="gz-mini">{d.note}</span>
                </figcaption>
              </figure>
            ))}
          </div>
          <p class="gz-text">
            Every forecast gets a dial, and the arc fills as the sources agree. Above 65 percent it
            stays teal. Below that it turns amber and Gauge leads with the doubt.
          </p>
        </article>

        <!-- 2. Honest uncertainty -->
        <article class="gz-card" aria-labelledby="gz-i2">
          <p class="gz-kicker">Idea 2 · Honest uncertainty</p>
          <h3 class="gz-h3" id="gz-i2">Doubt shows up as texture.</h3>
          <div class="gz-visual gz-bars">
            <div class="gz-barrow">
              <div class="gz-barlabel"><span>Rain at 3 PM</span><span class="gz-num" style={`color:${TEAL}`}>92% agree</span></div>
              <svg class="gz-bar" viewBox="0 0 300 14" preserveAspectRatio="none" role="img" aria-label="A smooth teal bar: high agreement.">
                <rect width="300" height="14" rx="3" fill="#12171b" />
                <rect width="276" height="14" rx="3" fill={TEAL} />
              </svg>
            </div>
            <div class="gz-barrow">
              <div class="gz-barlabel"><span>Tomorrow</span><span class="gz-num" style={`color:${AMBER}`}>3 of 6 say rain</span></div>
              <svg class="gz-bar" viewBox="0 0 300 14" preserveAspectRatio="none" role="img" aria-label="A grainy amber bar: the sources disagree.">
                <rect width="300" height="14" rx="3" fill="#12171b" />
                <rect width="150" height="14" rx="3" fill={AMBER} filter="url(#gz-g2)" />
                <rect class="gz-breathe" width="150" height="14" rx="3" fill={AMBER} filter="url(#gz-g3)" />
              </svg>
            </div>
            <div class="gz-barrow">
              <div class="gz-barlabel"><span>Next 12 hours</span><span class="gz-mini">Fraying with distance</span></div>
              <svg class="gz-bar gz-bar--strip" viewBox="0 0 300 26" preserveAspectRatio="none" role="img" aria-label="Twelve hourly cells, smooth teal at first and increasingly grainy amber toward the end.">
                {hours.map((h, i) => (
                  <rect x={i * 25 + 1} y="0" width="23" height="26" rx="2" fill={h.color} filter={h.grain ? `url(#gz-g${h.grain})` : undefined} />
                ))}
                {hours.map((h, i) => (h.grain >= 2 ? <rect class="gz-breathe" x={i * 25 + 1} y="0" width="23" height="26" rx="2" fill={h.color} filter="url(#gz-g3)" /> : null))}
              </svg>
              <div class="gz-axis"><span>Now</span><span>+6 h</span><span>+12 h</span></div>
            </div>
          </div>
          <p class="gz-text">
            A sure forecast is a smooth fill. An unsure one breaks into grain, so you feel the
            confidence before you read a number. The same texture runs through bars, timelines and
            ribbons.
          </p>
        </article>

        <!-- 3. One timeline -->
        <article class="gz-card" aria-labelledby="gz-i3">
          <p class="gz-kicker">Idea 3 · The aligned timeline</p>
          <h3 class="gz-h3" id="gz-i3">Every source on one clock.</h3>
          <div class="gz-visual gz-braid">
            <div class="gz-braidtags" aria-hidden="true"><span style={`color:${TEAL}`}>Sources agree</span><span style={`color:${AMBER}`}>Sources split</span></div>
            <svg class="gz-draw" data-draw viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Seven forecast strands on one time axis. They braid into a single thin line at the start and fan out toward the end.">
              <defs>
                <linearGradient id="gz-braid-g" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color={TEAL} />
                  <stop offset="0.45" stop-color={TEAL} />
                  <stop offset="1" stop-color={AMBER} />
                </linearGradient>
                <linearGradient id="gz-braid-e" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color={TEAL} stop-opacity="0" />
                  <stop offset="0.5" stop-color={AMBER} stop-opacity="0.04" />
                  <stop offset="1" stop-color={AMBER} stop-opacity="0.34" />
                </linearGradient>
              </defs>
              {[0, 1, 2, 3, 4].map((i) => (
                <line x1={i * 150} y1="8" x2={i * 150} y2={H - 8} stroke="#1b2024" stroke-width="1" />
              ))}
              <path d={envelope} fill="url(#gz-braid-e)" filter="url(#gz-g2)" />
              <path class="gz-breathe" d={envelope} fill="url(#gz-braid-e)" filter="url(#gz-g3)" />
              {strands.map((d, i) => (
                <path class="gz-strand" pathLength="1" style={`--i:${i}`} d={d} fill="none" stroke="url(#gz-braid-g)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              ))}
            </svg>
            <div class="gz-axis"><span>Now</span><span>+12 h</span><span>+24 h</span><span>+36 h</span><span>+48 h</span></div>
          </div>
          <p class="gz-text">
            Forecast sources are drawn as strands on a single time axis. Where they agree, the
            strands braid into one thin line. Where they split, the line frays, and its width is the
            disagreement.
          </p>
        </article>

        <!-- 4. The alert ladder -->
        <article class="gz-card" aria-labelledby="gz-i4">
          <p class="gz-kicker">Idea 4 · The alert ladder</p>
          <h3 class="gz-h3" id="gz-i4">Escalation that sounds like it.</h3>
          <ol class="gz-visual gz-ladder">
            {ladder.map((r, i) => (
              <li class={`gz-rung gz-rung--${r.key}`} style={`--rc:${r.color};--rt:${r.text};--i:${i}`}>
                <div class="gz-rung-dial">
                  <ArcDial value={r.v} color={r.color} ticks={false} label={`Countdown dial, ${r.name.toLowerCase()} rung, ${r.time.replace(/ /g, '')}.`} />
                </div>
                <div class="gz-rung-body">
                  <p class="gz-rung-top">
                    <span class="gz-chip">{r.name}</span>
                    <span class="gz-num gz-rung-time">{r.time}</span>
                  </p>
                  <p class="gz-rung-line">{r.line}</p>
                  <p class="gz-mini">Voice: {r.voice}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="gz-text">
            Alerts climb three rungs: watch, warning, emergency. Each has its own color, its own
            countdown and its own voice. At the top rung the screen is taken over and the wording
            turns imperative.
          </p>
        </article>
      </div>
      <p class="gz-fig gz-fig--wide">Illustrations. Every figure and sentence above is an example, not live data.</p>
    </section>

    <!-- ───────────── The lab: one clock drives everything ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-lab-h">
      <header class="gz-head">
        <p class="gz-kicker">02 / Try the instrument</p>
        <h2 class="gz-h2" id="gz-lab-h">One clock. Everything follows it.</h2>
        <p class="gz-lead">
          This is how Gauge is meant to read a single forecast. Drag through 48 hours and the palette,
          the agreement dial, the rain countdown, the dry window and the dew point all move together.
          The numbers are invented for the illustration. Nothing here is a forecast.
        </p>
      </header>

      <div class="gz-panel" data-gz-panel data-series={seriesJson}>
        <div class="gz-sky" aria-hidden="true">
          {states.map((s, i) => (<i class:list={[{ on: i === 0 }]} style={`background:${s.bg}`}></i>))}
        </div>
        <div class="gz-panel-in">
          <div class="gz-ph">
            <p class="gz-ph-state"><span class="gz-mini">Sky</span> <strong class="gz-acc" data-r="state">Clear Sky</strong></p>
            <p class="gz-num gz-ph-clock"><span data-r="clock">1:00 PM</span> <span class="gz-mini">·</span> <span data-r="offset">Now</span></p>
          </div>

          <div class="gz-cards">
            <figure class="gz-pc gz-pc--dial" data-r="agree">
              <p class="gz-mini gz-pc-k">Forecast agreement</p>
              <ArcDial
                value={0.97}
                readout="97%"
                caption="MODEL AGREEMENT"
                live={true}
                breathe={true}
                label="Illustration of the agreement dial. Its value follows the scrubber below."
              />
              <figcaption class="gz-num" data-r="agree-note">States it cleanly</figcaption>
            </figure>

            <figure class="gz-pc gz-pc--dial">
              <p class="gz-mini gz-pc-k">Nowcast Pulse</p>
              <NowcastDial label="Illustration of the rain countdown dial for the next two hours. Its value follows the scrubber below." value={1} minutes="2 H+" />
              <figcaption class="gz-num" data-r="nc-note">No rain in the next 2 hours</figcaption>
            </figure>

            <div class="gz-pc-col">
              <div class="gz-pc gz-cw" data-r="cwcard">
                <p class="gz-mini gz-pc-k">Next clean window</p>
                <p class="gz-cw-main" data-r="cw">Now to 7:00 PM</p>
                <p class="gz-num gz-cw-note" data-r="cwn">95% agreement</p>
              </div>
              <div class="gz-pc gz-dew">
                <p class="gz-mini gz-pc-k">Dew point comfort</p>
                <p class="gz-dew-main"><span class="gz-dew-n" data-r="dew">51</span><span class="gz-dew-u">°F</span> <span class="gz-dew-l" data-r="dewlab">Comfortable</span></p>
                <div class="gz-dewbar" role="img" aria-label="Dew point scale from 40 to 80 degrees Fahrenheit. Comfortable up to 55, humid up to 65, sticky up to 70, oppressive above 70.">
                  <i style="flex:15;background:#2dd4bf"></i><i style="flex:10;background:#d4a72d"></i><i style="flex:5;background:#ef6a50"></i><i style="flex:10;background:#ef4444"></i>
                  <b class="gz-dewmk" data-r="dewmk" style="left:27.5%"></b>
                </div>
                <div class="gz-dewticks" aria-hidden="true"><span style="left:0">40</span><span style="left:37.5%">55</span><span style="left:62.5%">65</span><span style="left:75%">70</span><span style="left:100%">80</span></div>
                <p class="gz-mini gz-dewkey">55 comfortable · 65 sticky · 70+ oppressive</p>
              </div>
            </div>
          </div>

          <div class="gz-tl">
            <div class="gz-tlhead"><span class="gz-mini">Next 48 hours</span><span class="gz-mini">Teal is sure, amber grain is not</span></div>
            <svg class="gz-draw gz-tlbraid" data-draw viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Seven forecast strands on one 48 hour axis. They braid thin at the start and fan out later. A marker shows the time you chose.">
              <defs>
                <linearGradient id="gz-pb-g" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color={TEAL} /><stop offset="0.45" stop-color={TEAL} /><stop offset="1" stop-color={AMBER} />
                </linearGradient>
                <linearGradient id="gz-pb-e" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color={TEAL} stop-opacity="0" /><stop offset="0.5" stop-color={AMBER} stop-opacity="0.04" /><stop offset="1" stop-color={AMBER} stop-opacity="0.34" />
                </linearGradient>
              </defs>
              {[0, 1, 2, 3, 4].map((i) => (<line x1={i * 150} y1="8" x2={i * 150} y2={H - 8} stroke="#1b2024" stroke-width="1" />))}
              <path d={envelope} fill="url(#gz-pb-e)" filter="url(#gz-g2)" />
              <path class="gz-breathe" d={envelope} fill="url(#gz-pb-e)" filter="url(#gz-g3)" />
              {strands.map((d, i) => (<path class="gz-strand" pathLength="1" style={`--i:${i}`} d={d} fill="none" stroke="url(#gz-pb-g)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />))}
              <line class="gz-playhead" data-ph="line" x1="0" x2="0" y1="4" y2={H - 4} />
              <circle class="gz-playdot" data-ph="dot" cx="0" cy="12" r="5" />
            </svg>
            <svg class="gz-tlrain" viewBox="0 0 600 56" preserveAspectRatio="none" role="img" aria-label="Hourly chance of rain across the 48 hours. Sure hours are smooth teal bars, unsure hours are grainy amber.">
              {rainBars.map((b) => (<rect x={b.x.toFixed(1)} y={b.y.toFixed(1)} width="9" height={b.h.toFixed(1)} rx="1.5" fill={b.color} filter={b.grain ? `url(#gz-g${b.grain})` : undefined} />))}
              <line class="gz-playhead" data-ph="line" x1="0" x2="0" y1="0" y2="56" />
            </svg>
            <div class="gz-axis"><span>Now</span><span>+12 h</span><span>+24 h</span><span>+36 h</span><span>+48 h</span></div>
            <div class="gz-scrub">
              <label for="gz-scrub" class="gz-scrublabel">Scrub the 48 hours <span class="gz-mini">Arrow keys move 15 minutes</span></label>
              <input id="gz-scrub" class="gz-range" type="range" min="0" max="192" step="1" value="0" aria-valuetext="Now, 1:00 PM, Clear Sky" />
            </div>
          </div>
        </div>
      </div>
      <p class="gz-fig gz-fig--wide">Illustration. Invented numbers, drawn in your browser. Not a forecast.</p>
    </section>

    <!-- ───────────── Seven skies ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-states-h">
      <header class="gz-head">
        <p class="gz-kicker">03 / The sky sets the palette</p>
        <h2 class="gz-h2" id="gz-states-h">Seven skies, one instrument.</h2>
        <p class="gz-lead">
          The whole interface takes its color from the conditions outside and crossfades between
          seven states. Saturation is capped, and every state is meant to hold WCAG AA contrast, so
          the mood never costs legibility.
        </p>
      </header>
      <ul class="gz-states">
        {states.map((s) => (
          <li class="gz-state" style={`--sb:${s.bg};--sbd:${s.border};--st:${s.text}`}>
            <ArcMark size={30} color={s.accent} />
            <span class="gz-state-name">{s.name}</span>
            <span class="gz-state-tag">{s.tag}</span>
            <span class="gz-dots" aria-hidden="true">
              {s.dots.map((d) => (<i style={`background:${d}`}></i>))}
            </span>
          </li>
        ))}
        <li class="gz-state gz-state--aa">
          <span class="gz-aa" aria-hidden="true">AA</span>
          <span class="gz-state-name">Contrast floor</span>
          <span class="gz-state-tag">Tested in every state</span>
        </li>
      </ul>
    </section>

    <!-- ───────────── Voice ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-voice-h">
      <header class="gz-head">
        <p class="gz-kicker">04 / The voice</p>
        <h2 class="gz-h2" id="gz-voice-h">The Flight Engineer.</h2>
        <p class="gz-lead">
          Precise, calm and never prescriptive. Numbers first, context second, and doubt said out
          loud. In an emergency the voice becomes an air traffic controller: still exact, now
          imperative.
        </p>
      </header>
      <div class="gz-voice">
        <figure class="gz-quote gz-quote--good">
          <figcaption>Says it cleanly</figcaption>
          <blockquote>Rain at 3 PM. 92% model agreement.</blockquote>
        </figure>
        <figure class="gz-quote gz-quote--doubt">
          <figcaption>Leads with the doubt</figcaption>
          <blockquote>Models split on tomorrow. Three say dry, three say rain. This forecast will change.</blockquote>
        </figure>
        <figure class="gz-quote gz-quote--alarm">
          <figcaption>Takes over when it matters</figcaption>
          <blockquote>Take shelter now. Go to an interior room on the lowest floor.</blockquote>
        </figure>
        <figure class="gz-quote gz-quote--no">
          <figcaption>Never this</figcaption>
          <blockquote>Looks like a rainy one, better grab that umbrella!</blockquote>
        </figure>
      </div>
    </section>

    <!-- ───────────── Promise + data ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-promise-h">
      <header class="gz-head">
        <p class="gz-kicker">05 / The promise</p>
        <h2 class="gz-h2" id="gz-promise-h">Free, open and private.</h2>
        <p class="gz-lead">
          These are commitments for the finished app, not features you can use today. Gauge is to be
          funded by donations and grants, so nobody has to be the product.
        </p>
      </header>
      <dl class="gz-promise">
        {promise.map((p) => (
          <div class="gz-prow">
            <dt>{p.k}</dt>
            <dd>{p.v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="gz-stage" aria-labelledby="gz-data-h">
      <header class="gz-head">
        <p class="gz-kicker">06 / Where the numbers come from</p>
        <h2 class="gz-h2" id="gz-data-h">Every number says where it came from.</h2>
      </header>
      <div class="gz-data">
        <div class="gz-data-copy">
          <p class="gz-text">
            Gauge starts on the US National Weather Service, whose data is open and free to use for
            any purpose. Each figure is meant to carry its source and its age, so you can judge how
            fresh it is.
          </p>
          <p class="gz-text">
            Comparing several forecast sources, and scoring how often each one is right, comes
            later. Every new source is checked against its terms of use before it goes in.
          </p>
        </div>
        <figure class="gz-readout">
          <figcaption>Example readout</figcaption>
          <dl>
            <div><dt>Source</dt><dd>National Weather Service</dd></div>
            <div><dt>Issued</dt><dd class="gz-num">42 minutes ago</dd></div>
            <div><dt>Status</dt><dd><span class="gz-ok">Current</span></dd></div>
          </dl>
        </figure>
      </div>
    </section>

    <!-- ───────────── Status ───────────── -->
    <section class="gz-stage" aria-labelledby="gz-status-h">
      <header class="gz-head">
        <p class="gz-kicker">07 / Where Gauge stands</p>
        <h2 class="gz-h2" id="gz-status-h">In development, and saying so.</h2>
        <p class="gz-lead">
          The design is locked and the app is being rebuilt to match it. Until it does, there is
          nothing to install.
        </p>
      </header>
      <ol class="gz-ledger">
        {ledger.map((l) => (
          <li class={`gz-lrow gz-lrow--${l.s.toLowerCase().replace(' ', '-')}`}>
            <span class="gz-lstate">{l.s}</span>
            <span class="gz-lk">{l.k}</span>
            <span class="gz-lv">{l.v}</span>
          </li>
        ))}
      </ol>
      <p class="gz-close">
        Questions about Gauge? <a href="/contact">Get in touch</a>. Built in Bandon, Oregon, by Winters Code.
      </p>
    </section>
  </div>
</BaseLayout>

<style is:global>
