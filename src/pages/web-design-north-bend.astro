---
import LocationPage from '../components/templates/LocationPage.astro';
import { serviceBySlug, townBySlug } from '../lib/business';
const town = townBySlug('north-bend')!;
const service = serviceBySlug('web-design')!;
---
<LocationPage
  town={town}
  service={service}
  path="/web-design-north-bend"
  title="Web Design in North Bend, OR · Winters Code"
  description="Custom web design in North Bend, Oregon. Fast, mobile-first websites built to catch travelers searching before they arrive. No templates, no WordPress."
  eyebrow="Locations · North Bend"
  h1="Web design in North Bend, Oregon."
  sub="Custom, fast, mobile-first websites for North Bend businesses. Built to catch travelers the moment they search."
  bgImage="/photo/local/towns/north-bend"
  showcase
  heroFocal="center 42%"
  heroTextPos="top"
  intro={[
    "North Bend runs on travelers: the airport, the casino, the shops along the highway. A lot of those customers are searching on a phone before they ever arrive, so <span class='hl-green'>a fast website that answers in seconds is the whole game.</span>",
  ]}
/>
