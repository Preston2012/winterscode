---
/**
 * Seam. S339, Preston 2026-11-21: "04 into 01, 02 and 03, into 05... none of
 * that makes sense." The quiet break between two sections: a copper hairline
 * that fades at both ends with one rivet at the center. No number, no button.
 * It sits inside the page's measure, so it never runs wider than the text.
 *
 * S453 motion: the seam welds. As it scrolls in, the rivet sets first with a
 * flash of heat, then the hairline runs out from it to both ends. Pure CSS on
 * a view timeline, so it is tied to the reader's scroll, costs no script, and
 * a browser without scroll timelines (or a reader who asked for less motion)
 * sees the finished seam.
 */
---

<div class="seam" aria-hidden="true"><i class="seam-line"></i><span></span></div>

<style>
  .seam {
    position: relative;
    max-width: var(--home-max, 1120px);
    height: 1px;
    margin: 0 auto;
    padding: 0;
  }
  .seam-line {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(216, 144, 90, 0.32) 20%, rgba(216, 144, 90, 0.5) 50%, rgba(216, 144, 90, 0.32) 80%, transparent);
  }
  .seam span {
    position: absolute; left: 50%; top: 50%;
    width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f6c39c, #c47b45 55%, #8a5430);
    box-shadow: 0 0 0 4px var(--color-bg-deep);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .seam-line {
        transform-origin: 50% 50%;
        animation: seam-run linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 10% cover 35%;
      }
      .seam span {
        animation: seam-set linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 0% cover 20%;
      }
    }
  }
  @keyframes seam-run {
    from { transform: scaleX(0); opacity: 0.4; }
    to { transform: scaleX(1); opacity: 1; }
  }
  @keyframes seam-set {
    0% { transform: scale(0); box-shadow: 0 0 0 4px var(--color-bg-deep), 0 0 0 0 rgba(246, 195, 156, 0); }
    55% { transform: scale(1.9); box-shadow: 0 0 0 4px var(--color-bg-deep), 0 0 18px 6px rgba(246, 165, 100, 0.55); }
    100% { transform: scale(1); box-shadow: 0 0 0 4px var(--color-bg-deep), 0 0 0 0 rgba(246, 195, 156, 0); }
  }
</style>
