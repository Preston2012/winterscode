---
/**
 * PaintPour: wet paint pouring off the top edge of a card image.
 *
 * Built for the Makai Painting card (S339), whose own site paints itself in
 * and hangs drips off its bands. The markup is the finished pour, so with no
 * JavaScript, with reduced motion, or without IntersectionObserver the card
 * simply shows the drips standing still. With all three, the script rewinds
 * the pour and plays it when the card scrolls into view: the band slides in,
 * each drip runs down at its own speed, and one bead keeps dropping off the
 * longest drip. Hovering the card stretches the drips a little further.
 *
 * Geometry is seeded (mulberry32), so every build draws the same pour, and
 * the viewBox is 600 wide, half the 1200x630 card art, so the drips read at
 * card size: short drips over the words on the left, long runs over the photo.
 */
interface Props {
  seed?: number;
  color?: string;
  /** Left share of the card that carries words; drips stay short there. */
  textEdge?: number;
}
const { seed = 20261019, color = '#e81068', textEdge = 310 } = Astro.props;

function rng(s: number) {
  return () => {
    s |= 0; s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const BAND = 6;
type Drip = { x: number; w: number; len: number; bulb: number; t: number; delay: number };
const drips: Drip[] = [];
let x = 5;
while (x < 596) {
  const overPhoto = x > textEdge;
  const w = 4 + r() * 4;
  const max = overPhoto ? 150 : 15;
  const min = overPhoto ? 14 : 4;
  const long = r() < (overPhoto ? 0.45 : 0.2);
  const len = min + (long ? (max - min) * (0.55 + r() * 0.45) : (max - min) * r() * 0.42);
  drips.push({
    x: +x.toFixed(1),
    w: +w.toFixed(1),
    len: +len.toFixed(1),
    bulb: +(w * (0.95 + r() * 0.5)).toFixed(1),
    // Longer runs take longer, the way heavy paint does, with a little jitter.
    t: Math.round(700 + len * 9 + r() * 500),
    delay: Math.round(140 + r() * 520),
  });
  x += 11 + r() * 22;
}
const longest = drips.reduce((a, b) => (b.len > a.len ? b : a));
const wave = rng(seed + 7);
let edge = `M0 0 H600 V${BAND}`;
for (let ex = 600; ex >= 0; ex -= 12) {
  edge += ` L${ex} ${(BAND + Math.sin(ex / 18) * 1.1 + (wave() - 0.5) * 1.4).toFixed(1)}`;
}
edge += ' Z';
const dropY = +(BAND + longest.len + longest.bulb * 0.6).toFixed(1);
const dropDelay = longest.delay + longest.t + 400;
---
<svg
  class="pour"
  viewBox="0 0 600 300"
  preserveAspectRatio="xMidYMin meet"
  aria-hidden="true"
  focusable="false"
  data-pour
>
  <g class="pour-band">
    <path d={edge} fill={color} />
    {drips.map((d) => (
      <ellipse cx={d.x} cy={BAND} rx={(d.w * 1.4).toFixed(1)} ry={(d.w * 0.9).toFixed(1)} fill={color} />
    ))}
  </g>
  {drips.map((d) => (
    <g class="pour-drip" style={`--len:${d.len};--t:${d.t}ms;--delay:${d.delay}ms`}>
      <rect class="pour-stem" x={(d.x - d.w / 2).toFixed(1)} y={BAND - 2} width={d.w} height={(d.len + 2).toFixed(1)} rx={(d.w / 2).toFixed(1)} fill={color} />
      <rect class="pour-stem pour-hl" x={(d.x - d.w / 2 + d.w * 0.22).toFixed(1)} y={BAND + 2} width={(d.w * 0.18).toFixed(2)} height={Math.max(d.len - 4, 1).toFixed(1)} rx={(d.w * 0.09).toFixed(2)} fill="#fff" />
      <g class="pour-bulb">
        <ellipse cx={d.x} cy={(BAND + d.len - d.bulb * 0.25).toFixed(1)} rx={d.bulb} ry={(d.bulb * 1.18).toFixed(1)} fill={color} />
        <ellipse cx={(d.x - d.bulb * 0.35).toFixed(1)} cy={(BAND + d.len - d.bulb * 0.55).toFixed(1)} rx={(d.bulb * 0.22).toFixed(2)} ry={(d.bulb * 0.32).toFixed(2)} fill="#fff" opacity="0.35" />
      </g>
    </g>
  ))}
  <ellipse
    class="pour-drop"
    style={`--delay:${dropDelay}ms`}
    cx={longest.x}
    cy={dropY}
    rx={(longest.bulb * 0.72).toFixed(1)}
    ry={(longest.bulb * 0.9).toFixed(1)}
    fill={color}
  />
</svg>

<script>
  const els = document.querySelectorAll<SVGElement>('[data-pour]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting && en.intersectionRatio >= 0.35) {
            en.target.classList.add('is-pouring');
            io.unobserve(en.target);
          }
        }
      },
      { threshold: [0, 0.35] },
    );
    els.forEach((el) => {
      el.classList.add('pour-armed');
      io.observe(el);
    });
  }
</script>

<style>
  .pour {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
  .pour-hl { opacity: 0.28; }
  .pour-drip,
  .pour-stem {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }
  .pour-drip { transition: transform 900ms cubic-bezier(0.3, 0.7, 0.2, 1); }
  .pour-drop { opacity: 0; transform-box: fill-box; transform-origin: 50% 0; }

  /* Armed: the script has rewound the pour and is waiting for the card. */
  .pour.pour-armed .pour-band { transform: translateY(-12px); }
  .pour.pour-armed .pour-stem { transform: scaleY(0); }
  .pour.pour-armed .pour-bulb { transform: translateY(calc(var(--len) * -1px)); }

  /* Pouring. */
  .pour.is-pouring .pour-band { animation: pour-band 320ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .pour.is-pouring .pour-stem { animation: pour-stem var(--t) cubic-bezier(0.55, 0.05, 0.3, 1) var(--delay) both; }
  .pour.is-pouring .pour-bulb { animation: pour-bulb var(--t) cubic-bezier(0.55, 0.05, 0.3, 1) var(--delay) both; }
  .pour.is-pouring .pour-drop { animation: pour-drop 5200ms ease-in var(--delay) infinite; }

  @keyframes pour-band { from { transform: translateY(-12px); } to { transform: translateY(0); } }
  @keyframes pour-stem { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes pour-bulb {
    from { transform: translateY(calc(var(--len) * -1px)); }
    to { transform: translateY(0); }
  }
  /* A bead swells at the tip of the longest run, lets go and falls away. */
  @keyframes pour-drop {
    0% { opacity: 0; transform: translateY(-4px) scale(0.2); }
    14% { opacity: 1; transform: translateY(0) scale(1); }
    30% { opacity: 1; transform: translateY(2px) scale(1, 1.12); }
    58% { opacity: 0; transform: translateY(150px) scale(0.85, 1.3); }
    100% { opacity: 0; transform: translateY(150px) scale(0.85, 1.3); }
  }

  /* The card under the pointer gets a little more paint. */
  @media (hover: hover) {
    :global(a:hover) .pour-drip { transform: scaleY(1.09); }
  }
  :global(a:focus-visible) .pour-drip { transform: scaleY(1.09); }

  @media (prefers-reduced-motion: reduce) {
    .pour-drip { transition: none; }
    .pour-drop { animation: none !important; opacity: 0; }
  }
</style>
