---
/**
 * Icon. Line icons for Home's four doors and four values, drawn for this
 * page on one 24px grid, one stroke weight, round caps. Decorative: the label
 * beside each one carries the meaning.
 */
interface Props { name: 'web' | 'apps' | 'brand' | 'auto' | 'keep' | 'all' | 'lock' | 'found'; size?: number; class?: string }
const { name, size = 24, class: cls = '' } = Astro.props;
---
<svg class:list={['wc-icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'web' && <><rect x="3" y="4.5" width="18" height="15" rx="2.8" /><path d="M3 9h18" /><circle cx="6.2" cy="6.8" r=".6" fill="currentColor" /><circle cx="8.4" cy="6.8" r=".6" fill="currentColor" /><path d="M7 13h6M7 15.8h10" /></>}
  {name === 'apps' && <><rect x="6.5" y="2.8" width="11" height="18.4" rx="2.8" /><path d="M10.5 17.6h3" /><path d="M9.5 7.5h5M9.5 10.5h3.5" /></>}
  {name === 'brand' && <><circle cx="12" cy="12" r="8.6" /><circle cx="12" cy="12" r="5.6" stroke-dasharray="1.2 2.1" /><path d="M9.4 10.2l1.2 4 1.4-3.2 1.4 3.2 1.2-4" /></>}
  {name === 'auto' && <><path d="M19.2 9.2A7.6 7.6 0 0 0 5.6 7.6" /><path d="M4.8 14.8a7.6 7.6 0 0 0 13.6 1.6" /><path d="M5.2 3.8v4.2h4.2" /><path d="M18.8 20.2V16h-4.2" /><circle cx="12" cy="12" r="1.6" /></>}
  {name === 'keep' && <><circle cx="8" cy="12" r="3.8" /><path d="M11.8 12H20.5M17.4 12v3M20.5 12v2.4" /></>}
  {name === 'all' && <><rect x="3.8" y="3.8" width="16.4" height="16.4" rx="3.2" /><path d="M8.2 12.4l2.6 2.6 5-5.6" /></>}
  {name === 'lock' && <><path d="M12 2.9l7.4 3v5.6c0 4.5-3.1 7.9-7.4 9.6-4.3-1.7-7.4-5.1-7.4-9.6V5.9z" /><circle cx="12" cy="10.6" r="1.7" /><path d="M12 12.3v3.4" /></>}
  {name === 'found' && <><circle cx="10.6" cy="10.6" r="6.4" /><path d="M15.4 15.4l4.8 4.8" /><path d="M10.6 7.8v5.6M7.8 10.6h5.6" /></>}
</svg>
