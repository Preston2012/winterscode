---
/**
 * Divider, the break between two sections on every reading page.
 *
 * S339, Preston 2026-11-21: "Cut unneeded numbers. 04 into 01, 02 and 03,
 * into 05... none of that makes sense." The numbered bezel, the dashed inner
 * ring and the return-to-top button are gone. What stays is the house seam:
 * a copper hairline that fades at both ends with one rivet at the center,
 * with less air around it so pages run shorter.
 *
 * label and ariaLabel are still accepted so the 80 existing call sites keep
 * building; neither renders. The divider is decoration and is hidden from
 * assistive tech.
 */
interface Props {
  label?: string;
  ariaLabel?: string;
}
---

<div class="divider" aria-hidden="true"><span></span></div>

<style>
  .divider {
    position: relative;
    height: 1px;
    margin: 24px 0;
    background: linear-gradient(90deg, transparent, rgba(216, 144, 90, 0.32) 20%, rgba(216, 144, 90, 0.5) 50%, rgba(216, 144, 90, 0.32) 80%, transparent);
  }
  @media (min-width: 740px) { .divider { margin: 32px 0; } }
  @media (min-width: 1024px) { .divider { margin: 40px 0; } }
  .divider span {
    position: absolute; left: 50%; top: 50%;
    width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f6c39c, #c47b45 55%, #8a5430);
    box-shadow: 0 0 0 4px var(--color-bg-deep);
  }
</style>
