---
/**
 * CardMotion: one signature movement per homepage card, drawn from the
 * client's own mark (S339, Preston). Siblings of the card art inside
 * .sw-preview; every overlay shares the art's 1200x630 space and uses
 * `slice`, the SVG twin of the image's object-fit: cover, so a beam or a
 * sight lands on the same pixel at every width.
 *
 *   lighthouse  Bandon By The Dunes: the lantern of their lighthouse mark
 *               turns, its beam sweeping out right, through the viewer (a
 *               flare at the lantern) and out left, every few seconds.
 *   flag        US Survey Supply: a slow wave of light travels across the
 *               flag folds (overlay blend, so it reads as cloth moving),
 *               and the red-and-white survey target is sighted once: a ring
 *               and four corner ticks close in on it and lock.
 *   lawn        SeaBreeze: one mower pass lays fresh-cut stripes across the
 *               green field around the logo panel (the panel itself is
 *               masked out), then the stripes simply stay, like a lawn.
 *   pins        Grand Management: a ring goes out from the Park Avenue office
 *               and each town's pin answers in turn, nearest first, out to
 *               Prineville: one office reaching every community it manages.
 *
 * Rules: motion only while the card is on screen (paused off screen, so
 * phones do no work for cards nobody sees), transforms and opacity only,
 * nothing at all under prefers-reduced-motion or without JavaScript: the
 * card is then exactly its art.
 */
interface Props { kind: 'lighthouse' | 'flag' | 'lawn' | 'pins' }
const { kind } = Astro.props;
// Measured on the card art (bbtd-card.webp, taylor-card.webp), 1200x630.
const LANTERN = { x: 574, y: 98 };
const TARGET = { x: 475.5, y: 178.5, r: 42 };
// Sixteen 40-unit mowing stripes across the 1200-wide art.
const STRIPES = Array.from({ length: 16 }, (_, k) => ({ x: k * 80 - 40, dark: k % 2 === 1 }));
// Measured on grand-card.webp, 1200x630: the office and the fourteen town
// pins, nearest the office first. Each pin answers after a delay that grows
// with its distance from the office.
const OFFICE = { x: 671.6, y: 385.1 };
const PINS: [number, number][] = [
  [671.6, 385.1], [659.4, 407.2], [676.4, 412], [726.7, 398.6], [653.8, 440.1],
  [726.1, 325.5], [658.5, 469.8], [680.8, 292.3], [707.4, 491.2], [667.2, 500.8],
  [733.5, 255.2], [695, 201.9], [775, 229], [885.1, 303.5],
];
const pinDelay = ([x, y]: [number, number]) =>
  (0.35 + Math.hypot(x - OFFICE.x, y - OFFICE.y) * 0.0065).toFixed(2);
---
{kind === 'lighthouse' && (
  <svg class="cm cm-lighthouse" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-card-motion>
    <defs>
      <linearGradient id="cm-beam" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffe7a3" stop-opacity="0.95" />
        <stop offset="0.45" stop-color="#f6c75a" stop-opacity="0.38" />
        <stop offset="1" stop-color="#f6c75a" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="cm-glow">
        <stop offset="0" stop-color="#fff6d6" stop-opacity="1" />
        <stop offset="0.35" stop-color="#ffd978" stop-opacity="0.75" />
        <stop offset="1" stop-color="#ffd978" stop-opacity="0" />
      </radialGradient>
    </defs>
    <polygon class="cm-beam" points={`${LANTERN.x},${LANTERN.y - 5} ${LANTERN.x + 600},${LANTERN.y - 78} ${LANTERN.x + 600},${LANTERN.y + 78} ${LANTERN.x},${LANTERN.y + 5}`} fill="url(#cm-beam)" />
    <circle class="cm-flare" cx={LANTERN.x} cy={LANTERN.y} r="46" fill="url(#cm-glow)" />
    <circle class="cm-lamp" cx={LANTERN.x} cy={LANTERN.y} r="11" fill="url(#cm-glow)" />
  </svg>
)}

{kind === 'flag' && (
  <>
    <svg class="cm cm-flag-sheen" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-card-motion>
      <defs>
        <linearGradient id="cm-fold" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.5" stop-color="#fff6ea" stop-opacity="0.34" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="cm-flag-edge" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0.40" stop-color="#fff" stop-opacity="0" />
          <stop offset="0.55" stop-color="#fff" stop-opacity="1" />
        </linearGradient>
        <mask id="cm-flag-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="565">
          <rect x="0" y="0" width="1200" height="565" fill="url(#cm-flag-edge)" />
        </mask>
      </defs>
      <g mask="url(#cm-flag-mask)">
        <rect class="cm-fold" x="-320" y="-200" width="320" height="1030" fill="url(#cm-fold)" />
        <rect class="cm-fold cm-fold-2" x="-240" y="-200" width="240" height="1030" fill="url(#cm-fold)" />
      </g>
    </svg>
    <svg class="cm cm-sight" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-card-motion>
      <g class="cm-sight-g">
        <circle class="cm-ring" cx={TARGET.x} cy={TARGET.y} r={TARGET.r + 8} fill="none" stroke="#fff" stroke-width="3" />
        {[[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([sx, sy], i) => (
          <path
            class="cm-tick"
            style={`--sx:${sx};--sy:${sy}`}
            d={`M${TARGET.x + sx * 58} ${TARGET.y + sy * 36} L${TARGET.x + sx * 58} ${TARGET.y + sy * 58} L${TARGET.x + sx * 36} ${TARGET.y + sy * 58}`}
            fill="none" stroke="#ff5a4f" stroke-width="4" stroke-linecap="square"
          />
        ))}
        <path class="cm-cross" d={`M${TARGET.x - 70} ${TARGET.y} H${TARGET.x - 50} M${TARGET.x + 50} ${TARGET.y} H${TARGET.x + 70} M${TARGET.x} ${TARGET.y - 70} V${TARGET.y - 50} M${TARGET.x} ${TARGET.y + 50} V${TARGET.y + 70}`} stroke="#fff" stroke-width="3" />
      </g>
    </svg>
  </>
)}

{kind === 'lawn' && (
  <svg class="cm cm-lawn" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-card-motion>
    <defs>
      <mask id="cm-lawn-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="630">
        <rect x="0" y="0" width="1200" height="630" fill="#fff" />
        <rect x="312" y="98" width="576" height="306" rx="18" fill="#000" />
      </mask>
      <linearGradient id="cm-blade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#d6ffe8" stop-opacity="0" />
        <stop offset="0.7" stop-color="#d6ffe8" stop-opacity="0.35" />
        <stop offset="1" stop-color="#f2fff8" stop-opacity="0.75" />
      </linearGradient>
    </defs>
    <g mask="url(#cm-lawn-mask)">
      <g class="cm-cut">
        {STRIPES.map((st) => (
          <rect x={st.x} y="0" width="40" height="630" class={st.dark ? 'cm-stripe-d' : 'cm-stripe-l'} />
        ))}
      </g>
      <rect class="cm-mower" x="-60" y="0" width="60" height="630" fill="url(#cm-blade)" />
    </g>
  </svg>
)}

{kind === 'pins' && (
  <svg class="cm cm-pins" viewBox="0 0 1200 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-card-motion>
    <circle class="cm-reach" cx={OFFICE.x} cy={OFFICE.y} r="14" fill="none" stroke="#f4efe6" stroke-width="2" />
    {PINS.map((pin) => (
      <circle class="cm-pin" cx={pin[0]} cy={pin[1]} r="7" fill="none" stroke="#e7cc95" stroke-width="2.4" style={`--d:${pinDelay(pin)}s`} />
    ))}
  </svg>
)}

<script>
  const els = document.querySelectorAll<SVGElement>('[data-card-motion]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        const el = en.target as SVGElement;
        if (en.isIntersecting) {
          el.classList.add('cm-on');
          if (!el.classList.contains('cm-played')) el.classList.add('cm-play');
        } else {
          el.classList.remove('cm-on');
          if (el.classList.contains('cm-play')) el.classList.add('cm-played');
        }
      }
    }, { threshold: 0.4 });
    els.forEach((el) => { el.classList.add('cm-armed'); io.observe(el); });
  }
</script>

<style>
  .cm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    display: none;
  }
  /* Only a page whose script armed it shows anything at all. */
  .cm.cm-armed { display: block; }
  .cm * { animation-play-state: paused; }
  .cm.cm-on * { animation-play-state: running; }

  /* ── Lighthouse ── */
  .cm-beam, .cm-flare {
    transform-box: view-box;
    transform-origin: 574px 98px;
  }
  .cm-beam { opacity: 0.9; animation: cm-sweep 7.2s linear infinite; }
  .cm-flare { opacity: 0; animation: cm-flare 7.2s linear infinite; }
  .cm-lamp { opacity: 0.8; }
  @keyframes cm-sweep {
    0%   { transform: scaleX(1); opacity: 0.85; }
    22%  { transform: scaleX(0.04); opacity: 0.5; }
    25%  { transform: scaleX(0.001); opacity: 0; }
    28%  { transform: scaleX(-0.04); opacity: 0.5; }
    50%  { transform: scaleX(-1); opacity: 0.85; }
    72%  { transform: scaleX(-0.04); opacity: 0.25; }
    75%  { transform: scaleX(-0.001); opacity: 0; }
    78%  { transform: scaleX(0.04); opacity: 0.25; }
    100% { transform: scaleX(1); opacity: 0.85; }
  }
  /* Facing the viewer at 25%: the flare. Facing away at 75%: nothing. */
  @keyframes cm-flare {
    0%, 18%, 32%, 100% { opacity: 0; transform: scale(0.6); }
    25% { opacity: 1; transform: scale(1.25); }
  }

  /* ── Flag ── */
  .cm-flag-sheen { mix-blend-mode: screen; }
  .cm-fold {
    transform-box: view-box;
    transform-origin: 0 0;
    transform: translateX(560px) skewX(-14deg);
    opacity: 0;
    animation: cm-fold 6.4s cubic-bezier(0.45, 0.05, 0.4, 1) infinite;
  }
  .cm-fold-2 { animation-delay: 2.2s; }
  @keyframes cm-fold {
    0%   { transform: translateX(470px) skewX(-14deg); opacity: 0; }
    12%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translateX(1480px) skewX(-14deg); opacity: 0; }
  }
  .cm-sight-g { opacity: 0; }
  .cm-ring, .cm-tick, .cm-cross {
    transform-box: view-box;
    transform-origin: 475.5px 178.5px;
  }
  .cm.cm-play .cm-sight-g { animation: cm-sight 2.6s ease-out 0.4s both; }
  .cm.cm-play .cm-ring { animation: cm-ring 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s both; }
  .cm.cm-play .cm-tick { animation: cm-tick 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s both; }
  .cm.cm-play .cm-cross { animation: cm-cross 1.1s ease-out 1.2s both; }
  @keyframes cm-sight {
    0% { opacity: 0; }
    12% { opacity: 1; }
    72% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cm-ring { from { transform: scale(2.1); opacity: 0.2; } to { transform: scale(1); opacity: 1; } }
  @keyframes cm-tick {
    from { transform: translate(calc(var(--sx) * 34px), calc(var(--sy) * 34px)); }
    to { transform: translate(0, 0); }
  }
  @keyframes cm-cross { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0.2; } }

  /* ── Lawn: one pass of the mower, then the stripes stay ── */
  .cm-stripe-l { fill: #c9f5dc; opacity: 0.075; }
  .cm-stripe-d { fill: #001a0e; opacity: 0.11; }
  .cm-cut, .cm-mower { transform-box: view-box; transform-origin: 0 0; }
  .cm-cut { transform: scaleX(0); }
  .cm-mower { opacity: 0; }
  .cm.cm-play .cm-cut, .cm.cm-played .cm-cut { animation: cm-cut 2.2s cubic-bezier(0.45, 0, 0.3, 1) 0.3s both; }
  .cm.cm-play .cm-mower { animation: cm-mower 2.2s cubic-bezier(0.45, 0, 0.3, 1) 0.3s both; }
  @keyframes cm-cut { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes cm-mower {
    0% { transform: translateX(0); opacity: 0; }
    8% { opacity: 1; }
    88% { opacity: 1; }
    100% { transform: translateX(1260px); opacity: 0; }
  }

  /* ── Pins: the office calls, the towns answer ── */
  .cm-reach, .cm-pin { transform-box: fill-box; transform-origin: center; opacity: 0; }
  .cm-reach { animation: cm-reach 6s ease-out infinite; }
  .cm-pin { animation: cm-pin 6s ease-out var(--d) infinite; }
  @keyframes cm-reach {
    0% { transform: scale(1); opacity: 0; }
    4% { opacity: 0.9; }
    30% { transform: scale(3.4); opacity: 0; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  @keyframes cm-pin {
    0% { transform: scale(0.9); opacity: 0; }
    3% { opacity: 1; }
    22% { transform: scale(2.6); opacity: 0; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm { display: none !important; }
  }
</style>
