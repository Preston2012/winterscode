---
/**
 * Slide-out mobile/tablet menu panel.
 *
 * State is plain DOM toggling, no React island needed since this is
 * pure show/hide with no reactive UI behind it. ~700 bytes of inline JS.
 *
 * The trigger button lives in <Header /> and identifies itself with
 * `data-menu-open`. This component wires up:
 *   - click on trigger → open
 *   - click on overlay → close
 *   - click on any menu link → close (smooth scroll handled by browser)
 *   - Escape key → close
 *   - aria-expanded sync on the trigger
 *   - body scroll lock while open
 */

export interface Props {
}

// homepage prop removed, nav points to real pages now, not anchors

const menuItems = [
  { href: '/',         label: 'Home',     num: '00' },
  { href: '/work',     label: 'Work',     num: '01' },
  { href: '/services', label: 'Services', num: '02' },
  { href: '/about',    label: 'About',    num: '03' },
  { href: '/contact',  label: 'Contact',  num: '04' },
];
---

<div
  class="menu-overlay"
  id="menu-overlay"
  aria-hidden="true"
  data-menu-close
></div>

<aside
  class="menu-panel"
  id="mobile-menu"
  aria-hidden="true"
  aria-label="Site navigation"
  inert
>
  <button
    type="button"
    class="menu-close"
    aria-label="Close menu"
    data-menu-close
  >
    ✕
  </button>

  <ul class="menu-list">
    {menuItems.map(({ href: itemHref, label, num }) => (
      <li>
        <a href={itemHref} data-menu-link>
          <span class="num">{num}</span>
          {label}
        </a>
      </li>
    ))}
  </ul>

  <div class="menu-footer">
    <div class="menu-footer-eyebrow">Reach out direct</div>
    <div class="menu-contact-row">
      <a href="tel:5415510731" class="menu-contact-btn">Call</a>
      <a
        href="mailto:preston@winterscode.com?subject=Winters%20Code%20consult%20request"
        class="menu-contact-btn"
      >
        Email
      </a>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    const panel = document.getElementById('mobile-menu');
    const overlay = document.getElementById('menu-overlay');
    const opener = document.querySelector('[data-menu-open]');
    if (!panel || !overlay || !opener) return;

    function open() {
      panel.classList.add('open');
      overlay.classList.add('open');
      panel.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      panel.removeAttribute('inert');
      opener.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      panel.classList.remove('open');
      overlay.classList.remove('open');
      panel.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');
      opener.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    opener.addEventListener('click', open);

    // Any element marked data-menu-close closes (overlay + X button)
    document.querySelectorAll('[data-menu-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    // Closing on link click, small delay lets the browser process the hash
    panel.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(close, 50);
      });
    });

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) close();
    });
  })();
</script>

<style>
  /* ─── Overlay ─── */
  .menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 13, 12, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms;
  }
  .menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Panel ─── */
  .menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    height: auto;
    max-height: 100vh;
    max-height: 100dvh;
    overflow-y: auto;
    width: 280px;
    max-width: 80vw;
    background: var(--color-bg-card);
    z-index: 201;
    transform: translateX(100%);
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
    border-left: 1px solid var(--copper-hairline);
    border-bottom: 1px solid var(--copper-hairline);
    border-bottom-left-radius: 16px;
    padding: 24px 20px 28px;
    display: flex;
    flex-direction: column;
  }
  .menu-panel.open { transform: translateX(0); }

  @media (min-width: 1024px) {
    .menu-panel,
    .menu-overlay {
      display: none;
    }
  }

  /* Close button */
  .menu-close {
    align-self: flex-end;
    background: none;
    border: none;
    color: var(--color-ash-300);
    font-size: 24px;
    cursor: pointer;
    padding: 0;
    margin-bottom: 24px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all 200ms;
  }
  .menu-close:hover {
    background: var(--color-bg-raised);
    color: var(--color-copper-bright);
  }

  /* Menu items */
  .menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .menu-list li {
    border-bottom: 1px dashed var(--copper-hairline);
  }
  .menu-list a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 4px;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ash-100);
    transition: all 200ms;
    cursor: pointer;
  }
  .menu-list a:hover {
    color: var(--color-wc-green);
    padding-left: 8px;
  }
  .menu-list .num {
    font-size: 12px;
    color: var(--color-copper);
    font-style: italic;
    font-family: var(--font-serif);
  }

  /* Footer */
  .menu-footer {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--copper-hairline);
  }
  .menu-footer-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-ash-500);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .menu-contact-row {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }
  .menu-contact-btn {
    flex: 1;
    padding: 10px;
    text-align: center;
    background: var(--color-bg-raised);
    border: 1px solid var(--copper-hairline);
    border-radius: 6px;
    font-size: 11px;
    color: var(--color-ash-300);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 200ms;
  }
  .menu-contact-btn:hover {
    border-color: var(--color-wc-green);
    color: var(--color-wc-green);
  }
</style>
