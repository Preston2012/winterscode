---
/**
 * Footer, one centered composition (S339 HONE-SPEC sitewide 3, Shear): the
 * masthead (seal + credo), one Text line, then five compact lines in place of
 * the old six columns: main pages, every client site, every town, and the
 * legal line with the Wall and the changelog. Keeps the original chrome:
 * beach-pebble wash, corner brackets, pulsing teal dot, the "I build it…"
 * credo, and the nominative-use fine print. Client and town links read off
 * the data modules so they stay in sync; the g l shortcut to the Wall lives
 * in KeyboardShortcuts and is untouched.
 *
 * The footer Text is a mint link, not a filled button: the "Ready to build"
 * closer right above it carries the screen's one filled Text (Look).
 */
import { towns } from '../../lib/business';
import { sites } from '../../lib/portfolio';
import { smsHref, telHref, phoneDisplay } from '../../lib/text-cta';

const year = new Date().getFullYear();
const sms = smsHref(Astro.url.pathname);

type L = { label: string; href: string };
const lines: { title?: string; aria: string; links: L[] }[] = [
  {
    aria: 'Pages',
    links: [
      { label: 'Services', href: '/services' },
      { label: 'Work', href: '/work' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Free site audit', href: '/audit' },
      { label: 'FAQ', href: '/faq' },
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    // Every published site, in the /work order; a site without a case page
    // opens its /work card. Sogn stays (Preston's correction).
    title: 'Work', aria: 'Client sites',
    links: sites.map((p) => ({ label: p.name, href: p.caseStudy ?? `/work#${p.slug}` })),
  },
  {
    title: 'Towns', aria: 'Towns',
    links: towns.map((t) => ({ label: t.name, href: `/web-design-${t.slug}` })),
  },
];

const legalLinks: L[] = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Credits', href: '/credits' },
  { label: 'The Wall', href: '/wall' },
  { label: 'Changelog', href: '/changelog' },
];
---

<footer class="page small wc-foot" style="position:relative; border-top:1px solid rgba(77, 216, 168, 0.18); padding-top:46px; padding-bottom:26px; margin-top:32px;">
  <div class="wc-foot-wash" aria-hidden="true"><img srcset="/photo/local/beach-pebbles-480.webp 480w, /photo/local/beach-pebbles-800.webp 800w" src="/photo/local/beach-pebbles-800.webp" sizes="100vw" alt="" width="800" height="600" loading="lazy" decoding="async" /></div>
  <span class="wc-foot-corner tl" aria-hidden="true"></span>
  <span class="wc-foot-corner tr" aria-hidden="true"></span>
  <span class="wc-foot-corner bl" aria-hidden="true"></span>
  <span class="wc-foot-corner br" aria-hidden="true"></span>

  <div class="wc-foot-inner">
    <div class="wc-foot-mast">
      <img src="/wc-logo-96.webp" srcset="/wc-logo-96.webp 96w, /wc-logo-160.webp 160w, /wc-logo-256.webp 256w" sizes="46px" width="46" height="46" decoding="async" loading="lazy" alt="" aria-hidden="true" class="wc-foot-seal" />
      <p class="wc-foot-tag">I build it. I ship it. I maintain it.</p>
      <p class="wc-foot-sub">Custom websites &amp; apps · Oregon Coast</p>
    </div>

    <p class="wc-foot-cta">
      <span class="wc-foot-cta-line">Help is just a text away.</span>
      <span class="wc-foot-cta-acts">
        <a href={sms} class="wc-foot-text">Text Preston {phoneDisplay}</a>
        <span class="wc-foot-dot" aria-hidden="true">&middot;</span>
        <a href={telHref} class="wc-foot-call">or call</a>
      </span>
    </p>

    <span class="wc-foot-rule" aria-hidden="true"></span>

    <div class="wc-foot-lines">
      {lines.map((ln) => (
        <nav class="wc-foot-line" aria-label={ln.aria}>
          {ln.title && <h2 class="wc-foot-line-h">{ln.title}</h2>}
          <ul>
            {ln.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>

    <span class="wc-foot-rule" aria-hidden="true"></span>

    <div class="wc-foot-chrome">
      <nav class="wc-foot-legal" aria-label="Legal">
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="wc-foot-copy">&copy; {year} Winters Code · Bandon, Oregon</div>
      <p class="wc-foot-fine">
        All product names, logos, and brands are property of their
        respective owners. References here are nominative and do not imply
        endorsement, affiliation, or sponsorship by any third party.
      </p>
    </div>
  </div>
</footer>

<style>
  /* ── Centered composition ── */
  .wc-foot-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  /* Masthead */
  .wc-foot-mast { display: flex; flex-direction: column; align-items: center; gap: 9px; }
  .wc-foot-seal { display: block; opacity: 0.95; }
  .wc-foot-tag {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.25;
    color: var(--color-ash-200, var(--color-ash-100));
  }
  @media (min-width: 740px) { .wc-foot-tag { font-size: 20px; } }
  .wc-foot-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ash-500);
  }

  /* Hairline rules (match the chrome's teal gradient) */
  .wc-foot-rule {
    display: block;
    height: 1px;
    width: min(72%, 440px);
    margin: 26px auto;
    background: linear-gradient(90deg, transparent, rgba(77, 216, 168, 0.22) 25%, rgba(77, 216, 168, 0.22) 75%, transparent);
  }

  /* One Text line under the masthead */
  .wc-foot-cta { margin: 20px 0 0; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .wc-foot-cta-line { font-family: var(--font-serif); font-size: 15px; color: var(--color-ash-300); }
  .wc-foot-cta-acts { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .wc-foot-cta a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; transition: color 0.15s ease; }
  .wc-foot-text { font-family: var(--font-sans); font-weight: 600; font-size: 14px; color: var(--color-wc-green); }
  .wc-foot-call { font-size: 13px; color: var(--color-ash-400); }
  .wc-foot-dot { color: var(--color-ash-500); }
  .wc-foot-cta a:focus-visible { text-decoration: underline; outline: none; }
  @media (hover: hover) { .wc-foot-cta a:hover { text-decoration: underline; text-underline-offset: 3px; } }

  /* Compact link lines, centered; each link keeps a 44px touch box (G-027) */
  .wc-foot-lines { display: grid; gap: 18px; max-width: 640px; margin: 0 auto; }
  .wc-foot-line-h {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0 0 2px;
  }
  /* No separator glyphs: a dot that wraps to the start of a centered line
     reads as a stray mark, so spacing alone sets the links apart. */
  .wc-foot-line ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; column-gap: 14px; }
  .wc-foot-line li { display: inline-flex; align-items: center; }
  .wc-foot-line a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 2px;
    margin: -6px 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--color-ash-400);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  @media (min-width: 740px) { .wc-foot-line a { font-size: 13px; } }
  .wc-foot-line a:focus-visible { color: var(--color-wc-green); outline: none; }
  @media (hover: hover) { .wc-foot-line a:hover { color: var(--color-wc-green); } }

  /* Legal */
  .wc-foot-chrome { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .wc-foot-legal { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; }
  /* 44px touch minimum (G-027). Privacy, Terms and Credits measured 19px tall on
     production at S245. Negative margin holds the footer's height. */
  .wc-foot-legal a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    margin: -12px 0;
  }
  .wc-foot-legal a {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-ash-400);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .wc-foot-legal a:focus-visible { color: var(--color-wc-green); outline: none; }

  @media (hover: hover) {

    .wc-foot-legal a:hover { color: var(--color-wc-green); outline: none; }}
  .wc-foot-copy { font-size: 12px; color: var(--color-ash-300); }
  .wc-foot-fine {
    margin: 0 auto;
    max-width: 600px;
    font-size: 11px;
    line-height: 1.55;
    color: var(--color-ash-500);
  }

  /* ── Preserved footer chrome (verbatim from BaseLayout) ── */
  .wc-foot::before {
    content: ""; position: absolute; z-index: 2; left: 0; right: 0; top: 3px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(77, 216, 168, 0.26) 20%, rgba(77, 216, 168, 0.26) 80%, transparent);
    pointer-events: none;
  }
  .wc-foot::after {
    content: ""; position: absolute; z-index: 2; left: 50%; top: -3px; width: 5px; height: 5px;
    border-radius: 50%; background: var(--accent-teal); transform: translateX(-50%);
    box-shadow: 0 0 7px rgba(53, 214, 196, 0.55), 0 0 0 3px var(--color-bg-deep);
    pointer-events: none;
    animation: wc-foot-pulse 2.6s ease-in-out infinite;
  }
  @keyframes wc-foot-pulse {
    0%, 100% { opacity: 0.55; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wc-foot::after { animation: none; }
  }
  .wc-foot-corner { position: absolute; z-index: 2; width: 14px; height: 14px; border-color: rgba(77, 216, 168, 0.26); pointer-events: none; }
  .wc-foot-corner.tl { top: 8px;  left: 0;  border-top: 1px solid; border-left: 1px solid; }
  .wc-foot-corner.tr { top: 8px;  right: 0; border-top: 1px solid; border-right: 1px solid; }
  .wc-foot-corner.bl { bottom: 0; left: 0;  border-bottom: 1px solid; border-left: 1px solid; }
  .wc-foot-corner.br { bottom: 0; right: 0; border-bottom: 1px solid; border-right: 1px solid; }
  .wc-foot-wash { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .wc-foot-wash img { width: 100%; height: 100%; object-fit: cover; object-position: center 62%; opacity: 0.42; display: block; -webkit-mask-image: linear-gradient(to top, #000 16%, transparent 90%); mask-image: linear-gradient(to top, #000 16%, transparent 90%); }
  .wc-foot-wash::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,13,12,0.18), rgba(10,13,12,0.5) 58%, var(--color-bg-deep)); }
</style>
