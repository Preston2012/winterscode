---
/**
 * Footer, extracted verbatim from BaseLayout (markup + chrome styles) and
 * expanded with an additive column nav for IA + internal linking.
 *
 * The original centered chrome is preserved exactly: beach-pebble wash,
 * corner brackets, pulsing teal dot, "I build it. I ship it. I maintain it.",
 * copyright, and the nominative-use fine print. The column grid is new, sits
 * above the chrome, and sources its links from the business data module so
 * Services + Locations stay in sync.
 */
import { services, towns, business } from '../../lib/business';

const year = new Date().getFullYear();

const columns: { title: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    title: 'Services',
    links: [
      ...services.map((s) => ({ label: s.name, href: `/services/${s.slug}` })),
      { label: 'All services', href: '/services' },
    ],
  },
  {
    title: 'Locations',
    links: towns.map((t) => ({ label: t.name, href: `/web-design-${t.slug}` })),
  },
  {
    title: 'Work',
    links: [
      { label: 'All work', href: '/work' },
      { label: 'Sogn Contracting', href: '/work/sogn-contracting' },
      { label: 'Baseline Marketing', href: '/work/baseline-marketing' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Free site audit', href: '/audit' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Insights', href: '/insights' },
      { label: 'Process', href: '/process' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
      { label: 'The Wall', href: '/wall' },
      { label: 'Changelog', href: '/changelog' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms', href: '/terms' },
      { label: 'GitHub', href: business.github, external: true },
    ],
  },
];
---

<footer class="page small wc-foot" style="position:relative; border-top:1px solid rgba(77, 216, 168, 0.18); padding-top:34px; padding-bottom:24px; margin-top:32px;">
  <div class="wc-foot-wash" aria-hidden="true"><img srcset="/photo/local/beach-pebbles-480.webp 480w, /photo/local/beach-pebbles-800.webp 800w" src="/photo/local/beach-pebbles-800.webp" sizes="100vw" alt="" width="800" height="600" loading="lazy" decoding="async" /></div>
  <span class="wc-foot-corner tl" aria-hidden="true"></span>
  <span class="wc-foot-corner tr" aria-hidden="true"></span>
  <span class="wc-foot-corner bl" aria-hidden="true"></span>
  <span class="wc-foot-corner br" aria-hidden="true"></span>

  <!-- Additive IA columns -->
  <nav class="wc-foot-cols" aria-label="Footer" style="position:relative; z-index:1;">
    {columns.map((col) => (
      <div class="wc-foot-col">
        <h2 class="wc-foot-col-h">{col.title}</h2>
        <ul>
          {col.links.map((l) => (
            <li>
              {l.external
                ? <a href={l.href} rel="noopener" target="_blank">{l.label}</a>
                : <a href={l.href}>{l.label}</a>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Preserved centered chrome -->
  <div class="wc-foot-chrome" style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; text-align:center; gap:13px;">
    <p style="margin:0; font-family:var(--font-serif); font-style:italic; font-size:12px; color:var(--color-ash-300); display:flex; align-items:center; justify-content:center; gap:10px;">
      <img src="/wc-logo-256.webp" width="34" height="34" decoding="async" alt="" aria-hidden="true" style="display:block; flex:0 0 auto;" />
      <span>I build it. I ship it. I maintain it.</span>
    </p>
    <div>
      &copy; {year} Winters Code · Bandon, Oregon
    </div>
    <p style="margin:8px auto 0; font-size:11px; color:var(--color-ash-500); line-height:1.5; max-width:640px;">
      All product names, logos, and brands are property of their
      respective owners. References here are nominative and do not imply
      endorsement, affiliation, or sponsorship by any third party.
    </p>
  </div>
</footer>

<style>
  /* ── Additive column grid ── */
  .wc-foot-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px 14px;
    max-width: 680px;
    margin: 0 auto 30px;
    text-align: left;
    padding-bottom: 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  @media (min-width: 768px) { .wc-foot-cols { gap: 30px 28px; max-width: 800px; } }
  .wc-foot-col-h {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0 0 10px;
  }
  .wc-foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
  .wc-foot-col a {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-ash-400);
    text-decoration: none;
    transition: color 0.15s ease;
    line-height: 1.35;
    display: inline-block;
  }
  @media (min-width: 768px) { .wc-foot-col a { font-size: 13px; } }
  .wc-foot-col a:hover, .wc-foot-col a:focus-visible { color: var(--color-wc-green); outline: none; }

  /* ── Preserved footer chrome (verbatim from BaseLayout) ── */
  .wc-foot::before {
    content: ""; position: absolute; z-index: 2; left: 0; right: 0; top: 3px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(77, 216, 168, 0.26) 20%, rgba(77, 216, 168, 0.26) 80%, transparent);
    pointer-events: none;
  }
  .wc-foot::after {
    content: ""; position: absolute; z-index: 2; left: 50%; top: -3px; width: 5px; height: 5px;
    border-radius: 50%; background: var(--accent-teal); transform: translateX(-50%);
    box-shadow: 0 0 7px rgba(53, 214, 196, 0.55), 0 0 0 3px var(--color-bg-deep);
    pointer-events: none;
    animation: wc-foot-pulse 2.6s ease-in-out infinite;
  }
  @keyframes wc-foot-pulse {
    0%, 100% { opacity: 0.55; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wc-foot::after { animation: none; }
  }
  .wc-foot-corner { position: absolute; z-index: 2; width: 14px; height: 14px; border-color: rgba(77, 216, 168, 0.26); pointer-events: none; }
  .wc-foot-corner.tl { top: 8px;  left: 0;  border-top: 1px solid; border-left: 1px solid; }
  .wc-foot-corner.tr { top: 8px;  right: 0; border-top: 1px solid; border-right: 1px solid; }
  .wc-foot-corner.bl { bottom: 0; left: 0;  border-bottom: 1px solid; border-left: 1px solid; }
  .wc-foot-corner.br { bottom: 0; right: 0; border-bottom: 1px solid; border-right: 1px solid; }
  .wc-foot-wash { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .wc-foot-wash img { width: 100%; height: 100%; object-fit: cover; object-position: center 62%; opacity: 0.42; display: block; -webkit-mask-image: linear-gradient(to top, #000 16%, transparent 90%); mask-image: linear-gradient(to top, #000 16%, transparent 90%); }
  .wc-foot-wash::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,13,12,0.18), rgba(10,13,12,0.5) 58%, var(--color-bg-deep)); }
</style>
