---
/**
 * LocalProofStrip. A warmth + local-credibility beat between the Wall (data)
 * and SelectedWork (portfolio). Real photos Preston shot on the Oregon coast,
 * framed in brand chrome.
 *
 * NOT a client-vertical portfolio. These are his own local images (photography
 * is a service WC sells), proof he is genuinely from here and shoots real
 * assets. Tags name the place in the photo, never an industry he has served.
 */

const cards = [
  {
    srcset: '/photo/local/cranberry-harvest-480.webp 480w, /photo/local/cranberry-harvest-800.webp 800w',
    src: '/photo/local/cranberry-harvest-800.webp',
    w: 800, h: 450,
    alt: 'Cranberry harvest on the Oregon coast',
    tag: 'CRANBERRY COUNTRY',
    copy: 'Shot right here in cranberry country. My own photos, not stock.',
  },
  {
    srcset: '/photo/local/golf-dunes-480.webp 480w, /photo/local/golf-dunes-800.webp 800w',
    src: '/photo/local/golf-dunes-800.webp',
    w: 800, h: 450,
    alt: 'Links golf course at sunset near Bandon, Oregon',
    tag: 'THE DUNES',
    copy: 'The dunes, ten minutes from the shop. I shoot the coast I build for.',
  },
  {
    srcset: '/photo/local/home-coast-wash-768.webp 768w',
    src: '/photo/local/home-coast-wash-768.webp',
    w: 768, h: 432,
    alt: 'The Oregon coast at sunset near Bandon',
    tag: 'THE COAST',
    copy: 'Built in Bandon, for the businesses the coast actually runs on.',
  },
];
---

<section class="lp" aria-labelledby="lp-h">
  <div class="lp-head">
    <div class="lp-eyebrow">
      <span class="lp-line" aria-hidden="true"></span>
      <span class="lp-kicker">ON THE COAST</span>
    </div>
    <h2 class="lp-h" id="lp-h">Built on the coast. Built for working businesses.</h2>
    <p class="lp-sub">
      The shops, contractors, charters, and growers out here don't need another
      generic template. They need something that fits how the business actually runs.
    </p>
  </div>

  <ul class="lp-cards" role="list">
    {cards.map((c) => (
      <li class="lp-card">
        <span class="lp-corner tl" aria-hidden="true"></span>
        <span class="lp-corner tr" aria-hidden="true"></span>
        <span class="lp-corner bl" aria-hidden="true"></span>
        <span class="lp-corner br" aria-hidden="true"></span>
        <div class="lp-media">
          <img src={c.src} srcset={c.srcset} sizes="(min-width: 740px) 32vw, 90vw"
               width={c.w} height={c.h} alt={c.alt} loading="lazy" decoding="async" />
        </div>
        <div class="lp-body">
          <span class="lp-tag">{c.tag}</span>
          <p class="lp-copy">{c.copy}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .lp { max-width: 440px; margin: 0 auto; padding: 28px 16px 0; }
  @media (min-width: 740px)  { .lp { max-width: 720px;  padding: 36px 24px 0; } }
  @media (min-width: 1024px) { .lp { max-width: 1200px; padding: 48px 40px 0; } }

  .lp-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .lp-line { width: 28px; height: 1px; background: var(--color-copper); }
  .lp-kicker {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.22em; color: var(--color-copper); text-transform: uppercase;
  }
  .lp-h {
    font-family: var(--font-serif); font-size: 24px; line-height: 1.15;
    font-weight: 500; color: var(--color-ash-100); margin: 0 0 12px; text-wrap: balance;
  }
  @media (min-width: 740px)  { .lp-h { font-size: 32px; } }
  @media (min-width: 1024px) { .lp-h { font-size: 38px; } }
  .lp-sub {
    font-family: var(--font-sans); font-size: 14px; line-height: 1.6;
    color: var(--color-ash-400); max-width: 62ch; margin: 0 0 28px;
  }
  @media (min-width: 740px)  { .lp-sub { font-size: 15px; margin-bottom: 32px; } }
  @media (min-width: 1024px) { .lp-sub { font-size: 16px; } }

  .lp-cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 740px) { .lp-cards { grid-template-columns: repeat(3, 1fr); gap: 18px; } }

  .lp-card {
    position: relative; border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card); background: rgba(255, 255, 255, 0.025);
    overflow: hidden; transition: border-color 240ms ease;
  }
  .lp-card:hover { border-color: var(--color-copper); }

  .lp-corner {
    position: absolute; width: 12px; height: 12px; z-index: 2;
    border-color: var(--copper-dim); pointer-events: none; transition: border-color 240ms ease;
  }
  .lp-corner.tl { top: 7px; left: 7px;  border-top: 1px solid; border-left: 1px solid; }
  .lp-corner.tr { top: 7px; right: 7px; border-top: 1px solid; border-right: 1px solid; }
  .lp-corner.bl { bottom: 7px; left: 7px;  border-bottom: 1px solid; border-left: 1px solid; }
  .lp-corner.br { bottom: 7px; right: 7px; border-bottom: 1px solid; border-right: 1px solid; }
  .lp-card:hover .lp-corner { border-color: var(--color-copper-bright); }

  .lp-media { position: relative; height: 130px; overflow: hidden; }
  @media (min-width: 740px)  { .lp-media { height: 150px; } }
  @media (min-width: 1024px) { .lp-media { height: 180px; } }
  .lp-media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    opacity: 0.82; transition: opacity 300ms ease, transform 600ms ease;
  }
  .lp-media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(10, 13, 12, 0.08), rgba(10, 13, 12, 0.55));
  }
  .lp-card:hover .lp-media img { opacity: 1; transform: scale(1.03); }

  .lp-body { padding: 14px 16px 16px; }
  .lp-tag {
    display: inline-block; font-family: var(--font-mono); font-size: 10px;
    font-weight: 600; letter-spacing: 0.18em; color: var(--color-copper);
    text-transform: uppercase; margin-bottom: 8px;
  }
  .lp-copy {
    font-family: var(--font-sans); font-size: 13px; line-height: 1.55;
    color: var(--color-ash-300); margin: 0;
  }
  @media (min-width: 1024px) { .lp-copy { font-size: 14px; } }

  @media (prefers-reduced-motion: reduce) {
    .lp-card, .lp-corner, .lp-media img { transition: none; }
    .lp-card:hover .lp-media img { transform: none; }
  }
</style>
