---
/**
 * SognContact: live mini contact form for the Sogn Contracting /work card.
 *
 * The widget IS the visual proof. Visitor sees Sogn's actual brand
 * (green + dark gray + Sogn logo), fills out the actual form, submits
 * to Sogn's /api/contact endpoint via CORS, real lead lands in Paul's
 * inbox with [WC Portfolio] subject prefix so attribution is clean.
 *
 * Doctrine: brain memory #2556 (the /work overhaul plan).
 * Sogn's CORS allowlist already includes winterscode.com.
 * Source tag "wc-portfolio" routes the email subject correctly per
 * Sogn's /api/contact handler.
 *
 * Embed-ready: no section/header wrappers, parent (a /work card slot)
 * provides framing.
 *
 * Fields mirror the canonical Sogn contact form (components/ContactForm.tsx):
 * - name (required)
 * - email (required, regex-validated)
 * - phone (optional)
 * - message (required, up to 4000 chars)
 * - website (honeypot, hidden via CSS)
 *
 * Rate limit: 3 submissions per IP per UTC day, client-side soft cap.
 * Server enforces its own rate limiting separately.
 */
---

<div class="sc-wrap">
  <div class="sc-radial-bg" aria-hidden="true"></div>
  <div class="sc-accent-l" aria-hidden="true"></div>
  <div class="sc-accent-r" aria-hidden="true"></div>

  <div class="sc-inner">
    <a
      class="sc-logo"
      href="https://www.sogncontracting.com"
      target="_blank"
      rel="noopener"
      aria-label="Sogn Contracting"
    >
      <img
        src="/brands/sogn-logo-full.png"
        alt="Sogn Contracting"
        width="720"
        height="332"
        loading="lazy"
        decoding="async"
      />
    </a>

    <div class="sc-header">
      <h4 class="sc-title">Start Your Project</h4>
      <p class="sc-subtitle">
        Get in touch for a free estimate. We'll get back to you within
        one business day.
      </p>
    </div>

    <div class="sc-form-card">
      <div class="sc-success" id="sc-success" hidden>
        <p class="sc-success-title">Message sent.</p>
        <p class="sc-success-body">
          Paul will get back to you within one business day. If urgent,
          call <a href="tel:+16029040741" class="sc-link">(602) 904-0741</a>.
        </p>
      </div>

      <form
        class="sc-form"
        id="sc-form"
        novalidate
        aria-label="Contact Sogn Contracting"
      >
        <div class="sc-honey" aria-hidden="true" tabindex="-1">
          <label for="sc-website">Website</label>
          <input
            type="text"
            id="sc-website"
            name="website"
            autocomplete="off"
            tabindex="-1"
          />
        </div>

        <div class="sc-row">
          <div class="sc-field">
            <label for="sc-name" class="sc-label">Name</label>
            <input
              type="text"
              id="sc-name"
              name="name"
              class="sc-input"
              placeholder="Your name"
              maxlength="100"
              autocomplete="name"
              required
            />
          </div>

          <div class="sc-field">
            <label for="sc-email" class="sc-label">Email</label>
            <input
              type="email"
              id="sc-email"
              name="email"
              class="sc-input"
              placeholder="you@example.com"
              maxlength="200"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div class="sc-field">
          <label for="sc-phone" class="sc-label">Phone <span class="sc-opt">(optional)</span></label>
          <input
            type="tel"
            id="sc-phone"
            name="phone"
            class="sc-input"
            placeholder="(555) 555-5555"
            maxlength="40"
            autocomplete="tel"
          />
        </div>

        <div class="sc-field">
          <label for="sc-message" class="sc-label">Project details</label>
          <textarea
            id="sc-message"
            name="message"
            class="sc-textarea"
            placeholder="Remodel, addition, new build, repair... what are you thinking?"
            rows="3"
            maxlength="4000"
            required
          ></textarea>
        </div>

        <button type="submit" class="sc-submit" id="sc-submit">
          <span data-submit-label>Send to Paul →</span>
        </button>

        <p class="sc-error" id="sc-error" hidden role="alert"></p>

      </form>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Defer setup until the widget is about to enter the viewport.
    // /work has many cards, eagerly initializing every widget would
    // waste cycles on cards the visitor never sees.
    function ready(fn) {
      if (document.readyState !== 'loading') fn();
      else document.addEventListener('DOMContentLoaded', fn);
    }

    ready(function () {
      var form = document.getElementById('sc-form');
      if (!form) return;

      var submit = document.getElementById('sc-submit');
      var label = submit.querySelector('[data-submit-label]');
      var errEl = document.getElementById('sc-error');
      var success = document.getElementById('sc-success');

      var RATE_KEY = 'sc-submits';
      var RATE_DAY_KEY = 'sc-submits-day';
      var RATE_MAX = 3;

      function getDayString() {
        var d = new Date();
        return d.getUTCFullYear() + '-' + (d.getUTCMonth() + 1) + '-' + d.getUTCDate();
      }

      function checkRate() {
        try {
          var today = getDayString();
          var lastDay = localStorage.getItem(RATE_DAY_KEY);
          if (lastDay !== today) {
            localStorage.setItem(RATE_DAY_KEY, today);
            localStorage.setItem(RATE_KEY, '0');
            return 0;
          }
          return parseInt(localStorage.getItem(RATE_KEY) || '0', 10);
        } catch (_) {
          return 0;
        }
      }

      function bumpRate() {
        try {
          var n = checkRate() + 1;
          localStorage.setItem(RATE_KEY, String(n));
          return n;
        } catch (_) {
          return 0;
        }
      }

      function validateEmail(v) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
      }

      function showError(msg) {
        errEl.textContent = msg;
        errEl.hidden = false;
      }

      function clearError() {
        errEl.textContent = '';
        errEl.hidden = true;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        clearError();

        if (checkRate() >= RATE_MAX) {
          showError('Easy there. Send your project details directly to sogncontracting@gmail.com.');
          return;
        }

        var data = new FormData(form);
        var name = (data.get('name') || '').toString().trim();
        var email = (data.get('email') || '').toString().trim();
        var message = (data.get('message') || '').toString().trim();

        if (!name || name.length < 2) return showError('Please add your name.');
        if (!email || !validateEmail(email)) return showError('That email does not look right.');
        if (!message || message.length < 5) return showError('Tell Paul a bit more about your project (at least 5 characters).');

        var payload = {
          name: name,
          email: email,
          phone: (data.get('phone') || '').toString().trim(),
          message: message,
          website: (data.get('website') || '').toString(),
          source: 'wc-portfolio',
        };

        submit.disabled = true;
        label.textContent = 'Sending...';

        fetch('https://www.sogncontracting.com/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.json().then(function (data) {
              return { ok: res.ok, status: res.status, data: data };
            }).catch(function () {
              return { ok: res.ok, status: res.status, data: null };
            });
          })
          .then(function (result) {
            if (result.ok) {
              bumpRate();
              form.hidden = true;
              success.hidden = false;
              return;
            }
            submit.disabled = false;
            label.textContent = 'Send to Paul →';
            // Map server validation errors to specific user messages
            var err = result.data && result.data.error;
            if (err === 'name_required') {
              showError('Please add your name.');
            } else if (err === 'email_invalid') {
              showError('That email does not look right.');
            } else if (err === 'message_required') {
              showError('Tell Paul a bit more about your project (at least 5 characters).');
            } else if (err === 'rate_limited') {
              showError('Too many sends today. Try again tomorrow or email sogncontracting@gmail.com directly.');
            } else if (err) {
              showError('Send failed (' + err + '). Email sogncontracting@gmail.com directly.');
            } else {
              showError('Send failed (' + result.status + '). Email sogncontracting@gmail.com directly.');
            }
          })
          .catch(function (e) {
            submit.disabled = false;
            label.textContent = 'Send to Paul →';
            showError('Network error: could not reach Sogn. Check your connection or email sogncontracting@gmail.com directly.');
          });
      });
    });
  })();
</script>

<style>
  .sc-wrap {
    /* Sogn's actual brand palette, locked from sogncontracting.com */
    --sogn-green: #72B725;
    --sogn-green-hover: #7BBA29;
    --sogn-green-text: #95DA35;
    --sogn-charcoal: #2D2D2D;
    --sogn-bg-dark: #484848;
    --sogn-bg-card: #525252;
    --sogn-text-on-dark: #FFFFFF;
    --sogn-text-on-dark-sub: #D0D0D0;
    --sogn-border-dark: #5C5C5C;

    position: relative;
    /* Explicit width:100% + box-sizing so the widget background fills its
       parent slot edge-to-edge (the wk-preview at /work). Without this the
       flex parent was sometimes shrink-to-fit the child, leaving a vertical
       dark gap on one side of the card. */
    width: 100%;
    box-sizing: border-box;
    background: var(--sogn-bg-dark);
    background-image:
      radial-gradient(circle at 20% 80%, rgba(0, 0, 0, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(0, 0, 0, 0.06) 0%, transparent 50%);
    overflow: hidden;
    padding: 28px 20px 24px;
    color: var(--sogn-text-on-dark);
    font-family: var(--font-sans);
  }
  @media (min-width: 768px) {
    .sc-wrap { padding: 36px 28px 32px; }
  }
  @media (min-width: 1024px) {
    .sc-wrap { padding: 44px 36px 40px; }
  }

  /* Radial lighten behind logo: Sogn's signature beat */
  /* Subtle white radial glow centered behind the logo. */
  .sc-radial-bg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    height: 200px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 45%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 0;
  }
  /* Accent lines sit BELOW the logo, framing the title. Mirrors Sogn's
     actual contact section where the green V-shape underlines the brand. */
  .sc-accent-l, .sc-accent-r {
    position: absolute;
    top: 120px;
    width: 30%;
    height: 1.5px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }
  .sc-accent-l {
    left: 0;
    background: linear-gradient(90deg, transparent 0%, #508019 100%);
  }
  .sc-accent-r {
    right: 0;
    background: linear-gradient(270deg, transparent 0%, #508019 100%);
  }
  @media (min-width: 768px) {
    .sc-accent-l, .sc-accent-r { top: 150px; }
  }

  .sc-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .sc-inner { gap: 20px; }
  }

  .sc-logo {
    width: 200px;
    height: auto;
    display: block;
    transition: opacity 0.2s ease;
    text-decoration: none;
  }
  .sc-logo:hover, .sc-logo:focus-visible {
    opacity: 0.88;
    outline: none;
  }
  .sc-logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 768px) {
    .sc-logo { width: 240px; }
  }

  .sc-header {
    text-align: center;
    max-width: 480px;
  }
  .sc-title {
    margin: 0 0 6px;
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--sogn-text-on-dark);
    letter-spacing: -0.01em;
  }
  @media (min-width: 768px) {
    .sc-title { font-size: 26px; }
  }
  .sc-subtitle {
    margin: 0;
    font-size: 13px;
    color: var(--sogn-text-on-dark-sub);
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    .sc-subtitle { font-size: 14px; }
  }

  .sc-form-card {
    width: 100%;
    max-width: 560px;
    background: var(--sogn-bg-card);
    border: 1px solid var(--sogn-border-dark);
    border-radius: 10px;
    padding: 18px 16px 16px;
  }
  @media (min-width: 768px) {
    .sc-form-card { padding: 24px 22px 22px; }
  }

  .sc-form { display: flex; flex-direction: column; gap: 12px; }

  /* Honeypot: visually hidden but focusable for accessibility audits */
  .sc-honey {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0, 0, 0, 0);
    overflow: hidden;
    white-space: nowrap;
  }

  .sc-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 480px) {
    .sc-row { grid-template-columns: 1fr 1fr; }
  }

  .sc-field { display: flex; flex-direction: column; gap: 4px; }
  .sc-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--sogn-text-on-dark);
    letter-spacing: 0.02em;
  }
  .sc-opt {
    font-weight: 400;
    color: var(--sogn-text-on-dark-sub);
    font-size: 11px;
  }

  .sc-input, .sc-textarea {
    width: 100%;
    padding: 9px 12px;
    background: var(--sogn-bg-dark);
    border: 1px solid var(--sogn-border-dark);
    border-radius: 6px;
    color: var(--sogn-text-on-dark);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
    transition: border-color 0.15s ease;
    /* Prevent iOS zoom on focus */
    font-size: 16px;
  }
  @media (min-width: 768px) {
    .sc-input, .sc-textarea { font-size: 14px; }
  }
  .sc-input::placeholder, .sc-textarea::placeholder {
    color: #999;
  }
  .sc-input:focus, .sc-textarea:focus {
    outline: none;
    border-color: var(--sogn-green);
    box-shadow: 0 0 0 2px rgba(114, 183, 37, 0.2);
  }
  .sc-textarea { resize: vertical; min-height: 80px; }

  .sc-submit {
    appearance: none;
    background: var(--sogn-green);
    color: var(--sogn-charcoal);
    border: 0;
    padding: 11px 18px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
    margin-top: 4px;
    min-height: 44px;
  }
  .sc-submit:hover, .sc-submit:focus-visible {
    background: var(--sogn-green-hover);
    transform: translateY(-1px);
    outline: none;
  }
  .sc-submit:focus-visible {
    box-shadow: 0 0 0 3px rgba(114, 183, 37, 0.4);
  }
  .sc-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .sc-error {
    margin: 4px 0 0;
    padding: 8px 12px;
    background: rgba(220, 80, 80, 0.15);
    border: 1px solid rgba(220, 80, 80, 0.4);
    border-radius: 6px;
    color: #ffb4b4;
    font-size: 13px;
    line-height: 1.45;
  }

  .sc-success {
    padding: 20px 16px;
    text-align: center;
  }
  .sc-success-title {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--sogn-green-text);
    font-weight: 600;
  }
  .sc-success-body {
    margin: 0;
    color: var(--sogn-text-on-dark-sub);
    font-size: 14px;
    line-height: 1.55;
  }
  .sc-link {
    color: var(--sogn-green-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sc-link:hover { color: var(--sogn-green); }

  @media (prefers-reduced-motion: reduce) {
    .sc-submit { transition: none; }
    .sc-submit:hover, .sc-submit:focus-visible { transform: none; }
  }
</style>
