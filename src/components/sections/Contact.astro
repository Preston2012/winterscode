---
/**
 * Contact, the closer at the foot of every reading page. No form.
 *
 * S339 round 3 (Preston 2026-11-21: "no words of no value, cut unneeded
 * numbers, brighten everything up"). The closer is now the Home close on a
 * riveted plate: the tagline as the heading, the Tangle's locked close as the
 * one line under it, Text and Call as two keys that each show the number, and
 * the reply line. The section numeral, the body paragraph and the per-page
 * "why" line are gone: every page above it already made its case.
 *
 * Kept: /contact's strip (reply hours, consult geography, the 50/50 terms,
 * then Book and Email), /pricing's collapsed consult policy, id="contact" and
 * data-textbar-hide so header links land and the phone thumb bar steps aside.
 *
 * Old props (sectionNumber, centered, suppressHeader, headerKicker, why) are
 * still accepted so every call site builds. headerTitle still replaces the
 * heading when a page passes one.
 */
import { smsHref, telHref, phoneDisplay, bookHref, mailHref } from '../../lib/text-cta';
import { business } from '../../lib/business';
import Arrow from '../ui/Arrow.astro';

export interface Props {
  sectionNumber?: string;
  centered?: boolean;
  suppressHeader?: boolean;
  headerKicker?: string;
  headerTitle?: string;
  strip?: boolean;
  policy?: boolean;
  why?: string;
}
const { headerKicker = 'Reach out', headerTitle, strip = false, policy = false } = Astro.props;
const sms = smsHref(Astro.url.pathname);
---

<section class="closer wc-plate wc-rv" id="contact" data-textbar-hide aria-labelledby="closer-h">
  <div class="closer-glow" aria-hidden="true"></div>
  <p class="wc-eyebrow"><span class="wc-dot" aria-hidden="true"></span>{headerKicker}</p>
  <h2 class="closer-h" id="closer-h">
    {headerTitle ? headerTitle : <>Help is just a <span class="wc-cu">text away.</span></>}
  </h2>
  <p class="closer-sub">I'm down the road. I pick up the phone.</p>

  <div class="closer-keys">
    <a class="wc-btn wc-btn--primary closer-key" href={sms}>
      <span class="closer-stack"><span class="closer-label">Text Preston</span><span class="closer-num">{phoneDisplay}</span></span>
      <Arrow size={22} />
    </a>
    <a class="wc-btn wc-btn--ghost closer-key" href={telHref}>
      <span class="closer-stack"><span class="closer-label">Call</span><span class="closer-num">{phoneDisplay}</span></span>
    </a>
  </div>

  {strip ? (
    <>
      <ul class="closer-strip">
        <li>I answer my texts within a few hours during business days.</li>
        <li>Consults are free in Bandon, and free by 30-minute video across Coos and Curry.</li>
        <li>Every build has a written SOW: 50% on signing, 50% at launch.</li>
      </ul>
      <div class="closer-quiet">
        <a class="wc-link" href={bookHref} target="_blank" rel="noopener">Book a 30-min call <Arrow size={16} /></a>
        <a class="wc-link" href={mailHref}>Email {business.email} <Arrow size={16} /></a>
      </div>
    </>
  ) : (
    <p class="closer-reply">I answer my texts within a few hours during business days.</p>
  )}

  {!strip && policy && (
    <details class="closer-policy">
      <summary>Consult policy <span class="closer-plus" aria-hidden="true"></span></summary>
      <ul>
        <li><strong>Bandon:</strong> free in person or by video</li>
        <li><strong>Coos and Curry counties:</strong> free 30-min video</li>
        <li><strong>In person up to 1.5 hours away:</strong> $250 deposit, credited to the project on signing</li>
        <li><strong>In person up to 2.5 hours away:</strong> $400 deposit, credited to the project on signing</li>
      </ul>
    </details>
  )}
</section>

<style>
  .closer {
    position: relative; overflow: hidden; isolation: isolate;
    margin-top: 28px;
    padding: 40px 20px 32px;
    scroll-margin-top: 96px;
  }
  @media (min-width: 740px) { .closer { padding: 56px 40px 44px; margin-top: 36px; } }
  @media (min-width: 1024px) { .closer { padding: 72px 64px 56px; margin-top: 44px; } }
  .closer-glow {
    position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background:
      radial-gradient(55% 70% at 88% 12%, rgba(240, 160, 110, 0.12), transparent 70%),
      radial-gradient(50% 60% at 8% 100%, rgba(77, 216, 168, 0.08), transparent 72%);
  }
  .closer-h {
    margin: 0; max-width: 14ch;
    font-family: var(--wc-display); font-weight: 500;
    font-size: clamp(40px, 7vw, 88px); line-height: 1; letter-spacing: -0.025em;
    color: #eef1ec; text-wrap: balance;
  }
  :global(html[data-display='sans']) .closer-h { font-weight: 600; letter-spacing: -0.045em; }
  .closer-sub { margin: 18px 0 0; font-size: clamp(17px, 1.8vw, 21px); line-height: 1.5; color: var(--color-ash-300); }

  .closer-keys { display: grid; grid-template-columns: 1.5fr 1fr; gap: 10px; max-width: 460px; margin-top: 28px; }
  .closer-key { min-height: 70px; }
  .closer-stack { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; }
  .closer-label { font-size: 18px; font-weight: 600; }
  .closer-num { font-family: var(--font-mono); font-size: 12.5px; font-weight: 400; opacity: 0.78; }
  .closer-reply { margin: 18px 0 0; font-size: 15px; color: var(--color-ash-500); }

  .closer-strip { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; max-width: 40rem; }
  .closer-strip li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; line-height: 1.5; color: var(--color-ash-300); }
  .closer-strip li::before {
    content: ''; flex: none; width: 8px; height: 8px; margin-top: 7px; border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #7ff0c8, #2f9e78 70%);
    box-shadow: 0 0 0 3px rgba(77, 216, 168, 0.14);
  }
  .closer-quiet { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 10px; }

  .closer-policy { margin-top: 22px; max-width: 40rem; border: 1px solid var(--wc-line); border-radius: var(--wc-r); background: rgba(10, 13, 12, 0.5); }
  .closer-policy summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 52px; padding: 0 16px; cursor: pointer; list-style: none;
    font-size: 15px; font-weight: 600; color: #eef1ec;
  }
  .closer-policy summary::-webkit-details-marker { display: none; }
  .closer-policy summary:focus-visible { outline: 2px solid var(--color-wc-green); outline-offset: 2px; border-radius: var(--wc-r); }
  .closer-plus { position: relative; width: 14px; height: 14px; }
  .closer-plus::before, .closer-plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: currentColor; border-radius: 1px; transition: transform .2s ease; }
  .closer-plus::after { transform: rotate(90deg); }
  .closer-policy[open] .closer-plus::after { transform: rotate(0deg); }
  .closer-policy ul { margin: 0; padding: 0 16px 16px 34px; display: grid; gap: 6px; font-size: 15px; line-height: 1.5; color: var(--color-ash-300); }
  .closer-policy strong { color: #eef1ec; font-weight: 600; }
</style>
