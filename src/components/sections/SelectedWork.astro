---
import { v } from '../../lib/asset';
import PaintPour from '../ui/PaintPour.astro';
import CardMotion from '../ui/CardMotion.astro';
import ChereFeature from './ChereFeature.astro';
/**
 * Selected Work (homepage teaser), 3 cards, deep-linked to /work.
 *
 * Spec ref: docs/design/S6_PLUS.md Section 5 (~line 626).
 * S7+ update (2026-05-12): StainSlayer + Demiurge+MyKonos cards have
 * real hero images. Sogn keeps the editorial glyph (mark + 2 heroes mix).
 * Demiurge + MyKonos merges engine + product into one card per Preston.
 * Locked S7+ (2026-05-12).
 * S168 (2026-09-05), Preston's ruling: client sites first, newest client first,
 * then the apps. Order matches src/lib/sites.ts.
 * S230 (2026-09-11), Preston's ruling: the grid goes to SEVEN. Taylor published
 * at the DNS cutover and branding joins as the seventh, because the two pages a
 * prospect reads for proof carried no brand work at all. The six-card cap and
 * the instruction to drop StainSlayer when Taylor published are both retired by
 * this ruling; StainSlayer stays off the teaser and keeps its card on /work.
 * S326 (2026-10-05), the site DNA Preston handed over: Sogn, SeaBreeze, US
 * Survey Supply lead, then the rest. Paul Sogn's review is the one on file and
 * SeaBreeze is the off-WordPress story, so the proof leads instead of the
 * newest build. This replaces newest-first; it is flagged on the preview for
 * Preston to keep or reverse. Cards open the case page, not the client's site:
 * the homepage is a trailer that points at dedicated pages, and Visit is the
 * secondary link on every case (DNA: Visit never the card primary).
 */

interface WorkCard {
  id: string;
  title: string;
  desc: string;
  stack: [string, string];
  status: 'LIVE' | 'BETA' | 'PROD';
  /** Rebuild of a site the client already had, or a first build. */
  build: 'rebuild' | 'new';
  /** Which labelled group the card sits under. S245: the grid is no longer one
      undivided run. Demiurge + MyKonos sitting in the same unlabelled row as
      five client websites reads as a sixth website, which was Preston's own
      read of his page. */
  kind: 'site' | 'app';
  built_in_days?: number;
  external_url?: string;
  /** Internal case page. When set the card opens it instead of the live site. */
  caseStudy?: string;
  /** False keeps the card off the homepage until the site's own domain is live. */
  published?: boolean;
  /** S339: pour wet paint off the top of the card art (PaintPour). Makai only. */
  pour?: boolean;
  /** S339: up to three short lines of what the build actually does, under the
      description. Used where one sentence cannot carry the build (Grand). */
  highlights?: string[];
  /** S339: one signature movement from the client's own mark (CardMotion). */
  motion?: 'lighthouse' | 'flag' | 'lawn' | 'pins';
  /** Optional hero image (overrides editorial glyph). */
  image?: {
    src: string;
    srcSmall?: string;
    srcXSmall?: string;
    alt: string;
    width?: number;
    height?: number;
  };
}

const CARDS: WorkCard[] = [
  {
    // S339, Preston 2026-10-28: Grand leads the homepage, and the card shows
    // what was built: 50 bilingual pages and the encrypted back office.
    // 13 business days, first build 2026-10-09 to live 2026-10-27.
    id: 'grand-management',
    caseStudy: '/work/grand-management',
    kind: 'site',
    title: 'Grand Management Services',
    desc: 'A Coos Bay property manager, rebuilt off WordPress.',
    highlights: [
      '50 bilingual pages',
      'Live AppFolio rentals',
      'Encrypted back office',
    ],
    stack: ['Astro', 'AppFolio'],
    status: 'LIVE',
    build: 'rebuild',
    built_in_days: 13,
    external_url: 'https://www.grandmgmt.com',
    motion: 'pins',
    image: {
      src: '/work/grand-card.webp',
      srcSmall: '/work/grand-card-720.webp',
      srcXSmall: '/work/grand-card-480.webp',
      alt: 'Grand Management Services, Coos Bay, Oregon: the Grand logo over the line How can we help?, beside a map of Oregon with a gold pin in every town where Grand manages a community.',
      width: 1200,
      height: 630,
    },
  },
  {
    id: 'sogn-contracting',
    caseStudy: '/work/sogn-contracting',
    kind: 'site',
    // S339, Preston 2026-10-28 14:00 PT: off the homepage again; /work only.
    published: false,
    title: 'Sogn Contracting',
    desc: 'Marketing site for a 30-year Bandon contractor.',
    stack: ['Next.js', 'Vercel'],
    status: 'LIVE',
    build: 'new',
    built_in_days: 3,
    external_url: 'https://sogncontracting.com',
    image: {
      src: '/work/sogn-card.webp',
      srcSmall: '/work/sogn-card-720.webp',
      srcXSmall: '/work/sogn-card-480.webp',
      alt: 'Sogn Contracting LLC, Bandon Oregon. 30 years of construction. Paul Sogn, Oregon CCB# 257491.',
      width: 1200,
      height: 630,
    },
  },
  {
    id: 'seabreeze',
    caseStudy: '/work/seabreeze',
    kind: 'site',
    title: 'SeaBreeze Landscape Care and Home Repair',
    desc: 'Site for a Bandon landscape-care and home-repair business.',
    stack: ['Astro', 'Cloudflare'],
    status: 'LIVE',
    build: 'rebuild',
    built_in_days: 7,
    external_url: 'https://seabreeze.llc',
    motion: 'lawn',
    image: {
      src: '/work/seabreeze-card.webp',
      srcSmall: '/work/seabreeze-card-720.webp',
      srcXSmall: '/work/seabreeze-card-480.webp',
      alt: 'SeaBreeze Landscape Care and Home Repair, Bandon Oregon: coastal logo in cream and teal on a deep green field.',
      width: 1200,
      height: 630,
    },
  },
  {
    id: 'us-survey-supply',
    caseStudy: '/work/us-survey-supply',
    kind: 'site',
    title: 'US Survey Supply',
    desc: '42-page rebuild for a surveying-equipment dealer shipping nationwide from Bandon.',
    stack: ['Astro', 'Cloudflare'],
    status: 'LIVE',
    build: 'rebuild',
    // Published 2026-09-11 (S230) at the cutover. The apex serves this build.
    published: true,
    external_url: 'https://ussurveysupply.com',
    motion: 'flag',
    image: {
      src: '/work/taylor-card.webp',
      srcSmall: '/work/taylor-card-720.webp',
      srcXSmall: '/work/taylor-card-480.webp',
      alt: 'US Survey Supply, Bandon, Oregon: white wordmark and red-and-white survey target on navy over an American flag. Surveying equipment, rentals, and service.',
      width: 1200,
      height: 630,
    },
    built_in_days: 8,
  },
  {
    // S339, Preston: Makai joins the homepage below US Survey Supply. Live on
    // its own domain since 2026-10-19. No case page yet, so the card opens its
    // /work entry, which carries the Text action and the live scores. Five
    // business days, per Preston: signed 10-13, live on her go email 10-19.
    id: 'makai-painting',
    kind: 'site',
    title: 'Makai Painting',
    desc: 'Site for a Coos Bay painting company, with pages that paint themselves in as you scroll.',
    stack: ['Astro', 'Cloudflare'],
    status: 'LIVE',
    build: 'new',
    external_url: 'https://www.makaipainting.com',
    built_in_days: 5,
    pour: true,
    image: {
      src: '/work/makai-card.webp',
      srcSmall: '/work/makai-card-720.webp',
      srcXSmall: '/work/makai-card-480.webp',
      alt: 'Makai Painting and Residential Rehab, Coos Bay, Oregon: the pink hibiscus logo over the words Interior, Exterior, Repairs and Hauling on gold, pink and white brush strokes, beside a freshly painted blue room with ladders and drop cloths.',
      width: 1200,
      height: 630,
    },
  },
  {
    id: 'bandon-by-the-dunes',
    caseStudy: '/work/bandon-by-the-dunes',
    kind: 'site',
    title: 'Bandon By The Dunes Realtee',
    desc: 'Real estate site with listings live from the RMLS feed.',
    stack: ['Astro', 'RMLS API'],
    status: 'LIVE',
    build: 'rebuild',
    built_in_days: 18,
    external_url: 'https://www.bandonbythedunesrealtee.net',
    motion: 'lighthouse',
    image: {
      src: '/work/bbtd-card.webp',
      srcSmall: '/work/bbtd-card-720.webp',
      srcXSmall: '/work/bbtd-card-480.webp',
      alt: 'Bandon By The Dunes Realtee: navy lighthouse mark on cream.',
      width: 1200,
      height: 630,
    },
  },
  {
    id: 'professors-golf',
    caseStudy: '/work/professors-golf',
    kind: 'site',
    // S339, Preston: off the homepage to make room for Makai. Stays on /work
    // with its case page.
    published: false,
    title: 'Professors Golf',
    desc: 'Site for a Bandon golf service: fitting, instruction, tee times, events.',
    stack: ['Astro', 'Cloudflare'],
    status: 'LIVE',
    build: 'new',
    external_url: 'https://professorsgolf.com',
    image: {
      src: '/work/golf-card.webp',
      srcSmall: '/work/golf-card-720.webp',
      srcXSmall: '/work/golf-card-480.webp',
      alt: 'Professors Golf, Bandon Oregon: dark green grid with a gold starburst beside Professional Golf Service in green serif on cream.',
      width: 1200,
      height: 630,
    },
    built_in_days: 1,
  },
  {
    id: 'stainslayer',
    kind: 'app',
    // Dropped from the homepage teaser 2026-09-11 (S230) when Taylor published,
    // so the grid stays at six. This is the S168 ruling, not a new decision.
    // StainSlayer keeps its full card on /work.
    published: false,
    title: 'StainSlayer AI',
    desc: 'Vision AI stain analysis. App Store + Play Store.',
    stack: ['Flutter', 'Supabase'],
    status: 'LIVE',
    build: 'new',
    built_in_days: 30,
    image: {
      src: '/work/stainslayer-card.webp',
      srcSmall: '/work/stainslayer-card-720.webp',
      srcXSmall: '/work/stainslayer-card-480.webp',
      alt: 'StainSlayer AI: rainbow stain splash with script tagline.',
      width: 1280,
      height: 625,
    },
  },
  {
    id: 'demiurge-mykonos',
    kind: 'app',
    // S339: off the homepage. The DNA keeps owned products to the Wall, Work
    // Apps and the app and AI service pages, never the home proof grid.
    published: false,
    title: 'Demiurge + MyKonos',
    desc: 'Memory engine powering the MyKonos AI companion.',
    stack: ['Demiurge', 'Flutter'],
    status: 'BETA',
    build: 'new',
    built_in_days: 14,
    image: {
      src: '/work/demiurge-card.webp',
      srcSmall: '/work/demiurge-card-720.webp',
      srcXSmall: '/work/demiurge-card-480.webp',
      alt: 'Project Demiurge: hexagonal node graph in teal with one node lit orange.',
      width: 1280,
      height: 640,
    },
  },
  {
    id: 'branding',
    kind: 'site',
    // OFF the homepage 2026-09-11 (S230), Preston's call, immediately after it
    // went live. The teaser card is built for a site or an app: it renders a
    // NEW BUILD badge and a stack row, and a logo board has neither. Putting
    // brand work in that frame made it read as a botched build card. The
    // branding work needs its own card shape before it goes back on the
    // homepage. It keeps its section on /work.
    published: false,
    title: 'Brand and graphic design',
    desc: 'Logos, wordmarks, and the color and type that go with them.',
    stack: ['Logos', 'Brand marks'],
    status: 'LIVE',
    build: 'new',
    external_url: '/logo-design',
    image: {
      src: v('/work/graphic-work-1200.webp'),
      srcSmall: v('/work/graphic-work-800.webp'),
      srcXSmall: v('/work/graphic-work-480.webp'),
      alt: 'A board of selected logo and brand work by Winters Code: nine wordmarks, emblems and full brand marks for a range of businesses, above six die-cut sticker and badge designs.',
      width: 1200,
      height: 1826,
    },
  },
];

// S339, Preston 2026-10-22: the homepage shows US Survey Supply, Makai,
// Bandon By The Dunes and SeaBreeze, in that order. Sogn and Professors Golf
// keep their /work cards and case pages. The order lives here, not in the
// array, so a card's data never has to move to change where it sits.
// S339, Preston 2026-10-28: four cards, two across: Grand, US Survey Supply,
// Makai, Bandon By The Dunes. SeaBreeze and Sogn keep their /work cards and
// case pages. Family builds lead less: Bandon By The Dunes sits fourth and is
// the next to leave the homepage; it stays for the depth and the live RMLS
// integration it shows. (The six-card layout earlier the same day is retired;
// its n6 grid rules stay for the day the grid grows again.)
const HOME_ORDER = ['grand-management', 'us-survey-supply', 'makai-painting', 'bandon-by-the-dunes'];
const HOME_SITES = HOME_ORDER
  .map((id) => CARDS.find((c) => c.id === id && c.kind === 'site' && c.published !== false))
  .filter((c): c is WorkCard => Boolean(c));
---

<section class="selected" id="work" aria-labelledby="selected-h">
  <header class="selected-head">
    <div class="selected-eyebrow">
      <span class="line" aria-hidden="true"></span>
      <h2 class="selected-h" id="selected-h">02 · SELECTED WORK</h2>
      <span class="selected-status">built and live</span>
    </div>
    <a href="/work" class="selected-link">see all →</a>
  </header>

  <div class="sw-group-head">
    <span class="line" aria-hidden="true"></span>
    <h3 class="sw-group-label">Websites</h3>
  </div>

  <ul class={`selected-grid selected-grid--n${HOME_SITES.length}`} role="list">
    {HOME_SITES.map((card) => (
      <li class="sw-card-wrap" role="listitem">
        <a
          href={card.caseStudy ?? (card.pour ? `/work#${card.id}` : card.external_url) ?? `/work#${card.id}`}
          target={!card.caseStudy && !card.pour && card.external_url ? '_blank' : undefined}
          rel={!card.caseStudy && !card.pour && card.external_url ? 'noopener' : undefined}
          class="sw-card"
          data-slug={card.id}
        >
          <div class="sw-preview" aria-hidden={card.image ? undefined : 'true'}>
            {card.image ? (
              <picture>
                {card.image.srcSmall && (
                  <source
                    type="image/webp"
                    srcset={`${card.image.srcXSmall ? card.image.srcXSmall + " 480w, " : ""}${card.image.srcSmall} 720w, ${card.image.src} 1280w`}
                    sizes="(min-width: 1024px) 320px, (min-width: 740px) 50vw, calc(100vw - 8px)"
                  />
                )}
                <img
                  src={card.image.src}
                  alt={card.image.alt}
                  width={card.image.width ?? 1280}
                  height={card.image.height ?? 640}
                  loading="lazy"
                  decoding="async"
                  class="sw-img"
                />
              </picture>
            ) : (
              <span class="sw-mark">{card.title.charAt(0)}</span>
            )}
            {card.pour && <PaintPour />}
            {card.motion && <CardMotion kind={card.motion} />}
          </div>
          <div class="sw-meta">
            <div class="sw-title-row">
              <span class="sw-title">{card.title}</span>
              <span class={`sw-status sw-status-${card.status.toLowerCase()}`}>{card.status}</span>
              <span class={`sw-status sw-build-${card.build}`}>{card.build === 'rebuild' ? 'REBUILD' : 'NEW BUILD'}</span>
            </div>
            <p class="sw-desc">{card.desc}</p>
            {card.highlights && (
              <ul class="sw-hl" role="list">
                {card.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
            <div class="sw-stack">
              {card.stack.map((s) => <span class="sw-tag">{s}</span>)}
              {card.built_in_days != null && <span class="sw-built">Built in {card.built_in_days}d</span>}
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <!-- S339, Preston 2026-10-22: Chere' leads Apps & software on the
       homepage, above any other app, with its demo video. -->
  <div class="sw-group-head">
    <span class="line" aria-hidden="true"></span>
    <h3 class="sw-group-label">Apps &amp; software</h3>
  </div>
  <ChereFeature variant="home" />

  {CARDS.some((c) => c.published !== false && c.kind === 'app') && <>
  <ul class="selected-grid selected-grid-apps sw-apps-after" role="list">
    {CARDS.filter((card) => card.published !== false && card.kind === 'app').map((card) => (
      <li class="sw-card-wrap" role="listitem">
        <a
          href={card.caseStudy ?? (card.pour ? `/work#${card.id}` : card.external_url) ?? `/work#${card.id}`}
          target={!card.caseStudy && !card.pour && card.external_url ? '_blank' : undefined}
          rel={!card.caseStudy && !card.pour && card.external_url ? 'noopener' : undefined}
          class="sw-card"
          data-slug={card.id}
        >
          <div class="sw-preview" aria-hidden={card.image ? undefined : 'true'}>
            {card.image ? (
              <picture>
                {card.image.srcSmall && (
                  <source
                    type="image/webp"
                    srcset={`${card.image.srcXSmall ? card.image.srcXSmall + " 480w, " : ""}${card.image.srcSmall} 720w, ${card.image.src} 1280w`}
                    sizes="(min-width: 1024px) 320px, (min-width: 740px) 50vw, calc(100vw - 8px)"
                  />
                )}
                <img
                  src={card.image.src}
                  alt={card.image.alt}
                  width={card.image.width ?? 1280}
                  height={card.image.height ?? 640}
                  loading="lazy"
                  decoding="async"
                  class="sw-img"
                />
              </picture>
            ) : (
              <span class="sw-mark">{card.title.charAt(0)}</span>
            )}
          </div>
          <div class="sw-meta">
            <div class="sw-title-row">
              <span class="sw-title">{card.title}</span>
              <span class={`sw-status sw-status-${card.status.toLowerCase()}`}>{card.status}</span>
              <span class={`sw-status sw-build-${card.build}`}>{card.build === 'rebuild' ? 'REBUILD' : 'NEW BUILD'}</span>
            </div>
            <p class="sw-desc">{card.desc}</p>
            <div class="sw-stack">
              {card.stack.map((s) => <span class="sw-tag">{s}</span>)}
              {card.built_in_days != null && <span class="sw-built">Built in {card.built_in_days}d</span>}
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
  </>}

  <!--
    BRAND BAND, S234. The S230 attempt put brand work in the teaser CARD,
    which is built for a build: a 140px cover-cropped preview slot, a LIVE
    badge, a NEW BUILD badge and a stack row. A logo board has none of those
    and the cover crop sliced rows of marks off, so it read as a botched
    build card and came off within minutes. This is not a card. No card
    fill, no border box around the whole thing, no status badge, no build
    badge, no stack tags, no built-in-days. A hairline band under the grid,
    the board whole at its native 3:2, one line of what the work is.
    "site" in the title, not "website", and that is deliberate. Preston's call:
    the hero sub carries "Custom websites" at the top of the page, which is the
    premium placement, so the word does not need forcing in again 2000px down.
    "website" there also wrapped the title onto a second line with one orphaned
    word on it at 393. Do not helpfully change it back.
    No eyebrow label here on purpose: the board image carries SELECTED GRAPHIC
    WORK across its own top edge, so a LOGO AND BRAND WORK eyebrow forty pixels
    under it printed the same label twice.
    Copy is NOT the /work entry. /work describes the offering to someone who
    already scrolled a portfolio; the homepage has to make the offer to someone
    who just landed. Same verified facts (ten in circulation, on signs, trucks
    and storefronts, sold with a build or alone), different sentences, and no
    line is shared between the two pages.
  -->
  <div class="sw-brand-block">
  <div class="sw-brand-head">
    <span class="line" aria-hidden="true"></span>
    <h3 class="sw-brand-label">Logo &amp; graphic design</h3>
  </div>

  <a class="sw-brand" href="/logo-design">
    <div class="sw-brand-board">
      <picture>
        <source
          type="image/webp"
          srcset={`${v('/work/graphic-work-480.webp')} 480w, ${v('/work/graphic-work-800.webp')} 800w, ${v('/work/graphic-work-1200.webp')} 1200w, ${v('/work/graphic-work-1536.webp')} 1536w`}
          sizes="(min-width: 1024px) 540px, calc(100vw - 8px)"
        />
        <img
          src={v('/work/graphic-work-1200.webp')}
          alt="A board of selected logo and brand work by Winters Code: nine wordmarks, emblems and full brand marks for a range of businesses, above six die-cut sticker and badge designs."
          width="1200"
          height="1826"
          loading="lazy"
          decoding="async"
          class="sw-brand-img"
        />
      </picture>
    </div>
    <div class="sw-brand-meta">
      <span class="sw-brand-title">I draw the mark, not just the site.</span>
      <p class="sw-brand-desc">
        These are out working on trucks, signs, storefronts and websites. Some
        came with a build, some stand alone. All of them drawn here, not picked
        off a shelf.
      </p>
      <span class="sw-brand-cta">See the logo work &rarr;</span>
    </div>
  </a>
  </div>
</section>

<style>
  .selected {
    padding: 40px 4px 48px;
    max-width: 720px;
    margin: 0 auto;
  }
  @media (min-width: 740px) {
    .selected { padding: 56px 4px 64px; max-width: 860px; }
  }
  @media (min-width: 1024px) {
    .selected { padding: 72px 0 80px; max-width: 960px; }
  }

  .selected-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--copper-hairline);
    margin-bottom: 20px;
  }
  .selected-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .selected-eyebrow .line {
    width: 28px;
    height: 1px;
    background: var(--color-copper);
  }
  @media (min-width: 1024px) { .selected-eyebrow .line { width: 40px; } }
  .selected-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-copper);
    text-transform: uppercase;
    margin: 0;
  }
  @media (min-width: 1024px) { .selected-h { font-size: 13px; } }
  .selected-status {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-ash-500);
    font-style: italic;
  }
  .selected-link {
    /* 44px touch minimum (G-027), S245 sweep. Negative margin holds the
       original layout, so the measured box and the tappable box match. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -12px 0;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-ash-400);
    transition: color 200ms;
  }
  @media (hover: hover) {

    .selected-link:hover { color: var(--color-wc-green); }}

  /* ─── Grid ─── */
  .selected-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 740px) {
    .selected-grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .sw-card-wrap:first-child { grid-column: span 2; }
  }
  @media (min-width: 1024px) {
    .selected-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 24px;
    }
    .sw-card-wrap:first-child { grid-column: auto; }
  }
  /* Four sites: two by two from tablet up, so no card sits alone in a row
     and a name never breaks mid-word (four across squeezed titles to
     "Paintin g" at 1440, S339). The art keeps its own 1200x630 shape
