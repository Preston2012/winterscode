---
import Stamp from '../ui/Stamp.astro';
import { smsHref } from '../../lib/text-cta';

const sms = smsHref(Astro.url.pathname);

/**
 * Hero, S7 ceiling pass (replaces S6 floor).
 *
 * Spec ref: docs/design/S6_PLUS.md Section 2 (~line 393).
 *
 * Critical change from S6 floor: H1 is now the emotional anchor
 * ("You didn't go into business to manage software."). The morph
 * line moves BELOW the sub as a small secondary line.
 *
 * Layout:
 *   mobile  (<768)  : single col. Eyebrow → H1 → sub → morph → CTAs → trust → shop card
 *   tablet (768-1023): single col, larger type, shop card full width under the text
 *   desktop  (≥1024): 2-col grid 1.2fr / 1fr, text left + shop card right
 *
 * S326 DNA: this card is the ONE workshop teaser on Home ("Live from the
 * shop"). The mid-page Wall block and the WORKSHOP STATUS stack are gone, so
 * the card now renders at every width (equal-forward: a phone visitor gets
 * the same peek a desktop visitor does). ENGINE is out (builder vanity, not
 * a reason to hire), CALENDAR is out (a booking cue in the hero beside Text),
 * and each row carries a plain caption for an owner who has never heard of
 * Lighthouse or Observatory.
 *
 * Trust tooltips:
 *   - Stub data for S7 ("last-known-good" pattern per Wall curation rules)
 *   - Real PSI/internal-tracker wiring lands when Preston rotates keys + PSI is provisioned
 *   - Mobile: tap to toggle. Desktop: hover.
 *
 * Morph line: vanilla JS (~700 bytes). Cycles every 3.5s automatically.
 * Click/Enter/Space advances manually, auto-resumes after 5s.
 */

const PHRASES = [
  // Ordered by Coos/Curry priority (data-anchored from Coos Co. top
  // employment sectors + Curry tourism/fishing/ag). At runtime the array
  // is Fisher-Yates shuffled on page load so no two visitors see the
  // same cycle order. kills the loop pattern, makes each visit feel
  // freshly curated. Source order preserved for sane future edits.
  // S326 DNA: index 0 is what paints before the shuffle and what a crawler
  // reads, so it leads with contractors, where the real proof is (Sogn).
  // Restaurants moved down: there is no restaurant build to back a lead.
  'websites for contractors',
  'mobile apps for fishing charters',
  'websites for vacation rentals',
  'software for property managers',
  'websites for lodging',
  'websites for restaurants',
  'tools for marinas',
  'mobile apps for tour guides',
  'websites for breweries',
  'websites for real estate agents',
  'websites for salons',
  'tools for landscapers',
  'mobile apps for food trucks',
  'websites for retail shops',
  'websites for photographers',
  'software for bookkeepers',
  'web apps for auto shops',
  'websites for farms',
  'websites for dispensaries',
  'tools for cranberry growers',
];

// Stub "last-known-good" data for trust tooltips. Replace with live
// data sources (PSI API, internal build tracker, securityheaders.com)
// once Preston rotates leaked keys and provisions PSI. Wire-up: S10.
const TRUST_TIPS = {
  price:
    'Most local business sites start at $1,750 flat, with the pages, the words, real photos, branding, and top Google scores included. One number, everything in. Bigger jobs cost more and I say so up front. The price I quote is the price you pay.',
  speed:
    'Site builds start at 3 business days, counted from the day I have what the build needs, and a bigger site gets its timeline in the quote. App builds run 2 to 4 weeks for an MVP, 4 to 8 weeks for a full build. Compare to 6 to 8 weeks just for a site at most agencies.',
  lighthouse:
    'Google\'s Lighthouse scores any website 0 to 100 on speed, accessibility, search readiness, and best practices. 100 is perfect. Most small-business sites score 50 to 70. Mine sit around a 95 average across every page (some checks dip a few points on heavy interactive pages, but the rolling average holds). Scores shown are mobile (the harder test). Desktop usually runs 2 to 5 points higher.',
  security:
    'Every site I build carries strict browser security headers: the settings that tell a browser what a page may load and who may frame it. Mozilla Observatory grades those headers. It is a header check, not a full security test. Every grade is measured live on the wall, including the one that is not an A-plus.',
};

// Live from the shop. Values here are what paints before /api/workshop
// answers, and what stays if it never does, so each is a floor that holds on
// a slow month (the Wall curation rule), never a frozen live number. The
// script below swaps in the live value by data-key, never by position.
const WORKSHOP_PREVIEW = [
  { key: 'deploys', glyph: '⚡', label: 'DEPLOYS', value: '200+ in past 30 days', cap: 'Changes I pushed live to the sites I run' },
  { key: 'lighthouse', glyph: '▲', label: 'LIGHTHOUSE', value: '~95 avg, mobile', cap: "Google's own test of this site, out of 100" },
  { key: 'security', glyph: '⬢', label: 'SECURITY', value: 'A+', cap: "Mozilla Observatory's grade for this site's security headers" },
];
---

<section class="hero" id="hero">
  <!-- Maker's stamp, top-right of hero. Replaces the magazine volume
       stamp. Doctrine: brain memory #2586. -->
  <div class="hero-mark" aria-hidden="false">
    <Stamp size={140} glow="full" priority ariaLabel="Winters Code" />
  </div>

  <div class="hero-text">
    <div class="hero-eyebrow">
      <span class="line" aria-hidden="true"></span>
      <span class="text">Bandon · Oregon</span>
    </div>

    <h1 class="hero-h1">
      Built for your business.<br class="desktop-break" />
      <span class="hero-h1-line2"> Not from a template.</span>
    </h1>

    <p class="hero-sub">
      Custom websites, apps, and tools for the <span class="keep">Oregon coast.</span><br />
      <em><a href={sms} class="hero-creed">Help is just a text away.</a></em>
    </p>

    <p class="hero-morph-line" aria-live="polite">
      I can build{' '}
      <span
        class="morph"
        id="morph-phrase"
        role="button"
        tabindex="0"
        aria-label={`Industry: ${PHRASES[0]}. Click to see another.`}
      >{PHRASES[0]}.</span>
    </p>

    <div class="hero-cta" data-textbar-hide>
      <a href={sms} class="btn btn-primary">Text Preston →</a>
      <a href="/work" class="btn btn-secondary">See the work →</a>
    </div>

    <div class="hero-trust">
      <span class="trust-item" tabindex="0" data-tip data-kind="price">
        <span class="dot" aria-hidden="true"></span>
        From $1,750, everything in
        <span class="tip" role="tooltip">{TRUST_TIPS.price}</span>
      </span>
      <span class="trust-item" tabindex="0" data-tip data-kind="speed">
        <span class="dot" aria-hidden="true"></span>
        Starts at 3 business days
        <span class="tip" role="tooltip">{TRUST_TIPS.speed}</span>
      </span>
      <span class="trust-item" tabindex="0" data-tip data-kind="lighthouse">
        <span class="dot" aria-hidden="true"></span>
        ~95 Lighthouse avg
        <span class="tip" role="tooltip">{TRUST_TIPS.lighthouse}</span>
      </span>
      <span class="trust-item" tabindex="0" data-tip data-kind="security">
        <span class="dot" aria-hidden="true"></span>
        A+ security grade
        <span class="tip" role="tooltip">{TRUST_TIPS.security}</span>
      </span>
    </div>
  </div>

  <!--
    Live from the shop: the one workshop teaser on Home (S326 DNA). Right
    column on desktop, under the hero text on tablet and phone. The pulse
    only turns green once /api/workshop has answered, so the card never
    claims "live" over numbers that are just the floors above.
  -->
  <aside class="workshop-preview" aria-labelledby="wp-h">
    <div class="wp-header">
      <h2 class="wp-eyebrow" id="wp-h">
        <span class="wp-pulse" aria-hidden="true"></span>
        Live from the shop
      </h2>
      <a href="/wall" class="wp-link">the whole shop &rarr;</a>
    </div>
    <ul class="wp-rows">
      {WORKSHOP_PREVIEW.map((row) => (
        <li class="wp-row" data-key={row.key}>
          <span class="wp-glyph" aria-hidden="true">{row.glyph}</span>
          <span class="wp-label">{row.label}</span>
          <span class="wp-value">{row.value}</span>
          <span class="wp-cap">{row.cap}</span>
        </li>
      ))}
    </ul>
  </aside>
</section>

<script
  is:inline
  type="application/json"
  id="morph-data"
  set:html={JSON.stringify(PHRASES)}
></script>

<script is:inline type="module">
  (function () {
    const el = document.getElementById('morph-phrase');
    const data = document.getElementById('morph-data');
    if (!el || !data) return;

    let phrases;
    try { phrases = JSON.parse(data.textContent || '[]'); } catch { return; }
    if (!Array.isArray(phrases) || phrases.length < 2) return;

    // Fisher-Yates shuffle on every page load. Each visit gets a fresh
    // industry order so the cycle doesn't reveal a loop pattern. We
    // copy the array first so the source order in DOM is preserved
    // for any external readers (screen-readers, scrapers).
    phrases = phrases.slice();
    for (var i = phrases.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = phrases[i]; phrases[i] = phrases[j]; phrases[j] = tmp;
    }
    // Set the initial phrase to index 0 of the shuffled order so the
    // first thing the visitor sees isn't always the first source phrase.
    el.textContent = phrases[0] + '.';
    el.setAttribute('aria-label', 'Industry: ' + phrases[0] + '. Click to see another.');

    const FADE_MS = 400;
    const AUTO_MS = 3500;
    const RESUME_MS = 5000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let idx = 0;
    let autoTimer = null;
    let resumeTimer = null;

    function advance() {
      el.style.opacity = '0';
      setTimeout(function () {
        idx = (idx + 1) % phrases.length;
        el.textContent = phrases[idx] + '.';
        el.setAttribute('aria-label', 'Industry: ' + phrases[idx] + '. Click to see another.');
        el.style.opacity = '1';
      }, FADE_MS);
    }

    function startAuto() {
      if (reduceMotion) return;
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(advance, AUTO_MS);
    }

    function handleClick() {
      if (autoTimer) clearInterval(autoTimer);
      if (resumeTimer) clearTimeout(resumeTimer);
      advance();
      resumeTimer = setTimeout(startAuto, RESUME_MS);
    }

    el.addEventListener('click', handleClick);
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        handleClick();
      }
    });

    el.style.transition = 'opacity ' + FADE_MS + 'ms ease-out, text-shadow ' + FADE_MS + 'ms ease-out';
    startAuto();
  })();

  // Trust tooltip: hover on desktop, tap-toggle on touch.
  // Closes on outside tap or another tooltip opening.
  (function () {
    const items = document.querySelectorAll('[data-tip]');
    if (!items.length) return;
    const isTouch = window.matchMedia('(hover: none)').matches;
    if (!isTouch) return; // hover handled by CSS, no JS needed

    let openItem = null;
    items.forEach(function (item) {
      item.addEventListener('click', function (e) {
        e.stopPropagation();
        if (openItem === item) {
          item.classList.remove('tip-open');
          openItem = null;
          return;
        }
        if (openItem) openItem.classList.remove('tip-open');
        item.classList.add('tip-open');
        openItem = item;
      });
    });
    document.addEventListener('click', function () {
      if (openItem) {
        openItem.classList.remove('tip-open');
        openItem = null;
      }
    });
  })();

  // Live data fetch from /api/workshop for trust tooltips + Workshop preview.
  // Falls back to baked-in last-known-good silently.
  (function () {
    fetch('/api/workshop', { signal: AbortSignal.timeout(8000) })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) return;
        // Trust tooltips
        // Looked up by WHAT THE ITEM IS, never by position. Until S245 this
        // read items[0..2] while the markup order is price, speed, lighthouse,
        // security, so every live line landed one tooltip to the left: the
        // price tip ended with build days, the speed tip ended with Lighthouse
        // scores. Both were live and both were visible to anyone who tapped.
        function tipFor(kind) {
          var el = document.querySelector('.trust-item[data-kind="' + kind + '"] .tip');
          return el;
        }
        var tSpeed = tipFor('speed'), tLh = tipFor('lighthouse'), tSec = tipFor('security');
        if (tSpeed && d.speed && d.speed.last_three) {
          tSpeed.insertAdjacentHTML('beforeend',
            '<span class="tip-live">last 3 builds: ' + d.speed.last_three + '</span>');
        }
        if (tLh && d.lighthouse && Array.isArray(d.lighthouse.winterscode)) {
          tLh.insertAdjacentHTML('beforeend',
            '<span class="tip-live">winterscode.com today: ' +
            d.lighthouse.winterscode.join('/') + '</span>');
        }
        if (tSec && d.security && d.security.grade) {
          tSec.insertAdjacentHTML('beforeend',
            '<span class="tip-live">current grade: ' + d.security.grade + '</span>');
        }
        // Live from the shop card. Rows are found by data-key, never by
        // position (the S245 tooltip lesson above).
        function wpSet(key, text) {
          var el = document.querySelector('.wp-row[data-key="' + key + '"] .wp-value');
          if (el && text) el.textContent = text;
          return !!(el && text);
        }
        var got = 0;
        if (d.deploys && typeof d.deploys.count_30d === 'number' && d.deploys.count_30d > 0)
          got += wpSet('deploys', d.deploys.count_30d + ' in past 30 days') ? 1 : 0;
        if (d.lighthouse && Array.isArray(d.lighthouse.winterscode) && d.lighthouse.winterscode.length === 4)
          got += wpSet('lighthouse', d.lighthouse.winterscode.join(' / ')) ? 1 : 0;
        if (d.security && d.security.grade)
          got += wpSet('security', d.security.grade) ? 1 : 0;
        var card = document.querySelector('.workshop-preview');
        if (card && got) card.classList.add('is-live');
      })
      .catch(function () { /* swallow, stubs already rendered */ });
  })();
</script>

<style>
  /* ─── Hero shell ─── */
  .hero {
    padding: 36px 4px 28px;
    position: relative;
  }
  @media (min-width: 740px) {
    /* Reserve right-side space on tablet so the 110px stamp doesn't
       overlap the H1. The stamp is fixed top-right inside .hero, so
       hero-text needs its own right-pad on this breakpoint only. */
    .hero { padding: 56px 4px 40px; }
    .hero-text { padding-right: 170px; }
  }
  @media (min-width: 1024px) {
    .hero {
      padding: 80px 0 60px;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
      align-items: center;
    }
  }

  .hero-text { position: relative; }

  /* ─── Eyebrow (line + locale) ─── */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .hero-eyebrow .line {
    width: 32px;
    height: 1px;
    background: var(--color-copper);
  }
  .hero-eyebrow .text {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-copper);
  }
  @media (min-width: 1024px) {
    .hero-eyebrow .line { width: 48px; }
    .hero-eyebrow .text { font-size: 13px; }
  }

  /* ─── H1 (emotional anchor) ─── */
  .hero-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ash-100);
    margin: 32px 0 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
    hyphens: auto;
    word-break: normal;
  }
  .hero-h1-line2 {
    font-style: italic;
    color: var(--color-ash-300);
  }
  .desktop-break { display: none; }
  @media (min-width: 740px) {
    .hero-h1 {
      font-size: 44px;
      line-height: 1.08;
      margin-top: 0;
    }
    /* Force the line break at tablet too so line 1 ("...into business")
       ends before the maker's-mark zone top-right. Without this the H1
       runs full width and collides with the stamp. */
    .desktop-break { display: inline; }
  }
  @media (min-width: 1024px) {
    .hero-h1 {
      font-size: 56px;
      line-height: 1.05;
    }
  }

  /* ─── Sub ─── */
  .hero-sub {
    margin: 18px 0 0;
    max-width: 540px;
    font-size: 14px;
    color: var(--color-ash-300);
    line-height: 1.55;
  }
  /* Preston's call: hold "Oregon coast." together so it drops to its own line
     directly above "Help is just a text away." The two then read as one
     sentence to anyone scanning, which is the whole point. */
  .hero-sub .keep { white-space: nowrap; }
  .hero-sub em {
    color: var(--color-ash-100);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  /* The creed is wired to the control (S326 DNA): the tagline itself opens
     the same text as the button below it. Quiet underline, no button look. */
  .hero-creed {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: rgba(200, 128, 74, 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 200ms, text-decoration-color 200ms;
  }
  @media (hover: hover) {
    .hero-creed:hover {
      color: var(--color-wc-green);
      text-decoration-color: var(--color-wc-green);
    }
  }
  @media (min-width: 740px) {
    .hero-sub { font-size: 15px; margin-top: 20px; }
  }
  @media (min-width: 1024px) {
    .hero-sub {
      font-size: 17px;
      max-width: 560px;
      line-height: 1.5;
      margin-top: 24px;
    }
  }

  /* ─── Morph line (small secondary line BELOW sub) ─── */
  .hero-morph-line {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-ash-400);
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0;
  }
  @media (min-width: 740px) {
    .hero-morph-line { font-size: 14px; }
  }
  @media (min-width: 1024px) {
    .hero-morph-line { font-size: 15px; margin-top: 18px; }
  }
  .morph {
    /* 44px touch minimum (G-027). Measured 22px tall on production at S245 while
       carrying role="button" and tabindex, so it advertised itself as tappable
       at half the size a finger needs. Padding grows the hit area, the matching
       negative margin keeps the sentence on its original line. */
    padding: 12px 0;
    margin: -12px 0;
    display: inline-block;
    color: var(--color-wc-green);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    position: relative;
  }
  /* The dashed underline is a pseudo-element, not a border. A border sits on the
     padding edge, and the padding is what buys the 44px hit area, so as a border
     it dropped 11px below the text. This keeps it tight under the words while
     the box stays 44 tall. */
  .morph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    border-bottom: 1px dashed rgba(77, 216, 168, 0.3);
  }
  @media (hover: hover) {

    .morph:hover::after {
    border-bottom-color: var(--color-wc-green);
  }}
  .morph:focus-visible {
    outline: 2px solid var(--color-wc-green);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ─── CTAs ─── */
  .hero-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 26px;
  }
  @media (min-width: 740px) {
    .hero-cta {
      gap: 12px;
      max-width: 480px;
      margin-top: 32px;
    }
  }

  /* Shared button base, used by hero + 404 + future CTAs */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 18px;
    border-radius: var(--radius-btn);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-align: center;
    cursor: pointer;
    transition: all 200ms;
    border: 1.5px solid transparent;
    white-space: nowrap;
    min-height: 44px;
  }
  :global(.btn-primary) {
    background: var(--color-wc-green);
    color: var(--color-bg-deep);
    box-shadow: 0 1px 0 rgba(240, 160, 110, 0.3) inset;
  }
  @media (hover: hover) {

    :global(.btn-primary:hover) {
    background: var(--color-wc-green-bright);
    transform: translateY(-1px);
  }}
  :global(.btn-secondary) {
    background: transparent;
    color: var(--color-ash-100);
    border-color: var(--copper-hairline);
  }
  @media (hover: hover) {

    :global(.btn-secondary:hover) {
    border-color: var(--color-copper);
    color: var(--color-copper-bright);
  }}
  @media (min-width: 740px) {
    :global(.btn) { padding: 15px 22px; font-size: 15px; }
  }

  /* ─── Trust signals ─── */
  .hero-trust {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  @media (min-width: 740px) {
    .hero-trust { gap: 12px 22px; margin-top: 32px; padding-top: 24px; }
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-ash-400);
    font-weight: 500;
    cursor: help;
    /* static on purpose: the tip resolves against .hero-trust, not against the
       item, so it can never be pushed off an edge by where its item sits. */
    position: static;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    padding-bottom: 1px;
  }
  @media (min-width: 740px) {
    .trust-item { font-size: 13px; }
  }
  .trust-item .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-wc-green);
  }
  .trust-item:focus-visible {
    color: var(--color-ash-100);
    border-bottom-color: var(--color-wc-green);
    outline: none;
  }

  @media (hover: hover) {

    .trust-item:hover {
    color: var(--color-ash-100);
    border-bottom-color: var(--color-wc-green);
    outline: none;
  }}
  .trust-item .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--color-bg-card);
    border: 1px solid var(--copper-hairline);
    color: var(--color-ash-100);
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 12px;
    line-height: 1.45;
    width: auto;
    white-space: normal;
    text-align: left;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms;
    z-index: 10;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    font-family: var(--font-sans);
  }
  /* Live-data line appended after plain text by the workshop fetch.
     :global on the last step is load bearing. Astro scopes every selector with
     a data-astro-cid attribute, and this span is created at runtime by
     insertAdjacentHTML so it never gets one. Scoped, the rule matched nothing,
     the span fell back to inline, and every tooltip ended with its live line
     jammed onto the last sentence with no space: "the price you pay.last 3
     builds: 3d". Preston caught it on the preview. */
  .trust-item .tip :global(.tip-live) {
    display: block;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px dashed var(--copper-hairline);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-copper-bright);
    letter-spacing: 0.02em;
  }
  /* The tip spans the trust row at EVERY width. It used to be centred on its
     own item with max-width min(300px, 80vw), which put the tip's position at
     the mercy of where its item happened to sit: the first item pushed its tip
     off the left edge, the last pushed off the right. Measured on production
     before any change, that overflowed at 320, 360, 393, 430, 600, 739, 768,
     1024 and 1280. Every width it was ever tested at. Pinning both edges to
     .hero-trust makes the geometry independent of the item, so there is no
     width at which it can fail. */
  .trust-item .tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 16px;
    border: 5px solid transparent;
    border-top-color: var(--copper-hairline);
