---
import { smsHref } from '../../lib/text-cta';

const sms = smsHref(Astro.url.pathname);

/**
 * Hero, S339 HONE-SPEC (Nov 4) pass.
 *
 * Left: eyebrow, H1, one plain sub with the price, Text (filled) and See the
 * work (outline), then the reply-time line and the free audit. Right: real
 * work instead of a badge: a phone-frame screenshot of ussurveysupply.com
 * (the portfolio clause in the USS contract covers it) with its build facts
 * and one link to the Wall. On phones the screenshot sits under the reply
 * line, so Text is the first thing a thumb reaches.
 *
 * Cut in this pass, per the spec: the industry rotator, the maker's stamp,
 * the "Live from the shop" panel (the Wall shows the same numbers live), and
 * the four trust chips with their tooltip essays. The "Why $1,750" block
 * under the hero replaces the chips.
 *
 * Facts on the caption, verified against the USS case page: 42 pages,
 * 8 business days of build time.
 */
---

<section class="hero" id="hero">
  <div class="hero-text">
    <div class="hero-eyebrow">
      <span class="line" aria-hidden="true"></span>
      <span class="text">Bandon · Oregon</span>
    </div>

    <h1 class="hero-h1">
      Built for your business.<br class="desktop-break" />
      <span class="hero-h1-line2"> Not from a template.</span>
    </h1>

    <p class="hero-sub">
      Hand-built websites from $1,750 that you own, fast on a phone, from a
      builder in Bandon you can text.
    </p>

    <div class="hero-cta" data-textbar-hide>
      <a href={sms} class="btn btn-primary">Text Preston →</a>
      <a href="/work" class="btn btn-secondary">See the work →</a>
    </div>

    <p class="hero-reply">I answer my texts within a few hours during business days.</p>
    <p class="hero-audit">
      Not sure what's wrong with your site?
      <a href="/audit">Run the free audit. No email needed. →</a>
    </p>
  </div>

  <figure class="hero-proof">
    <a href="/work/us-survey-supply" class="hero-phone" aria-label="US Survey Supply, the case study">
      <span class="hero-phone-notch" aria-hidden="true"></span>
      <picture>
        <source type="image/avif" srcset="/work/uss-phone-280.avif 280w, /work/uss-phone-420.avif 420w, /work/uss-phone-560.avif 560w" sizes="(min-width: 1024px) 280px, 240px" />
        <img
          src="/work/uss-phone-420.webp"
          srcset="/work/uss-phone-280.webp 280w, /work/uss-phone-420.webp 420w, /work/uss-phone-560.webp 560w"
          sizes="(min-width: 1024px) 280px, 240px"
          width="280" height="560"
          alt="The US Survey Supply homepage on a phone"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </a>
    <figcaption class="hero-proof-cap">
      <span class="hero-proof-facts">US Survey Supply · 42-page rebuild · built in 8 business days</span>
      <a href="/wall" class="hero-proof-link">Scored live on the Wall →</a>
    </figcaption>
  </figure>
</section>

<style>
  /* ─── Hero shell ─── */
  .hero {
    padding: 52px 4px 28px;
    position: relative;
  }
  @media (min-width: 740px) {
    /* Reserve right-side space on tablet so the 110px stamp doesn't
       overlap the H1. The stamp is fixed top-right inside .hero, so
       hero-text needs its own right-pad on this breakpoint only. */
    .hero { padding: 56px 4px 40px; }
  }
  @media (min-width: 1024px) {
    .hero {
      padding: 80px 0 60px;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 60px;
      align-items: center;
    }
  }

  .hero-text { position: relative; }

  /* ─── Eyebrow (line + locale) ─── */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .hero-eyebrow .line {
    width: 32px;
    height: 1px;
    background: var(--color-copper);
  }
  .hero-eyebrow .text {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-copper);
  }
  @media (min-width: 1024px) {
    .hero-eyebrow .line { width: 48px; }
    .hero-eyebrow .text { font-size: 13px; }
  }

  /* ─── H1 (emotional anchor) ─── */
  .hero-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ash-100);
    margin: 32px 0 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
    hyphens: auto;
    word-break: normal;
  }
  .hero-h1-line2 {
    font-style: italic;
    color: var(--color-ash-300);
  }
  .desktop-break { display: none; }
  @media (min-width: 740px) {
    .hero-h1 {
      font-size: 44px;
      line-height: 1.08;
      margin-top: 0;
    }
    .desktop-break { display: inline; }
  }
  @media (min-width: 1024px) {
    .hero-h1 {
      font-size: 56px;
      line-height: 1.05;
    }
  }

  /* ─── Sub ─── */
  .hero-sub {
    margin: 18px 0 0;
    max-width: 540px;
    font-size: 14px;
    color: var(--color-ash-300);
    line-height: 1.55;
  }
  @media (min-width: 740px) {
    .hero-sub { font-size: 15px; margin-top: 20px; }
  }
  @media (min-width: 1024px) {
    .hero-sub {
      font-size: 17px;
      max-width: 560px;
      line-height: 1.5;
      margin-top: 24px;
    }
  }

  /* ─── CTAs ─── */
  .hero-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 26px;
  }
  @media (min-width: 740px) {
    .hero-cta {
      gap: 12px;
      max-width: 480px;
      margin-top: 32px;
    }
  }

  /* Shared button base, used by hero + 404 + future CTAs */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 18px;
    border-radius: var(--radius-btn);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-align: center;
    cursor: pointer;
    transition: all 200ms;
    border: 1.5px solid transparent;
    white-space: nowrap;
    min-height: 44px;
  }
  :global(.btn-primary) {
    background: var(--color-wc-green);
    color: var(--color-bg-deep);
    box-shadow: 0 1px 0 rgba(240, 160, 110, 0.3) inset;
  }
  @media (hover: hover) {

    :global(.btn-primary:hover) {
    background: var(--color-wc-green-bright);
    transform: translateY(-1px);
  }}
  :global(.btn-secondary) {
    background: transparent;
    color: var(--color-ash-100);
    border-color: var(--copper-hairline);
  }
  @media (hover: hover) {

    :global(.btn-secondary:hover) {
    border-color: var(--color-copper);
    color: var(--color-copper-bright);
  }}
  @media (min-width: 740px) {
    :global(.btn) { padding: 15px 22px; font-size: 15px; }
  }

  /* ─── Reply line and audit, right under the buttons ─── */
  .hero-reply {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ash-300);
  }
  .hero-audit {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ash-400);
  }
  .hero-audit a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-wc-green);
    text-decoration: underline;
    text-decoration-color: rgba(77, 216, 168, 0.35);
    text-underline-offset: 4px;
  }
  @media (hover: hover) { .hero-audit a:hover { text-decoration-color: var(--color-wc-green); } }
  @media (min-width: 740px) { .hero-reply, .hero-audit { font-size: 14px; } }

  /* ─── Proof: a real client site in a phone frame ─── */
  .hero-proof {
    margin: 34px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  @media (min-width: 1024px) { .hero-proof { margin: 0; } }
  .hero-phone {
    position: relative;
    display: block;
    width: 240px;
    aspect-ratio: 1 / 2.04;
    padding: 30px 10px 12px;
    border-radius: 34px;
    background: linear-gradient(160deg, #1d2422, #0c100f);
    border: 1px solid var(--copper-hairline);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6) inset, 0 24px 60px rgba(0, 0, 0, 0.55), 0 0 40px rgba(77, 216, 168, 0.06);
    transition: transform 240ms ease, box-shadow 240ms ease;
  }
  @media (min-width: 1024px) { .hero-phone { width: 280px; } }
  .hero-phone picture, .hero-phone img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 6px 6px 25px 25px;
    object-fit: cover;
    object-position: top center;
  }
  .hero-phone-notch {
    position: absolute;
    z-index: 1;
    top: 10px;
    left: 50%;
    width: 58px;
    height: 12px;
    transform: translateX(-50%);
    border-radius: 10px;
    background: #050706;
  }
  .hero-phone:focus-visible { outline: 2px solid var(--color-wc-green); outline-offset: 6px; }
  @media (hover: hover) {
    .hero-phone:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6) inset, 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 48px rgba(77, 216, 168, 0.12);
    }
  }
  @media (prefers-reduced-motion: reduce) { .hero-phone { transition: none; } }
  .hero-proof-cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    text-align: center;
  }
  .hero-proof-facts {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ash-300);
  }
  .hero-proof-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    color: var(--color-ash-300);
    text-decoration: underline;
    text-decoration-color: var(--copper-hairline);
    text-underline-offset: 4px;
  }
  @media (hover: hover) { .hero-proof-link:hover { color: var(--color-copper-bright); } }
</style>
