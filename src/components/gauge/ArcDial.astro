---
/**
 * ArcDial, a 270 degree gauge dial drawn from the brand: true black, a thin
 * track, a filled arc, micro-ticks on the bezel and one needle. The gap sits at
 * the bottom, which is where the readout goes.
 *
 * Everything here is geometry computed at build time. Nothing is fetched and
 * nothing on it is live data: the pages that use it label their figures as
 * illustrations.
 *
 *   value   0 to 1, how far the arc fills and where the needle points
 *   color   the arc colour (teal, amber, violet, crimson in the brand)
 *   grain   0 smooth to 3 heavy: uncertainty shown as texture, on the filled arc
 *   ticks   draw the bezel ticks
 *   readout big number inside the dial (only where the dial is large enough)
 *   caption small mono line under the number
 *   animate sweep the needle and arc once on load, only when motion is allowed
 *   label   accessible name; the dial is an image with this text
 */
interface Props {
  value: number;
  color?: string;
  grain?: 0 | 1 | 2 | 3;
  ticks?: boolean;
  readout?: string;
  caption?: string;
  animate?: boolean;
  label: string;
}
const { value, color = '#2dd4bf', grain = 0, ticks = true, readout, caption, animate = false, label } = Astro.props;

const C = 100;
const R = 84;
const START = 135;
const SPAN = 270;
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)] as const;
};
const f = (n: number) => n.toFixed(2);
const [x1, y1] = pt(START, R);
const [x2, y2] = pt(START + SPAN, R);
const arc = `M ${f(x1)} ${f(y1)} A ${R} ${R} 0 1 1 ${f(x2)} ${f(y2)}`;

const tickList = ticks
  ? Array.from({ length: 28 }, (_, i) => {
      const major = i % 9 === 0;
      const [ax, ay] = pt(START + i * 10, major ? 91 : 92);
      const [bx, by] = pt(START + i * 10, major ? 99 : 96);
      return { ax: f(ax), ay: f(ay), bx: f(bx), by: f(by), major };
    })
  : [];

const v = Math.min(1, Math.max(0, value));
const needleDeg = START + v * SPAN;
---

<svg
  class:list={['gz-dial', { 'gz-dial--anim': animate }]}
  viewBox="0 0 200 200"
  role="img"
  aria-label={label}
  focusable="false"
  style={`--c:${color};--v:${(v * 100).toFixed(1)};--na:${needleDeg.toFixed(1)}deg`}
>
  {tickList.map((t) => (
    <line class:list={['gz-tick', { 'gz-tick--major': t.major }]} x1={t.ax} y1={t.ay} x2={t.bx} y2={t.by} />
  ))}
  <path class="gz-track" d={arc} pathLength="100" />
  <path class="gz-fill" d={arc} pathLength="100" filter={grain ? `url(#gz-g${grain})` : undefined} />
  <g class="gz-needle">
    <line x1="88" y1="100" x2="170" y2="100" />
  </g>
  <circle class="gz-hub" cx="100" cy="100" r="4.5" />
  {readout && <text class="gz-read" x="100" y="152" text-anchor="middle">{readout}</text>}
  {caption && <text class="gz-cap" x="100" y="172" text-anchor="middle">{caption}</text>}
</svg>

<style>
  .gz-dial { display: block; width: 100%; height: auto; overflow: visible; }
  .gz-track { fill: none; stroke: #1b2024; stroke-width: 8; stroke-linecap: round; }
  .gz-fill {
    fill: none;
    stroke: var(--c);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: var(--v) 100;
  }
  .gz-tick { stroke: #3a4651; stroke-width: 1; }
  .gz-tick--major { stroke: #7b8aa0; stroke-width: 1.6; }
  .gz-needle { transform-origin: 100px 100px; transform: rotate(var(--na)); }
  .gz-needle line { stroke: #e2e8f0; stroke-width: 2.2; stroke-linecap: round; }
  .gz-hub { fill: var(--c); }
  .gz-read {
    font-family: var(--gz-display, 'Space Grotesk', sans-serif);
    font-weight: 600;
    font-size: 34px;
    fill: #e2e8f0;
    font-variant-numeric: tabular-nums;
  }
  .gz-cap {
    font-family: var(--gz-mono, 'JetBrains Mono', monospace);
    font-size: 8.5px;
    letter-spacing: 0.16em;
    fill: #94a3b8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gz-dial--anim .gz-fill { animation: gz-fill 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
    .gz-dial--anim .gz-needle { animation: gz-sweep 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
  }
  @keyframes gz-fill { from { stroke-dasharray: 0 100; } }
  @keyframes gz-sweep { from { transform: rotate(135deg); } }
</style>
