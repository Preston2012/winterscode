---
/**
 * CaseStudyLayout, shared scaffold for per-project case-study pages under
 * /work/<slug>. Facts (stack, scope, result, quote, links, image) come from
 * the real portfolio data in src/lib/portfolio.ts so nothing drifts or gets
 * invented. The page file passes only the narrative framing.
 *
 * S187: three additions, all driven by measurement.
 *
 *   BREADCRUMBS. The page emitted a BreadcrumbList and showed no trail. The
 *   same `crumbs` array now feeds both, so they cannot disagree.
 *
 *   STATS. A band of real measured numbers. Real numbers beat adjectives, and
 *   a case study that only asserts quality is a page of adjectives.
 *
 *   SECTIONS. Optional named blocks between the build table and the quote.
 *   The two original case studies measured 200 and 240 unique text shingles
 *   after boilerplate removal, the thinnest content pages on the site outside
 *   the blog index. A hero, three paragraphs and a definition list is not
 *   enough page to rank or to convince, and these are the pages that have to
 *   do the convincing.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import MobileMenu from '../layout/MobileMenu.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import PageHero from '../sections/PageHero.astro';
import Divider from '../ui/Divider.astro';
import RelatedLinks from '../sections/RelatedLinks.astro';
import Contact from '../sections/Contact.astro';
import { portfolio } from '../../lib/portfolio';
import type { PortfolioItem } from '../../lib/portfolio';
import { breadcrumbSchema, absUrl, BUSINESS_ID } from '../../lib/schema';

interface RelatedLink { href: string; label: string; sub?: string }
interface Stat { value: string; label: string }
interface Section { h: string; body: string[] }
interface Props {
  slug: string;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  sub: string;
  /** Narrative paragraphs (HTML allowed). */
  intro: string[];
  /** Measured numbers. Every one must be verifiable. */
  stats?: Stat[];
  /** Named blocks after the build table. */
  sections?: Section[];
  relatedLinks: RelatedLink[];
}

const {
  slug, title, description, eyebrow, h1, sub,
  intro, stats = [], sections = [], relatedLinks,
} = Astro.props;
const item = portfolio.find((p) => p.slug === slug) as PortfolioItem;
const path = `/work/${slug}`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
  { name: item.name, path },
];
const breadcrumbLd = breadcrumbSchema(crumbs);
// CreativeWork node for the project, attributed to the business. Real values only.
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: item.name,
  url: absUrl(path),
  description,
  creator: { '@id': BUSINESS_ID },
  ...(item.image ? { image: absUrl(item.image.src) } : {}),
};

// Divider labels run in document order so adding a section never leaves a gap.
let n = 0;
const nx = () => String(++n).padStart(2, '0');
---

<BaseLayout title={title} description={description} canonicalPath={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <PageHero eyebrow={eyebrow} h1={h1} sub={sub} />

  <Divider label={nx()} />

  {item.image && (
    <section class="cs-hero-img" aria-hidden="false">
      <img
        src={item.image.src}
        srcset={item.image.srcSmall ? `${item.image.srcXSmall ?? item.image.src} 480w, ${item.image.srcSmall} 720w, ${item.image.src} 1200w` : undefined}
        sizes="(min-width: 1024px) 960px, 100vw"
        alt={item.image.alt}
        width={item.image.width}
        height={item.image.height}
        loading="eager"
        decoding="async"
      />
    </section>
  )}

  <section class="cs-intro" aria-label="Overview">
    {intro.map((p) => <p class="cs-lead" set:html={p} />)}
  </section>

  {stats.length > 0 && (
    <section class="cs-stats" aria-label="By the numbers">
      {stats.map((s) => (
        <div class="cs-stat">
          <span class="cs-stat-v" set:html={s.value} />
          <span class="cs-stat-l">{s.label}</span>
        </div>
      ))}
    </section>
  )}

  <Divider label={nx()} />

  <section class="cs-block" aria-labelledby="cs-build-h">
    <h2 class="cs-h" id="cs-build-h">The build</h2>
    <dl class="cs-details">
      {item.details.map((d) => (
        <div class="cs-row">
          <dt>{d.label}</dt>
          <dd>{d.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {sections.map((s, i) => (
    <>
      <Divider label={nx()} />
      <section class="cs-block" aria-labelledby={`cs-sec-${i}`}>
        <h2 class="cs-h" id={`cs-sec-${i}`}>{s.h}</h2>
        {s.body.map((p) => <p class="cs-lead" set:html={p} />)}
      </section>
    </>
  ))}

  {item.quote && (
    <>
      <Divider label={nx()} />
      <section class="cs-quote-wrap" aria-label="Quote">
        <blockquote class="cs-quote">
          <p>{item.quote.text}</p>
          <cite>{item.quote.attr}</cite>
        </blockquote>
      </section>
    </>
  )}

  {item.links.length > 0 && (
    <section class="cs-links">
      {item.links.map((l) => (
        <a href={l.href} class={`cs-link${l.primary ? ' primary' : ''}`} target="_blank" rel="noopener">{l.label}</a>
      ))}
    </section>
  )}

  <Divider label={nx()} />

  <RelatedLinks id="cs-related" title="Related" links={relatedLinks} />

  <Divider label={nx()} />

  <Contact sectionNumber={String(n).padStart(2, '0')} centered suppressHeader />
</BaseLayout>

<style>
  .cs-hero-img { max-width: 960px; margin: 0 auto; padding: 8px 4px 0; }
  .cs-hero-img img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card, 10px);
    border: 1px solid var(--copper-hairline);
  }
  .cs-intro { padding: 20px 4px 8px; max-width: 720px; margin: 0 auto; }
  .cs-lead {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ash-300);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  @media (min-width: 740px) { .cs-lead { font-size: 17px; } }
  .cs-lead :global(strong) { color: var(--color-ash-100); font-weight: 600; }
  .cs-lead :global(em) { color: var(--color-copper-bright); font-style: italic; font-family: var(--font-serif); }

  /* Stats band. auto-fit so three, four or five all sit right, and so it
     collapses to two columns on a phone instead of overflowing. */
  .cs-stats {
    max-width: 720px;
    margin: 4px auto 0;
    padding: 0 4px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--copper-hairline);
    border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card, 10px);
    overflow: hidden;
  }
  .cs-stat {
    background: var(--color-bg-card);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cs-stat-v {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.1;
    color: var(--color-copper-bright);
  }
  .cs-stat-l {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ash-300);
    line-height: 1.4;
  }

  .cs-block { padding: 28px 4px 20px; max-width: 720px; margin: 0 auto; }
  .cs-h { font-family: var(--font-serif); font-size: 26px; font-weight: 600; color: var(--color-ash-100); margin: 0 0 16px; }
  @media (min-width: 740px) { .cs-h { font-size: 34px; } }
  .cs-details { margin: 0; display: grid; gap: 0; }
  .cs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  @media (min-width: 740px) { .cs-row { grid-template-columns: 140px 1fr; gap: 18px; } }
  .cs-row:last-child { border-bottom: 0; }
  .cs-row dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0;
    padding-top: 2px;
  }
  .cs-row dd {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ash-300);
    margin: 0;
  }

  .cs-quote-wrap { padding: 8px 4px; max-width: 720px; margin: 0 auto; }
  .cs-quote {
    margin: 0;
    padding: 20px 22px;
    background: var(--color-bg-card);
    border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card, 10px);
  }
  .cs-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.4;
    color: var(--color-ash-100);
    margin: 0 0 10px;
  }
  @media (min-width: 740px) { .cs-quote p { font-size: 24px; } }
  .cs-quote cite {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-copper);
  }

  .cs-links { max-width: 720px; margin: 18px auto 0; padding: 0 4px; display: flex; flex-wrap: wrap; gap: 10px; }
  .cs-link {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-wc-green);
    border: 1px solid var(--color-wc-green-dim, rgba(77, 216, 168, 0.4));
    border-radius: 6px;
    padding: 9px 14px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .cs-link.primary { background: rgba(77, 216, 168, 0.08); }
  .cs-link:hover, .cs-link:focus-visible {
    background-color: var(--color-wc-green);
    color: var(--color-bg-deep);
    outline: none;
  }
</style>
