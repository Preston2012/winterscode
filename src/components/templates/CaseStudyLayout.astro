---
/**
 * CaseStudyLayout, shared scaffold for per-project case-study pages under
 * /work/<slug>. Facts (stack, scope, result, quote, links, image) come from
 * the real portfolio data in src/lib/portfolio.ts so nothing drifts or gets
 * invented. The page file passes only the narrative framing.
 *
 * S187: three additions, all driven by measurement.
 *
 *   BREADCRUMBS. The page emitted a BreadcrumbList and showed no trail. The
 *   same `crumbs` array now feeds both, so they cannot disagree.
 *
 *   STATS. A band of real measured numbers. Real numbers beat adjectives, and
 *   a case study that only asserts quality is a page of adjectives.
 *
 *   SECTIONS. Optional named blocks after the build table.
 *
 *   QUOTE (S339). A client's own words sit right after the numbers and
 *   before the Text button: proof, then the ask. It used to close the page
 *   under the build table, where the one real review on the site was the
 *   last thing anyone reached.
 *
 * S326 DNA. Text is the climax, not Visit: a Text block right after the
 * stats band, and the page's ending is "Text me about a build like this" with
 * the live site as a quiet secondary link. The build table leads with what
 * the work did (scope, result) and puts the stack last, because the reader is
 * an owner deciding whether to text, not a developer auditing the stack.
 *   The two original case studies measured 200 and 240 unique text shingles
 *   after boilerplate removal, the thinnest content pages on the site outside
 *   the blog index. A hero, three paragraphs and a definition list is not
 *   enough page to rank or to convince, and these are the pages that have to
 *   do the convincing.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import MobileMenu from '../layout/MobileMenu.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import PageHero from '../sections/PageHero.astro';
import Fold from '../ui/Fold.astro';
import CardArt from '../ui/CardArt.astro';
import Arrow from '../ui/Arrow.astro';
import RelatedLinks from '../sections/RelatedLinks.astro';
import Contact from '../sections/Contact.astro';
import TextCta from '../ui/TextCta.astro';
import ClientQuote from '../ui/ClientQuote.astro';
import { portfolio } from '../../lib/portfolio';
import type { PortfolioItem } from '../../lib/portfolio';
import { breadcrumbSchema, absUrl, BUSINESS_ID } from '../../lib/schema';

interface RelatedLink { href: string; label: string; sub?: string }
interface EndLink { href: string; label: string; external?: boolean }
interface Stat { value: string; label: string }
interface Section { h: string; body: string[] }
interface Props {
  slug: string;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  sub: string;
  /** Narrative paragraphs (HTML allowed). */
  intro: string[];
  /** Measured numbers. Every one must be verifiable. */
  stats?: Stat[];
  /** Named blocks after the build table. */
  sections?: Section[];
  relatedLinks: RelatedLink[];
  /** Quiet links beside the closing Text button. Default: the live site, then pricing. */
  endLinks?: EndLink[];
}

const {
  slug, title, description, eyebrow, h1, sub,
  intro, stats = [], sections = [], relatedLinks, endLinks,
} = Astro.props;
const item = portfolio.find((p) => p.slug === slug) as PortfolioItem;
const path = `/work/${slug}`;

// Outcome first: scope and result before the stack.
const details = [...item.details].sort(
  (a, b) => Number(a.label === 'Stack') - Number(b.label === 'Stack'),
);
const visit = item.links.find((l) => l.primary) ?? item.links[0];
// S339 round 4 (Preston: "don't bury and hide important stuff"): the first
// time the story names the client, the name links to their live site.
// The story may use a shorter name ("SeaBreeze", "Baseline"), so the full
// name is tried first, then its first four words, then its first word when
// that word is a name and not a place.
let named = false;
const esc = (t: string) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const words = item.name.split(' ');
const PLACES = new Set(['Bandon', 'Coos', 'Grand', 'South', 'US', 'North']);
const names = [item.name, words.slice(0, 4).join(' '), ...(PLACES.has(words[0]) || words[0].length < 5 ? [] : [words[0]])];
const introLinked = intro.map((para) => {
  if (named || !visit) return para;
  for (const n of names) {
    const re = new RegExp(`\\b${esc(n)}\\b`);
    if (!re.test(para)) continue;
    named = true;
    return para.replace(re, `<a class="cs-client" href="${visit.href}" target="_blank" rel="noopener">${n}</a>`);
  }
  return para;
});
const closing: EndLink[] = endLinks ?? [
  ...(visit ? [{ href: visit.href, label: 'Visit the live site', external: true }] : []),
  { href: '/pricing', label: 'See pricing' },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
  { name: item.name, path },
];
const breadcrumbLd = breadcrumbSchema(crumbs);
// CreativeWork node for the project, attributed to the business. Real values only.
const workLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: item.name,
  url: absUrl(path),
  description,
  creator: { '@id': BUSINESS_ID },
  ...(item.image ? { image: absUrl(item.image.src) } : {}),
};

---

<BaseLayout title={title} description={description} canonicalPath={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(workLd)} />
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <!-- S339 round 3 (Preston 2026-11-21: fold, cut numbers, every word
       earns its place). The numbered dividers are gone; the story and the
       numbers stay open, the build table and the named sections fold (their
       text stays in the HTML for search), and one Text key carries the live
       site link instead of two Text blocks. -->
  <PageHero eyebrow={eyebrow} h1={h1} sub={sub} />

  {visit && (
    <p class="cs-visit">
      <a class="wc-btn wc-btn--ghost" href={visit.href} target="_blank" rel="noopener">Visit {visit.href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} <Arrow dir="up-right" size={16} /></a>
    </p>
  )}

  {item.image && (
    <section class="cs-hero-img" aria-label={`${item.name}, live site`}>
      {visit ? (
        <a class="cs-hero-link" href={visit.href} target="_blank" rel="noopener">
          <CardArt slug={slug} image={item.image} eager sizes="(min-width: 1024px) 960px, 100vw" />
          <span class="cs-hero-chip">Open the live site <Arrow dir="up-right" size={14} /></span>
        </a>
      ) : (
        <CardArt slug={slug} image={item.image} eager sizes="(min-width: 1024px) 960px, 100vw" />
      )}
    </section>
  )}

  {stats.length > 0 && (
    <section class="cs-stats wc-plate wc-rv" aria-label="By the numbers">
      {stats.map((s) => (
        <div class="cs-stat">
          <span class="cs-stat-v" set:html={s.value} />
          <span class="cs-stat-l">{s.label}</span>
        </div>
      ))}
    </section>
  )}

  <section class="cs-intro" aria-label="Overview">
    {introLinked.map((p) => <p class="cs-lead" set:html={p} />)}
  </section>

  {item.quote && (
    <section class="cs-quote-wrap" aria-label="In the client's words">
      <ClientQuote quote={item.quote} />
    </section>
  )}

  <section class="cs-block cs-cta" aria-label="Text Preston about a build like this">
    <TextCta label="Text me about a build like this" about={item.name} links={closing} />
  </section>

  <section class="cs-folds" aria-label="More about the build">
    <Fold title="The build" meta={details.map((d) => d.label).join(' · ')}>
      <dl class="cs-details">
        {details.map((d) => (
          <div class="cs-row">
            <dt>{d.label}</dt>
            <dd>{d.value}</dd>
          </div>
        ))}
      </dl>
    </Fold>
    {sections.map((s) => (
      <Fold title={s.h}>
        {s.body.map((p) => <p class="cs-lead" set:html={p} />)}
      </Fold>
    ))}
  </section>

  <RelatedLinks id="cs-related" title="Related" links={relatedLinks} />

  <Contact />
</BaseLayout>

<style>
  .cs-hero-img { max-width: 960px; margin: 0 auto; padding: 4px 0 0; }
  .cs-hero-img img {
    width: 100%;
    height: auto;
    border-radius: var(--wc-r-lg);
    border: 1px solid var(--wc-line);
  }
  .cs-intro { padding: 20px 4px 8px; max-width: 720px; margin: 0 auto; }
  .cs-lead {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ash-300);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  @media (min-width: 740px) { .cs-lead { font-size: 17px; } }
  .cs-lead :global(strong) { color: var(--color-ash-100); font-weight: 600; }
  .cs-lead :global(em) { color: var(--color-copper-bright); font-style: italic; font-family: var(--font-serif); }

  /* Stats band. auto-fit so three, four or five all sit right, and so it
     collapses to two columns on a phone instead of overflowing. */
  .cs-stats {
    max-width: 720px;
    margin: 4px auto 0;
    padding: 0 4px;
    display: grid;
    /* Two columns on phones and small tablets, with an odd last stat spanning
       the row, so a three-stat band never leaves an empty hairline cell. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--copper-hairline);
    border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card, 10px);
    overflow: hidden;
  }
  .cs-stat:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 740px) {
    .cs-stats { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
    .cs-stat:last-child:nth-child(odd) { grid-column: auto; }
  }
  .cs-stat {
    background: var(--color-bg-card);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cs-stat-v {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.1;
    color: var(--color-copper-bright);
  }
  .cs-stat-l {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ash-300);
    line-height: 1.4;
  }

  .cs-block { padding: 28px 4px 20px; max-width: 720px; margin: 0 auto; }
  .cs-h { font-family: var(--font-serif); font-size: 26px; font-weight: 600; color: var(--color-ash-100); margin: 0 0 16px; }
  @media (min-width: 740px) { .cs-h { font-size: 34px; } }
  .cs-details { margin: 0; display: grid; gap: 0; }
  .cs-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  @media (min-width: 740px) { .cs-row { grid-template-columns: 140px 1fr; gap: 18px; } }
  .cs-row:last-child { border-bottom: 0; }
  .cs-row dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-copper);
    margin: 0;
    padding-top: 2px;
  }
  .cs-row dd {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ash-300);
    margin: 0;
  }

  .cs-quote-wrap { padding: 20px 16px 4px; max-width: 760px; margin: 0 auto; }
  @media (min-width: 740px) { .cs-quote-wrap { padding: 28px 24px 4px; } }

  /* S339 round 3: the numbers on a riveted plate, the annealed copper. */
  .cs-stats { margin-top: 14px; padding: 6px; gap: 0; background-color: var(--wc-raised); border: 1px solid var(--wc-line); border-radius: var(--wc-r-lg); }
  .cs-stat { background: transparent; padding: 18px 16px; align-items: flex-start; }
  .cs-stat + .cs-stat { border-left: 1px solid var(--wc-line); }
  @media (max-width: 739px) { .cs-stat:nth-child(odd) { border-left: 0; } .cs-stat:nth-child(n + 3) { border-top: 1px solid var(--wc-line); } }
  .cs-stat-v { font-family: var(--wc-display); font-size: clamp(30px, 4vw, 40px); font-weight: 500; letter-spacing: -0.02em; background: var(--wc-annealed); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cs-stat-l { font-family: var(--font-sans); font-size: 13px; letter-spacing: 0; text-transform: none; color: var(--color-ash-300); }
  .cs-cta { padding-top: 4px; padding-bottom: 8px; }
  .cs-folds { max-width: 720px; margin: 8px auto 0; }
  .cs-folds .cs-lead { font-size: 15.5px; }

  /* S339 round 4: the live site is one tap from the top of the page. */
  .cs-visit { margin: 4px 0 14px; }
  .cs-visit :global(.wc-btn) { min-height: 48px; font-size: 15px; }
  .cs-hero-link { position: relative; display: block; border-radius: var(--wc-r-lg); overflow: hidden; border: 1px solid var(--wc-line); }
  .cs-hero-link:hover, .cs-hero-link:focus-visible { border-color: rgba(77, 216, 168, 0.5); }
  .cs-hero-chip {
    position: absolute; right: 12px; bottom: 12px;
    display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px;
    font-size: 13.5px; font-weight: 600; color: #06150f;
    background: var(--color-wc-green); border-radius: 999px;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.7);
  }
  .cs-lead :global(a.cs-client) {
    color: var(--color-copper-bright); font-weight: 600;
    text-decoration: underline; text-decoration-color: rgba(244, 168, 116, 0.5); text-underline-offset: 4px;
  }
  .cs-lead :global(a.cs-client)::after { content: ' \2197'; font-size: 0.85em; }
</style>
