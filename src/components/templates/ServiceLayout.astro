---
/**
 * ServiceLayout, shared scaffold for the Tier-1 service spine pages
 * (/services/<slug>). Keeps every service page native to the existing site
 * by reusing BaseLayout, Header, MobileMenu, PageHero, Divider, RelatedLinks,
 * and Contact. Per-service differentiation lives entirely in the copy passed
 * as props, not in the layout.
 *
 * Injects per-page Service + BreadcrumbList + FAQPage JSON-LD through the
 * BaseLayout head slot (CSP-safe data blocks).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import MobileMenu from '../layout/MobileMenu.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import PageHero from '../sections/PageHero.astro';
import Fold from '../ui/Fold.astro';
import RelatedLinks from '../sections/RelatedLinks.astro';
import Contact from '../sections/Contact.astro';
import TextCta from '../ui/TextCta.astro';
import type { ServiceEntry } from '../../lib/business';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

interface Include { h: string; body: string }
interface Faq { q: string; a: string }
interface RelatedLink { href: string; label: string; sub?: string }

interface Props {
  service: ServiceEntry;
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  sub: string;
  sub2?: string;
  bgImage?: string;
  bgOpacity?: number;
  /** Prominent photo hero with text in the photo's dead space + scrim. */
  showcase?: boolean;
  /** Photo focal point (object-position) for showcase heroes. */
  heroFocal?: string;
  /** Which dead-space the hero text sits in: 'bottom' (default) or 'top'. */
  heroTextPos?: 'top' | 'bottom';
  /** Override the public path. Defaults to /services/<slug>. */
  path?: string;
  /** Override the breadcrumb trail. Defaults to Home > Services > <name>. */
  breadcrumb?: { name: string; path: string }[];
  /** When set, the Service schema areaServed is this single town. */
  areaName?: string;
  /** Override the Service schema name (e.g. "App Development in Bandon, OR"). */
  schemaName?: string;
  intro: string[];
  /** Optional labeled figure shown under the intro (e.g. concept builds). */
  figure?: {
    src: string;
    srcLarge?: string;
    width: number;
    height: number;
    alt: string;
    caption?: string;
    /** Small honesty pill, e.g. "Concept build · fictional business". */
    label?: string;
  };
  includesTitle?: string;
  includes: Include[];
  /** Optional flexible sections rendered between includes and FAQ. 0, 1, or 2. */
  sections?: { heading: string; body: string[] }[];
  whyTitle?: string;
  /** When true, the page drops its own why-block and links to the canonical one. */
  whyLink?: boolean;
  why?: string[];
  /** When true, show a one-line link to the canonical /process page. */
  processLink?: boolean;
  /** S326: quiet links beside the Text button that follows the sections. */
  textLinks?: { href: string; label: string }[];
  /** S326: the Text button's words. Default "Text Preston". */
  textLabel?: string;
  /** S339 HONE-SPEC: the page's "why $1,750" line, shown in the closer. */
  closerWhy?: string;
  faq: Faq[];
  relatedTitle?: string;
  relatedIntro?: string;
  relatedLinks: RelatedLink[];
}

const {
  service,
  title,
  description,
  eyebrow,
  h1,
  sub,
  sub2,
  bgImage,
  bgOpacity = 0.34,
  showcase = false,
  heroFocal = 'center',
  heroTextPos = 'bottom',
  path: pathProp,
  breadcrumb,
  areaName,
  schemaName,
  intro,
  figure,
  includesTitle = "What's included",
  includes,
  sections = [],
  whyTitle = 'Why custom, not a builder',
  whyLink = false,
  why = [],
  processLink = false,
  textLinks = [{ href: '/pricing', label: 'See pricing' }, { href: '/work', label: 'See the work' }],
  textLabel,
  faq,
  relatedTitle = 'Serving the Oregon coast',
  relatedIntro,
  relatedLinks,
  closerWhy,
} = Astro.props;

const path = pathProp ?? `/services/${service.slug}`;
const serviceLd = serviceSchema({
  name: schemaName ?? service.name,
  serviceType: service.serviceType,
  description,
  path,
  areaName,
});
const crumbs = breadcrumb ?? [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path },
];
const breadcrumbLd = breadcrumbSchema(crumbs);
const faqLd = faq.length ? faqSchema(faq) : null;
// S339 (Nov 4 site audit): divider numbers run in document order. The
// fixed 04/05/06 after the counted sections printed 04 twice on any page
// with two sections (real estate, redesign).
---

<BaseLayout title={title} description={description} canonicalPath={path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <Header />
  <MobileMenu />
  <Breadcrumbs items={crumbs} />

  <PageHero
    eyebrow={eyebrow}
    h1={h1}
    sub={sub}
    sub2={sub2}
    bgImage={bgImage}
    bgOpacity={bgOpacity}
    showcase={showcase}
    bgPosition={heroFocal}
    textPos={heroTextPos}
  />

  <!-- S339 round 3 (Preston 2026-11-21: fold, dedupe, cut numbers). The
       story, the proof and the Text key stay open; what's included, the named
       sections, the why and the questions fold, text still in the HTML for
       search. /services/web-design#why opens its fold. -->
  <section class="svc-intro" aria-label="Overview">
    {intro.map((p) => <p class="svc-lead" set:html={p} />)}
    {figure && (
      <figure class="svc-figure">
        {figure.label && <span class="svc-figure-label">{figure.label}</span>}
        <img
          src={figure.src}
          srcset={figure.srcLarge ? `${figure.src} 800w, ${figure.srcLarge} 1200w` : undefined}
          sizes="(min-width: 740px) 680px, 100vw"
          alt={figure.alt}
          width={figure.width}
          height={figure.height}
          loading="lazy"
          decoding="async"
        />
        {figure.caption && <figcaption>{figure.caption}</figcaption>}
      </figure>
    )}
  </section>

  <section class="svc-folds" aria-labelledby="svc-incl-h">
    <h2 class="svc-sub-h" id="svc-incl-h">{includesTitle}</h2>
    {includes.map((it, i) => (
      <Fold title={it.h} group="svc-incl" open={i === 0}>
        <p set:html={it.body} />
      </Fold>
    ))}
  </section>

  {Astro.slots.has('proof') && (
    <section class="svc-block svc-proof" aria-label="Featured build">
      <slot name="proof" />
    </section>
  )}

  <section class="svc-block svc-cta" aria-label="Text Preston">
    <TextCta label={textLabel} links={textLinks} />
  </section>

  {(sections.length > 0 || (why.length > 0 && !whyLink)) && (
    <section class="svc-folds" aria-label="More detail">
      {sections.map((sec) => (
        <Fold title={sec.heading}>
          {sec.body.map((para) => <p set:html={para} />)}
        </Fold>
      ))}
      {why.length > 0 && !whyLink && (
        <Fold title={whyTitle} id="why">
          {why.map((para) => <p set:html={para} />)}
        </Fold>
      )}
    </section>
  )}

  {(whyLink || processLink) && (
    <p class="svc-inline">
      {whyLink && <a href="/services/web-design#why">Why custom code, not WordPress</a>}
      {processLink && <a href="/process">How a build goes</a>}
    </p>
  )}

  {faq.length > 0 && (
    <section class="svc-faq" aria-labelledby="svc-faq-h">
      <p class="wc-eyebrow"><span class="wc-dot" aria-hidden="true"></span>Questions</p>
      <h2 class="svc-faq-h" id="svc-faq-h">Straight answers</h2>
      {faq.map((item, i) => (
        <Fold title={item.q} group="svc-faq" open={i === 0}>
          <p set:html={item.a} />
        </Fold>
      ))}
    </section>
  )}

  <RelatedLinks
    id="svc-related"
    title={relatedTitle}
    intro={relatedIntro}
    links={relatedLinks}
  />

  <Contact />
</BaseLayout>

<style>
  .svc-intro {
    padding: 24px 4px 8px;
    max-width: 720px;
    margin: 0 auto;
  }
  @media (min-width: 740px) { .svc-intro { padding: 36px 4px 12px; } }
  .svc-lead {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ash-300);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  @media (min-width: 740px) { .svc-lead { font-size: 17.5px; } }
  .svc-lead :global(strong) { color: var(--color-ash-100); font-weight: 600; }
  .svc-lead :global(a) {
    color: var(--color-wc-green);
    text-decoration: underline;
    text-decoration-color: rgba(77, 216, 168, 0.45);
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .svc-lead :global(em) {
    color: var(--color-copper-bright);
    font-style: italic;
    font-family: var(--font-serif);
  }

  .svc-figure { margin: 22px 0 4px; position: relative; }
  .svc-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card, 10px);
    border: 1px solid var(--copper-hairline);
    display: block;
  }
  .svc-figure-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-copper);
    background: var(--color-bg-deep);
    border: 1px solid var(--copper-hairline);
    border-radius: 999px;
    padding: 4px 10px;
    margin-bottom: 10px;
  }
  .svc-figure figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ash-500);
    margin-top: 10px;
    letter-spacing: 0.03em;
  }

  .svc-block {
    padding: 32px 4px 24px;
    max-width: 960px;
    margin: 0 auto;
  }
  @media (min-width: 740px) { .svc-block { padding: 48px 4px 32px; } }
  .svc-block-head { margin: 0 0 18px; }
  .svc-block-h {
    font-family: var(--font-serif);
    font-size: 28px;
    line-height: 1.15;
    margin: 0;
    color: var(--color-ash-100);
    font-weight: 600;
  }
  @media (min-width: 740px) { .svc-block-h { font-size: 36px; } }
  @media (min-width: 1024px) { .svc-block-h { font-size: 42px; } }

  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: 18px 0 0;
  }
  @media (min-width: 740px) { .svc-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (min-width: 1024px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }
  .svc-card {
    background: var(--color-bg-card);
    border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card, 10px);
    padding: 18px 16px 16px;
  }
  .svc-card-h {
    font-family: var(--font-serif);
    font-size: 19px;
    margin: 0 0 8px;
    color: var(--color-ash-100);
    font-weight: 600;
  }
  @media (min-width: 740px) { .svc-card-h { font-size: 21px; } }
  .svc-card-body {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ash-300);
    margin: 0;
  }
  @media (min-width: 740px) { .svc-card-body { font-size: 14.5px; } }
  .svc-card-body :global(strong) { color: var(--color-ash-100); }

  .svc-why { max-width: 720px; }
  .svc-why-p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-ash-300);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  @media (min-width: 740px) { .svc-why-p { font-size: 16px; } }
  .svc-why-p :global(strong) { color: var(--color-ash-100); font-weight: 600; }
  /* Flexible per-page sections + inline canonical links (re-spine system) */
  .svc-section { max-width: 720px; }
  /* S339: one featured build under the sections (App Development: Chere'). */
  .svc-proof { max-width: 720px; padding-top: 4px; }
  .svc-section-p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-ash-300);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  @media (min-width: 740px) { .svc-section-p { font-size: 16px; } }
  .svc-section-p :global(strong) { color: var(--color-ash-100); font-weight: 600; }
  .svc-section-p :global(a) { color: var(--color-copper-bright); text-decoration: underline; text-underline-offset: 3px; }
  .svc-inline-link { max-width: 720px; padding-top: 4px; padding-bottom: 4px; }
  .svc-inline-link .svc-section-p { color: var(--color-ash-400); font-size: 14px; margin: 0; }
  @media (min-width: 740px) { .svc-inline-link .svc-section-p { font-size: 15px; } }
  .svc-why-p :global(em) {
    color: var(--color-copper-bright);
    font-style: italic;
    font-family: var(--font-serif);
  }

  /* FAQ accordion, mirrors services.astro pattern */
  .svc-faq {
    padding: 32px 4px 24px;
    max-width: 720px;
    margin: 0 auto;
  }
  @media (min-width: 740px) { .svc-faq { padding: 48px 4px 32px; } }
  .svc-faq-list { margin: 18px 0 0; display: grid; gap: 8px; }
  .svc-faq-item {
    background: var(--color-bg-card);
    border: 1px solid var(--copper-hairline);
    border-radius: var(--radius-card, 10px);
    overflow: hidden;
  }
  .svc-faq-item[open] { border-color: var(--copper-dim, rgba(240, 160, 110, 0.5)); }
  .svc-faq-q {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 14px 16px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .svc-faq-q::-webkit-details-marker { display: none; }
  .svc-faq-q:focus-visible {
    background-color: rgba(200, 128, 74, 0.04);
    outline: none;
  }

  @media (hover: hover) {

    .svc-faq-q:hover {
    background-color: rgba(200, 128, 74, 0.04);
    outline: none;
  }}
  .svc-faq-q-text {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ash-100);
    font-weight: 600;
    line-height: 1.35;
  }
  @media (min-width: 740px) { .svc-faq-q-text { font-size: 17px; } }
  .svc-faq-toggle {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--color-copper);
    width: 20px;
    text-align: center;
    transition: transform 0.15s ease;
  }
  .svc-faq-item[open] .svc-faq-toggle { transform: rotate(45deg); }
  .svc-faq-a {
    padding: 0 16px 16px 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ash-300);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 740px) { .svc-faq-a { font-size: 15px; } }
  .svc-faq-a p { margin: 14px 0 0; }
  .svc-faq-a :global(strong) { color: var(--color-ash-100); }
  .svc-faq-a :global(em) { color: var(--color-copper-bright); font-style: italic; }

  /* S339 round 3 */
  .svc-sub-h { margin: 0 0 14px; font-family: var(--wc-display); font-weight: 500; font-size: clamp(26px, 4vw, 40px); line-height: 1.1; letter-spacing: -0.015em; color: #eef1ec; }
  .svc-folds { margin-top: 24px; }
  .svc-inline { display: flex; flex-wrap: wrap; gap: 0 22px; margin: 14px 4px 0; }
  .svc-inline a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--color-wc-green); text-decoration: none; }
  .svc-inline a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .svc-faq { margin-top: 36px; }
  .svc-faq-h { margin: 0 0 16px; font-family: var(--wc-display); font-weight: 500; font-size: clamp(30px, 4.6vw, 48px); line-height: 1.05; letter-spacing: -0.02em; color: #eef1ec; }
</style>
