---
/**
 * HomeClose. S339 home consolidation, beat 05: the tagline as the last word.
 *
 * "Help is just a text away." set as large as the H1, then the one filled
 * control on the page's final screen (Text), Call as the quiet second, and the
 * reply line. The Tangle's locked close ("I'm down the road. I pick up the
 * phone.") lands here now that the Tangle is off Home.
 *
 * Keeps id="contact" and data-textbar-hide from the shared closer, so header
 * links to #contact still land and the phone thumb bar steps aside here.
 */
import { smsHref, telHref, phoneDisplay } from '../../lib/text-cta';

const sms = smsHref('/');
---

<section class="hc" id="contact" data-textbar-hide aria-labelledby="hc-h2">
  <div class="hc-glow" aria-hidden="true"></div>
  <div class="hc-inner">
    <p class="home-eyebrow"><span class="home-num">05</span> Reach out</p>
    <h2 class="hc-h2" id="hc-h2">Help is just a <span class="hc-cu">text away.</span></h2>
    <p class="hc-sub">I'm down the road. I pick up the phone.</p>

    <div class="hc-actions">
      <a class="hc-btn" href={sms}>
        <span class="hc-btn-stack">
          <span class="hc-btn-label">Text Preston</span>
          <span class="hc-btn-num">{phoneDisplay}</span>
        </span>
        <span class="hc-arrow" aria-hidden="true">→</span>
      </a>
      <a class="hc-call" href={telHref}>or call {phoneDisplay}</a>
    </div>

    <p class="hc-reply">I answer my texts within a few hours during business days.</p>
  </div>
</section>

<style>
  .hc {
    position: relative; overflow: hidden; isolation: isolate;
    padding: clamp(72px, 11vw, 160px) var(--home-gut) clamp(72px, 10vw, 140px);
  }
  .hc-glow {
    position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background:
      radial-gradient(50% 60% at 85% 20%, rgba(240, 160, 110, 0.11), transparent 70%),
      radial-gradient(45% 55% at 10% 95%, rgba(77, 216, 168, 0.07), transparent 72%);
  }
  .hc-inner { max-width: var(--home-max); margin: 0 auto; }
  .hc-h2 {
    margin: 0; max-width: 14ch;
    font-family: var(--home-display); font-weight: 500;
    font-size: clamp(44px, 8.6vw, 112px); line-height: 0.98; letter-spacing: -0.025em;
    color: #eef1ec; text-wrap: balance;
  }
  :global(html[data-display='sans']) .hc-h2 { font-weight: 600; letter-spacing: -0.045em; line-height: 0.96; }
  .hc-cu {
    background: var(--home-annealed); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-style: italic; padding-right: 0.06em;
  }
  :global(html[data-display='sans']) .hc-cu { font-style: normal; }
  .hc-sub { margin: clamp(20px, 3vw, 30px) 0 0; font-size: clamp(18px, 1.8vw, 22px); line-height: 1.5; color: var(--color-ash-300); }

  .hc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: clamp(30px, 4vw, 48px); }
  .hc-btn {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 36px;
    min-height: 68px; min-width: 248px; padding: 10px 24px;
    background: var(--color-wc-green); color: #06150f; border-radius: 4px; text-decoration: none;
    transition: background-color .2s ease;
  }
  .hc-btn:hover, .hc-btn:focus-visible { background: var(--color-wc-green-bright); }
  .hc-btn-stack { display: flex; flex-direction: column; gap: 2px; }
  .hc-btn-label { font-size: 19px; font-weight: 600; }
  .hc-btn-num { font-family: var(--font-mono); font-size: 13px; opacity: 0.78; }
  .hc-arrow { font-size: 22px; transition: transform .2s ease; }
  .hc-btn:hover .hc-arrow { transform: translateX(4px); }
  .hc-call { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; color: var(--color-ash-300); text-decoration: underline; text-decoration-color: rgba(170, 183, 186, 0.4); text-underline-offset: 5px; }
  .hc-call:hover, .hc-call:focus-visible { color: #eef1ec; text-decoration-color: var(--color-copper-bright); }
  .hc-reply { margin: 22px 0 0; font-size: 15px; color: var(--color-ash-500); }

  @media (prefers-reduced-motion: reduce) {
    .hc-btn, .hc-arrow { transition: none; }
  }
</style>
