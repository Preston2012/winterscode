---
/**
 * HomeClose. S339 home consolidation, beat 05: the tagline as the last word.
 *
 * "Help is just a text away." set as large as the H1, then the one filled
 * control on the page's final screen (Text), Call as the quiet second, and the
 * reply line. The Tangle's locked close ("I'm down the road. I pick up the
 * phone.") lands here now that the Tangle is off Home.
 *
 * Keeps id="contact" from the shared closer, so header links to #contact
 * still land; data-textbar-hide sits on the keys row, so the phone thumb bar
 * steps aside only while these keys are on screen.
 *
 * S453 motion: the close arrives like a text. A copper typing bubble sits
 * where the line will be, then the tagline rises in word by word, and the
 * Text key pings once, the way a phone does when the reply lands. It plays
 * once, on arrival (lib/in-view), every part under 1000ms. The words are one
 * string joined with real spaces (S339, section 5), and without script or
 * with reduced motion the tagline simply sits there.
 *
 * Round 2 (Preston, "too subtle"): a thread. The visitor's text comes in
 * first, in the green of the Text button: the opening words of the message
 * that button prefills (lib/text-cta, smsHref), so it shows what tapping it
 * starts. Then the dots, then the tagline as the reply. The bubble is
 * decoration (aria-hidden); it stays, so the close reads as a conversation
 * with or without the motion.
 */
import { smsHref, telHref, phoneDisplay } from '../../lib/text-cta';
import Arrow from '../ui/Arrow.astro';

const sms = smsHref('/');
const LEAD = ['Help', 'is', 'just', 'a'];
const headHtml =
  LEAD.map((w, i) => `<span class="hc-w" style="--w:${i}">${w}</span>`).join(' ') +
  ` <span class="hc-cu hc-w" style="--w:${LEAD.length}">text away.</span>`;
---

<section class="hc" id="contact" aria-labelledby="hc-h2" data-inview="0.35">
  <div class="hc-glow" aria-hidden="true"></div>
  <div class="hc-inner">
    <p class="wc-eyebrow"><span class="wc-dot" aria-hidden="true"></span>Reach out</p>
    <div class="hc-line">
      <p class="hc-sent" aria-hidden="true"><span>Hi Preston, found you at winterscode.com.</span></p>
      <div class="hc-reply-line">
        <span class="hc-typing" aria-hidden="true"><i></i><i></i><i></i></span>
        <h2 class="hc-h2" id="hc-h2" set:html={headHtml} />
      </div>
    </div>
    <p class="hc-sub">I'm down the road. I pick up the phone.</p>

    <div class="hc-actions" data-textbar-hide>
      <a class="wc-btn wc-btn--primary hc-btn" href={sms}>
        <span class="hc-btn-stack">
          <span class="hc-btn-label">Text Preston</span>
          <span class="hc-btn-num">{phoneDisplay}</span>
        </span>
        <Arrow size={22} />
      </a>
      <a class="wc-btn wc-btn--ghost hc-call" href={telHref}>
        <span class="hc-btn-stack">
          <span class="hc-btn-label">Call</span>
          <span class="hc-btn-num">{phoneDisplay}</span>
        </span>
      </a>
    </div>

    <p class="hc-reply">I answer my texts within a few hours during business days.</p>
  </div>
</section>

<style>
  .hc {
    position: relative; overflow: hidden; isolation: isolate;
    padding: clamp(72px, 11vw, 160px) var(--home-gut) clamp(72px, 10vw, 140px);
  }
  .hc-glow {
    position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background:
      radial-gradient(50% 60% at 85% 20%, rgba(240, 160, 110, 0.11), transparent 70%),
      radial-gradient(45% 55% at 10% 95%, rgba(77, 216, 168, 0.07), transparent 72%);
  }
  .hc-inner { max-width: var(--home-max); margin: 0 auto; }
  .hc-h2 {
    margin: 0; max-width: 14ch;
    font-family: var(--wc-display); font-weight: 500;
    font-size: clamp(44px, 8.6vw, 112px); line-height: 0.98; letter-spacing: -0.025em;
    color: #eef1ec; text-wrap: balance;
  }
  .hc-h2 :global(.hc-cu), .hc-cu {
    background: var(--wc-annealed); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-style: italic; padding-right: 0.06em;
  }
  .hc-sub { margin: clamp(20px, 3vw, 30px) 0 0; font-size: clamp(18px, 1.8vw, 22px); line-height: 1.5; color: var(--color-ash-300); }

  .hc-actions { display: grid; grid-template-columns: 1.5fr 1fr; gap: 10px; max-width: 460px; margin-top: clamp(28px, 4vw, 44px); }
  .hc-btn, .hc-call { min-height: 72px; }
  .hc-btn-stack { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left; }
  .hc-btn-label { font-size: 18px; font-weight: 600; }
  .hc-btn-num { font-family: var(--font-mono); font-size: 12.5px; font-weight: 400; opacity: 0.78; }
  .hc-reply { margin: 22px 0 0; font-size: 15px; color: var(--color-ash-500); }


  /* ── S453 motion ───────────────────────────────────────────── */
  .hc-line { position: relative; max-width: 760px; }
  .hc-reply-line { position: relative; }
  .hc-sent { display: flex; justify-content: flex-end; margin: 0 0 clamp(18px, 3vw, 28px); }
  .hc-sent span {
    max-width: 18rem; padding: 12px 16px;
    font-size: 16px; line-height: 1.4; color: #06150f;
    background: var(--color-wc-green);
    border-radius: 20px 20px 6px 20px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 12px 26px -14px rgba(77, 216, 168, 0.55);
  }
  .hc-h2 :global(.hc-w) { display: inline-block; }
  .hc-typing {
    position: absolute; left: 0; top: 0.2em;
    display: none; align-items: center; gap: 6px;
    padding: 14px 18px; border-radius: 22px 22px 22px 6px;
    background: linear-gradient(180deg, #2a221c, #1d1915);
    border: 1px solid rgba(240, 160, 110, 0.35);
    box-shadow: 0 14px 30px -16px rgba(0, 0, 0, 0.9);
    pointer-events: none;
  }
  .hc-typing i { width: 8px; height: 8px; border-radius: 50%; background: #f0b07c; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.hc[data-armed]) .hc-typing { display: inline-flex; opacity: 0; }
    :global(.hc[data-armed]:not(.is-in)) .hc-h2 :global(.hc-w) { opacity: 0; transform: translateY(0.5em); }
    :global(.hc[data-armed]:not(.is-in)) .hc-sent span { opacity: 0; transform: translate(40px, 16px) scale(0.7); }
    :global(.hc[data-armed].is-in) .hc-sent span { animation: hc-sent 560ms cubic-bezier(.2, .9, .3, 1.25) both; transform-origin: 100% 100%; }
    :global(.hc[data-armed].is-in) .hc-typing { animation: hc-bubble 980ms ease 520ms both; }
    :global(.hc[data-armed].is-in) .hc-typing i { animation: hc-dot 420ms ease-in-out 520ms 2 both; }
    :global(.hc[data-armed].is-in) .hc-typing i:nth-child(2) { animation-delay: 640ms; }
    :global(.hc[data-armed].is-in) .hc-typing i:nth-child(3) { animation-delay: 760ms; }
    :global(.hc[data-armed].is-in) .hc-h2 :global(.hc-w) {
      animation: hc-word 520ms cubic-bezier(.2, .85, .25, 1.15) both;
      animation-delay: calc(1280ms + var(--w) * 70ms);
    }
    :global(.hc[data-armed].is-in) .hc-btn { animation: hc-ping 900ms ease-out 1900ms both; }
    :global(.hc[data-armed].is-in) .hc-glow { animation: hc-glow 1000ms ease-out 1200ms both; }
  }
  @keyframes hc-sent {
    from { opacity: 0; transform: translate(40px, 16px) scale(0.7); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hc-bubble {
    0% { opacity: 0; transform: translateY(12px) scale(0.8); }
    18% { opacity: 1; transform: none; }
    76% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-8px) scale(0.92); }
  }
  @keyframes hc-dot {
    0%, 100% { transform: none; opacity: 0.45; }
    50% { transform: translateY(-5px); opacity: 1; }
  }
  @keyframes hc-word {
    from { opacity: 0; transform: translateY(0.5em) rotate(2deg); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes hc-ping {
    0% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 0 0 rgba(95, 232, 181, 0.55); transform: none; }
    25% { transform: scale(1.03); }
    100% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 0 22px rgba(95, 232, 181, 0); transform: none; }
  }
  @keyframes hc-glow {
    from { opacity: 0.2; transform: scale(0.9); }
    to { opacity: 1; transform: none; }
  }
</style>
