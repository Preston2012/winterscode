---
/**
 * WhyMe. S339 home consolidation, beat 03: why $1,750 buys more than a
 * template, and who is behind it. Replaces WhyPrice, CareLine and
 * AboutTeaser on Home; every line is condensed from those three and from
 * /services, nothing new is claimed.
 *
 * Round 2 (Preston's phone markup): the four values are a 2 by 2 of plates,
 * each with a drawn icon in a fixed corner seat, no numbers. The meter plate carries rivets.
 *
 * The phone-score meter: two bars, the county average and the floor every
 * build clears, fill when the meter scrolls into view. Without JavaScript, or
 * with reduced motion, they sit filled. The 61 is from Preston's audit of 169
 * Coos County business sites (the ones Google could score); the 90 is the
 * floor every build is held to and is measured live on the Wall.
 *
 * S453 motion (Preston 2026-11-27): the two numbers count up with their bars,
 * and the floor bar carries the live reading, one dot per live site at its
 * Google phone score, dropped onto the track after the bar fills. The dots and
 * the readout under them are painted from the Wall's last dated read
 * (lib/sites.ts) and replaced by /api/workshop when the meter arrives, so the
 * line always says when it was measured. A score under the floor would show
 * under the floor: the meter reports, it does not flatter. The four values
 * stamp in one by one, and the photo develops like a print as it scrolls in.
 */
import Arrow from '../ui/Arrow.astro';
import Icon from '../ui/Icon.astro';
import { WALL_SITES, LH_FALLBACK_AT } from '../../lib/sites';

const VALUES: { icon: 'keep' | 'all' | 'lock' | 'found'; head: string; body: string }[] = [
  { icon: 'all', head: 'One price', body: 'The quote is what you pay' },
  { icon: 'keep', head: 'No monthly rent', body: 'No platform fee to stay online' },
  { icon: 'lock', head: 'Locked down', body: 'Security graded live' },
  { icon: 'found', head: 'Readable by all', body: 'Keyboard and contrast built in' },
];

// The live reading, painted first from the Wall's last dated read.
const LIVE = WALL_SITES.filter((s) => s.lhFallback).map((s) => ({ key: s.key, label: s.label, score: (s.lhFallback as number[])[0] }));
const lowest = Math.min(...LIVE.map((s) => s.score));
const fallbackWhen = new Date(LH_FALLBACK_AT).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'America/Los_Angeles' });
---

<section class="wm" id="why" aria-labelledby="wm-h2">
  <div class="wm-inner">
    <p class="wc-eyebrow"><span class="wc-dot" aria-hidden="true"></span>Why it's worth it</p>
    <h2 class="wc-h2" id="wm-h2">Why $1,750 and <span class="wc-soft">not a few hundred.</span></h2>

    <!-- Round 4 (Preston: "looks bad, rethink and shrink"): one spec sheet.
         The meter and the four values share a riveted plate, the values a
         two-by-two of icon, name and one short line, split by hairlines. -->
    <div class="wm-sheet wc-plate wc-rv">
      <figure class="wm-meter" data-meter data-inview="0.45">
        <figcaption class="wm-meter-cap">Google's mobile test, out of 100</figcaption>
        <div class="wm-bar">
          <div class="wm-bar-label"><span>Coos County business sites, average</span>{' '}<b data-count="61">61</b></div>
          <div class="wm-track"><span class="wm-fill wm-fill-county"></span></div>
        </div>
        <div class="wm-bar">
          <div class="wm-bar-label"><span>Every site I build</span>{' '}<b class="wm-mine" data-count="90">90+</b></div>
          <div class="wm-track">
            <span class="wm-fill wm-fill-mine"></span><span class="wm-tick" aria-hidden="true"></span>
            {LIVE.map((s, i) => (
              <span class="wm-dot" data-site={s.key} style={`--x:${s.score}%;--d:${i}`} title={`${s.label} ${s.score}`} aria-hidden="true"></span>
            ))}
          </div>
          <p class="wm-live" data-live>
            <span class="wm-live-lamp" aria-hidden="true"></span>
            <span><b data-live-n>{LIVE.length}</b> sites, lowest <b data-live-low>{lowest}</b>, measured <span data-live-when>{fallbackWhen}</span></span>
          </p>
        </div>
        <p class="wm-meter-note">From my audit of 169 Coos County business sites. <a href="/wall">Mine, live on the Wall</a></p>
      </figure>
      <ul class="wm-specs">
        {VALUES.map((v, i) => (
          <li class="wm-spec" style={`--i:${i}`}>
            <span class="wm-spec-h"><Icon name={v.icon} size={18} class="wm-spec-i" />{v.head}</span>
            <span class="wm-spec-b">{v.body}</span>
          </li>
        ))}
      </ul>
    </div>
    <a class="wc-link wm-compare" href="/pricing#compare">Comparing quotes? Ask these five <Arrow size={16} /></a>

    <div class="wm-who wc-plate">
      <span class="wm-photo-frame"><img
        class="wm-photo"
        src="/photo/preston-560.webp"
        srcset="/photo/preston-560.webp 560w, /photo/preston-840.webp 840w"
        sizes="(min-width: 900px) 220px, 104px"
        alt="Preston Winters with his daughter at the Coquille River Lighthouse, Bandon, Oregon."
        width="560"
        height="530"
        loading="lazy"
        decoding="async"
      /></span>
      <p class="wm-who-name">I'm Preston Winters. <span>Sixth generation Bandon.</span></p>
      <div class="wm-who-copy">
        <p class="wm-who-body">The person you text is the person who builds it, and the one who keeps it running.</p>
        <a class="wc-link" href="/about">More about me <Arrow size={16} /></a>
      </div>
    </div>
  </div>
</section>

<script>
  // The live reading. The bars, counts and dots play through lib/in-view (the
  // meter carries data-inview); this swaps the painted read for the live one
  // when the meter arrives, and leaves the dated read in place if the feed is
  // down. Only a live or cached feed replaces it, never the Worker's static
  // fallback, which is older than the read already painted.
  import '../../lib/in-view';
  const meter = document.querySelector<HTMLElement>('[data-meter]');
  if (meter) {
    let done = false;
    const read = async () => {
      if (done) return;
      done = true;
      try {
        const r = await fetch('/api/workshop', { headers: { accept: 'application/json' } });
        if (!r.ok) return;
        const data = await r.json();
        const lh = data?.lighthouse;
        if (!lh || lh.source === 'fallback') return;
        const scores: number[] = [];
        meter.querySelectorAll<HTMLElement>('.wm-dot').forEach((dot) => {
          const q = lh[dot.dataset.site ?? ''];
          if (!Array.isArray(q) || typeof q[0] !== 'number') return;
          dot.style.setProperty('--x', `${q[0]}%`);
          dot.title = `${dot.title.split(' ')[0]} ${q[0]}`;
          scores.push(q[0]);
        });
        if (!scores.length) return;
        const low = meter.querySelector<HTMLElement>('[data-live-low]');
        const n = meter.querySelector<HTMLElement>('[data-live-n]');
        const when = meter.querySelector<HTMLElement>('[data-live-when]');
        if (low) low.textContent = String(Math.min(...scores));
        if (n) n.textContent = String(scores.length);
        if (when && typeof lh.measured === 'string') when.textContent = lh.measured;
        meter.classList.add('wm-is-live');
      } catch {
        // The dated read stays.
      }
    };
    if (meter.classList.contains('is-in')) read();
    else meter.addEventListener('wc:in', read, { once: true });
    // Without the observer (or with reduced motion) nothing arms; read on idle.
    if (!meter.hasAttribute('data-armed')) {
      if ('requestIdleCallback' in window) window.requestIdleCallback(() => { read(); });
      else window.setTimeout(() => { read(); }, 800);
    }
  }
</script>

<style>
  /* clip, not hidden: hidden makes the section a scroll container, and every
     view timeline inside it then measured a box that never scrolls, so the
     photo and the values stopped part-done (S453, Preston's phone). */
  .wm { padding: var(--home-pad) var(--home-gut); position: relative; isolation: isolate; overflow: clip; }
  .wm::before {
    content: ''; position: absolute; z-index: -1; inset: auto -20% -30% auto; width: 70%; height: 80%;
    background: radial-gradient(closest-side, rgba(77, 216, 168, 0.07), transparent);
    pointer-events: none;
  }
  .wm-inner { max-width: var(--home-max); margin: 0 auto; }
  .wm-sheet { margin-top: clamp(22px, 3.4vw, 32px); padding: 0; overflow: clip; }
  .wm-meter { margin: 0; padding: 26px 22px 16px; }
  .wm-meter-cap { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash-500); margin-bottom: 16px; }
  .wm-bar + .wm-bar { margin-top: 16px; }
  .wm-bar-label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--color-ash-300); margin-bottom: 8px; }
  .wm-bar-label b { flex: none; white-space: nowrap; font-family: var(--wc-display); font-weight: 500; font-size: 30px; line-height: 1; color: var(--color-ash-100); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .wm-bar-label b.wm-mine { color: var(--color-wc-green-bright); }
  .wm-track { position: relative; height: 10px; background: rgba(221, 228, 230, 0.07); border-radius: 5px; box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5); }
  .wm-fill { position: absolute; inset: 0 auto 0 0; border-radius: 5px; transition: width 900ms cubic-bezier(.2, .7, .2, 1); }
  .wm-fill-county { width: 61%; background: linear-gradient(90deg, #4a5459, #7d888c); }
  .wm-fill-mine { width: 90%; background: linear-gradient(90deg, #2f9e78, var(--color-wc-green-bright)); transition-delay: .2s; }
  .wm-tick { position: absolute; top: -3px; bottom: -3px; left: 90%; width: 2px; background: rgba(238, 241, 236, 0.55); }
  :global(.wm-meter[data-armed]:not(.is-in)) .wm-fill { width: 0; }

  /* The live dots: one per live site, centred on its score. */
  .wm-dot {
    position: absolute; top: 50%; left: var(--x); z-index: 1;
    width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%;
    background: #f2f5ef; box-shadow: 0 0 0 2px #0f1a16, 0 0 8px rgba(95, 232, 181, 0.55);
    transition: left 600ms cubic-bezier(.2, .8, .2, 1);
  }
  .wm-live {
    display: flex; align-items: center; gap: 8px;
    margin: 10px 0 0; font-size: 13.5px; line-height: 1.4; color: var(--color-ash-300);
  }
  .wm-live b { color: #eef1ec; font-weight: 600; font-variant-numeric: tabular-nums; }
  .wm-live-lamp {
    flex: none; width: 7px; height: 7px; border-radius: 50%; background: #6c777b;
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  :global(.wm-meter.wm-is-live) .wm-live-lamp { background: var(--color-wc-green-bright); box-shadow: 0 0 0 3px rgba(77, 216, 168, 0.16), 0 0 10px rgba(95, 232, 181, 0.55); }

  .wm-meter-note { margin: 14px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--color-ash-500); }
  .wm-meter-note a { color: var(--color-wc-green); text-decoration: underline; text-underline-offset: 3px; }

  .wm-specs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--wc-line); }
  .wm-spec { display: flex; flex-direction: column; gap: 4px; padding: 16px 16px 18px; }
  .wm-spec:nth-child(even) { border-left: 1px solid var(--wc-line); }
  .wm-spec:nth-child(n + 3) { border-top: 1px solid var(--wc-line); }
  .wm-spec-h { display: flex; align-items: center; gap: 8px; font-size: 15.5px; font-weight: 600; color: #eef1ec; }
  .wm-spec-h :global(.wm-spec-i) { flex: none; color: var(--color-copper-bright); }
  .wm-spec-b { font-size: 13.5px; line-height: 1.4; color: var(--color-ash-300); padding-left: 26px; }
  .wm-compare { margin-top: 8px; }

  @media (min-width: 900px) {
    .wm-sheet { display: grid; grid-template-columns: 1.1fr 1fr; }
    .wm-meter { padding: 32px 30px 22px; }
    .wm-specs { border-top: 0; border-left: 1px solid var(--wc-line); }
    .wm-spec { justify-content: center; padding: 20px 22px; }
    .wm-spec-h { font-size: 17px; }
    .wm-spec-b { font-size: 14.5px; }
  }

  .wm-who {
    margin-top: clamp(32px, 5vw, 64px);
    display: grid; grid-template-columns: 104px 1fr; gap: 16px 18px; align-items: center;
    padding: 18px;
  }
  .wm-photo-frame { display: block; overflow: clip; border-radius: var(--wc-r-sm); }
  .wm-photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 25% 70%; border-radius: var(--wc-r-sm); }
  .wm-who-name { margin: 0; font-family: var(--wc-display); font-weight: 500; font-size: clamp(22px, 2.6vw, 32px); line-height: 1.15; color: #eef1ec; letter-spacing: -0.01em; }
  .wm-who-name span { color: var(--color-ash-300); }
  .wm-who-copy { grid-column: 1 / -1; }
  .wm-who-body { margin: 0 0 4px; max-width: 40rem; font-size: 16px; line-height: 1.6; color: var(--color-ash-300); }

  @media (min-width: 900px) {
    .wm-who { grid-template-columns: 200px minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 36px; padding: 22px; }
    .wm-who-copy { grid-column: auto; }
  }

  /* ── S453 motion ───────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    /* The dots drop onto the track once the floor bar has filled. */
    :global(.wm-meter[data-armed]:not(.is-in)) .wm-dot { opacity: 0; transform: translateY(-16px) scale(0.4); }
    :global(.wm-meter[data-armed].is-in) .wm-dot {
      animation: wm-drop 420ms cubic-bezier(.2, .9, .3, 1.35) both;
      animation-delay: calc(850ms + var(--d) * 45ms);
    }
    @supports (animation-timeline: view()) {
      .wm-specs { view-timeline: --wm-specs block; view-timeline-inset: var(--vi); }
      .wm-spec { animation: wm-in linear both; animation-timeline: --wm-specs; animation-range: entry calc(var(--i) * 8%) entry calc(36% + var(--i) * 8%); }
      .wm-spec-h :global(.wm-spec-i) {
        animation: wm-stamp linear both;
        animation-timeline: --wm-specs;
        animation-range: entry calc(8% + var(--i) * 8%) entry calc(46% + var(--i) * 8%);
      }
      .wm-photo {
        animation: wm-develop linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 0% entry 100%;
      }
      .wm-who-name {
        animation: wm-in linear both;
        animation-timeline: view(block var(--vi));
        animation-range: entry 0% entry 90%;
      }
    }
  }
  @keyframes wm-drop {
    from { opacity: 0; transform: translateY(-16px) scale(0.4); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wm-in {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wm-stamp {
    0% { opacity: 0; transform: scale(2.4) rotate(-24deg); }
    70% { opacity: 1; transform: scale(0.88) rotate(4deg); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes wm-develop {
    from { transform: scale(1.7); filter: grayscale(1) sepia(0.6) contrast(0.7) brightness(1.5) blur(3px); }
    60% { filter: grayscale(0.4) sepia(0.25) contrast(0.9) brightness(1.15) blur(0.5px); }
    to { transform: none; filter: none; }
  }

  @media (prefers-reduced-motion: reduce) { .wm-fill, .wm-dot { transition: none; } }
</style>
