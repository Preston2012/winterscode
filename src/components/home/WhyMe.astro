---
/**
 * WhyMe. S339 home consolidation, beat 03: why $1,750 buys more than a
 * template, and who is behind it. Replaces WhyPrice, CareLine and
 * AboutTeaser on Home; every line is condensed from those three and from
 * /services, nothing new is claimed.
 *
 * Round 2 (Preston's phone markup): the four values are a 2 by 2 of plates,
 * each with a drawn icon, no numbers. The meter plate carries rivets.
 *
 * The phone-score meter is the section's one moving part: two bars, the
 * county average and the floor every build clears, fill when the meter
 * scrolls into view. Without JavaScript, or with reduced motion, they sit
 * filled. The 61 is from Preston's audit of 169 Coos County business sites
 * (the ones Google could score); the 90 is the floor every build is held to
 * and is measured live on the Wall.
 */
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';

const VALUES: { icon: 'keep' | 'all' | 'lock' | 'found'; head: string; body: string }[] = [
  { icon: 'keep', head: 'Yours to keep.', body: 'Custom code, your domain, your account. Skip the care plan and nothing turns off.' },
  { icon: 'all', head: 'Everything in.', body: 'Pages, words, real photos and branding. The price I quote is the price you pay.' },
  { icon: 'lock', head: 'Locked down.', body: 'HTTPS, strict security headers and spam-protected forms, graded live on the Wall.' },
  { icon: 'found', head: 'Set up to be found.', body: 'Search Console, sitemap and Business Profile, all done. Nobody can promise a ranking.' },
];
---

<section class="wm" id="why" aria-labelledby="wm-h2">
  <div class="wm-inner">
    <div class="wm-top">
      <div class="wm-lead">
        <p class="home-eyebrow"><span class="home-dot" aria-hidden="true"></span>Why it's worth it</p>
        <h2 class="home-h2" id="wm-h2">Why $1,750 and <span class="home-soft">not a few hundred.</span></h2>

        <figure class="wm-meter home-plate rv" data-meter>
          <figcaption class="wm-meter-cap">Google's mobile test, out of 100</figcaption>
          <div class="wm-bar">
            <div class="wm-bar-label"><span>Coos County business sites, average</span><b>61</b></div>
            <div class="wm-track"><span class="wm-fill wm-fill-county"></span></div>
          </div>
          <div class="wm-bar">
            <div class="wm-bar-label"><span>Every site I build</span><b class="wm-mine">90+</b></div>
            <div class="wm-track"><span class="wm-fill wm-fill-mine"></span><span class="wm-tick" aria-hidden="true"></span></div>
          </div>
          <p class="wm-meter-note">From my audit of 169 Coos County business sites, the ones Google could score.</p>
          <a class="home-link" href="/wall">Every build of mine, scored live on the Wall <Arrow size={16} /></a>
        </figure>
      </div>

      <div class="wm-right">
        <ul class="wm-values">
          {VALUES.map((v) => (
            <li class="wm-value">
              <h3 class="wm-vh">
                {v.head.split(' ').slice(0, -1).join(' ')}{' '}
                <span class="wm-vlast">{v.head.split(' ').slice(-1)[0]}<span class="wm-seat" aria-hidden="true"><Icon name={v.icon} size={17} /></span></span>
              </h3>
              <p class="wm-vb">{v.body}</p>
            </li>
          ))}
        </ul>
        <a class="home-link wm-compare" href="/pricing#compare">Comparing quotes? Ask these five questions <Arrow size={16} /></a>
      </div>
    </div>

    <div class="wm-who home-plate">
      <img
        class="wm-photo"
        src="/photo/preston-560.webp"
        srcset="/photo/preston-560.webp 560w, /photo/preston-840.webp 840w"
        sizes="(min-width: 900px) 220px, 104px"
        alt="Preston Winters with his daughter at the Coquille River Lighthouse, Bandon, Oregon."
        width="560"
        height="530"
        loading="lazy"
        decoding="async"
      />
      <p class="wm-who-name">I'm Preston Winters. <span>Sixth generation Bandon.</span></p>
      <div class="wm-who-copy">
        <p class="wm-who-body">
          I've owned small businesses, so I know what it's like to drown in software you didn't choose.
          Now I build the tools I wish I'd had. The person you text is the person who builds it, and the one
          who keeps it running if you want that, with optional care from $75 a month.
        </p>
        <a class="home-link" href="/about">More about me <Arrow size={16} /></a>
      </div>
    </div>
  </div>
</section>

<script>
  // Fill the two bars once the meter is on screen. The bars start filled in
  // the CSS; this only arms the empty state when it can also release it.
  const meter = document.querySelector<HTMLElement>('[data-meter]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (meter && !still && 'IntersectionObserver' in window) {
    meter.classList.add('wm-armed');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        meter.classList.add('wm-in');
        io.disconnect();
      }
    }, { threshold: 0.45 });
    io.observe(meter);
  }
</script>

<style>
  .wm { padding: var(--home-pad) var(--home-gut); position: relative; isolation: isolate; overflow: hidden; }
  .wm::before {
    content: ''; position: absolute; z-index: -1; inset: auto -20% -30% auto; width: 70%; height: 80%;
    background: radial-gradient(closest-side, rgba(77, 216, 168, 0.07), transparent);
    pointer-events: none;
  }
  .wm-inner { max-width: var(--home-max); margin: 0 auto; }
  .wm-top { display: grid; gap: clamp(28px, 5vw, 72px); }

  .wm-meter { margin: clamp(24px, 4vw, 36px) 0 0; padding: 26px 22px 14px; }
  .wm-meter-cap { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash-500); margin-bottom: 18px; }
  .wm-bar + .wm-bar { margin-top: 18px; }
  .wm-bar-label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 15px; color: var(--color-ash-300); margin-bottom: 8px; }
  .wm-bar-label b { flex: none; white-space: nowrap; font-family: var(--home-display); font-weight: 500; font-size: 30px; line-height: 1; color: var(--color-ash-100); letter-spacing: -0.02em; }
  .wm-bar-label b.wm-mine { color: var(--color-wc-green-bright); }
  .wm-track { position: relative; height: 10px; background: rgba(221, 228, 230, 0.07); border-radius: 5px; overflow: hidden; box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5); }
  .wm-fill { position: absolute; inset: 0 auto 0 0; border-radius: 5px; transition: width 1.1s cubic-bezier(.2, .7, .2, 1); }
  .wm-fill-county { width: 61%; background: linear-gradient(90deg, #4a5459, #7d888c); }
  .wm-fill-mine { width: 90%; background: linear-gradient(90deg, #2f9e78, var(--color-wc-green-bright)); transition-delay: .25s; }
  .wm-tick { position: absolute; top: 0; bottom: 0; left: 90%; width: 2px; background: rgba(238, 241, 236, 0.55); }
  :global(.wm-meter.wm-armed:not(.wm-in)) .wm-fill { width: 0; }
  .wm-meter-note { margin: 18px 0 2px; font-size: 14px; line-height: 1.55; color: var(--color-ash-500); }

  .wm-values { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .wm-value {
    display: flex; flex-direction: column; gap: 6px;
    padding: 16px 14px 16px;
    background-color: var(--home-raised);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0) 60%);
    border: 1px solid var(--home-line);
    border-radius: var(--home-r);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  /* The icon sits in a seat at the end of the heading, held to the last
     word so it never wraps onto a line by itself. */
  .wm-vh { margin: 0 0 2px; font-size: 16.5px; font-weight: 600; color: #eef1ec; line-height: 1.3; }
  .wm-vlast { white-space: nowrap; }
  .wm-seat {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; margin-left: 8px; vertical-align: -8px;
    border-radius: 50%;
    color: var(--color-copper-bright);
    background: radial-gradient(circle at 50% 35%, rgba(244, 168, 116, 0.12), rgba(244, 168, 116, 0.03));
    border: 1px solid rgba(216, 144, 90, 0.36);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .wm-vb { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--color-ash-300); }
  .wm-compare { margin-top: 10px; }

  .wm-who {
    margin-top: clamp(32px, 5vw, 64px);
    display: grid; grid-template-columns: 104px 1fr; gap: 16px 18px; align-items: center;
    padding: 18px;
  }
  .wm-photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 25% 70%; border-radius: var(--home-r-sm); }
  .wm-who-name { margin: 0; font-family: var(--home-display); font-weight: 500; font-size: clamp(22px, 2.6vw, 32px); line-height: 1.15; color: #eef1ec; letter-spacing: -0.01em; }
  .wm-who-name span { color: var(--color-ash-300); }
  .wm-who-copy { grid-column: 1 / -1; }
  .wm-who-body { margin: 0 0 4px; max-width: 40rem; font-size: 16px; line-height: 1.6; color: var(--color-ash-300); }

  @media (min-width: 900px) {
    .wm-top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .wm-right { padding-top: 6px; }
    .wm-meter { padding: 30px 28px 16px; }
    .wm-value { padding: 20px 18px; }
    .wm-vh { font-size: 18px; }
    .wm-vb { font-size: 15px; }
    .wm-who { grid-template-columns: 200px minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 36px; padding: 22px; }
    .wm-who-copy { grid-column: auto; }
  }
  @media (max-width: 359px) { .wm-values { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) { .wm-fill { transition: none; } }
</style>
