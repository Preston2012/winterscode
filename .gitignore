# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Cloudflare adapter local state (miniflare cache, KV/D1/R2 sandbox data)
.wrangler/

# Build artifacts and types (already covered above but listed for clarity)

# Cloudflare Pages local secrets (never commit)
.dev.vars
.dev.vars.*

# Internal/operational docs - private, see winterscode-internal repo
docs/*
!docs/screenshots/

# .env matches exactly one filename. A prefixed or suffixed variant walks past
# it, which is how .demiurge-cax11.env sat untracked and unignored in another
# repo on this host. Latent there, so closed everywhere rather than only where
# a file happened to exist.
.env.*
*.env
*.key
*.pem
*credential*
*secret*
