# Hashed assets (Astro emits content-addressed paths under /_astro/) are
# immutable: a content change yields a new path. Cache aggressively at the
# edge AND in browsers.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets (favicon, brandmark, og-image) get long cache. They rarely
# change but are not content-hashed, so use a lifetime we can purge.
/brandmark.svg
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.svg
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-w.svg
  Cache-Control: public, max-age=86400, must-revalidate

/wc-stamp-*
  Cache-Control: public, max-age=86400, must-revalidate

/wordmark.svg
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate

# HTML documents render a built shell plus live client-fetched data (workshop
# wall, availability). Strategy: edge-cache the shell (s-maxage=600) so cold
# POPs serve a fast TTFB, but force the BROWSER to revalidate every navigation
# (max-age=0, must-revalidate) so a visitor never holds a stale shell. The
# deploy step purges the edge, so a cached shell can never outlive a deploy.
# The /api/* routes set their own no-store and are never cached here.
/
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/work
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/services
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/about
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/contact
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/wall
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/audit
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/changelog
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/privacy
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/terms
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
/404
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600

# Self-hosted fonts under /_fonts are built by scripts/subset-fonts.py and are
# not content-hashed, so a change gets a new file name (the wght range is in
# it) rather than a purge. 30 days keeps repeat visits off the network.
/_fonts/*
  Cache-Control: public, max-age=2592000, immutable

# Portfolio card images change only when a card is re-cut. A week.
#
# S199: this was /work/* and it caught the four case-study HTML pages, which
# are served at /work/<slug> with no extension. Measured on production: the
# case studies came back max-age=604800 while every other document came back
# max-age=0, must-revalidate. A visitor held a case study in their own browser
# for a week and the deploy purge only clears the edge, so a corrected price or
# a removed client claim did not reach anyone who had already read it.
#
# The fix is to narrow the pattern, never to add an overriding rule: Cloudflare
# joins duplicate header values with a comma rather than replacing them, so a
# second Cache-Control rule on the same path yields one merged header. Only one
# splat is allowed per pattern, so the two asset extensions get one rule each.
/work/*.webp
  Cache-Control: public, max-age=604800, must-revalidate

/work/*.png
  Cache-Control: public, max-age=604800, must-revalidate

# The case-study documents, now carrying the same policy as their siblings
# above rather than the image policy they were inheriting by accident.
/work/bandon-by-the-dunes
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600

/work/baseline-marketing
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600

/work/seabreeze
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600

/work/sogn-contracting
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600
